  <tendon>
    <fixed name="split">
      <joint joint="finger_joint1" coef="0.5"/>
      <joint joint="finger_joint2" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <joint joint1="finger_joint1" joint2="finger_joint2" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <!-- 抓取吸附约束（grasp assist）：默认关闭，CLOSE 阶段检测到物体在指尖间且夹爪
         闭合时由代码激活，模拟「指尖摩擦锁死物体」。这是 robosuite/ManiSkill 等
         主流 IL 数据采集环境的通行做法，物理上等价于成功夹持，便于采集干净演示。
         注意：object body 在 build 时由 dp_objects 片段注入，名字固定为 "object"。 -->
    <weld name="grasp_weld" body1="hand" body2="object" active="false"
          solimp="0.9 0.95 0.001" solref="0.02 1"/>
  </equality>

