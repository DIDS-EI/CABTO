selector
    cond On(big_box,board)
    sequence
        cond On(left_robot,center_table)
        selector
            sequence
                cond Holding(left_robot,big_box)
                act PlaceOnBoard(left_robot,big_box)
            sequence
                cond On(big_box,center_table)
                cond IsHandEmpty(left_robot)
                act PickUp(left_robot,big_box)
    sequence
        cond On(big_box,center_table)
        cond On(left_robot,left_table)
        cond On(left_robot,right_table)
        cond IsHandEmpty(left_robot)
        act MoveRobotToCenterTable(left_robot)
