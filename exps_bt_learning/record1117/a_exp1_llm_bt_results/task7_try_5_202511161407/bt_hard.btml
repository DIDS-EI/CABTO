selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            sequence
                                cond IsOpened(microwave)
                                selector
                                    sequence
                                        cond IsSwitchedOn(radio)
                                        act PutOnBreakfastTable(pie)
                                    sequence
                                        cond IsSwitchedOff(radio)
                                        act SwitchOn(radio)
                            sequence
                                cond IsClosed(microwave)
                                cond IsSwitchedOff(radio)
                                act OpenDevice(microwave)
                    sequence
                        cond IsClosed(microwave)
                        cond IsSwitchedOff(radio)
                        cond IsClosed(oven)
                        act OpenDevice(oven)
            sequence
                cond IsSwitchedOff(light)
                cond IsClosed(microwave)
                cond IsSwitchedOff(radio)
                cond IsClosed(oven)
                act SwitchOn(light)
    sequence
        cond IsClosed(microwave)
        cond IsClosed(oven)
        cond IsSwitchedOff(light)
        cond IsHandEmpty()
        cond IsSwitchedOff(radio)
        act PickUp(pie)
