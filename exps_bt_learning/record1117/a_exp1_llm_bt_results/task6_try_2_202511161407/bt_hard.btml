selector
    sequence
        cond IsClosed(fridge)
        cond In(banana,fridge)
    sequence
        cond Open(fridge)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    cond In(banana,fridge)
                    act Close(fridge)
                sequence
                    cond Holding(banana)
                    act PutInContainer(banana,fridge)
            sequence
                cond IsHandEmpty()
                cond On(banana,table)
                act PickUpFromSurface(banana,table)
    sequence
        cond IsClosed(fridge)
        cond IsHandEmpty()
        cond On(banana,table)
        act Open(fridge)
