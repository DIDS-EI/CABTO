selector
    sequence
        cond On(b,d)
        cond On(c,b)
        cond On(a,c)
    sequence
        cond On(b,d)
        selector
            selector
                sequence
                    cond On(a,c)
                    selector
                        sequence
                            cond Holding(c)
                            act PutAonB(c,b)
                        sequence
                            cond On(c,table)
                            cond IsHandEmpty()
                            act PickUp(c)
                sequence
                    cond On(c,table)
                    cond Holding(a)
                    act PutAonB(a,c)
            sequence
                cond On(c,table)
                cond IsHandEmpty()
                cond On(a,table)
                act PickUp(a)
    sequence
        cond On(c,table)
        cond On(a,table)
        selector
            sequence
                cond Holding(b)
                act PutAonB(b,d)
            sequence
                cond IsHandEmpty()
                cond On(b,table)
                act PickUp(b)
