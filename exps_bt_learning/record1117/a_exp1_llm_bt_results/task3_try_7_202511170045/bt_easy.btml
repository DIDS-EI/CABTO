selector
    cond In(left_lego,center_big_box)
    sequence
        cond Holding(right_franka,center_big_box)
        selector
            selector
                sequence
                    cond Holding(left_franka,left_lego)
                    act DropLeftFranka(left_lego,center_big_box)
                sequence
                    cond IsHandEmpty(left_franka)
                    cond On(left_franka,left_table)
                    cond On(left_lego,left_table)
                    act PickUpLeftFranka(left_lego)
            sequence
                cond On(left_franka,left_table)
                cond Holding(left_franka,center_big_box)
                cond On(left_lego,left_table)
                act DropLeftFranka(center_big_box,center_big_box)
    sequence
        cond IsHandEmpty(right_franka)
        cond BigBoxNeedTwoFrankaHoldTogether()
        cond IsHandEmpty(left_franka)
        cond On(left_franka,left_table)
        cond On(left_lego,left_table)
        cond On(center_big_box,center_table)
        act HoldCenterBigBoxTogether(center_big_box)
