selector
    sequence
        cond On(c,place_c)
        cond On(b,place_b)
    sequence
        cond On(b,place_b)
        selector
            sequence
                cond Holding(c)
                act Drop(c,place_c)
            sequence
                cond On(c,table)
                cond IsHandEmpty()
                act PickUp(c)
    sequence
        cond On(c,table)
        selector
            sequence
                cond Holding(b)
                act Drop(b,place_b)
            sequence
                cond On(b,table)
                cond IsHandEmpty()
                act PickUp(b)
