selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            selector
                sequence
                    cond Holding(book)
                    act StoreInContainer(book,cabinet)
                sequence
                    cond In(book,fridge)
                    cond IsOpened(fridge)
                    cond IsHandEmpty()
                    act RemoveFromContainer(book,fridge)
            sequence
                cond In(book,fridge)
                cond IsClosed(fridge)
                cond IsHandEmpty()
                act Open(fridge)
    sequence
        cond In(book,fridge)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty()
                act Open(cabinet)
            sequence
                cond Holding(banana)
                act PutDown(banana,table)
