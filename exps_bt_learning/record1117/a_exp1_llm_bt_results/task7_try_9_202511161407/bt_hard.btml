selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond On(pie,breakfast_table)
        cond IsClosed(oven)
        selector
            selector
                sequence
                    cond IsOpened(microwave)
                    selector
                        sequence
                            cond IsHandEmpty(left_franka)
                            selector
                                sequence
                                    cond IsSwitchedOn(light)
                                    selector
                                        sequence
                                            cond IsSwitchedOn(radio)
                                            act OpenDeviceLeftFranka(oven)
                                        sequence
                                            cond IsSwitchedOff(radio)
                                            act SwitchOnLeftFranka(radio)
                                sequence
                                    cond IsSwitchedOff(light)
                                    cond IsSwitchedOff(radio)
                                    act SwitchOnLeftFranka(light)
                        sequence
                            cond IsSwitchedOff(light)
                            cond Holding(left_franka,soup)
                            cond IsSwitchedOff(radio)
                            act PutDownLeftFranka(soup)
                sequence
                    cond Holding(left_franka,soup)
                    cond IsHandEmpty(left_franka)
                    cond IsClosed(microwave)
                    cond IsSwitchedOff(light)
                    cond IsSwitchedOff(radio)
                    act OpenDeviceLeftFranka(microwave)
            sequence
                cond In(chickenleg,microwave)
                cond Holding(left_franka,soup)
                cond IsClosed(microwave)
                cond Holding(left_franka,chickenleg)
                cond IsSwitchedOff(light)
                cond IsSwitchedOff(radio)
                act PutDownInLeftFranka(chickenleg,microwave)
