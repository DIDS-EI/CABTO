selector
    sequence
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        cond In(banana,fridge)
        cond On(book,breakfast_table)
    sequence
        cond IsClosed(cabinet)
        selector
            selector
                selector
                    sequence
                        cond In(banana,fridge)
                        selector
                            sequence
                                cond IsClosed(fridge)
                                selector
                                    sequence
                                        cond Holding(book)
                                        act PutOn(book,breakfast_table)
                                    sequence
                                        cond On(book,table)
                                        cond IsHandEmpty()
                                        act PickUp(book)
                            sequence
                                cond IsOpened(fridge)
                                cond On(book,table)
                                cond IsHandEmpty()
                                act Close(fridge)
                    sequence
                        cond IsOpened(fridge)
                        cond On(book,table)
                        cond Holding(banana)
                        act PutIn(banana,fridge)
                sequence
                    cond On(book,table)
                    cond IsOpened(fridge)
                    cond On(banana,table)
                    cond IsHandEmpty()
                    act PickUp(banana)
            sequence
                cond On(book,table)
                cond IsClosed(fridge)
                cond On(banana,table)
                cond IsHandEmpty()
                act Open(fridge)
