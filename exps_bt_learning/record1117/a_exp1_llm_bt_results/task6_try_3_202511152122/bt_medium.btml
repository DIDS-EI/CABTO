selector
    sequence
        cond In(pen,cabinet)
        cond On(book,breakfast_table)
    sequence
        cond In(pen,cabinet)
        selector
            sequence
                cond Holding(book)
                act DropAction(book,breakfast_table)
            sequence
                cond In(book,fridge)
                cond IsHandEmpty()
                cond Open(fridge)
                act TakeOutAction(book,fridge)
    sequence
        cond In(book,fridge)
        selector
            selector
                sequence
                    cond Open(fridge)
                    selector
                        sequence
                            cond Open(cabinet)
                            selector
                                sequence
                                    cond Holding(pen)
                                    act PutInAction(pen,cabinet)
                                sequence
                                    cond IsHandEmpty()
                                    cond In(pen,fridge)
                                    act TakeOutAction(pen,fridge)
                        sequence
                            cond IsClosed(cabinet)
                            cond IsHandEmpty()
                            cond In(pen,fridge)
                            act OpenAction(cabinet)
                sequence
                    cond IsClosed(fridge)
                    cond IsClosed(cabinet)
                    cond IsHandEmpty()
                    cond In(pen,fridge)
                    act OpenAction(fridge)
            sequence
                cond IsClosed(fridge)
                cond IsClosed(cabinet)
                cond Holding(banana)
                cond In(pen,fridge)
                act DropAction(banana,breakfast_table)
