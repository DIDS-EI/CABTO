selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            sequence
                cond Holding(chickenleg)
                selector
                    sequence
                        cond IsOpened(oven)
                        act PlaceIn(chickenleg,oven)
                    sequence
                        cond IsClosed(oven)
                        act Open(oven)
            sequence
                cond On(chickenleg,table)
                cond IsClosed(oven)
                cond IsHandEmpty()
                act PickUp(chickenleg)
    sequence
        cond On(chickenleg,table)
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond IsHandEmpty()
        act SwitchOn(oven)
