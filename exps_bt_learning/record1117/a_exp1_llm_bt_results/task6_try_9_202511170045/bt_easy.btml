selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(cabinet)
    sequence
        cond Holding(book)
        selector
            sequence
                cond IsOpened(cabinet)
                act PutIn(book,cabinet)
            act Open(cabinet)
    sequence
        cond On(book,table)
        cond IsHandEmpty()
        act PickUp(book)
