selector
    sequence
        cond On(c,b)
        cond On(b,a)
    sequence
        cond On(b,a)
        selector
            sequence
                cond Holding(c)
                act PutOn(c,b)
            sequence
                cond IsHandEmpty()
                act PickUp(c)
    sequence
        cond Holding(b)
        act PutOn(b,a)
    sequence
        cond IsHandEmpty()
        act PickUp(b)
