selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond On(book,breakfast_table)
        cond IsClosed(cabinet)
    sequence
        cond Holding(left_franka,book)
        selector
            sequence
                cond IsClosed(cabinet)
                selector
                    selector
                        selector
                            sequence
                                cond In(banana,fridge)
                                selector
                                    sequence
                                        cond IsClosed(fridge)
                                        act PutOnLeftFranka(book,breakfast_table)
                                    sequence
                                        cond IsOpened(fridge)
                                        act CloseLeftFranka(fridge)
                            sequence
                                cond IsOpened(fridge)
                                cond Holding(left_franka,banana)
                                act PutInLeftFranka(banana,fridge)
                        sequence
                            cond On(banana,table)
                            cond IsHandEmpty(left_franka)
                            cond IsOpened(fridge)
                            act PickUpLeftFranka(banana)
                    sequence
                        cond On(banana,table)
                        cond IsHandEmpty(left_franka)
                        cond IsClosed(fridge)
                        act OpenLeftFranka(fridge)
            sequence
                cond On(banana,table)
                cond IsHandEmpty(left_franka)
                cond IsClosed(fridge)
                cond IsOpened(cabinet)
                act CloseLeftFranka(cabinet)
