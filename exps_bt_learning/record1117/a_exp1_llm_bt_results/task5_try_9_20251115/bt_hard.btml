selector
    sequence
        cond IsFull(right_cup)
        cond On(right_cup,right_table)
    sequence
        cond IsEmpty(right_cup)
        cond CanGrasp(right_milk,right_cup)
        cond Holding(right_milk)
        selector
            sequence
                cond On(right_cup,right_table)
                act PourIntoCup(right_milk,right_cup)
            sequence
                cond Holding(right_franka,right_cup)
                act DropCupRight(right_cup,right_table)
