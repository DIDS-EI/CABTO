selector
    sequence
        cond On(apple,breakfast_table)
        cond IsOpened(fridge)
        cond In(wine,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond Holding(apple)
                selector
                    sequence
                        cond In(wine,fridge)
                        act PutOnSurface(apple,breakfast_table)
                    sequence
                        cond Holding(wine)
                        act PutInContainer(wine,fridge)
            sequence
                cond Holding(wine)
                cond On(apple,table)|On(apple,breakfast_table)
                cond IsHandEmpty()
                act PickUpItem(apple)
    sequence
        cond IsClosed(fridge)
        cond On(apple,table)|On(apple,breakfast_table)
        selector
            selector
                sequence
                    cond Holding(wine)
                    selector
                        sequence
                            cond IsHandEmpty()
                            act OpenContainer(fridge)
                        sequence
                            cond Holding(book)
                            act PutOnSurface(book,table)
                sequence
                    cond On(wine,table)|On(wine,breakfast_table)
                    cond Holding(book)
                    cond IsHandEmpty()
                    act PickUpItem(wine)
            sequence
                cond On(wine,table)|On(wine,breakfast_table)
                cond Holding(book)
                cond Holding(banana)
                act PutOnSurface(banana,table)
