selector
    cond In(wine,fridge)
    sequence
        cond Holding(wine)
        selector
            selector
                sequence
                    cond IsOpen(fridge)
                    act PutIn(wine,fridge)
                sequence
                    cond IsClosed(fridge)
                    cond IsHandEmpty()
                    act Open(fridge)
            sequence
                cond IsClosed(fridge)
                cond Holding(banana)
                act PutOn(banana,breakfast_table)
    sequence
        cond On(wine,breakfast_table)
        cond IsClosed(fridge)
        cond Holding(banana)
        cond On(wine,table)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(wine)
            sequence
                cond Holding(book)
                act PutOn(book,breakfast_table)
