selector
    sequence
        cond IsHandEmpty(right_franka)
        cond IsHalfFull(left_cup)
        cond IsHandEmpty(left_franka)
        cond On(left_milk,left_table)
        cond IsHalfFull(right_cup)
        cond On(right_milk,right_table)
    sequence
        cond Holding(right_franka,right_milk)
        selector
            sequence
                cond IsHalfFull(left_cup)
                selector
                    sequence
                        cond IsHalfFull(right_cup)
                        selector
                            sequence
                                cond IsHandEmpty(left_franka)
                                cond On(left_milk,left_table)
                                act PutDownRightFranka(right_milk,right_table)
                            sequence
                                cond Holding(left_franka,left_milk)
                                act PutDownLeftFranka(left_milk,left_table)
                    sequence
                        cond CupNeedGraspAndSupport()
                        cond Holding(left_franka,left_milk)
                        act PourIntoRightCup(right_milk)
            sequence
                cond CupNeedGraspAndSupport()
                cond Holding(left_franka,left_milk)
                act PourIntoLeftCup(left_milk)
    sequence
        cond CanGrasp(right_franka,right_milk)
        cond CupNeedGraspAndSupport()
        cond IsHandEmpty(right_franka)
        selector
            sequence
                cond Holding(left_franka,left_milk)
                act PickUpRightFranka(right_milk)
            sequence
                cond CanGrasp(left_franka,left_milk)
                cond IsHandEmpty(left_franka)
                act PickUpLeftFranka(left_milk)
