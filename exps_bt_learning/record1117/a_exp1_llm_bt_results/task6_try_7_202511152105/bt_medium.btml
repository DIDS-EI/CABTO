selector
    sequence
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond IsOpen(cabinet)
        selector
            sequence
                cond In(pen,cabinet)
                selector
                    sequence
                        cond Holding(book)
                        act PlaceIn(book,cabinet)
                    sequence
                        cond On(book,table)
                        cond IsHandEmpty()
                        act PickUp(book)
            sequence
                cond On(book,table)
                cond Holding(pen)
                act PlaceIn(pen,cabinet)
    sequence
        cond On(book,table)
        cond IsClosed(cabinet)
        selector
            sequence
                cond Holding(pen)
                act OpenContainer(cabinet)
            sequence
                cond On(pen,table)
                cond IsHandEmpty()
                act PickUp(pen)
