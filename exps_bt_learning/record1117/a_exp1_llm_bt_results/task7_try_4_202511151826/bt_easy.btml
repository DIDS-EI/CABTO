selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsHandEmpty()
        cond On(chickenleg,table)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    sequence
                        cond IsOpened(oven)
                        act PutInOven(chickenleg)
                    sequence
                        cond IsClosed(oven)
                        act OpenAppliance(oven)
            sequence
                cond IsSwitchedOff(oven)
                cond IsClosed(oven)
                act SwitchOnAppliance(oven)
