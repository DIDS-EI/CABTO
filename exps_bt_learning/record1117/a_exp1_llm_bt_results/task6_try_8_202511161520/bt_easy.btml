selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            selector
                selector
                    sequence
                        cond Holding(book)
                        act PutIn(book,cabinet)
                    sequence
                        cond IsHandEmpty()
                        cond On(book,table)
                        cond On(book,breakfast_table)
                        act PickUp(book)
                sequence
                    cond Holding(banana)
                    cond On(book,table)
                    cond On(book,breakfast_table)
                    cond IsOpened(fridge)
                    act PutIn(banana,fridge)
            sequence
                cond IsClosed(fridge)
                cond Holding(banana)
                cond On(book,table)
                cond On(book,breakfast_table)
                act OpenContainer(fridge)
    sequence
        cond IsClosed(fridge)
        cond On(book,breakfast_table)
        cond IsClosed(cabinet)
        cond Holding(banana)
        cond On(book,table)
        act OpenContainer(cabinet)
