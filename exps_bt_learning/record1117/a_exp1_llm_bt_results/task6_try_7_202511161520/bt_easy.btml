selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond Holding(book)
        selector
            sequence
                cond IsOpened(cabinet)
                act PlaceInCabinet(book,cabinet)
            sequence
                cond IsClosed(cabinet)
                act OpenCabinet(cabinet)
    sequence
        cond IsHandEmpty()
        cond On(book,table)
        cond IsClosed(cabinet)
        act PickUpFromTable(book)
