selector
    sequence
        cond In(pen,cabinet)
        cond IsClosed(fridge)
        cond In(banana,fridge)
        cond IsClosed(cabinet)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond In(banana,fridge)
                    selector
                        selector
                            selector
                                sequence
                                    cond In(pen,cabinet)
                                    selector
                                        sequence
                                            cond IsClosed(cabinet)
                                            act CloseFridge(fridge)
                                        sequence
                                            cond IsOpened(cabinet)
                                            act CloseCabinet(cabinet)
                                sequence
                                    cond IsOpened(cabinet)
                                    cond Holding(pen)
                                    act PlaceInCabinet(pen,cabinet)
                            sequence
                                cond IsOpened(cabinet)
                                cond On(pen,breakfast_table)
                                cond IsHandEmpty()
                                act PickUpFromBreakfastTable(pen)
                        sequence
                            cond IsHandEmpty()
                            cond On(pen,breakfast_table)
                            cond IsClosed(cabinet)
                            act OpenCabinet(cabinet)
                sequence
                    cond Holding(banana)
                    cond On(pen,breakfast_table)
                    cond IsClosed(cabinet)
                    act PlaceInFridge(banana,fridge)
            sequence
                cond IsHandEmpty()
                cond On(pen,breakfast_table)
                cond IsClosed(cabinet)
                cond On(banana,table)
                act PickUpFromTable(banana)
    sequence
        cond IsClosed(fridge)
        cond On(pen,breakfast_table)
        cond IsClosed(cabinet)
        cond IsHandEmpty()
        cond On(banana,table)
        act OpenFridge(fridge)
