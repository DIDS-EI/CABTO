selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(fridge)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond IsOpened(fridge)
                selector
                    sequence
                        cond In(book,cabinet)
                        selector
                            sequence
                                cond Holding(pen)
                                act PlaceInContainer(pen,cabinet)
                            sequence
                                cond IsHandEmpty()
                                cond On(pen,table)
                                act PickUp(pen)
                    sequence
                        cond Holding(book)
                        cond On(pen,table)
                        act PlaceInContainer(book,cabinet)
            sequence
                cond Holding(book)
                cond IsClosed(fridge)
                cond On(pen,table)
                act OpenContainer(fridge)
    sequence
        cond On(pen,table)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        selector
            sequence
                cond Holding(book)
                act OpenContainer(cabinet)
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                act PickUp(book)
