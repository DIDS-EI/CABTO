selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond On(book,breakfast_table)
        cond IsClosed(cabinet)
    sequence
        cond IsClosed(cabinet)
        selector
            selector
                selector
                    sequence
                        cond In(banana,fridge)
                        selector
                            sequence
                                cond Holding(book)
                                selector
                                    sequence
                                        cond IsClosed(fridge)
                                        act PutOnTable(book,breakfast_table)
                                    sequence
                                        cond IsOpened(fridge)
                                        act CloseContainer(fridge)
                            sequence
                                cond On(book,table)
                                cond IsHandEmpty()
                                cond IsOpened(fridge)
                                act PickUp(book)
                    sequence
                        cond Holding(banana)
                        cond On(book,table)
                        cond IsOpened(fridge)
                        act PlaceInContainer(banana,fridge)
                sequence
                    cond On(book,table)
                    cond On(banana,table)
                    cond IsHandEmpty()
                    cond IsOpened(fridge)
                    act PickUp(banana)
            sequence
                cond On(book,table)
                cond On(banana,table)
                cond IsHandEmpty()
                cond IsClosed(fridge)
                act OpenContainer(fridge)
