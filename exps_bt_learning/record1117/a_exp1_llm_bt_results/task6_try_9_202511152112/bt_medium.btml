selector
    sequence
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond Open(cabinet)
        selector
            selector
                selector
                    sequence
                        cond In(book,cabinet)
                        selector
                            sequence
                                cond Holding(pen)
                                act PutInCabinet(pen)
                            sequence
                                cond On(pen,table)
                                cond On(pen,breakfast_table)
                                cond IsHandEmpty()
                                act PickUp(pen)
                    sequence
                        cond Holding(book)
                        cond On(pen,table)
                        cond On(pen,breakfast_table)
                        act PutInCabinet(book)
                sequence
                    cond On(pen,table)
                    cond On(book,breakfast_table)
                    cond On(pen,breakfast_table)
                    cond On(book,table)
                    cond IsHandEmpty()
                    act PickUp(book)
            sequence
                cond On(pen,table)
                cond On(book,breakfast_table)
                cond On(pen,breakfast_table)
                cond Open(fridge)
                cond On(book,table)
                cond Holding(banana)
                act PutInFridge(banana)
    sequence
        cond On(pen,table)
        cond IsClosed(cabinet)
        cond On(book,breakfast_table)
        cond On(pen,breakfast_table)
        cond On(book,table)
        cond Holding(banana)
        selector
            sequence
                cond Open(fridge)
                act OpenCabinet()
            sequence
                cond IsClosed(fridge)
                act OpenFridge()
