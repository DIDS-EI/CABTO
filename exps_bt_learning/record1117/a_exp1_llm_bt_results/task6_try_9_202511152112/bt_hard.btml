selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(wine,fridge)
    sequence
        cond In(wine,fridge)
        selector
            selector
                sequence
                    cond Open(fridge)
                    selector
                        selector
                            selector
                                sequence
                                    cond In(banana,fridge)
                                    act CloseFridge()
                                sequence
                                    cond Holding(banana)
                                    act PutInFridge(banana)
                            sequence
                                cond On(banana,table)
                                cond On(banana,breakfast_table)
                                cond IsHandEmpty()
                                act PickUp(banana)
                        sequence
                            cond Open(cabinet)
                            cond On(banana,table)
                            cond On(banana,breakfast_table)
                            cond Holding(pen)
                            act PutInCabinet(pen)
                sequence
                    cond Open(cabinet)
                    cond Holding(pen)
                    cond IsClosed(fridge)
                    cond On(banana,table)
                    cond On(banana,breakfast_table)
                    act OpenFridge()
            sequence
                cond IsClosed(cabinet)
                cond Holding(pen)
                cond IsClosed(fridge)
                cond On(banana,table)
                cond On(banana,breakfast_table)
                act OpenCabinet()
