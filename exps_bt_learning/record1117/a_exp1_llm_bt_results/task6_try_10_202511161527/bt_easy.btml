selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond Holding(book)
        selector
            sequence
                cond IsOpened(cabinet)
                act PutInCabinet(book)
            sequence
                cond IsClosed(cabinet)
                act OpenCabinet()
    sequence
        cond In(book,fridge)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty()
                selector
                    sequence
                        cond IsOpened(fridge)
                        act TakeOutFridge(book,table)
                    sequence
                        cond IsClosed(fridge)
                        act OpenFridge()
            sequence
                cond Holding(pen)
                cond IsClosed(fridge)
                act PutDown(pen,table)
