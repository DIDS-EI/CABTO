selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
        cond In(chickenleg,oven)
    sequence
        cond On(chickenleg,table)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            sequence
                                cond In(pie,oven)
                                act PutInOnto(chickenleg,oven)
                            sequence
                                cond On(pie,table)
                                act PutInOnto(pie,oven)
                    sequence
                        cond On(pie,table)
                        cond IsClosed(oven)
                        act OpenOven()
            sequence
                cond IsSwitchedOff(oven)
                cond On(pie,table)
                cond IsClosed(oven)
                act SwitchOnOven()
