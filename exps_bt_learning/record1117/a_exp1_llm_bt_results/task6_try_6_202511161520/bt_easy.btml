selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond Holding(book)
        selector
            selector
                sequence
                    cond IsOpened(cabinet)
                    act PutIn(book,cabinet)
                sequence
                    cond IsHandEmpty()
                    cond IsClosed(cabinet)
                    act OpenContainer(cabinet)
            sequence
                cond Holding(banana)
                cond IsClosed(cabinet)
                act PlaceOn(banana,table)
    sequence
        cond Holding(banana)
        cond On(book,table)orOn(book,breakfast_table)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(book)
            sequence
                cond Holding(pen)
                act PlaceOn(pen,table)
