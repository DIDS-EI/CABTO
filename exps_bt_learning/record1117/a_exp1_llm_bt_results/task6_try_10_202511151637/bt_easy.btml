selector
    sequence
        cond Open(cabinet)
        cond In(apple,fridge)
    sequence
        cond Open(fridge)
        selector
            sequence
                cond Open(cabinet)
                selector
                    sequence
                        cond Holding(apple)
                        act PlaceInContainer(apple,fridge)
                    sequence
                        cond On(apple,table)
                        cond IsHandEmpty()
                        act PickUpObject(apple)
            sequence
                cond IsClosed(cabinet)
                cond On(apple,table)
                cond IsHandEmpty()
                act OpenContainer(cabinet)
    sequence
        cond IsClosed(cabinet)
        cond On(apple,table)
        cond IsHandEmpty()
        cond IsClosed(fridge)
        act OpenContainer(fridge)
