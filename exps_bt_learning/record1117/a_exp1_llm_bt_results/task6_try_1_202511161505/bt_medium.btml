selector
    sequence
        cond On(book,breakfast_table)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond On(book,breakfast_table)
                selector
                    sequence
                        cond Holding(pen)
                        act PutIn(pen,cabinet)
                    sequence
                        cond IsHandEmpty()
                        cond On(pen,table)
                        cond On(pen,breakfast_table)
                        act PickUp(pen)
            sequence
                cond IsHandEmpty()
                cond On(pen,table)
                cond Holding(book)
                cond On(pen,breakfast_table)
                act PutOn(book,breakfast_table)
    sequence
        cond IsClosed(cabinet)
        cond On(pen,table)
        cond Holding(book)
        cond On(pen,breakfast_table)
        selector
            sequence
                cond IsHandEmpty()
                act Open(cabinet)
            sequence
                cond IsOpened(fridge)
                cond Holding(banana)
                act PutIn(banana,fridge)
