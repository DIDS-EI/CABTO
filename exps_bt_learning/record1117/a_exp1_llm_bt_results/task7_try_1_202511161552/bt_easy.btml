selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    selector
                        sequence
                            cond In(chickenleg,oven)
                            selector
                                sequence
                                    cond Holding(pie)
                                    act PlaceInOven(pie)
                                sequence
                                    cond On(pie,table)
                                    cond IsHandEmpty()
                                    act PickUp(pie)
                        sequence
                            cond On(pie,table)
                            cond Holding(chickenleg)
                            act PlaceInOven(chickenleg)
                    sequence
                        cond On(pie,table)
                        cond IsHandEmpty()
                        cond On(chickenleg,table)
                        act PickUp(chickenleg)
            sequence
                cond On(pie,table)
                cond IsSwitchedOff(oven)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                act SwitchOn(oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond On(pie,table)
        cond IsHandEmpty()
        cond On(chickenleg,table)
        act OpenAppliance(oven)
