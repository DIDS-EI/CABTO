selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                selector
                    sequence
                        cond IsSwitchedOn(oven)
                        selector
                            selector
                                sequence
                                    cond In(pie,oven)
                                    selector
                                        sequence
                                            cond Holding(left_franka,chickenleg)
                                            act PlaceInContainerLeftFranka(chickenleg,oven)
                                        sequence
                                            cond IsHandEmpty(left_franka)
                                            cond On(chickenleg,table)
                                            cond On(chickenleg,breakfast_table)
                                            act PickUpLeftFranka(chickenleg)
                                sequence
                                    cond On(chickenleg,table)
                                    cond Holding(left_franka,pie)
                                    cond On(chickenleg,breakfast_table)
                                    act PlaceInContainerLeftFranka(pie,oven)
                            sequence
                                cond IsHandEmpty(left_franka)
                                cond On(chickenleg,table)
                                cond In(pie,microwave)
                                cond IsOpened(microwave)
                                cond On(chickenleg,breakfast_table)
                                act PickOutFromContainerLeftFranka(pie,microwave)
                    sequence
                        cond IsHandEmpty(left_franka)
                        cond On(chickenleg,table)
                        cond In(pie,microwave)
                        cond IsSwitchedOff(oven)
                        cond IsOpened(microwave)
                        cond On(chickenleg,breakfast_table)
                        act SwitchOnLeftFranka(oven)
                sequence
                    cond Holding(left_franka,soup)
                    cond On(chickenleg,table)
                    cond In(pie,microwave)
                    cond IsSwitchedOff(oven)
                    cond IsOpened(microwave)
                    cond On(chickenleg,breakfast_table)
                    act PlaceInContainerLeftFranka(soup,oven)
            sequence
                cond Holding(left_franka,soup)
                cond IsHandEmpty(left_franka)
                cond On(chickenleg,table)
                cond IsClosed(microwave)
                cond In(pie,microwave)
                cond On(microwave,table)
                cond On(chickenleg,breakfast_table)
                cond IsSwitchedOff(oven)
                act OpenContainerLeftFranka(microwave)
