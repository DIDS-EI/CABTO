selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(wine,fridge)
    sequence
        cond At(fridge)
        selector
            selector
                selector
                    sequence
                        cond IsOpen(fridge)
                        selector
                            selector
                                sequence
                                    cond In(banana,fridge)
                                    selector
                                        selector
                                            sequence
                                                cond In(wine,fridge)
                                                act CloseContainer(fridge)
                                            sequence
                                                cond Holding(wine)
                                                act PlaceIn(wine,fridge)
                                        sequence
                                            cond On(wine,breakfast_table)
                                            cond On(wine,table)
                                            cond IsHandEmpty()
                                            act PickUp(wine)
                                sequence
                                    cond On(wine,breakfast_table)
                                    cond On(wine,table)
                                    cond Holding(banana)
                                    act PlaceIn(banana,fridge)
                            sequence
                                cond On(wine,breakfast_table)
                                cond On(wine,table)
                                cond On(banana,table)
                                cond On(banana,breakfast_table)
                                cond IsHandEmpty()
                                act PickUp(banana)
                    sequence
                        cond On(wine,breakfast_table)
                        cond On(wine,table)
                        cond IsClosed(fridge)
                        cond On(banana,table)
                        cond On(banana,breakfast_table)
                        cond IsHandEmpty()
                        act OpenContainer(fridge)
                sequence
                    cond Holding(apple)
                    cond On(wine,breakfast_table)
                    cond At(cabinet)
                    cond On(wine,table)
                    cond IsClosed(fridge)
                    cond On(banana,table)
                    cond On(banana,breakfast_table)
                    cond IsOpen(cabinet)
                    act PlaceIn(apple,cabinet)
            sequence
                cond IsClosed(cabinet)
                cond Holding(apple)
                cond On(wine,breakfast_table)
                cond At(cabinet)
                cond On(wine,table)
                cond IsClosed(fridge)
                cond On(banana,table)
                cond On(banana,breakfast_table)
                act OpenContainer(cabinet)
    sequence
        cond IsClosed(cabinet)
        cond Holding(apple)
        cond On(wine,breakfast_table)
        cond At(cabinet)
        cond On(wine,table)
        cond IsClosed(fridge)
        cond On(banana,table)
        cond On(banana,breakfast_table)
        act MoveTo(fridge)
