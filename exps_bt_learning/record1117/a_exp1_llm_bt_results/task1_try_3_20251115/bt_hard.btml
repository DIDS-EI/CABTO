selector
    sequence
        cond On(c,place_c)
        cond On(b,place_a)
    sequence
        cond IsEmpty(place_c)
        selector
            selector
                sequence
                    cond On(b,place_a)
                    selector
                        sequence
                            cond Holding(c)
                            act PlaceOn(c,place_c)
                        sequence
                            cond IsHandEmpty()
                            cond On(c,table)
                            act PickUp(c)
                sequence
                    cond Holding(b)
                    cond On(c,table)
                    cond IsEmpty(place_a)
                    act PlaceOn(b,place_a)
            sequence
                cond IsHandEmpty()
                cond On(b,table)
                cond On(c,table)
                cond IsEmpty(place_a)
                act PickUp(b)
