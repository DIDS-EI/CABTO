selector
    sequence
        cond In(apple,fridge)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        cond In(pen,cabinet)
    sequence
        cond In(apple,fridge)
        cond In(pen,cabinet)
        cond IsOpen(fridge)
        selector
            sequence
                cond IsClosed(cabinet)
                act CloseFridge(fridge)
            sequence
                cond IsOpen(cabinet)
                act CloseCabinet(cabinet)
