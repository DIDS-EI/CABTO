selector
    sequence
        cond IsClosed(fridge)
        cond In(banana,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    cond In(banana,fridge)
                    act CloseFridge()
                sequence
                    cond Holding(banana)
                    act PutDownBananaInFridge()
            sequence
                cond IsHandEmpty()
                cond On(banana,table)
                act PickUpBananaFromTable()
    sequence
        cond IsHandEmpty()
        cond IsClosed(fridge)
        cond On(banana,table)
        act OpenFridge()
