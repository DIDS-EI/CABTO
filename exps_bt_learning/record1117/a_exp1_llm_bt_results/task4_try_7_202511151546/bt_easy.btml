selector
    cond On(left_box1,right_table)
    sequence
        cond On(left_franka,right_table)
        selector
            selector
                sequence
                    cond Holding(left_franka,left_box1)
                    act DropOffLeftFranka(left_franka,right_table,left_box1)
                sequence
                    cond On(left_box1,left_table)
                    cond IsHandEmpty(left_franka)
                    cond On(left_franka,left_table)
                    act PickUpLeftFranka(left_franka,left_box1)
            sequence
                cond Holding(left_franka,left_box2)
                cond On(left_box1,left_table)
                cond On(left_franka,left_table)
                act DropOffLeftFranka(left_franka,right_table,left_box2)
