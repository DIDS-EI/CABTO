selector
    sequence
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond In(banana,fridge)
        cond In(apple,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond In(apple,cabinet)
                selector
                    selector
                        selector
                            sequence
                                cond In(banana,fridge)
                                selector
                                    sequence
                                        cond IsClosed(fridge)
                                        act Close(cabinet)
                                    sequence
                                        cond IsOpened(fridge)
                                        act Close(fridge)
                            sequence
                                cond Holding(banana)
                                cond IsOpened(fridge)
                                act PutIn(banana,fridge)
                        sequence
                            cond Holding(banana)
                            cond IsClosed(fridge)
                            act Open(fridge)
                    sequence
                        cond IsClosed(fridge)
                        cond On(banana,table)
                        cond IsHandEmpty()
                        act PickUp(banana)
            sequence
                cond IsClosed(fridge)
                cond On(banana,table)
                cond Holding(apple)
                act PutIn(apple,cabinet)
    sequence
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond On(banana,table)
        selector
            sequence
                cond Holding(apple)
                act Open(cabinet)
            sequence
                cond On(apple,table)
                cond IsHandEmpty()
                act PickUp(apple)
