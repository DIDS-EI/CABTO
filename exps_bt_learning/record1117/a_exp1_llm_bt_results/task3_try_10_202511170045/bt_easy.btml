selector
    cond In(left_lego,center_big_box)
    sequence
        cond Holding(left_franka,left_lego)
        act PutInLeftFranka(left_lego,center_big_box)
    sequence
        cond On(left_lego,left_franka)
        selector
            sequence
                cond IsHandEmpty(left_franka)
                act PickUpLeftFranka(left_franka,left_lego)
            sequence
                cond BigBoxNeedTwoFrankaHoldTogether()
                cond Holding(right_franka,center_big_box)
                cond Holding(left_franka,center_big_box)
                act PlaceOnBoard(center_big_box,box_board)
