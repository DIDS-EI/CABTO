selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsNotIn(soup,microwave)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    sequence
                        cond Holding(soup)
                        act PutInMicrowave(soup)
                    sequence
                        cond IsHandEmpty()
                        cond On(soup,table)
                        act PickUp(soup)
            sequence
                cond IsSwitchedOff(microwave)
                cond IsHandEmpty()
                cond On(soup,table)
                act TurnOnMicrowave()
