selector
    sequence
        cond In(pie,oven)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                sequence
                    cond In(pie,oven)
                    selector
                        sequence
                            cond In(chickenleg,oven)
                            act SwitchOn(oven)
                        sequence
                            cond On(chickenleg,table)
                            cond IsOpened(oven)
                            cond IsHandEmpty()
                            act PutIn(chickenleg,oven)
                sequence
                    cond On(chickenleg,table)
                    cond IsOpened(oven)
                    cond IsHandEmpty()
                    cond On(pie,table)
                    act PutIn(pie,oven)
            sequence
                cond On(chickenleg,table)
                cond IsClosed(oven)
                cond IsHandEmpty()
                cond On(pie,table)
                act Open(oven)
