selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond Holding(soup)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PlaceIn(soup,microwave)
                    sequence
                        cond IsClosed(microwave)
                        act Open(microwave)
            sequence
                cond IsHandEmpty()
                cond On(soup,table)
                cond IsClosed(microwave)
                act PickUp(soup)
    sequence
        cond IsSwitchedOff(microwave)
        cond On(soup,table)
        cond IsHandEmpty()
        cond IsClosed(microwave)
        act ToggleSwitch(microwave)
