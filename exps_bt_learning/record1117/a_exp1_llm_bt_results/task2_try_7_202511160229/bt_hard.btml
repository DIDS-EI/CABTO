selector
    sequence
        cond On(b,d)
        cond On(c,b)
        cond On(a,c)
    sequence
        cond On(b,d)
        selector
            selector
                sequence
                    cond On(c,b)
                    cond Clear(c)
                    selector
                        sequence
                            cond Holding(a)
                            act PutOn(a,c)
                        sequence
                            cond IsHandEmpty()
                            cond On(a,table)
                            act PickUp(a)
                sequence
                    cond Holding(c)
                    cond Clear(b)
                    cond On(a,table)
                    act PutOn(c,b)
            sequence
                cond On(c,table)
                cond IsHandEmpty()
                cond Clear(b)
                cond On(a,table)
                act PickUp(c)
    sequence
        cond On(c,table)
        cond On(a,table)
        selector
            selector
                sequence
                    cond Clear(d)
                    selector
                        sequence
                            cond Holding(b)
                            act PutOn(b,d)
                        sequence
                            cond IsHandEmpty()
                            cond On(b,table)
                            act PickUp(b)
                sequence
                    cond Holding(d)
                    cond On(b,table)
                    act PutOnTable(d)
            sequence
                cond On(d,table)
                cond IsHandEmpty()
                cond On(b,table)
                act PickUp(d)
