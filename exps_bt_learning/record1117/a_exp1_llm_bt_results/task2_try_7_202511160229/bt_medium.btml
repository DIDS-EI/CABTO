selector
    sequence
        cond On(c,b)
        cond On(b,a)
    sequence
        cond Clear(b)
        cond On(b,a)
        selector
            sequence
                cond Holding(c)
                act PutOn(c,b)
            sequence
                cond On(c,table)
                cond IsHandEmpty()
                act PickUp(c)
    sequence
        cond On(c,table)
        selector
            selector
                sequence
                    cond Clear(a)
                    selector
                        sequence
                            cond Holding(b)
                            act PutOn(b,a)
                        sequence
                            cond IsHandEmpty()
                            cond On(b,table)
                            act PickUp(b)
                sequence
                    cond Holding(a)
                    cond On(b,table)
                    act PutOnTable(a)
            sequence
                cond IsHandEmpty()
                cond On(a,table)
                cond On(b,table)
                act PickUp(a)
