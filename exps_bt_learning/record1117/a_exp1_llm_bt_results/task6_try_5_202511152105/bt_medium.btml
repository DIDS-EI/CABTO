selector
    sequence
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond Holding(book)
        selector
            selector
                selector
                    sequence
                        cond IsOpen(cabinet)
                        selector
                            sequence
                                cond In(pen,cabinet)
                                act PutInCabinet(book)
                            sequence
                                cond Holding(pen)
                                act PutInCabinet(pen)
                    sequence
                        cond IsClosed(cabinet)
                        cond Holding(pen)
                        act OpenCabinet()
                sequence
                    cond On(pen,breakfast_table)
                    cond On(pen,table)
                    cond IsHandEmpty()
                    cond IsClosed(cabinet)
                    act PickUp(pen)
            sequence
                cond IsOpen(fridge)
                cond On(pen,breakfast_table)
                cond On(pen,table)
                cond IsClosed(cabinet)
                cond Holding(banana)
                act PutInFridge(banana)
    sequence
        cond On(book,table)
        cond IsOpen(fridge)
        cond On(pen,breakfast_table)
        cond On(pen,table)
        cond IsClosed(cabinet)
        cond On(book,breakfast_table)
        cond Holding(banana)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(book)
            sequence
                cond Holding(wine)
                act PutInFridge(wine)
