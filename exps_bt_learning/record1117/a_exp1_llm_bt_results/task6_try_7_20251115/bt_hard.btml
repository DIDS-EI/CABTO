selector
    sequence
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
    sequence
        cond IsClosed(cabinet)
        selector
            sequence
                cond Holding(robot,pen)
                act PutPenInCabinet(pen,cabinet)
            sequence
                cond IsHandEmpty()
                cond On(pen,table)
                act PickUpPen(pen)
