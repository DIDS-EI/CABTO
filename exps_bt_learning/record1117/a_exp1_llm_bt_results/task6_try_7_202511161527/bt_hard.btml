selector
    sequence
        cond IsClosed(fridge)
        cond In(banana,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond IsHandEmpty(left_franka)
                    cond In(banana,fridge)
                    act CloseContainerLeftFranka(fridge)
                sequence
                    cond Holding(left_franka,banana)
                    act PutInLeftFranka(banana,fridge)
            sequence
                cond IsHandEmpty(left_franka)
                cond IsOpened(cabinet)
                cond In(banana,cabinet)
                act TakeOutLeftFranka(banana,cabinet)
    sequence
        cond IsClosed(fridge)
        cond In(banana,cabinet)
        selector
            sequence
                cond IsHandEmpty(left_franka)
                selector
                    sequence
                        cond IsOpened(cabinet)
                        act OpenContainerLeftFranka(fridge)
                    sequence
                        cond IsClosed(cabinet)
                        act OpenContainerLeftFranka(cabinet)
            sequence
                cond Holding(left_franka,book)
                cond IsClosed(cabinet)
                act PutOnLeftFranka(book,table)
