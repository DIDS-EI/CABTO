selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(book,cabinet)
        cond In(apple,fridge)
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
    sequence
        cond OpenCabinet()
        cond In(book,cabinet)
        selector
            sequence
                cond In(pen,cabinet)
                selector
                    selector
                        selector
                            sequence
                                cond In(banana,fridge)
                                selector
                                    sequence
                                        cond In(apple,fridge)
                                        selector
                                            sequence
                                                cond IsClosed(fridge)
                                                act CloseCabinet()
                                            sequence
                                                cond OpenFridge()
                                                act CloseFridge()
                                    sequence
                                        cond Holding(apple)
                                        cond OpenFridge()
                                        act PutInFridge(apple)
                            sequence
                                cond Holding(banana)
                                cond Holding(apple)
                                cond OpenFridge()
                                act PutInFridge(banana)
                        sequence
                            cond On(apple,table)
                            cond IsHandEmpty()
                            cond Holding(banana)
                            cond OpenFridge()
                            act PickUp(apple)
                    sequence
                        cond On(apple,table)
                        cond IsClosed(fridge)
                        cond IsHandEmpty()
                        cond Holding(banana)
                        act OpenFridge()
            sequence
                cond On(apple,table)
                cond IsClosed(fridge)
                cond Holding(pen)
                cond Holding(banana)
                act PutInCabinet(pen)
