selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
        cond IsOpened(oven)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsSwitchedOn(radio)
                selector
                    sequence
                        cond IsOpened(microwave)
                        selector
                            sequence
                                cond IsSwitchedOn(light)
                                selector
                                    sequence
                                        cond IsOpened(oven)
                                        act PlaceOn(pie,breakfast_table)
                                    sequence
                                        cond IsClosed(oven)
                                        act Open(oven)
                            sequence
                                cond IsClosed(oven)
                                cond IsSwitchedOff(light)
                                act SwitchOn(light)
                    sequence
                        cond IsClosed(microwave)
                        cond IsClosed(oven)
                        cond IsSwitchedOff(light)
                        act Open(microwave)
            sequence
                cond IsClosed(microwave)
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                cond IsSwitchedOff(radio)
                act SwitchOn(radio)
    sequence
        cond IsClosed(microwave)
        cond IsSwitchedOff(radio)
        cond IsClosed(oven)
        cond IsSwitchedOff(light)
        cond IsHandEmpty()
        cond On(pie,table)
        act PickUp(pie)
