selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsOpened(microwave)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    sequence
                        cond Holding(soup)
                        act PlaceIn(soup,microwave)
                    sequence
                        cond IsHandEmpty()
                        cond On(soup,table)
                        act PickUp(soup)
            sequence
                cond IsHandEmpty()
                cond IsSwitchedOff(microwave)
                cond On(soup,table)
                act SwitchOn(microwave)
    sequence
        cond IsHandEmpty()
        cond IsSwitchedOff(microwave)
        cond IsClosed(microwave)
        cond On(soup,table)
        act Open(microwave)
