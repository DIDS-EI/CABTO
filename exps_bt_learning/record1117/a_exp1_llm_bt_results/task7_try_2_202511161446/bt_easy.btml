selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                selector
                    sequence
                        cond In(chickenleg,oven)
                        selector
                            selector
                                sequence
                                    cond In(pie,oven)
                                    act SwitchOn(oven)
                                sequence
                                    cond Holding(pie)
                                    cond IsOpened(oven)
                                    act PlaceIn(pie,oven)
                            sequence
                                cond IsHandEmpty()
                                cond On(pie,table)
                                cond IsOpened(oven)
                                act PickUp(pie)
                    sequence
                        cond Holding(chickenleg)
                        cond On(pie,table)
                        cond IsOpened(oven)
                        act PlaceIn(chickenleg,oven)
                sequence
                    cond Holding(chickenleg)
                    cond IsClosed(oven)
                    cond On(pie,table)
                    act Open(oven)
            sequence
                cond IsHandEmpty()
                cond On(chickenleg,table)
                cond IsClosed(oven)
                cond On(pie,table)
                act PickUp(chickenleg)
