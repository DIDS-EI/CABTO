selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
        cond In(chickenleg,oven)
    sequence
        cond IsClosed(oven)
        selector
            sequence
                cond Holding(robot1,pie)
                selector
                    sequence
                        cond IsSwitchedOn(oven)
                        cond In(chickenleg,oven)
                        act PutPieInOven(pie)
                    sequence
                        cond IsSwitchedOff(oven)
                        cond Holding(robot1,chickenleg)
                        act PutChickenLegInOven(chickenleg)
            sequence
                cond IsSwitchedOff(oven)
                cond IsHandEmpty()
                cond On(pie,table)
                cond Holding(robot1,chickenleg)
                act PickUpPie(pie)
