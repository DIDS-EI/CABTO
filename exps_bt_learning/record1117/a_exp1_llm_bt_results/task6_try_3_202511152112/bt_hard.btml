selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(wine,fridge)
    sequence
        cond Open(fridge)
        selector
            selector
                sequence
                    cond In(banana,fridge)
                    selector
                        selector
                            sequence
                                cond In(wine,fridge)
                                act CloseFridge()
                            sequence
                                cond Holding(wine)
                                act PlaceInFridge(wine)
                        sequence
                            cond On(wine,breakfast_table)
                            cond IsHandEmpty()
                            act PickUpBreakfastTable(wine)
                sequence
                    cond On(wine,breakfast_table)
                    cond Holding(banana)
                    act PlaceInFridge(banana)
            sequence
                cond On(wine,breakfast_table)
                cond On(banana,table)
                cond IsHandEmpty()
                act PickUp(banana)
    sequence
        cond IsClosed(fridge)
        cond On(banana,table)
        cond On(wine,breakfast_table)
        cond IsHandEmpty()
        act OpenFridge()
