selector
    sequence
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond Open(cabinet)
        selector
            sequence
                cond In(book,cabinet)
                selector
                    sequence
                        cond Holding(pen)
                        act PlaceInCabinet(pen)
                    sequence
                        cond On(pen,table)
                        cond IsHandEmpty()
                        act PickUp(pen)
            sequence
                cond Holding(book)
                cond On(pen,table)
                act PlaceInCabinet(book)
    sequence
        cond On(pen,table)
        cond IsClosed(cabinet)
        selector
            sequence
                cond Holding(book)
                act OpenCabinet()
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                act PickUp(book)
