selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond Holding(book)
                act PlaceInContainer(book,cabinet)
            sequence
                cond IsHandEmpty()
                cond On(book,table)
                act PickUpItem(book,table)
    sequence
        cond IsClosed(cabinet)
        cond IsHandEmpty()
        cond On(book,table)
        act OpenCabinet(cabinet)
