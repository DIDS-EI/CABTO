selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(book,cabinet)
        cond In(apple,fridge)
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
    sequence
        cond In(banana,fridge)
        cond Open(fridge)
        selector
            selector
                sequence
                    cond In(book,cabinet)
                    selector
                        selector
                            sequence
                                cond In(pen,cabinet)
                                selector
                                    sequence
                                        cond IsClosed(cabinet)
                                        selector
                                            sequence
                                                cond In(apple,fridge)
                                                act CloseFridge()
                                            sequence
                                                cond Holding(apple)
                                                act PlaceInFridge(apple)
                                    sequence
                                        cond Open(cabinet)
                                        cond Holding(apple)
                                        act CloseCabinet()
                            sequence
                                cond Open(cabinet)
                                cond Holding(pen)
                                cond Holding(apple)
                                act PlaceInCabinet(pen)
                        sequence
                            cond On(apple,table)
                            cond Open(cabinet)
                            cond IsHandEmpty()
                            cond Holding(pen)
                            act PickUp(apple)
                sequence
                    cond On(apple,table)
                    cond Open(cabinet)
                    cond Holding(pen)
                    cond Holding(book)
                    act PlaceInCabinet(book)
            sequence
                cond On(pen,table)
                cond Holding(book)
                cond On(apple,table)
                cond Open(cabinet)
                cond IsHandEmpty()
                act PickUp(pen)
