selector
    sequence
        cond In(chickenleg,oven)
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                sequence
                    cond In(pie,oven)
                    selector
                        sequence
                            cond IsSwitchedOn(oven)
                            selector
                                sequence
                                    cond Holding(chickenleg)
                                    act PlaceIn(chickenleg,oven)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(chickenleg,table)
                                    act PickUp(chickenleg)
                        sequence
                            cond IsHandEmpty()
                            cond IsSwitchedOff(oven)
                            cond On(chickenleg,table)
                            act SwitchOn(oven)
                sequence
                    cond IsSwitchedOff(oven)
                    cond Holding(pie)
                    cond On(chickenleg,table)
                    act PlaceIn(pie,oven)
            sequence
                cond IsHandEmpty()
                cond IsSwitchedOff(oven)
                cond On(pie,table)
                cond On(chickenleg,table)
                act PickUp(pie)
    sequence
        cond IsSwitchedOff(oven)
        cond IsHandEmpty()
        cond On(chickenleg,table)
        cond IsClosed(oven)
        cond On(pie,table)
        act Open(oven)
