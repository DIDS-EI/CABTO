selector
    cond In(wine,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                selector
                    sequence
                        cond Holding(wine)
                        act PlaceInContainer(wine,fridge)
                    sequence
                        cond IsHandEmpty()
                        cond On(wine,table)|On(wine,breakfast_table)
                        act PickUp(wine)
                sequence
                    cond Holding(apple)
                    cond On(wine,table)|On(wine,breakfast_table)
                    cond IsOpened(cabinet)
                    act PlaceInContainer(apple,cabinet)
            sequence
                cond Holding(apple)
                cond On(wine,table)|On(wine,breakfast_table)
                cond IsClosed(cabinet)
                act OpenContainer(cabinet)
    sequence
        cond Holding(apple)
        cond IsClosed(fridge)
        cond On(wine,table)|On(wine,breakfast_table)
        cond IsClosed(cabinet)
        act OpenContainer(fridge)
