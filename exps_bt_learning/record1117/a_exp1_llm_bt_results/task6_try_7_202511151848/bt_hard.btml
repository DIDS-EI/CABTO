selector
    sequence
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond On(book,breakfast_table)
        cond In(banana,fridge)
    sequence
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsOpened(fridge)
                selector
                    selector
                        sequence
                            cond In(banana,fridge)
                            selector
                                selector
                                    sequence
                                        cond On(book,breakfast_table)
                                        act Close(fridge)
                                    sequence
                                        cond Holding(book)
                                        act PutOnBreakfastTable(book)
                                sequence
                                    cond On(book,table)
                                    cond IsHandEmpty()
                                    act PickUp(book)
                        sequence
                            cond On(book,table)
                            cond Holding(banana)
                            act PutInFridge(banana)
                    sequence
                        cond IsHandEmpty()
                        cond On(book,table)
                        cond On(banana,table)
                        act PickUp(banana)
            sequence
                cond IsHandEmpty()
                cond IsClosed(fridge)
                cond On(book,table)
                cond On(banana,table)
                act Open(fridge)
