selector
    cond In(wine,fridge)
    sequence
        cond Holding(wine)
        selector
            sequence
                cond IsOpened(fridge)
                act PutIn(wine,fridge)
            sequence
                cond IsClosed(fridge)
                act Open(fridge)
    sequence
        cond On(wine,table)
        cond IsClosed(fridge)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    act PickUp(wine)
                sequence
                    cond Holding(pen)
                    cond IsOpened(cabinet)
                    act PutIn(pen,cabinet)
            sequence
                cond Holding(pen)
                cond IsClosed(cabinet)
                act Open(cabinet)
