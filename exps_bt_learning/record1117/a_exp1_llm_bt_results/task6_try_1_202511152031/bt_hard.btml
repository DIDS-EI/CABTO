selector
    sequence
        cond On(book,breakfast_table)
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond In(banana,fridge)
    sequence
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsOpened(fridge)
                selector
                    selector
                        sequence
                            cond On(book,breakfast_table)
                            selector
                                selector
                                    sequence
                                        cond In(banana,fridge)
                                        act Close(fridge)
                                    sequence
                                        cond Holding(banana)
                                        act PutIn(banana,fridge)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(banana,table)
                                    act PickUp(banana)
                        sequence
                            cond Holding(book)
                            cond On(banana,table)
                            act PutOnBreakfastTable(book)
                    sequence
                        cond IsHandEmpty()
                        cond On(book,table)
                        cond On(banana,table)
                        act PickUp(book)
            sequence
                cond IsClosed(fridge)
                cond IsHandEmpty()
                cond On(book,table)
                cond On(banana,table)
                act Open(fridge)
