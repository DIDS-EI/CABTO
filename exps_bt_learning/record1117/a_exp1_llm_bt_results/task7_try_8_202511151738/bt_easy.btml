selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    sequence
                        cond Holding(chickenleg)
                        act PlaceInAppliance(chickenleg,oven)
                    sequence
                        cond On(chickenleg,table)
                        cond IsHandEmpty()
                        act PickUp(chickenleg)
            sequence
                cond On(chickenleg,table)
                cond IsSwitchedOff(oven)
                cond IsHandEmpty()
                act SwitchOnAppliance(oven)
    sequence
        cond IsHandEmpty()
        cond On(chickenleg,table)
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        act OpenAppliance(oven)
