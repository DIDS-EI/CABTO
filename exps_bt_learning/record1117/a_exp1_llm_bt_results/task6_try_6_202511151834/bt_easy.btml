selector
    sequence
        cond On(apple,breakfast_table)
        cond IsOpened(fridge)
        cond In(wine,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond On(apple,breakfast_table)
                selector
                    sequence
                        cond Holding(wine)
                        act PutIn(wine,fridge)
                    sequence
                        cond On(wine,breakfast_table)
                        cond IsHandEmpty()
                        act PickUpFromBreakfastTable(wine)
            sequence
                cond On(wine,breakfast_table)
                cond Holding(apple)
                act PutOnBreakfastTable(apple)
    sequence
        cond On(wine,breakfast_table)
        cond IsClosed(fridge)
        selector
            sequence
                cond Holding(apple)
                act OpenContainer(fridge)
            sequence
                cond On(apple,table)
                cond IsHandEmpty()
                act PickUp(apple)
