selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                selector
                    sequence
                        cond In(soup,microwave)
                        act SwitchOn(microwave)
                    sequence
                        cond Holding(soup)
                        cond IsOpened(microwave)
                        act PutIn(soup,microwave)
                sequence
                    cond IsClosed(microwave)
                    cond Holding(soup)
                    act Open(microwave)
            sequence
                cond IsClosed(microwave)
                cond IsHandEmpty()
                cond On(soup,table)
                act PickUp(soup)
