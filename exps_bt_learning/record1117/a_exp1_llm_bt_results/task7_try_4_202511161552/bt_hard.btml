selector
    sequence
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsSwitchedOff(radio)
        selector
            selector
                sequence
                    cond IsOpened(microwave)
                    selector
                        sequence
                            cond On(pie,breakfast_table)
                            selector
                                sequence
                                    cond IsSwitchedOn(light)
                                    selector
                                        sequence
                                            cond IsOpened(oven)
                                            act SwitchOnRadio()
                                        sequence
                                            cond IsClosed(oven)
                                            act OpenOven()
                                sequence
                                    cond IsSwitchedOff(light)
                                    cond IsClosed(oven)
                                    act SwitchOnLight()
                        sequence
                            cond IsSwitchedOff(light)
                            cond IsClosed(oven)
                            cond Holding(pie)
                            act DropOnTable(pie)
                sequence
                    cond IsSwitchedOff(light)
                    cond IsClosed(oven)
                    cond IsClosed(microwave)
                    cond Holding(pie)
                    act OpenMicrowave()
            sequence
                cond IsSwitchedOff(light)
                cond IsClosed(microwave)
                cond IsClosed(oven)
                cond On(pie,table)
                cond IsHandEmpty()
                act PickUp(pie)
