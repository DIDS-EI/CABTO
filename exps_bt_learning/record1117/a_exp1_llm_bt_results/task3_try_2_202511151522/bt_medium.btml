selector
    cond On(right_lego,center_big_box)
    sequence
        cond Holding(right_franka,right_lego)
        selector
            sequence
                cond On(center_big_box,box_board)
                act PlaceOnCenterBigBoxRight(right_lego,center_big_box)
            sequence
                cond Holding(left_franka,center_big_box)
                cond Holding(right_franka,center_big_box)
                act PlaceCenterBigBoxOnBoard(center_big_box,box_board)
    sequence
        cond IsHandEmpty(right_franka)
        cond On(right_lego,right_table)
        cond Holding(left_franka,center_big_box)
        cond Holding(right_franka,center_big_box)
        act PickUpRightFranka(right_lego)
