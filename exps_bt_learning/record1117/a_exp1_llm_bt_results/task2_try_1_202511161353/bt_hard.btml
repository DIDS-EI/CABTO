selector
    sequence
        cond On(b,d)
        cond On(c,b)
        cond On(a,c)
    sequence
        cond On(c,b)
        selector
            selector
                sequence
                    cond On(b,d)
                    selector
                        sequence
                            cond Holding(a)
                            act PutAOnB(a,c)
                        sequence
                            cond IsHandEmpty()
                            cond On(a,table)
                            act PickUp(a)
                sequence
                    cond Holding(b)
                    cond On(a,table)
                    act PutAOnB(b,d)
            sequence
                cond IsHandEmpty()
                cond On(b,table)
                cond On(a,table)
                act PickUp(b)
    sequence
        cond On(b,table)
        cond On(a,table)
        selector
            sequence
                cond Holding(c)
                act PutAOnB(c,b)
            sequence
                cond IsHandEmpty()
                cond On(c,table)
                act PickUp(c)
