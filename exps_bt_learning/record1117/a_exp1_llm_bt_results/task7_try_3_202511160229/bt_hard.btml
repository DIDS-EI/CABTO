selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsClosed(microwave)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    selector
                        sequence
                            cond On(pie,breakfast_table)
                            selector
                                sequence
                                    cond IsSwitchedOn(light)
                                    selector
                                        sequence
                                            cond IsSwitchedOn(radio)
                                            act OpenContainer(microwave)
                                        sequence
                                            cond IsSwitchedOff(radio)
                                            act SwitchOnDevice(radio)
                                sequence
                                    cond IsSwitchedOff(light)
                                    cond IsSwitchedOff(radio)
                                    act SwitchOnDevice(light)
                        sequence
                            cond IsSwitchedOff(light)
                            cond IsSwitchedOff(radio)
                            cond Holding(pie)
                            act PutOnTable(pie,breakfast_table)
                    sequence
                        cond IsSwitchedOff(light)
                        cond IsSwitchedOff(radio)
                        cond On(pie,table)
                        cond IsHandEmpty()
                        act PickUp(pie)
            sequence
                cond IsSwitchedOff(radio)
                cond On(pie,table)
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                cond IsHandEmpty()
                act OpenContainer(oven)
