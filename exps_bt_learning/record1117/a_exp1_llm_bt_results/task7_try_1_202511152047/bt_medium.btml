selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                selector
                    sequence
                        cond In(soup,microwave)
                        act SwitchOnAppliance(microwave)
                    sequence
                        cond Holding(soup)
                        cond IsOpened(microwave)
                        act PlaceInMicrowave(soup)
                sequence
                    cond IsHandEmpty()
                    cond On(soup,table)
                    cond IsOpened(microwave)
                    act PickUpFromTable(soup)
            sequence
                cond IsClosed(microwave)
                cond IsHandEmpty()
                cond On(soup,table)
                act OpenAppliance(microwave)
