selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
        cond IsOpened(oven)
    sequence
        cond IsOpened(microwave)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsSwitchedOn(radio)
                        selector
                            sequence
                                cond IsOpened(oven)
                                selector
                                    sequence
                                        cond Holding(pie)
                                        act PutOnTable(pie,breakfast_table)
                                    sequence
                                        cond IsHandEmpty()
                                        cond On(pie,table)
                                        act PickUp(pie)
                            sequence
                                cond IsClosed(oven)
                                cond IsHandEmpty()
                                cond On(pie,table)
                                act Open(oven)
                    sequence
                        cond IsSwitchedOff(radio)
                        cond IsClosed(oven)
                        cond IsHandEmpty()
                        cond On(pie,table)
                        act SwitchOn(radio)
            sequence
                cond IsSwitchedOff(radio)
                cond IsClosed(oven)
                cond IsSwitchedOff(light)
                cond IsHandEmpty()
                cond On(pie,table)
                act SwitchOn(light)
    sequence
        cond IsClosed(microwave)
        cond IsSwitchedOff(radio)
        cond IsClosed(oven)
        cond IsSwitchedOff(light)
        cond IsHandEmpty()
        cond On(pie,table)
        act Open(microwave)
