selector
    sequence
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond IsOpen(cabinet)
        selector
            selector
                selector
                    sequence
                        cond Holding(book)
                        selector
                            sequence
                                cond In(pen,cabinet)
                                act PlaceInStorage(book,cabinet)
                            sequence
                                cond Holding(pen)
                                act PlaceInStorage(pen,cabinet)
                    sequence
                        cond On(book,table)
                        cond IsHandEmpty()
                        cond Holding(pen)
                        cond On(book,breakfast_table)
                        act PickUp(book)
                sequence
                    cond On(book,table)
                    cond Holding(banana)
                    cond Holding(pen)
                    cond On(book,breakfast_table)
                    act PlaceInStorage(banana,cabinet)
            sequence
                cond On(book,table)
                cond On(pen,breakfast_table)
                cond On(pen,table)
                cond IsHandEmpty()
                cond On(book,breakfast_table)
                cond Holding(banana)
                act PickUp(pen)
    sequence
        cond On(book,table)
        cond On(pen,breakfast_table)
        cond On(pen,table)
        cond IsHandEmpty()
        cond Holding(banana)
        cond On(book,breakfast_table)
        cond IsClosed(cabinet)
        act OpenStorage(cabinet)
