selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond IsClosed(oven)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    sequence
                        cond IsSwitchedOn(light)
                        selector
                            sequence
                                cond IsSwitchedOn(radio)
                                selector
                                    sequence
                                        cond On(pie,breakfast_table)
                                        act OpenOven()
                                    sequence
                                        cond IsHandEmpty()
                                        cond On(pie,table)
                                        act PlaceOnBreakfastTable(pie)
                            sequence
                                cond IsHandEmpty()
                                cond IsSwitchedOff(radio)
                                cond On(pie,table)
                                act SwitchOnRadio()
                    sequence
                        cond IsSwitchedOff(light)
                        cond IsHandEmpty()
                        cond IsSwitchedOff(radio)
                        cond On(pie,table)
                        act SwitchOnLight()
            sequence
                cond IsClosed(microwave)
                cond On(pie,table)
                cond IsSwitchedOff(light)
                cond IsHandEmpty()
                cond IsSwitchedOff(radio)
                act OpenMicrowave()
