selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
        cond In(pie,oven)
    sequence
        cond In(pie,oven)
        cond On(left_franka,oven)
        selector
            sequence
                cond IsSwitchedOff(oven)
                selector
                    selector
                        selector
                            selector
                                selector
                                    selector
                                        selector
                                            sequence
                                                cond In(chickenleg,oven)
                                                selector
                                                    sequence
                                                        cond IsClosed(oven)
                                                        act SwitchOnOvenLeftFranka()
                                                    sequence
                                                        cond IsOpened(oven)
                                                        act CloseOvenLeftFranka()
                                            sequence
                                                cond Holding(left_franka,chickenleg)
                                                cond IsOpened(oven)
                                                act PutInOvenLeftFranka(chickenleg)
                                        sequence
                                            cond On(chickenleg,table)
                                            cond On(left_franka,table)
                                            cond IsOpened(oven)
                                            cond IsHandEmpty(left_franka)
                                            act PickUpLeftFranka(chickenleg)
                                    sequence
                                        cond On(chickenleg,table)
                                        cond IsHandEmpty(left_franka)
                                        cond On(left_franka,table)
                                        cond IsClosed(oven)
                                        act OpenOvenLeftFranka()
                                sequence
                                    cond On(right_franka,table)
                                    cond IsClosed(oven)
                                    cond Holding(right_franka,chickenleg)
                                    cond On(left_franka,table)
                                    cond IsHandEmpty(left_franka)
                                    act DropRightFranka(chickenleg,table)
                            sequence
                                cond On(right_franka,table)
                                cond IsClosed(oven)
                                cond Holding(right_franka,chickenleg)
                                cond On(left_franka,table)
                                cond Holding(left_franka,pie)
                                act DropLeftFranka(pie,table)
                        sequence
                            cond IsClosed(oven)
                            cond IsHandEmpty(right_franka)
                            cond Holding(right_franka,chickenleg)
                            cond On(left_franka,table)
                            cond Holding(left_franka,pie)
                            act MoveRightFranka(table)
                    sequence
                        cond Holding(right_franka,pie)
                        cond IsClosed(oven)
                        cond On(right_franka,microwave)
                        cond Holding(right_franka,chickenleg)
                        cond On(left_franka,table)
                        cond Holding(left_franka,pie)
                        act DropRightFranka(pie,microwave)
            sequence
                cond Holding(right_franka,pie)
                cond IsClosed(oven)
                cond IsSwitchedOn(oven)
                cond On(right_franka,microwave)
                cond Holding(right_franka,chickenleg)
                cond On(left_franka,table)
                cond Holding(left_franka,pie)
                act SwitchOffOvenLeftFranka()
