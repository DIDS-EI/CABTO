selector
    cond In(wine,fridge)
    sequence
        cond Holding(wine)
        selector
            selector
                sequence
                    cond IsOpen(fridge)
                    act PlaceIn(wine,fridge)
                sequence
                    cond IsClosed(fridge)
                    cond IsHandEmpty()
                    act OpenContainer(fridge)
            sequence
                cond IsClosed(fridge)
                cond Holding(pen)
                act PlaceOn(pen,table)
    sequence
        cond IsClosed(fridge)
        cond On(wine,table)
        cond Holding(pen)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(wine)
            sequence
                cond Holding(book)
                act PlaceOn(book,breakfast_table)
