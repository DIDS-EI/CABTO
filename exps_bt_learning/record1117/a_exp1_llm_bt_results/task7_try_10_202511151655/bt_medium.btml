selector
    sequence
        cond IsSwitchedOn(oven)
        cond IsClosed(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond In(chickenleg,oven)
                        act Close(oven)
                    sequence
                        cond Holding(chickenleg)
                        act PutIn(chickenleg,oven)
            sequence
                cond Holding(chickenleg)
                cond IsClosed(oven)
                act Open(oven)
    sequence
        cond IsClosed(oven)
        cond IsSwitchedOff(oven)
        selector
            sequence
                cond Holding(chickenleg)
                act SwitchOn(oven)
            sequence
                cond IsHandEmpty()
                cond On(chickenleg,table)
                act PickUp(chickenleg)
