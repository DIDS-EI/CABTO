selector
    sequence
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsSwitchedOn(radio)
                selector
                    sequence
                        cond IsOpened(microwave)
                        selector
                            sequence
                                cond IsSwitchedOn(light)
                                selector
                                    sequence
                                        cond IsOpened(oven)
                                        act PlaceObjectOnTable(pie)
                                    sequence
                                        cond IsClosed(oven)
                                        act OpenAppliance(oven)
                            sequence
                                cond IsSwitchedOff(light)
                                cond IsClosed(oven)
                                act SwitchOnAppliance(light)
                    sequence
                        cond IsClosed(microwave)
                        cond IsSwitchedOff(light)
                        cond IsClosed(oven)
                        act OpenAppliance(microwave)
            sequence
                cond IsClosed(microwave)
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                cond IsSwitchedOff(radio)
                act SwitchOnAppliance(radio)
    sequence
        cond IsClosed(microwave)
        cond On(pie,table)
        cond IsSwitchedOff(radio)
        cond IsSwitchedOff(light)
        cond IsHandEmpty()
        cond IsClosed(oven)
        act PickUpObject(pie)
