selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond Holding(soup)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PlaceObjectInAppliance(soup,microwave)
                    sequence
                        cond IsClosed(microwave)
                        act OpenAppliance(microwave)
            sequence
                cond IsClosed(microwave)
                cond IsSwitchedOff(microwave)
                act SwitchOnAppliance(microwave)
    sequence
        cond IsClosed(microwave)
        cond IsSwitchedOff(microwave)
        cond IsHandEmpty()
        cond On(soup,table)
        act PickUpObject(soup)
