selector
    sequence
        cond IsClosed(fridge)
        cond In(banana,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    cond In(banana,fridge)
                    act Close(fridge)
                sequence
                    cond Holding(banana)
                    act PlaceIn(banana,fridge)
            sequence
                cond IsHandEmpty()
                cond On(banana,table)
                act PickUp(banana)
    sequence
        cond IsClosed(fridge)
        cond IsHandEmpty()
        cond On(banana,table)
        act Open(fridge)
