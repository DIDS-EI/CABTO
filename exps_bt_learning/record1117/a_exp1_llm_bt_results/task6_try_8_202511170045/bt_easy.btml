selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond Holding(book)
                act PlaceIn(book,cabinet)
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                act PickUp(book)
    sequence
        cond On(book,table)
        cond IsHandEmpty()
        cond IsClosed(cabinet)
        act Open(cabinet)
