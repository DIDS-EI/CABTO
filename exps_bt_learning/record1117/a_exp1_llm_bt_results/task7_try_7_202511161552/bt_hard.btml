selector
    sequence
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsOpened(microwave)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsSwitchedOn(radio)
                        selector
                            sequence
                                cond Holding(pie)
                                selector
                                    sequence
                                        cond IsOpened(oven)
                                        act PutOnTable(pie)
                                    sequence
                                        cond IsClosed(oven)
                                        act Open(oven)
                            sequence
                                cond On(pie,table)
                                cond IsHandEmpty()
                                cond IsClosed(oven)
                                act PickUp(pie)
                    sequence
                        cond On(pie,table)
                        cond IsSwitchedOff(radio)
                        cond IsHandEmpty()
                        cond IsClosed(oven)
                        act SwitchOn(radio)
            sequence
                cond IsSwitchedOff(radio)
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                cond On(pie,table)
                cond IsHandEmpty()
                act SwitchOn(light)
    sequence
        cond IsSwitchedOff(radio)
        cond IsSwitchedOff(light)
        cond IsClosed(microwave)
        cond IsClosed(oven)
        cond On(pie,table)
        cond IsHandEmpty()
        act Open(microwave)
