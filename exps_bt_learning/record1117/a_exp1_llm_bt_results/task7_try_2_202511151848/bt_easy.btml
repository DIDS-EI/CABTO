selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond In(chickenleg,oven)
                selector
                    sequence
                        cond IsSwitchedOn(oven)
                        selector
                            sequence
                                cond Holding(pie)
                                act PutIn(pie,oven)
                            sequence
                                cond On(pie,table)
                                cond IsHandEmpty()
                                act PickUp(pie)
                    sequence
                        cond IsSwitchedOff(oven)
                        cond On(pie,table)
                        cond IsHandEmpty()
                        act SwitchOn(oven)
            sequence
                cond IsSwitchedOff(oven)
                cond On(pie,table)
                cond Holding(chickenleg)
                act PutIn(chickenleg,oven)
    sequence
        cond IsClosed(oven)
        cond On(pie,table)
        cond IsSwitchedOff(oven)
        selector
            sequence
                cond Holding(chickenleg)
                act Open(oven)
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                act PickUp(chickenleg)
