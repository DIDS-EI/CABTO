selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond Holding(soup)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PutInMicrowave(soup)
                    sequence
                        cond IsClosed(microwave)
                        act OpenMicrowave()
            sequence
                cond IsClosed(microwave)
                cond IsHandEmpty()
                cond On(soup,table)
                act PickUp(soup)
    sequence
        cond IsClosed(microwave)
        cond IsSwitchedOff(microwave)
        cond IsHandEmpty()
        cond On(soup,table)
        act TurnOnMicrowave()
