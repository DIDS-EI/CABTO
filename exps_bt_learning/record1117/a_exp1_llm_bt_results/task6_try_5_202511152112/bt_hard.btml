selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(wine,fridge)
    sequence
        cond Open(fridge)
        selector
            selector
                sequence
                    cond In(wine,fridge)
                    selector
                        selector
                            sequence
                                cond In(banana,fridge)
                                act CloseFridge()
                            sequence
                                cond Holding(banana)
                                act PutInFridge(banana)
                        sequence
                            cond On(banana,table)
                            cond IsHandEmpty()
                            act PickUp(banana)
                sequence
                    cond On(banana,table)
                    cond Holding(wine)
                    act PutInFridge(wine)
            sequence
                cond On(wine,breakfast_table)
                cond On(banana,table)
                cond IsHandEmpty()
                act PickUpFromBreakfastTable(wine)
    sequence
        cond IsClosed(fridge)
        cond On(banana,table)
        cond On(wine,breakfast_table)
        cond IsHandEmpty()
        act OpenFridge()
