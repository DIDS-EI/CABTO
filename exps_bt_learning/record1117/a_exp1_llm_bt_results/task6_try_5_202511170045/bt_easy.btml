selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(cabinet)
    sequence
        cond Holding(book)
        selector
            sequence
                cond IsOpened(cabinet)
                act PutIn(book,cabinet)
            sequence
                cond IsClosed(cabinet)
                act Open(cabinet)
    sequence
        cond On(book,table)
        cond On(book,breakfast_table)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(book)
            sequence
                cond Holding(banana)
                act PutOnTable(banana,breakfast_table)
