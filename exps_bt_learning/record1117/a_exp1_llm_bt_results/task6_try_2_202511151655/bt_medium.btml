selector
    sequence
        cond In(book,fridge)
        cond In(pen,cabinet)
    sequence
        cond In(pen,cabinet)
        selector
            sequence
                cond Holding(book)
                selector
                    sequence
                        cond IsOpened(fridge)
                        act DropInFridge(book)
                    sequence
                        cond IsClosed(fridge)
                        act OpenFridge()
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                cond IsClosed(fridge)
                act PickUp(book)
    sequence
        cond On(book,table)
        cond IsClosed(fridge)
        selector
            sequence
                cond Holding(pen)
                selector
                    sequence
                        cond IsOpened(cabinet)
                        act DropInCabinet(pen)
                    sequence
                        cond IsClosed(cabinet)
                        act OpenCabinet()
            sequence
                cond IsClosed(cabinet)
                cond IsHandEmpty()
                cond On(pen,table)
                act PickUp(pen)
