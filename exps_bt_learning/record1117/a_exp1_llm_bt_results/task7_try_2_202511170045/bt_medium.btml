selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    sequence
                        cond Holding(soup)
                        act PutIn(soup,microwave)
                    sequence
                        cond IsHandEmpty()
                        cond On(soup,table)
                        act PickUp(soup)
            sequence
                cond IsClosed(microwave)
                cond IsHandEmpty()
                cond On(soup,table)
                act Open(microwave)
    sequence
        cond IsClosed(microwave)
        cond On(soup,table)
        cond IsSwitchedOff(microwave)
        cond IsHandEmpty()
        act SwitchOn(microwave)
