selector
    sequence
        cond In(pie,oven)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                selector
                    sequence
                        cond In(chickenleg,oven)
                        selector
                            selector
                                sequence
                                    cond In(pie,oven)
                                    cond IsHandEmpty()
                                    act SwitchOn(oven)
                                sequence
                                    cond IsOpened(oven)
                                    cond Holding(pie)
                                    act PutIn(pie,oven)
                            sequence
                                cond IsOpened(oven)
                                cond IsHandEmpty()
                                cond On(pie,table)
                                act PickUp(pie)
                    sequence
                        cond IsOpened(oven)
                        cond Holding(chickenleg)
                        cond On(pie,table)
                        act PutIn(chickenleg,oven)
                sequence
                    cond On(chickenleg,table)
                    cond IsOpened(oven)
                    cond IsHandEmpty()
                    cond On(pie,table)
                    act PickUp(chickenleg)
            sequence
                cond On(chickenleg,table)
                cond IsClosed(oven)
                cond IsHandEmpty()
                cond On(pie,table)
                act Open(oven)
