selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
        cond In(pie,oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            selector
                selector
                    sequence
                        cond Holding(robot,chickenleg)
                        selector
                            sequence
                                cond IsOpened(oven)
                                selector
                                    sequence
                                        cond In(pie,oven)
                                        act PutInOven(chickenleg)
                                    sequence
                                        cond Holding(robot,pie)
                                        act PutInOven(pie)
                            sequence
                                cond Holding(robot,pie)
                                cond IsClosed(oven)
                                act OpenOven()
                    sequence
                        cond On(chickenleg,table)
                        cond IsHandEmpty(robot)
                        cond Holding(robot,pie)
                        cond IsClosed(oven)
                        act PickUpFromTable(chickenleg)
                sequence
                    cond On(chickenleg,table)
                    cond Holding(robot,soup)
                    cond Holding(robot,pie)
                    cond IsClosed(oven)
                    act PutDownOnTable(soup)
            sequence
                cond IsClosed(oven)
                cond On(chickenleg,table)
                cond Holding(robot,soup)
                cond IsHandEmpty(robot)
                cond On(pie,table)
                act PickUpFromTable(pie)
    sequence
        cond On(chickenleg,table)
        cond Holding(robot,soup)
        cond IsHandEmpty(robot)
        cond IsSwitchedOff(oven)
        cond On(pie,table)
        selector
            sequence
                cond IsClosed(oven)
                act SwitchOnOven()
            sequence
                cond IsOpened(oven)
                act CloseOven()
