selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond Holding(soup)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PutInMicrowave(soup)
                    sequence
                        cond IsClosed(microwave)
                        act Open(microwave)
            sequence
                cond IsHandEmpty()
                cond IsClosed(microwave)
                cond On(soup,table)
                act PickUpFromTable(soup)
    sequence
        cond IsSwitchedOff(microwave)
        cond IsHandEmpty()
        cond IsClosed(microwave)
        cond On(soup,table)
        act SwitchOn(microwave)
