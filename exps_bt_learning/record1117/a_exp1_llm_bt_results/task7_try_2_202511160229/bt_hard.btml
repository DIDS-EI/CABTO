selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(radio)
                selector
                    sequence
                        cond IsOpened(microwave)
                        selector
                            sequence
                                cond Holding(pie)
                                selector
                                    sequence
                                        cond IsSwitchedOn(light)
                                        act PutDownOnTable(pie,breakfast_table)
                                    sequence
                                        cond IsSwitchedOff(light)
                                        act SwitchOn(light)
                            sequence
                                cond IsSwitchedOff(light)
                                cond IsHandEmpty()
                                cond On(pie,table)
                                act PickUpFromTable(pie)
                    sequence
                        cond IsSwitchedOff(light)
                        cond IsHandEmpty()
                        cond On(pie,table)
                        cond IsClosed(microwave)
                        act Open(microwave)
            sequence
                cond IsSwitchedOff(radio)
                cond On(pie,table)
                cond IsClosed(microwave)
                cond IsSwitchedOff(light)
                cond IsHandEmpty()
                act SwitchOn(radio)
    sequence
        cond IsSwitchedOff(radio)
        cond On(pie,table)
        cond IsClosed(microwave)
        cond IsSwitchedOff(light)
        cond IsClosed(oven)
        cond IsHandEmpty()
        act Open(oven)
