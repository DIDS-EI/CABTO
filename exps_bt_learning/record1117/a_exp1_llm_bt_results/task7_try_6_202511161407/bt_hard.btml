selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond IsClosed(oven)
        selector
            selector
                selector
                    sequence
                        cond IsOpened(microwave)
                        selector
                            sequence
                                cond On(pie,breakfast_table)
                                selector
                                    sequence
                                        cond IsSwitchedOn(light)
                                        selector
                                            sequence
                                                cond IsSwitchedOn(radio)
                                                act OpenOven()
                                            sequence
                                                cond IsSwitchedOff(radio)
                                                act SwitchOnDevice(radio)
                                    sequence
                                        cond IsSwitchedOff(light)
                                        cond IsSwitchedOff(radio)
                                        act SwitchOnDevice(light)
                            sequence
                                cond IsSwitchedOff(light)
                                cond Holding(left_franka,pie)
                                cond IsSwitchedOff(radio)
                                act PutOnBreakfastTable(left_franka,pie)
                    sequence
                        cond IsSwitchedOff(light)
                        cond IsClosed(microwave)
                        cond Holding(left_franka,pie)
                        cond IsSwitchedOff(radio)
                        act OpenMicrowave()
                sequence
                    cond IsHandEmpty(left_franka)
                    cond IsClosed(microwave)
                    cond On(pie,table)
                    cond IsSwitchedOff(light)
                    cond IsSwitchedOff(radio)
                    act PickUp(left_franka,pie)
            sequence
                cond Holding(left_franka,light)
                cond IsClosed(microwave)
                cond On(pie,table)
                cond IsSwitchedOff(light)
                cond IsSwitchedOff(radio)
                act PutDown(left_franka,light)
