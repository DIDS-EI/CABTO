selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(wine,fridge)
    sequence
        cond Open(fridge)
        selector
            selector
                selector
                    sequence
                        cond In(banana,fridge)
                        selector
                            selector
                                sequence
                                    cond In(wine,fridge)
                                    act Close(fridge)
                                sequence
                                    cond Holding(wine)
                                    act PutIn(wine,fridge)
                            sequence
                                cond On(wine,table)
                                cond IsHandEmpty()
                                act PickUp(wine)
                    sequence
                        cond On(wine,table)
                        cond Holding(banana)
                        act PutIn(banana,fridge)
                sequence
                    cond On(wine,table)
                    cond On(banana,table)
                    cond IsHandEmpty()
                    act PickUp(banana)
            sequence
                cond Holding(book)
                cond Open(cabinet)
                cond On(wine,table)
                cond On(banana,table)
                act PutIn(book,cabinet)
    sequence
        cond Holding(book)
        cond On(wine,table)
        cond On(banana,table)
        cond IsClosed(fridge)
        selector
            sequence
                cond Open(cabinet)
                act Open(fridge)
            sequence
                cond IsClosed(cabinet)
                act Open(cabinet)
