selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    cond In(banana,fridge)
                    act CloseContainer(fridge)
                sequence
                    cond Holding(banana)
                    act PlaceIn(banana,fridge)
            sequence
                cond IsHandEmpty()
                cond On(banana,table)
                act PickUp(banana)
    sequence
        cond IsHandEmpty()
        cond On(banana,table)
        cond IsClosed(fridge)
        act OpenContainer(fridge)
