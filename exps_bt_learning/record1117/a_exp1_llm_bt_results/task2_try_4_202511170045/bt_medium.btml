selector
    sequence
        cond On(b,a)
        cond On(c,b)
    sequence
        cond On(b,a)
        selector
            sequence
                cond Holding(c)
                act PutDownOn(c,b)
            sequence
                cond On(c,table)
                cond IsHandEmpty()
                act PickUp(c)
    sequence
        cond On(c,table)
        selector
            sequence
                cond Holding(b)
                act PutDownOn(b,a)
            sequence
                cond On(b,table)
                cond IsHandEmpty()
                act PickUp(b)
