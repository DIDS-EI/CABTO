selector
    sequence
        cond On(b,place_a)
        cond On(c,place_b)
        cond On(a,place_c)
    sequence
        cond On(c,place_b)
        selector
            sequence
                cond Holding(a)
                selector
                    sequence
                        cond On(b,place_a)
                        act Drop(a,place_c)
                    sequence
                        cond Holding(b)
                        act Drop(b,place_a)
            sequence
                cond Holding(b)
                cond IsHandEmpty()
                cond On(a,table)
                act PickUp(a)
    sequence
        cond Holding(b)
        cond IsHandEmpty()
        cond On(a,table)
        cond Holding(c)
        act Drop(c,place_b)
