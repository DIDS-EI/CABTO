selector
    sequence
        cond IsHalfFull(right_cup)
        cond IsHandEmpty(right_franka)
        cond On(right_milk,right_table)
        cond IsHandEmpty(left_franka)
        cond On(left_milk,left_table)
        cond IsHalfFull(left_cup)
    sequence
        cond IsHolding(right_franka,right_milk)
        selector
            sequence
                cond IsHalfFull(right_cup)
                selector
                    sequence
                        cond IsHalfFull(left_cup)
                        selector
                            sequence
                                cond IsHandEmpty(left_franka)
                                cond On(left_milk,left_table)
                                act PutDown(right_franka,right_milk)
                            sequence
                                cond IsHolding(left_franka,left_milk)
                                act PutDown(left_franka,left_milk)
                    sequence
                        cond CupNeedGraspAndSupport()
                        cond IsEmpty(left_cup)
                        cond IsHolding(left_franka,left_milk)
                        act FillCup(left_franka,left_cup)
            sequence
                cond CupNeedGraspAndSupport()
                cond IsEmpty(right_cup)
                cond IsEmpty(left_cup)
                cond IsHolding(left_franka,left_milk)
                act FillCup(right_franka,right_cup)
    sequence
        cond IsHandEmpty(right_franka)
        cond CupNeedGraspAndSupport()
        cond CanGrasp(right_franka,right_milk)
        cond On(right_milk,right_table)
        cond IsEmpty(right_cup)
        cond IsEmpty(left_cup)
        selector
            sequence
                cond IsHolding(left_franka,left_milk)
                act PickUp(right_franka,right_milk)
            sequence
                cond IsHandEmpty(left_franka)
                cond On(left_milk,left_table)
                cond CanGrasp(left_franka,left_milk)
                act PickUp(left_franka,left_milk)
