selector
    sequence
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOff(light)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond IsSwitchedOn(radio)
                        selector
                            sequence
                                cond IsOpened(microwave)
                                act SwitchOnLight()
                            sequence
                                cond IsClosed(microwave)
                                act OpenMicrowave()
                    sequence
                        cond IsClosed(microwave)
                        cond IsSwitchedOff(radio)
                        act SwitchOnRadio()
            sequence
                cond IsClosed(microwave)
                cond IsClosed(oven)
                cond IsSwitchedOff(radio)
                act OpenOven()
