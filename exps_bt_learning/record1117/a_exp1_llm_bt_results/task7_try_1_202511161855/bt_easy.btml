selector
    sequence
        cond In(chickenleg,oven)
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond On(chickenleg,table)
        cond IsHandEmpty()
        cond IsClosed(oven)
        cond IsSwitchedOff(oven)
        selector
            sequence
                cond In(pie,oven)
                act PutInOven(chickenleg)
            sequence
                cond On(pie,table)
                act PutInOven(pie)
