selector
    sequence
        cond On(a,c)
        cond On(b,d)
        cond On(c,b)
    sequence
        cond On(a,c)
        selector
            sequence
                cond On(d,table)
                selector
                    selector
                        selector
                            sequence
                                cond On(c,b)
                                selector
                                    sequence
                                        cond Holding(b)
                                        act MoveOnto(b,d)
                                    sequence
                                        cond On(b,table)
                                        cond IsHandEmpty()
                                        act PickUp(b)
                            sequence
                                cond On(b,table)
                                cond IsHandEmpty()
                                cond Holding(c)
                                act MoveOnto(c,b)
                        sequence
                            cond Holding(b)
                            cond Holding(c)
                            act Drop(b)
                    sequence
                        cond On(c,table)
                        cond IsHandEmpty()
                        cond Holding(b)
                        act PickUp(c)
            sequence
                cond On(c,table)
                cond Holding(b)
                cond Holding(d)
                act Drop(d)
    sequence
        cond Holding(b)
        cond Holding(d)
        selector
            sequence
                cond On(c,table)
                selector
                    sequence
                        cond Holding(a)
                        act MoveOnto(a,c)
                    sequence
                        cond On(a,table)
                        cond IsHandEmpty()
                        act PickUp(a)
            sequence
                cond On(a,table)
                cond Holding(c)
                act Drop(c)
