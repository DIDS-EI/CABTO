selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
        cond In(pie,oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        selector
            selector
                sequence
                    cond In(chickenleg,oven)
                    selector
                        selector
                            sequence
                                cond In(pie,oven)
                                act SwitchOnOven()
                            sequence
                                cond Holding(pie)
                                act PutInOven(pie)
                        sequence
                            cond IsHandEmpty()
                            cond On(pie,table)
                            act PickUp(pie)
                sequence
                    cond Holding(chickenleg)
                    cond On(pie,table)
                    act PutInOven(chickenleg)
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond On(pie,table)
                act PickUp(chickenleg)
