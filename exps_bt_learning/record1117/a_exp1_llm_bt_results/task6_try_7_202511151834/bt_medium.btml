selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            selector
                selector
                    sequence
                        cond In(book,cabinet)
                        selector
                            sequence
                                cond Holding(pen)
                                act StoreIn(pen,cabinet)
                            sequence
                                cond On(pen,breakfast_table)
                                cond IsHandEmpty()
                                cond On(pen,table)
                                act PickUp(pen)
                    sequence
                        cond Holding(book)
                        cond On(pen,breakfast_table)
                        cond On(pen,table)
                        act StoreIn(book,cabinet)
                sequence
                    cond On(book,breakfast_table)
                    cond On(pen,breakfast_table)
                    cond On(pen,table)
                    cond IsHandEmpty()
                    cond On(book,table)
                    act PickUp(book)
            sequence
                cond On(book,breakfast_table)
                cond Holding(apple)
                cond On(pen,table)
                cond On(book,table)
                cond On(pen,breakfast_table)
                act PutDown(apple,breakfast_table)
    sequence
        cond IsClosed(cabinet)
        cond On(book,breakfast_table)
        cond Holding(apple)
        cond On(pen,table)
        cond On(book,table)
        cond On(pen,breakfast_table)
        selector
            sequence
                cond IsHandEmpty()
                act Open(cabinet)
            sequence
                cond Holding(wine)
                act PutDown(wine,breakfast_table)
