selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsHandEmpty()
        cond On(pie,table)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond In(chickenleg,oven)
                        selector
                            sequence
                                cond IsSwitchedOn(oven)
                                act PlaceInOven(pie)
                            sequence
                                cond IsSwitchedOff(oven)
                                act SwitchOnOven()
                    sequence
                        cond On(chickenleg,table)
                        cond IsSwitchedOff(oven)
                        act PlaceInOven(chickenleg)
            sequence
                cond On(chickenleg,table)
                cond IsSwitchedOff(oven)
                cond IsClosed(oven)
                act OpenOven()
