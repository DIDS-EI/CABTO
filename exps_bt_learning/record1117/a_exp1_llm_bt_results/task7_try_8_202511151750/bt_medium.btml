selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond Holding(soup)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PutIn(soup,microwave)
                    sequence
                        cond IsClosed(microwave)
                        act Open(microwave)
            sequence
                cond IsClosed(microwave)
                cond IsHandEmpty()
                cond On(soup,table)
                act PickUp(soup)
    sequence
        cond IsClosed(microwave)
        cond IsSwitchedOff(microwave)
        cond IsHandEmpty()
        cond On(soup,table)
        act SwitchOn(microwave)
