selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
        cond IsOpened(oven)
    sequence
        cond IsClosed(microwave)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    selector
                        sequence
                            cond On(pie,breakfast_table)
                            selector
                                sequence
                                    cond IsSwitchedOn(radio)
                                    selector
                                        sequence
                                            cond IsSwitchedOn(light)
                                            act OpenDevice(microwave)
                                        sequence
                                            cond IsSwitchedOff(light)
                                            act SwitchOnDevice(light)
                                sequence
                                    cond IsSwitchedOff(radio)
                                    cond IsSwitchedOff(light)
                                    act SwitchOnDevice(radio)
                        sequence
                            cond IsSwitchedOff(radio)
                            cond Holding(pie)
                            cond IsSwitchedOff(light)
                            act PutOnBreakfastTable(pie)
                    sequence
                        cond IsSwitchedOff(radio)
                        cond IsHandEmpty()
                        cond On(pie,table)
                        cond IsSwitchedOff(light)
                        act PickUp(pie)
            sequence
                cond IsSwitchedOff(radio)
                cond IsClosed(oven)
                cond IsSwitchedOff(light)
                cond IsHandEmpty()
                cond On(pie,table)
                act OpenDevice(oven)
