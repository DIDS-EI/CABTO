selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                selector
                    sequence
                        cond In(soup,microwave)
                        act SwitchOnDevice(microwave)
                    sequence
                        cond Holding(soup)
                        cond IsOpened(microwave)
                        act PutInMicrowave(soup)
                sequence
                    cond IsHandEmpty()
                    cond IsOpened(microwave)
                    cond On(soup,table)
                    act PickUp(soup)
            sequence
                cond IsClosed(microwave)
                cond IsHandEmpty()
                cond On(soup,table)
                act OpenDevice(microwave)
