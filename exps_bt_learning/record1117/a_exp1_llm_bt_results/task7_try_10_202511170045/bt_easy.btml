selector
    sequence
        cond In(pie,oven)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    selector
                        sequence
                            cond In(chickenleg,oven)
                            selector
                                sequence
                                    cond Holding(pie)
                                    act PutInOven(pie)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(pie,table)
                                    act PickUp(pie)
                        sequence
                            cond Holding(chickenleg)
                            cond On(pie,table)
                            act PutInOven(chickenleg)
                    sequence
                        cond On(chickenleg,table)
                        cond IsHandEmpty()
                        cond On(pie,table)
                        act PickUp(chickenleg)
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond On(pie,table)
                cond IsSwitchedOff(oven)
                act SwitchOnDevice(oven)
    sequence
        cond On(chickenleg,table)
        cond IsClosed(oven)
        cond IsHandEmpty()
        cond IsSwitchedOff(oven)
        cond On(pie,table)
        act OpenDevice(oven)
