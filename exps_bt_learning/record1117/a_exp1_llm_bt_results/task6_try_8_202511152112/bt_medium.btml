selector
    sequence
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond IsOpen(cabinet)
        selector
            selector
                selector
                    sequence
                        cond In(pen,cabinet)
                        selector
                            selector
                                sequence
                                    cond Holding(book)
                                    act PutIn(book,cabinet)
                                sequence
                                    cond On(book,table)
                                    cond On(book,breakfast_table)
                                    cond IsHandEmpty()
                                    act PickUp(book)
                            sequence
                                cond Holding(apple)
                                cond On(book,table)
                                cond On(book,breakfast_table)
                                act PutOn(apple,breakfast_table)
                    sequence
                        cond Holding(apple)
                        cond On(book,table)
                        cond On(book,breakfast_table)
                        cond Holding(pen)
                        act PutIn(pen,cabinet)
                sequence
                    cond On(pen,table)
                    cond On(book,breakfast_table)
                    cond Holding(apple)
                    cond On(pen,breakfast_table)
                    cond On(book,table)
                    cond IsHandEmpty()
                    act PickUp(pen)
            sequence
                cond On(pen,table)
                cond On(book,breakfast_table)
                cond Holding(apple)
                cond On(pen,breakfast_table)
                cond On(book,table)
                cond Holding(banana)
                act PutIn(banana,cabinet)
    sequence
        cond On(pen,table)
        cond IsClosed(cabinet)
        cond On(book,breakfast_table)
        cond Holding(apple)
        cond On(pen,breakfast_table)
        cond On(book,table)
        cond Holding(banana)
        act OpenCabinet()
