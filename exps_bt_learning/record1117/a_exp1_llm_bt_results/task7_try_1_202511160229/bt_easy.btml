selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                selector
                    sequence
                        cond In(chickenleg,oven)
                        selector
                            sequence
                                cond Holding(left_franka,pie)
                                selector
                                    sequence
                                        cond IsSwitchedOn(oven)
                                        act PutInContainerLeftFranka(pie,oven)
                                    sequence
                                        cond IsSwitchedOff(oven)
                                        act SwitchOnDevice(oven)
                            sequence
                                cond IsOpened(microwave)
                                cond IsSwitchedOff(oven)
                                cond In(pie,microwave)
                                cond IsHandEmpty(left_franka)
                                act RemoveFromContainerLeftFranka(pie,microwave)
                    sequence
                        cond IsOpened(microwave)
                        cond IsSwitchedOff(oven)
                        cond In(pie,microwave)
                        cond Holding(left_franka,chickenleg)
                        act PutInContainerLeftFranka(chickenleg,oven)
                sequence
                    cond IsSwitchedOff(oven)
                    cond IsOpened(microwave)
                    cond In(pie,microwave)
                    cond In(chickenleg,microwave)
                    cond IsHandEmpty(left_franka)
                    act RemoveFromContainerLeftFranka(chickenleg,microwave)
            sequence
                cond IsSwitchedOff(oven)
                cond Holding(left_franka,soup)
                cond IsOpened(microwave)
                cond In(pie,microwave)
                cond In(chickenleg,microwave)
                act PutDownLeftFrankaOnTable(soup)
    sequence
        cond IsSwitchedOff(oven)
        cond Holding(left_franka,soup)
        cond IsClosed(oven)
        cond In(pie,microwave)
        cond In(chickenleg,microwave)
        selector
            sequence
                cond IsOpened(microwave)
                act OpenContainerLeftFranka(oven)
            sequence
                cond IsClosed(microwave)
                act OpenContainerLeftFranka(microwave)
