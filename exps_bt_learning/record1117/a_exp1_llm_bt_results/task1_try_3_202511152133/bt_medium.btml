selector
    sequence
        cond On(b,place_b)
        cond On(c,place_c)
    sequence
        cond On(c,table)
        cond IsHandEmpty()
        cond IsEmpty(place_c)
        selector
            sequence
                cond On(b,place_b)
                act PutAOnB(c,place_c)
            sequence
                cond On(b,table)
                cond IsEmpty(place_b)
                act PutAOnB(b,place_b)
