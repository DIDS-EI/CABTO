selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond Holding(book)
                act PutInContainer(book,cabinet)
            sequence
                cond IsHandEmpty()
                cond On(book,table)
                act PickUpFromSurface(book,table)
    sequence
        cond On(book,table)
        cond IsHandEmpty()
        cond IsClosed(cabinet)
        act OpenCabinet(cabinet)
