selector
    cond On(left_box1,right_table)
    sequence
        cond IsHolding(left_franka,left_box1)
        selector
            selector
                sequence
                    cond On(left_franka,right_table)
                    act PutDownLeftFranka(left_box1,right_table)
                sequence
                    cond IsHandEmpty(left_franka)
                    act MoveLeftFrankaToTable(right_table)
            sequence
                cond IsHolding(left_franka,left_box2)
                cond On(left_franka,left_table)
                act PutDownLeftFranka(left_box2,left_table)
    sequence
        cond IsHandEmpty(left_franka)
        cond IsHolding(left_franka,left_box2)
        cond On(left_box1,left_table)
        selector
            sequence
                cond On(left_franka,left_table)
                act PickUpLeftFranka(left_box1)
            act MoveLeftFrankaToTable(left_table)
