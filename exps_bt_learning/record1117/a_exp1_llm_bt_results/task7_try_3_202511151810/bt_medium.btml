selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsHandEmpty()
        cond On(soup,table)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PutInMicrowave(soup)
                    sequence
                        cond IsClosed(microwave)
                        act OpenMicrowave(microwave)
            sequence
                cond IsClosed(microwave)
                cond IsSwitchedOff(microwave)
                act SwitchOnMicrowave(microwave)
