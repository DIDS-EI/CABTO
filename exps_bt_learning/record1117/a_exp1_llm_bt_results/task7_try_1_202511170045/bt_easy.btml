selector
    sequence
        cond In(pie,oven)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                sequence
                    cond In(pie,oven)
                    selector
                        sequence
                            cond IsSwitchedOn(oven)
                            selector
                                sequence
                                    cond Holding(chickenleg)
                                    act PlaceIn(chickenleg,oven)
                                sequence
                                    cond On(chickenleg,table)
                                    cond IsHandEmpty()
                                    act PickUp(chickenleg)
                        sequence
                            cond On(chickenleg,table)
                            cond IsHandEmpty()
                            cond IsSwitchedOff(oven)
                            act SwitchOn(oven)
                sequence
                    cond On(chickenleg,table)
                    cond Holding(pie)
                    cond IsSwitchedOff(oven)
                    act PlaceIn(pie,oven)
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond On(pie,table)
                cond IsSwitchedOff(oven)
                act PickUp(pie)
    sequence
        cond On(chickenleg,table)
        cond IsClosed(oven)
        cond IsHandEmpty()
        cond IsSwitchedOff(oven)
        cond On(pie,table)
        act Open(oven)
