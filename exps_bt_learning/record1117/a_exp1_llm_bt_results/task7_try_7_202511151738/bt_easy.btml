selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            sequence
                cond Holding(chickenleg)
                selector
                    sequence
                        cond IsOpened(oven)
                        act PlaceIn(chickenleg,oven)
                    sequence
                        cond IsClosed(oven)
                        act OpenDevice(oven)
            sequence
                cond IsHandEmpty()
                cond On(chickenleg,table)
                cond IsClosed(oven)
                act PickUp(chickenleg)
    sequence
        cond IsHandEmpty()
        cond On(chickenleg,table)
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        act SwitchOn(oven)
