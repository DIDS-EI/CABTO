selector
    sequence
        cond IsHandEmpty(right_franka)
        cond IsHalfFull(left_cup)
        cond IsHandEmpty(left_franka)
        cond On(left_milk,left_table)
        cond IsHalfFull(right_cup)
        cond On(right_milk,right_table)
    sequence
        cond Holding(left_franka,left_milk)
        selector
            sequence
                cond IsHalfFull(left_cup)
                selector
                    sequence
                        cond IsHalfFull(right_cup)
                        selector
                            sequence
                                cond On(right_milk,right_table)
                                cond IsHandEmpty(right_franka)
                                act PutDownLeftFranka(left_milk)
                            sequence
                                cond Holding(right_franka,right_milk)
                                act PutDownRightFranka(right_milk)
                    sequence
                        cond Holding(left_franka,right_milk)|Holding(right_franka,right_milk)
                        cond Holding(right_franka,right_milk)
                        cond IsFull(right_milk)
                        cond IsEmpty(right_cup)
                        act PourMilkIntoRightCup(right_milk,right_cup)
            sequence
                cond Holding(left_franka,right_milk)|Holding(right_franka,right_milk)
                cond IsFull(right_milk)
                cond IsFull(left_milk)
                cond IsEmpty(left_cup)
                cond Holding(left_franka,left_milk)|Holding(right_franka,left_milk)
                cond IsEmpty(right_cup)
                cond Holding(right_franka,right_milk)
                act PourMilkIntoLeftCup(left_milk,left_cup)
