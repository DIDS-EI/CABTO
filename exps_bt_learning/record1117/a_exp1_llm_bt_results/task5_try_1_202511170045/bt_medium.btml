selector
    sequence
        cond IsHalfFull(left_cup)
        cond IsHalfFull(right_cup)
    sequence
        cond Holding(left_franka,left_milk)|Holding(right_franka,left_milk)
        cond IsEmpty(left_cup)
        cond IsFull(left_milk)
        selector
            sequence
                cond IsHalfFull(right_cup)
                act PourMilkIntoLeftCup(left_milk,left_cup)
            sequence
                cond IsEmpty(right_cup)
                act PourMilkIntoRightCup(left_milk,right_cup)
