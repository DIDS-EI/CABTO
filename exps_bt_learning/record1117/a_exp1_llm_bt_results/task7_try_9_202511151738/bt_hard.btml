selector
    sequence
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsNoIsClosedIn(microwave)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsOpened(oven)
                        act OpenMicrowave()
                    act OpenOven()
            sequence
                cond IsSwitchedOff(light)
                act SwitchOnLight()
