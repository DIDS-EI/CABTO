selector
    sequence
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsClosed(microwave)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsOpened(oven)
                        act Open(right_franka,microwave)
                    sequence
                        cond IsClosed(oven)
                        act Open(right_franka,oven)
            sequence
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                act SwitchOn(left_franka,light)
