selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsSwitchedOff(light)
        cond On(pie,breakfast_table)
        cond IsAt(left_franka,light)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            selector
                                sequence
                                    cond IsHandEmpty(left_franka)
                                    selector
                                        sequence
                                            cond IsSwitchedOn(radio)
                                            act SwitchOn(left_franka,light)
                                        sequence
                                            cond IsHandEmpty(right_franka)
                                            cond IsSwitchedOff(radio)
                                            cond IsAt(right_franka,radio)
                                            act SwitchOn(right_franka,radio)
                                sequence
                                    cond IsSwitchedOff(radio)
                                    cond IsAt(left_franka,oven)
                                    cond IsHandEmpty(right_franka)
                                    cond IsAt(right_franka,radio)
                                    cond Holding(left_franka,chickenleg)
                                    act PutInOven(left_franka,chickenleg)
                            sequence
                                cond IsSwitchedOff(radio)
                                cond IsAt(left_franka,oven)
                                cond Holding(right_franka,chickenleg)
                                cond Holding(left_franka,chickenleg)
                                cond IsAt(right_franka,oven)
                                cond IsAt(right_franka,radio)
                                act PutInOven(right_franka,chickenleg)
                    sequence
                        cond IsHandEmpty(('left_franka',))
                        cond IsSwitchedOff(radio)
                        cond IsAt(left_franka,oven)
                        cond IsAt(('left_franka',),oven)
                        cond IsClosed(oven)
                        cond Holding(right_franka,chickenleg)
                        cond Holding(left_franka,chickenleg)
                        cond IsAt(right_franka,oven)
                        cond IsAt(right_franka,radio)
                        act OpenOven(left_franka)
            sequence
                cond IsHandEmpty(('left_franka',))
                cond IsSwitchedOff(radio)
                cond IsAt(left_franka,oven)
                cond IsClosed(microwave)
                cond IsAt(('right_franka',),microwave)
                cond IsAt(('left_franka',),oven)
                cond IsHandEmpty(('right_franka',))
                cond Holding(right_franka,chickenleg)
                cond IsClosed(oven)
                cond Holding(left_franka,chickenleg)
                cond IsAt(right_franka,oven)
                cond IsAt(right_franka,radio)
                act OpenMicrowave(right_franka)
