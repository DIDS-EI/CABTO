selector
    sequence
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond IsOpen(cabinet)
        selector
            selector
                selector
                    selector
                        sequence
                            cond In(book,cabinet)
                            selector
                                sequence
                                    cond Holding(pen)
                                    act PutIn(pen,cabinet)
                                sequence
                                    cond On(pen,table)|On(pen,breakfast_table)
                                    cond IsHandEmpty()
                                    act PickUp(pen)
                        sequence
                            cond On(pen,table)|On(pen,breakfast_table)
                            cond Holding(book)
                            act PutIn(book,cabinet)
                    sequence
                        cond On(book,table)|On(book,breakfast_table)
                        cond On(pen,table)|On(pen,breakfast_table)
                        cond IsHandEmpty()
                        act PickUp(book)
                sequence
                    cond On(book,table)|On(book,breakfast_table)
                    cond On(pen,table)|On(pen,breakfast_table)
                    cond IsOpen(fridge)
                    cond Holding(wine)
                    act PutIn(wine,fridge)
            sequence
                cond On(book,table)|On(book,breakfast_table)
                cond On(pen,table)|On(pen,breakfast_table)
                cond IsClosed(fridge)
                cond Holding(wine)
                act Open(fridge)
    sequence
        cond Holding(wine)
        cond On(book,table)|On(book,breakfast_table)
        cond On(pen,table)|On(pen,breakfast_table)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        act Open(cabinet)
