selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                selector
                    sequence
                        cond In(soup,microwave)
                        act SwitchOn(microwave)
                    sequence
                        cond Holding(soup)
                        cond IsOpened(microwave)
                        act PutInMicrowave(soup)
                sequence
                    cond Holding(soup)
                    cond IsClosed(microwave)
                    act Open(microwave)
            sequence
                cond IsHandEmpty()
                cond IsClosed(microwave)
                cond On(soup,table)
                act PickUp(soup)
