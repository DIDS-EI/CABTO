selector
    sequence
        cond On(a,place_a)
        cond On(b,place_b)
    sequence
        cond On(a,table)
        cond IsEmpty(place_a)
        cond IsHandEmpty()
        selector
            sequence
                cond On(b,place_b)
                act PutAOnB(a,place_a)
            sequence
                cond IsEmpty(place_b)
                cond On(b,table)
                act PutBOnC(b,place_b)
