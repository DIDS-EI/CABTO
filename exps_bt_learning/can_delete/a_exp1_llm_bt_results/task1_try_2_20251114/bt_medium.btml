selector
    sequence
        cond On(b,place_b)
        cond On(a,place_a)
    sequence
        cond IsHandEmpty()
        cond IsEmpty(place_a)
        selector
            sequence
                cond On(b,place_b)
                act PutAOnB(a,place_a)
            sequence
                cond IsEmpty(place_b)
                act PutAOnB(b,place_b)
