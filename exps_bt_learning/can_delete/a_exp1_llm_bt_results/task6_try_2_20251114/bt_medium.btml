selector
    sequence
        cond In(pen,cabinet)
        cond In(apple,fridge)
    sequence
        cond IsClosed(cabinet)
        cond IsContainerEmpty(cabinet)
        selector
            selector
                sequence
                    cond In(apple,fridge)
                    selector
                        sequence
                            cond Holding(pen)
                            act DropToCabinet(pen)
                        sequence
                            cond IsHandEmpty()
                            cond On(pen,table)
                            act PickUp(pen)
                sequence
                    cond Holding(apple)
                    cond IsClosed(fridge)
                    cond On(pen,table)
                    cond IsContainerEmpty(fridge)
                    act DropToFridge(apple)
            sequence
                cond On(pen,table)
                cond IsContainerEmpty(fridge)
                cond IsHandEmpty()
                cond On(apple,table)
                cond IsClosed(fridge)
                act PickUp(apple)
