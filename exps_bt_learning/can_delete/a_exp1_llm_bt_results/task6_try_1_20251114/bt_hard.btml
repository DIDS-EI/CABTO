selector
    sequence
        cond IsClosed(cabinet)
        cond In(pen,cabinet)
        cond IsClosed(fridge)
        cond In(apple,fridge)
    sequence
        cond Holding(apple)
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        selector
            selector
                sequence
                    cond In(pen,cabinet)
                    act PutInFridge(apple)
                sequence
                    cond Holding(pen)
                    act PutInCabinet(pen)
            sequence
                cond IsHandEmpty()
                cond On(pen,table)
                cond IsContainerEmpty(cabinet)
                cond IsContainerEmpty(fridge)
                act PickUpPen(pen)
