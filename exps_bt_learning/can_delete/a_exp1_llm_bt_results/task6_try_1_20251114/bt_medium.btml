selector
    sequence
        cond In(pen,cabinet)
        cond In(apple,fridge)
    sequence
        cond Holding(apple)
        cond IsClosed(fridge)
        selector
            selector
                sequence
                    cond In(pen,cabinet)
                    act PutInFridge(apple)
                sequence
                    cond IsClosed(cabinet)
                    cond Holding(pen)
                    act PutInCabinet(pen)
            sequence
                cond On(pen,table)
                cond IsContainerEmpty(cabinet)
                cond IsClosed(cabinet)
                cond IsContainerEmpty(fridge)
                cond IsHandEmpty()
                act PickUpPen(pen)
