selector
    sequence
        cond On(b,place_b)
        cond On(c,place_c)
        cond On(a,place_a)
    sequence
        cond On(a,place_a)
        selector
            selector
                sequence
                    cond On(c,place_c)
                    selector
                        sequence
                            cond Holding(b)
                            act Drop(b,place_b)
                        sequence
                            cond IsHandEmpty()
                            cond On(b,table)
                            act PickUp(b)
                sequence
                    cond On(b,table)
                    cond Holding(c)
                    act Drop(c,place_c)
            sequence
                cond IsHandEmpty()
                cond On(c,table)
                cond On(b,table)
                act PickUp(c)
    sequence
        cond On(b,table)
        cond On(c,table)
        selector
            sequence
                cond Holding(a)
                act Drop(a,place_a)
            sequence
                cond On(a,table)
                cond IsHandEmpty()
                act PickUp(a)
