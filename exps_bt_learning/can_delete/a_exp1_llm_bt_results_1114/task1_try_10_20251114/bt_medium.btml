selector
    sequence
        cond On(b,place_b)
        cond On(a,place_a)
    sequence
        cond On(a,place_a)
        selector
            sequence
                cond Holding(b)
                act Drop(b,place_b)
            sequence
                cond IsHandEmpty()
                cond On(b,table)
                act PickUp(b)
    sequence
        cond On(b,table)
        selector
            sequence
                cond Holding(a)
                act Drop(a,place_a)
            sequence
                cond On(a,table)
                cond IsHandEmpty()
                act PickUp(a)
