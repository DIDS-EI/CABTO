selector
    sequence
        cond On(b,c)
        cond On(a,b)
    sequence
        cond On(c,table)
        selector
            selector
                sequence
                    cond On(a,b)
                    selector
                        sequence
                            cond Holding(b)
                            act Drop(b,c)
                        sequence
                            cond IsHandEmpty()
                            cond On(b,table)
                            act PickUp(b)
                sequence
                    cond Holding(a)
                    cond On(b,table)
                    act Drop(a,b)
            sequence
                cond On(a,table)
                cond On(b,table)
                cond IsHandEmpty()
                act PickUp(a)
