selector
    sequence
        cond On(b,place_b)
        cond On(c,place_c)
        cond On(a,place_a)
    sequence
        cond On(c,place_c)
        selector
            sequence
                cond Holding(a)
                selector
                    sequence
                        cond On(b,place_b)
                        act Drop(a,place_a)
                    sequence
                        cond Holding(b)
                        act Drop(b,place_b)
            sequence
                cond On(a,table)
                cond Holding(b)
                cond IsHandEmpty()
                act PickUp(a)
    sequence
        cond On(a,table)
        cond Holding(b)
        cond IsHandEmpty()
        cond Holding(c)
        act Drop(c,place_c)
