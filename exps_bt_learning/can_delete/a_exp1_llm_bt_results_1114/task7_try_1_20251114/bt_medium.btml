selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(soup,microwave)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsNotIn(chickenleg,oven)
        cond In(soup,microwave)
        selector
            sequence
                cond Holding(robot,chickenleg)
                selector
                    sequence
                        cond IsSwitchedOn(oven)
                        selector
                            sequence
                                cond IsSwitchedOn(microwave)
                                act Drop(chickenleg,oven)
                            sequence
                                cond IsSwitchedOff(microwave)
                                act TurnOnMicrowave()
                    sequence
                        cond IsSwitchedOff(oven)
                        cond IsSwitchedOff(microwave)
                        act TurnOnOven()
            sequence
                cond On(chickenleg,table)
                cond IsSwitchedOff(oven)
                cond IsHandEmpty()
                cond IsSwitchedOff(microwave)
                act PickUp(chickenleg)
