selector
    sequence
        cond On(left_box,right_table)
        cond On(right_box,left_table)
    sequence
        cond On(left_franka,right_table)
        selector
            selector
                sequence
                    cond On(right_box,left_table)
                    selector
                        sequence
                            cond Holding(left_franka,left_box)
                            act DropLeftBox(left_box,right_table)
                        sequence
                            cond On(left_box,left_table)
                            cond IsHandEmpty(left_franka)
                            act PickUpLeftBox(left_box)
                sequence
                    cond On(left_box,left_table)
                    cond Holding(right_franka,right_box)
                    cond IsHandEmpty(left_franka)
                    cond On(right_franka,right_table)
                    act DropRightBox(right_box,left_table)
            sequence
                cond On(right_box,right_table)
                cond IsHandEmpty(right_franka)
                cond On(right_franka,right_table)
                cond On(left_box,left_table)
                cond IsHandEmpty(left_franka)
                act PickUpRightBox(right_box)
    sequence
        cond On(right_box,right_table)
        cond IsHandEmpty(right_franka)
        cond On(right_franka,right_table)
        cond On(left_box,left_table)
        cond On(left_franka,left_table)
        cond IsHandEmpty(left_franka)
        act MoveToward(left_franka)
