selector
    sequence
        cond On(left_box,right_table)
        cond On(right_box,left_table)
    sequence
        cond On(left_box,right_table)
        selector
            sequence
                cond Holding(right_franka,right_box)
                act DropRightFranka(right_box,left_table)
            sequence
                cond IsHandEmpty(right_franka)
                cond On(right_box,right_table)
                act PickUpRightFranka(right_box)
    sequence
        cond On(left_box,left_table)
        cond IsHandEmpty(right_franka)
        cond On(right_box,right_table)
        act TransferLeftBoxToRightTable(left_box)
