selector
    sequence
        cond On(left_box,right_table)
        cond On(right_box,left_table)
    sequence
        cond On(right_box,left_box)
        selector
            sequence
                cond On(left_box,right_table)
                act MoveRightBox(left_table)
            sequence
                cond On(left_box,left_table)
                act MoveLeftBox(right_table)
