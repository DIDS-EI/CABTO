selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(soup,microwave)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOff(oven)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    selector
                        sequence
                            cond In(soup,microwave)
                            selector
                                sequence
                                    cond In(chickenleg,oven)
                                    act SwitchOnOven()
                                sequence
                                    cond IsNotIn(chickenleg,oven)
                                    cond Holding(chickenleg)
                                    act PutInOven(chickenleg)
                        sequence
                            cond IsNotIn(chickenleg,oven)
                            cond Holding(soup)
                            cond Holding(chickenleg)
                            cond IsNotIn(soup,microwave)
                            act Drop(soup,microwave)
                    sequence
                        cond IsNotIn(soup,microwave)
                        cond IsNotIn(chickenleg,oven)
                        cond Holding(chickenleg)
                        cond IsHandEmpty()
                        cond On(soup)
                        act PickUp(soup)
            sequence
                cond IsSwitchedOff(microwave)
                cond IsNotIn(soup,microwave)
                cond IsNotIn(chickenleg,oven)
                cond Holding(chickenleg)
                cond IsHandEmpty()
                cond On(soup)
                act SwitchOnMicrowave()
