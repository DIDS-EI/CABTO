selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(light)
        cond IsSwitchedOn(oven)
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOff(light)
        selector
            selector
                sequence
                    cond IsSwitchedOn(oven)
                    selector
                        sequence
                            cond In(soup,microwave)
                            selector
                                sequence
                                    cond IsSwitchedOn(microwave)
                                    selector
                                        sequence
                                            cond In(chickenleg,oven)
                                            act SwitchOnLight()
                                        sequence
                                            cond IsNotIn(chickenleg,oven)
                                            cond Holding(chickenleg)
                                            act Drop(chickenleg,oven)
                                sequence
                                    cond IsNotIn(chickenleg,oven)
                                    cond Holding(chickenleg)
                                    cond IsSwitchedOff(microwave)
                                    act SwitchOnMicrowave()
                        sequence
                            cond Holding(soup)
                            cond IsNotIn(soup,microwave)
                            cond IsNotIn(chickenleg,oven)
                            cond Holding(chickenleg)
                            cond IsSwitchedOff(microwave)
                            act Drop(soup,microwave)
                sequence
                    cond Holding(soup)
                    cond IsNotIn(soup,microwave)
                    cond IsNotIn(chickenleg,oven)
                    cond Holding(chickenleg)
                    cond IsSwitchedOff(oven)
                    cond IsSwitchedOff(microwave)
                    act SwitchOnOven()
            sequence
                cond Holding(soup)
                cond IsNotIn(soup,microwave)
                cond IsNotIn(chickenleg,oven)
                cond IsHandEmpty()
                cond On(chickenleg)
                cond IsSwitchedOff(oven)
                cond IsSwitchedOff(microwave)
                act PickUp(chickenleg)
