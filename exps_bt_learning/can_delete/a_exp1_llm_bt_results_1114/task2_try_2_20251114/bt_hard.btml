selector
    sequence
        cond On(b,c)
        cond On(a,b)
        cond On(c,d)
    sequence
        cond On(b,c)
        selector
            sequence
                cond On(b,table)
                selector
                    selector
                        sequence
                            cond On(a,table)
                            selector
                                sequence
                                    cond IsHandEmpty()
                                    selector
                                        sequence
                                            cond On(c,d)
                                            act PutAOnB(a,b)
                                        sequence
