selector
    sequence
        cond In(pen,cabinet)
        cond In(apple,fridge)
    sequence
        cond Holding(apple)
        selector
            sequence
                cond In(pen,cabinet)
                selector
                    sequence
                        cond IsClosed(fridge)
                        act DropInFridge(apple)
                    sequence
                        cond !IsClosed(fridge)
                        act CloseFridge()
            sequence
                cond !IsClosed(fridge)
                cond IsClosed(cabinet)
                cond Holding(pen)
                act DropInCabinet(pen)
    sequence
        cond On(apple,table)
        cond !IsClosed(fridge)
        cond Holding(pen)
        cond IsHandEmpty()
        selector
            sequence
                cond IsClosed(cabinet)
                act PickUp(apple)
            sequence
                cond !IsClosed(cabinet)
                act CloseCabinet()
