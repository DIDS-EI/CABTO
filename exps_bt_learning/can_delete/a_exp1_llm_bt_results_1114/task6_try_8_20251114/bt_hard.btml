selector
    sequence
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond In(apple,fridge)
    sequence
        cond Holding(pen)
        selector
            sequence
                cond IsClosed(fridge)
                selector
                    sequence
                        cond IsClosed(cabinet)
                        selector
                            sequence
                                cond In(apple,fridge)
                                act DropInCabinet(pen)
                            sequence
                                cond Holding(apple)
                                act DropInFridge(apple)
                    sequence
                        cond Holding(apple)
                        cond !IsClosed(cabinet)
                        act CloseCabinet()
            sequence
                cond !IsClosed(fridge)
                cond Holding(apple)
                cond !IsClosed(cabinet)
                act CloseFridge()
    sequence
        cond On(pen,table)
        cond !IsClosed(cabinet)
        cond IsHandEmpty()
        cond !IsClosed(fridge)
        cond Holding(apple)
        act PickUp(pen)
