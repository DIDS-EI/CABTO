selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(light)
        cond IsSwitchedOn(oven)
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond Holding(robot,soup)
        selector
            selector
                sequence
                    cond IsSwitchedOn(oven)
                    selector
                        sequence
                            cond IsSwitchedOn(microwave)
                            selector
                                sequence
                                    cond IsSwitchedOn(light)
                                    selector
                                        sequence
                                            cond In(chickenleg,oven)
                                            act PlaceSoupInMicrowave(soup)
                                        sequence
                                            cond Holding(robot,chickenleg)
                                            act DropChickenLeg(chickenleg)
                                sequence
                                    cond Holding(robot,chickenleg)
                                    cond IsSwitchedOff(light)
                                    act SwitchOnLight()
                        sequence
                            cond Holding(robot,chickenleg)
                            cond IsSwitchedOff(light)
                            cond IsSwitchedOff(microwave)
                            act SwitchOnMicrowave()
                sequence
                    cond Holding(robot,chickenleg)
                    cond IsSwitchedOff(oven)
                    cond IsSwitchedOff(light)
                    cond IsSwitchedOff(microwave)
                    act SwitchOnOven()
            sequence
                cond On(chickenleg,table)
                cond IsSwitchedOff(light)
                cond IsHandEmpty()
                cond IsSwitchedOff(oven)
                cond IsSwitchedOff(microwave)
                act PickUpChickenLeg(chickenleg)
