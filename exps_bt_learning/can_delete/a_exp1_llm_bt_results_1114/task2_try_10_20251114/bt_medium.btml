selector
    sequence
        cond On(b,c)
        cond On(a,b)
    sequence
        cond On(a,b)
        selector
            sequence
                cond Holding(b)
                act Drop(b,c)
            sequence
                cond IsHandEmpty()
                cond On(b,table)
                act PickUp(b)
    sequence
        cond On(b,table)
        selector
            sequence
                cond Holding(a)
                act Drop(a,b)
            sequence
                cond On(a,table)
                cond IsHandEmpty()
                act PickUp(a)
