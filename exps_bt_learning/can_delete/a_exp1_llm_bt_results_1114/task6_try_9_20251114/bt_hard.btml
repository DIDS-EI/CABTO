selector
    sequence
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond In(apple,fridge)
    sequence
        cond IsClosed(fridge)
        selector
            sequence
                cond In(apple,fridge)
                selector
                    sequence
                        cond IsClosed(cabinet)
                        selector
                            sequence
                                cond Holding(pen)
                                act PutInCabinet(pen)
                            sequence
                                cond On(pen,table)
                                cond IsHandEmpty()
                                act PickUp(pen)
                    sequence
                        cond IsHandEmpty()
                        cond On(pen,table)
                        cond IsContainerEmpty(cabinet)
                        act CloseCabinet()
            sequence
                cond Holding(apple)
                cond IsHandEmpty()
                cond On(pen,table)
                cond IsContainerEmpty(cabinet)
                act PutInFridge(apple)
    sequence
        cond IsContainerEmpty(cabinet)
        cond IsContainerEmpty(fridge)
        cond On(pen,table)
        cond IsHandEmpty()
        cond Holding(apple)
        act CloseFridge()
