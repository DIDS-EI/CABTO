selector
    sequence
        cond IsHandEmpty(right_franka)
        cond IsHalfFull(right_cup)
        cond On(left_milk,left_table)
        cond IsHandEmpty(left_franka)
        cond On(right_milk,right_table)
        cond IsHalfFull(left_cup)
    sequence
        cond On(right_milk,right_table)
        cond Holding(right_franka,right_cup)
        cond On(left_milk,left_table)
        selector
            sequence
                cond IsHalfFull(left_cup)
                selector
                    sequence
                        cond IsHandEmpty(left_franka)
                        selector
                            sequence
                                cond IsHalfFull(right_cup)
                                act PutDownRightFranka(right_cup)
                            sequence
                                cond On(right_cup,right_table)
                                act AdjustRightCup(right_cup)
                    sequence
                        cond On(right_cup,right_table)
                        cond Holding(left_franka,left_cup)
                        act PutDownLeftFranka(left_cup)
            sequence
                cond On(left_cup,left_table)
                cond On(right_cup,right_table)
                cond Holding(left_franka,left_cup)
                act AdjustLeftCup(left_cup)
