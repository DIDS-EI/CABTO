selector
    sequence
        cond On(center_big_box,box_board)
        cond On(left_lego,center_big_box)
        cond On(right_lego,center_big_box)
    sequence
        cond On(center_big_box,box_board)
        cond Holding(right_lego,left_franka)
        cond BigBoxNeedTwoFranka()
        selector
            sequence
                cond On(right_franka,box_board)
                selector
                    sequence
                        cond On(left_franka,box_board)
                        selector
                            sequence
                                cond On(left_lego,center_big_box)
                                act PutLegoOnBox(right_lego,center_big_box)
                            sequence
                                cond Holding(left_lego,left_franka)
                                act PutLegoOnBox(left_lego,center_big_box)
                    sequence
                        cond On(left_franka,left_table)
                        cond Holding(left_lego,left_franka)
                        cond LeftFrankaCanOnlyDoLeftAction()
                        cond IsHandEmpty(left_franka)
                        act MoveLeftFranka(box_board)
            sequence
                cond IsHandEmpty(right_franka)
                cond Holding(left_lego,left_franka)
                cond On(right_franka,right_table)
                cond On(left_franka,left_table)
                cond IsHandEmpty(left_franka)
                cond RightFrankaCanOnlyDoRightAction()
                cond LeftFrankaCanOnlyDoLeftAction()
                act MoveRightFranka(box_board)
