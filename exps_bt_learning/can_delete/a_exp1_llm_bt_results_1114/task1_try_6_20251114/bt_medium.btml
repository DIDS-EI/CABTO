selector
    sequence
        cond On(b,place_b)
        cond On(a,place_a)
    sequence
        cond IsEmpty(place_a)
        selector
            selector
                sequence
                    cond On(b,place_b)
                    selector
                        sequence
                            cond Holding(a)
                            act Drop(a,place_a)
                        sequence
                            cond On(a,table)
                            cond IsHandEmpty()
                            act PickUp(a)
                sequence
                    cond IsEmpty(place_b)
                    cond On(a,table)
                    cond Holding(b)
                    act Drop(b,place_b)
            sequence
                cond IsEmpty(place_b)
                cond On(a,table)
                cond On(b,table)
                cond IsHandEmpty()
                act PickUp(b)
