selector
    sequence
        cond In(pen,cabinet)
        cond In(apple,fridge)
    sequence
        cond Holding(apple)
        selector
            sequence
                cond In(pen,cabinet)
                selector
                    sequence
                        cond IsClosed(fridge)
                        act DropToFridge(apple)
                    sequence
                        cond IsClosed(fridge)==False
                        act CloseFridge()
            sequence
                cond IsClosed(cabinet)
                cond Holding(pen)
                cond IsClosed(fridge)==False
                act DropToCabinet(pen)
    sequence
        cond On(apple,table)
        cond Holding(pen)
        cond IsHandEmpty()
        cond IsClosed(fridge)==False
        selector
            sequence
                cond IsClosed(cabinet)
                act PickUp(apple)
            sequence
                cond IsClosed(cabinet)==False
                act CloseCabinet()
