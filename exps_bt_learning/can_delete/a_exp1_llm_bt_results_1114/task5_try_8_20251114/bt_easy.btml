selector
    sequence
        cond IsHalfFull(right_cup)
        cond IsHolding(right_franka,right_cup)
    sequence
        cond CanGrasp(right_franka,right_cup)
        selector
            sequence
                cond On(right_cup,right_table)
                selector
                    sequence
                        cond IsHandEmpty(right_franka)
                        selector
                            sequence
                                cond IsHalfFull(right_cup)
                                act PickUpRightCup(right_cup)
                            sequence
                                cond IsFull(right_milk)
                                cond CanGrasp(right_franka,right_milk)
                                act FillCup(right_cup)
                    sequence
                        cond IsFull(right_milk)
                        cond CanGrasp(right_franka,right_milk)
                        cond IsHolding(right_franka,left_cup)
                        act DropCup(left_cup,left_table)
            sequence
                cond IsFull(right_milk)
                cond IsHolding(right_franka,right_cup)
                cond CanGrasp(right_franka,right_milk)
                cond IsHolding(right_franka,left_cup)
                act DropCup(right_cup,right_table)
