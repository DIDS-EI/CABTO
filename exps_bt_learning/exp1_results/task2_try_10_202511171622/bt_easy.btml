selector
    cond On(a,b)
    sequence
        cond Holding(a)
        selector
            sequence
                cond Clear(b)
                act PutOn(a,b)
            sequence
                cond Clear(table)
                cond Holding(b)
                act PutOn(b,table)
    sequence
        cond Clear(a)
        cond On(a,table)
        cond Holding(b)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(a)
            sequence
                cond Holding(d)
                cond Clear(b)
                act PutOn(d,b)
