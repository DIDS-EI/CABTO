selector
    sequence
        cond On(b,a)
        cond On(c,b)
    sequence
        cond On(b,a)
        cond Clear(b)
        selector
            selector
                sequence
                    cond Holding(c)
                    act PutOn(c,b)
                sequence
                    cond IsHandEmpty()
                    cond Clear(c)
                    cond On(c,table)
                    act PickUp(c)
            sequence
                cond Clear(table)
                cond On(c,table)
                cond Clear(c)
                cond Holding(d)
                act PutOn(d,table)
    sequence
        cond Holding(d)
        cond Clear(c)
        cond On(c,table)
        selector
            sequence
                cond Clear(a)
                selector
                    sequence
                        cond Clear(table)
                        cond Holding(b)
                        act PutOn(b,a)
                    sequence
                        cond IsHandEmpty()
                        cond On(b,table)
                        cond Clear(b)
                        act PickUp(b)
            sequence
                cond On(b,table)
                cond Clear(table)
                cond Holding(a)
                cond Clear(b)
                act PutOn(a,table)
