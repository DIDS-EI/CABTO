selector
    sequence
        cond In(pie,oven)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    sequence
                        cond In(chickenleg,oven)
                        selector
                            sequence
                                cond Holding(pie)
                                act DropInOven(pie)
                            sequence
                                cond IsHandEmpty()
                                cond On(pie,table)
                                act PickUp(pie)
                    sequence
                        cond On(pie,table)
                        cond Holding(chickenleg)
                        act DropInOven(chickenleg)
            sequence
                cond On(pie,table)
                cond IsSwitchedOff(oven)
                cond Holding(chickenleg)
                act SwitchOn(oven)
    sequence
        cond IsSwitchedOff(oven)
        cond On(pie,table)
        cond IsClosed(oven)
        selector
            sequence
                cond Holding(chickenleg)
                act Open(oven)
            sequence
                cond IsHandEmpty()
                cond On(chickenleg,table)
                act PickUp(chickenleg)
