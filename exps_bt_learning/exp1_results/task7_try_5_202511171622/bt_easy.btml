selector
    sequence
        cond In(pie,oven)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                sequence
                    cond In(pie,oven)
                    selector
                        sequence
                            cond IsSwitchedOn(oven)
                            selector
                                sequence
                                    cond Holding(chickenleg)
                                    act PutIn(chickenleg,oven)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(chickenleg,table)
                                    act PickUp(chickenleg)
                        sequence
                            cond IsHandEmpty()
                            cond On(chickenleg,table)
                            cond IsSwitchedOff(oven)
                            act SwitchOn(oven)
                sequence
                    cond On(chickenleg,table)
                    cond Holding(pie)
                    cond IsSwitchedOff(oven)
                    act PutIn(pie,oven)
            sequence
                cond IsHandEmpty()
                cond On(chickenleg,table)
                cond On(pie,table)
                cond IsSwitchedOff(oven)
                act PickUp(pie)
    sequence
        cond IsHandEmpty()
        cond On(pie,table)
        cond IsClosed(oven)
        cond On(chickenleg,table)
        cond IsSwitchedOff(oven)
        act Open(oven)
