selector
    sequence
        cond IsClosed(fridge)
        cond In(banana,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond In(banana,fridge)
                act Close(fridge)
            sequence
                cond Holding(banana)
                act PlaceInFridge(banana)
    sequence
        cond IsClosed(fridge)
        selector
            sequence
                cond Holding(banana)
                act Open(fridge)
            sequence
                cond On(banana,table)
                cond IsHandEmpty()
                act PickUp(banana)
