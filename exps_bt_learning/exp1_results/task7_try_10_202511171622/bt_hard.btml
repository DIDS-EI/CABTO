selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsSwitchedOff(light)
        cond On(pie,breakfast_table)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond IsSwitchedOn(radio)
                        selector
                            sequence
                                cond IsOpened(microwave)
                                act SwitchOn(light)
                            sequence
                                cond IsClosed(microwave)
                                act Open(microwave)
                    sequence
                        cond IsClosed(microwave)
                        cond IsSwitchedOff(radio)
                        act SwitchOn(radio)
            sequence
                cond IsClosed(microwave)
                cond IsSwitchedOff(radio)
                cond IsClosed(oven)
                act Open(oven)
