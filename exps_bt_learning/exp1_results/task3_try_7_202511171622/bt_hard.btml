selector
    cond On(center_big_box,box_board)
    sequence
        cond On(box_board,center_table)
        cond On(center_big_box,center_table)
        selector
            selector
                selector
                    selector
                        selector
                            sequence
                                cond In(right_lego,center_big_box)
                                selector
                                    sequence
                                        cond In(left_lego,center_big_box)
                                        act PutOnBoxBoard(center_big_box)
                                    sequence
                                        cond On(left_franka,center_table)
                                        cond Holding(left_franka,left_lego)
                                        act PutInCenterBigBoxLeftFranka(left_lego)
                            sequence
                                cond On(right_franka,center_table)
                                cond Holding(right_franka,right_lego)
                                cond On(left_franka,center_table)
                                cond Holding(left_franka,left_lego)
                                act PutInCenterBigBoxRightFranka(right_lego)
                        sequence
                            cond Holding(right_franka,right_lego)
                            cond On(left_franka,center_table)
                            cond Holding(left_franka,left_lego)
                            cond On(right_franka,right_table)
                            act MoveToCenterTableRightFranka()
                    sequence
                        cond Holding(right_franka,right_lego)
                        cond On(left_franka,left_table)
                        cond Holding(left_franka,left_lego)
                        cond On(right_franka,right_table)
                        act MoveToCenterTableLeftFranka()
                sequence
                    cond IsHandEmpty(right_franka)
                    cond Holding(left_franka,left_lego)
                    cond On(right_franka,right_table)
                    cond On(right_lego,right_table)
                    cond On(left_franka,left_table)
                    act PickUpRightFranka(right_lego)
            sequence
                cond On(left_lego,left_table)
                cond IsHandEmpty(left_franka)
                cond IsHandEmpty(right_franka)
                cond On(right_franka,right_table)
                cond On(right_lego,right_table)
                cond On(left_franka,left_table)
                act PickUpLeftFranka(left_lego)
