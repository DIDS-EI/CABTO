selector
    sequence
        cond In(pie,oven)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        cond IsSwitchedOn(oven)
        selector
            selector
                selector
                    sequence
                        cond In(chickenleg,oven)
                        selector
                            sequence
                                cond Holding(pie)
                                act PutInOven(pie)
                            sequence
                                cond IsHandEmpty()
                                cond On(pie,table)
                                act PickUp(pie)
                    sequence
                        cond On(pie,table)
                        cond Holding(chickenleg)
                        act PutInOven(chickenleg)
                sequence
                    cond IsHandEmpty()
                    cond On(chickenleg,table)
                    cond On(pie,table)
                    act PickUp(chickenleg)
            sequence
                cond Holding(soup)
                cond On(chickenleg,table)
                cond On(pie,table)
                cond IsOpened(microwave)
                act PutInMicrowave(soup)
