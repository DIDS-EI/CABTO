selector
    sequence
        cond On(a,c)
        cond On(b,d)
        cond On(c,b)
    sequence
        cond On(b,d)
        selector
            selector
                sequence
                    cond On(c,b)
                    selector
                        sequence
                            cond Holding(a)
                            act PutDown(a,c)
                        sequence
                            cond IsHandEmpty()
                            cond On(a,table)
                            act PickUp(a)
                sequence
                    cond Holding(c)
                    cond On(a,table)
                    act PutDown(c,b)
            sequence
                cond On(a,table)
                cond IsHandEmpty()
                cond On(c,table)
                act PickUp(c)
    sequence
        cond On(a,table)
        cond On(c,table)
        selector
            sequence
                cond Holding(b)
                act PutDown(b,d)
            sequence
                cond IsHandEmpty()
                cond On(b,table)
                act PickUp(b)
