selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsOpened(microwave)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    sequence
                        cond Holding(soup)
                        act PutIn(soup,microwave)
                    sequence
                        cond On(soup,table)
                        cond IsHandEmpty()
                        act PickUp(soup)
            sequence
                cond On(soup,table)
                cond IsSwitchedOff(microwave)
                cond IsHandEmpty()
                act SwitchOn(microwave)
    sequence
        cond IsClosed(microwave)
        cond On(soup,table)
        cond IsSwitchedOff(microwave)
        cond IsHandEmpty()
        act Open(microwave)
