selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond Holding(soup)
                act Drop(soup,microwave)
            sequence
                cond On(soup,table)
                cond IsHandEmpty()
                act PickUp(soup)
    sequence
        cond IsSwitchedOff(microwave)
        cond IsHandEmpty()
        cond On(soup,table)
        act SwitchOnDevice(microwave)
