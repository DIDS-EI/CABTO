selector
    sequence
        cond In(pie,oven)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond Holding(pie)
        selector
            selector
                sequence
                    cond IsSwitchedOn(oven)
                    selector
                        sequence
                            cond In(chickenleg,oven)
                            act Drop(pie,oven)
                        sequence
                            cond Holding(chickenleg)
                            act Drop(chickenleg,oven)
                sequence
                    cond IsSwitchedOff(oven)
                    cond Holding(chickenleg)
                    act SwitchOnDevice(oven)
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond IsSwitchedOff(oven)
                act PickUp(chickenleg)
