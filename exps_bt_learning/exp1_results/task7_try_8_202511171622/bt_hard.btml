selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            sequence
                                cond IsOpened(microwave)
                                selector
                                    sequence
                                        cond IsSwitchedOn(radio)
                                        act PutOn(pie,breakfast_table)
                                    sequence
                                        cond IsSwitchedOff(radio)
                                        act SwitchOn(radio)
                            sequence
                                cond IsClosed(microwave)
                                cond IsSwitchedOff(radio)
                                act Open(microwave)
                    sequence
                        cond IsClosed(microwave)
                        cond IsSwitchedOff(radio)
                        cond IsClosed(oven)
                        act Open(oven)
            sequence
                cond IsSwitchedOff(light)
                cond IsClosed(microwave)
                cond IsSwitchedOff(radio)
                cond IsClosed(oven)
                act SwitchOn(light)
    sequence
        cond On(pie,table)
        cond IsSwitchedOff(light)
        cond IsClosed(microwave)
        cond IsSwitchedOff(radio)
        cond IsClosed(oven)
        cond IsHandEmpty()
        act PickUp(pie)
