selector
    cond On(center_big_box,box_board)
    sequence
        cond HeldBy(left_franka,right_franka,center_big_box)
        act TwoFrankaPutDownBigBox(center_big_box,box_board)
    sequence
        cond IsHandEmpty(left_franka)
        cond BigBoxNeedTwoFrankaHoldTogether()
        cond IsHandEmpty(right_franka)
        cond On(center_big_box,center_table)
        act TwoFrankaPickUpBigBox(center_big_box)
