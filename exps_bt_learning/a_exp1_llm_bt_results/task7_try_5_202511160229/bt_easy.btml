selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
        cond In(chickenleg,oven)
    sequence
        cond IsHandEmpty()
        cond On(pie,table)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond In(chickenleg,oven)
                        selector
                            sequence
                                cond IsSwitchedOn(oven)
                                act PutInOven(pie)
                            sequence
                                cond IsSwitchedOff(oven)
                                act SwitchOnOven()
                    sequence
                        cond IsSwitchedOff(oven)
                        cond On(chickenleg,table)
                        act PutInOven(chickenleg)
            sequence
                cond IsSwitchedOff(oven)
                cond On(chickenleg,table)
                cond IsClosed(oven)
                act OpenOven()
