selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsSwitchedOff(radio)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    sequence
                        cond IsSwitchedOn(light)
                        selector
                            sequence
                                cond IsOpened(oven)
                                selector
                                    selector
                                        sequence
                                            cond On(pie,breakfast_table)
                                            act SwitchOnRadio()
                                        sequence
                                            cond Holding(pie)
                                            act PutDown(pie,breakfast_table)
                                    sequence
                                        cond IsHandEmpty()
                                        cond On(pie,table)
                                        act PickUp(pie)
                            sequence
                                cond IsHandEmpty()
                                cond On(pie,table)
                                cond IsClosed(oven)
                                act OpenOven()
                    sequence
                        cond IsSwitchedOff(light)
                        cond IsHandEmpty()
                        cond On(pie,table)
                        cond IsClosed(oven)
                        act SwitchOnLight()
            sequence
                cond On(pie,table)
                cond IsClosed(microwave)
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                cond IsHandEmpty()
                act OpenMicrowave()
