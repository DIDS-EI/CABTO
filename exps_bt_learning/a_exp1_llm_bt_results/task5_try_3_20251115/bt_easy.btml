selector
    cond IsFull(right_cup)
    sequence
        cond Holding(right_franka,right_milk)
        cond IsFull(right_milk)
        selector
            selector
                sequence
                    cond IsEmpty(right_cup)
                    act PourMilkToRightCup(right_milk,right_cup)
                sequence
                    cond CanGrasp(right_franka,right_cup)
                    cond On(right_cup,right_table)
                    cond IsHandEmpty(right_franka)
                    act PickRightCup(right_cup)
            sequence
                cond CanGrasp(right_franka,right_cup)
                cond Holding(right_franka,right_cup)
                cond IsHandEmpty(right_franka)
                act PutCupOnTable(right_cup)
