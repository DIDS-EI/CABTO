selector
    sequence
        cond In(banana,fridge)
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
    sequence
        cond In(banana,fridge)
        selector
            sequence
                cond IsOpened(cabinet)
                selector
                    selector
                        sequence
                            cond In(pen,cabinet)
                            selector
                                sequence
                                    cond IsClosed(fridge)
                                    act CloseCabinet()
                                sequence
                                    cond IsOpened(fridge)
                                    act CloseFridge()
                        sequence
                            cond Holding(pen)
                            cond IsOpened(fridge)
                            act PutInCabinet(pen)
                    sequence
                        cond IsOpened(fridge)
                        cond IsHandEmpty()
                        cond On(pen,table)
                        act PickUp(pen)
            sequence
                cond IsOpened(fridge)
                cond IsHandEmpty()
                cond IsClosed(cabinet)
                cond On(pen,table)
                act OpenCabinet()
    sequence
        cond IsClosed(cabinet)
        cond On(pen,table)
        selector
            sequence
                cond IsOpened(fridge)
                selector
                    sequence
                        cond Holding(banana)
                        act PutInFridge(banana)
                    sequence
                        cond On(banana,table)
                        cond IsHandEmpty()
                        act PickUp(banana)
            sequence
                cond On(banana,table)
                cond IsHandEmpty()
                cond IsClosed(fridge)
                act OpenFridge()
