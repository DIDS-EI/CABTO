selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                selector
                    sequence
                        cond In(soup,microwave)
                        act SwitchOn(microwave)
                    sequence
                        cond Holding(soup)
                        cond IsOpened(microwave)
                        act PlaceInMicrowave(soup)
                sequence
                    cond IsHandEmpty()
                    cond On(soup,table)
                    cond IsOpened(microwave)
                    act PickUp(soup)
            sequence
                cond IsHandEmpty()
                cond On(soup,table)
                cond IsClosed(microwave)
                act OpenAppliance(microwave)
