selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond In(pie,oven)
                selector
                    sequence
                        cond IsSwitchedOn(oven)
                        selector
                            sequence
                                cond Holding(chickenleg)
                                act DropInOven(chickenleg)
                            sequence
                                cond IsHandEmpty()
                                cond On(chickenleg,table)
                                act PickUp(chickenleg)
                    sequence
                        cond IsSwitchedOff(oven)
                        cond On(chickenleg,table)
                        cond IsHandEmpty()
                        act SwitchOnOven()
            sequence
                cond IsSwitchedOff(oven)
                cond On(chickenleg,table)
                cond Holding(pie)
                act DropInOven(pie)
    sequence
        cond IsSwitchedOff(oven)
        cond On(chickenleg,table)
        cond IsClosed(oven)
        selector
            sequence
                cond Holding(pie)
                act OpenOven()
            sequence
                cond On(pie,table)
                cond IsHandEmpty()
                act PickUp(pie)
