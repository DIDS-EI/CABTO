selector
    sequence
        cond On(book,breakfast_table)
        cond On(cake,breakfast_table)
    sequence
        cond On(book,breakfast_table)
        selector
            selector
                selector
                    selector
                        sequence
                            cond Holding(cake)
                            act PutOn(cake,breakfast_table)
                        sequence
                            cond IsHandEmpty()
                            cond In(cake,fridge)
                            cond IsOpened(fridge)
                            act PickUpFromContainer(cake,fridge)
                    sequence
                        cond IsOpened(fridge)
                        cond IsOpened(cabinet)
                        cond In(cake,fridge)
                        cond Holding(pen)
                        act PutIn(pen,cabinet)
                sequence
                    cond IsClosed(fridge)
                    cond IsOpened(cabinet)
                    cond In(cake,fridge)
                    cond Holding(pen)
                    act OpenContainer(fridge)
            sequence
                cond IsClosed(fridge)
                cond Holding(pen)
                cond In(cake,fridge)
                cond IsClosed(cabinet)
                act OpenContainer(cabinet)
