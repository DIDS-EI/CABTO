selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsOpened(microwave)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsSwitchedOn(radio)
                        selector
                            sequence
                                cond Holding(pie)
                                selector
                                    sequence
                                        cond IsOpened(oven)
                                        act PutOnTable(pie,breakfast_table)
                                    sequence
                                        cond IsClosed(oven)
                                        act Open(oven)
                            sequence
                                cond IsHandEmpty()
                                cond On(pie,table)
                                cond IsClosed(oven)
                                act PickUp(pie)
                    sequence
                        cond IsSwitchedOff(radio)
                        cond On(pie,table)
                        cond IsHandEmpty()
                        cond IsClosed(oven)
                        act SwitchOn(radio)
            sequence
                cond IsSwitchedOff(radio)
                cond On(pie,table)
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                cond IsHandEmpty()
                act SwitchOn(light)
    sequence
        cond IsSwitchedOff(radio)
        cond On(pie,table)
        cond IsClosed(microwave)
        cond IsSwitchedOff(light)
        cond IsClosed(oven)
        cond IsHandEmpty()
        act Open(microwave)
