selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
    sequence
        cond IsSwitchedOn(radio)
        selector
            selector
                sequence
                    cond IsSwitchedOn(light)
                    selector
                        sequence
                            cond IsOpened(oven)
                            selector
                                sequence
                                    cond IsOpened(microwave)
                                    selector
                                        sequence
                                            cond Holding(robot,pie)
                                            act PutDownOnBreakfastTable(pie)
                                        sequence
                                            cond IsHandEmpty(robot)
                                            cond In(pie,oven)
                                            act TakeOutFromOven(pie)
                                sequence
                                    cond IsClosed(microwave)
                                    cond IsHandEmpty(robot)
                                    cond In(pie,oven)
                                    act OpenMicrowave()
                        sequence
                            cond IsClosed(microwave)
                            cond IsHandEmpty(robot)
                            cond In(pie,oven)
                            cond IsClosed(oven)
                            act OpenOven()
                sequence
                    cond IsClosed(oven)
                    cond IsSwitchedOff(light)
                    cond IsClosed(microwave)
                    cond IsHandEmpty(robot)
                    cond In(pie,oven)
                    act SwitchOnLight()
            sequence
                cond IsClosed(oven)
                cond IsSwitchedOff(light)
                cond IsClosed(microwave)
                cond Holding(robot,soup)
                cond In(pie,oven)
                act PutDownOnTable(soup)
    sequence
        cond IsClosed(oven)
        cond IsSwitchedOff(light)
        cond Holding(robot,soup)
        cond IsClosed(microwave)
        cond In(pie,oven)
        cond IsSwitchedOff(radio)
        act SwitchOnRadio()
