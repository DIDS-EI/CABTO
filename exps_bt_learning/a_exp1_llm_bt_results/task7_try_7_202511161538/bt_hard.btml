selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    sequence
                        cond IsSwitchedOn(radio)
                        selector
                            sequence
                                cond IsSwitchedOn(light)
                                selector
                                    sequence
                                        cond IsOpened(oven)
                                        act PutOnTable(pie)
                                    sequence
                                        cond IsClosed(oven)
                                        act OpenOven()
                            sequence
                                cond IsSwitchedOff(light)
                                cond IsClosed(oven)
                                act SwitchOnLight()
                    sequence
                        cond IsSwitchedOff(light)
                        cond IsSwitchedOff(radio)
                        cond IsClosed(oven)
                        act SwitchOnRadio()
            sequence
                cond IsSwitchedOff(light)
                cond IsClosed(microwave)
                cond IsSwitchedOff(radio)
                cond IsClosed(oven)
                act OpenMicrowave()
    sequence
        cond IsClosed(oven)
        cond IsSwitchedOff(light)
        cond IsClosed(microwave)
        cond On(pie,table)
        cond IsHandEmpty()
        cond IsSwitchedOff(radio)
        act PickUp(pie)
