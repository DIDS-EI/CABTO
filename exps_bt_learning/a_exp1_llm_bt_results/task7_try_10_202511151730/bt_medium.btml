selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond Holding(soup)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PutInMicrowave(soup)
                    sequence
                        cond IsNoIsClosedIn(microwave)
                        act OpenMicrowave()
            sequence
                cond On(soup,table)
                cond IsHandEmpty()
                cond IsNoIsClosedIn(microwave)
                act PickUp(soup)
    sequence
        cond On(soup,table)
        cond IsSwitchedOff(microwave)
        cond IsHandEmpty()
        cond IsNoIsClosedIn(microwave)
        act SwitchOnMicrowave()
