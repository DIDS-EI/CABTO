selector
    cond In(wine,fridge)
    sequence
        cond Holding(wine)
        selector
            sequence
                cond IsOpen(fridge)
                act PutIn(wine,fridge)
            sequence
                cond IsClosed(fridge)
                act Open(fridge)
    sequence
        cond IsClosed(fridge)
        cond On(wine,table)|On(wine,breakfast_table)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    act PickUp(wine)
                sequence
                    cond IsOpen(cabinet)
                    cond Holding(pen)
                    act PutIn(pen,cabinet)
            sequence
                cond IsClosed(cabinet)
                cond Holding(pen)
                act Open(cabinet)
