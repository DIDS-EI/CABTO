selector
    sequence
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond In(banana,fridge)
        cond In(apple,cabinet)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond In(banana,fridge)
                selector
                    selector
                        selector
                            sequence
                                cond In(apple,cabinet)
                                selector
                                    sequence
                                        cond IsClosed(cabinet)
                                        act Close(fridge)
                                    sequence
                                        cond IsOpened(cabinet)
                                        act Close(cabinet)
                            sequence
                                cond IsOpened(cabinet)
                                cond Holding(apple)
                                act PlaceIn(apple,cabinet)
                        sequence
                            cond IsOpened(cabinet)
                            cond On(apple,table)
                            cond IsHandEmpty()
                            act PickUp(apple)
                    sequence
                        cond IsClosed(cabinet)
                        cond On(apple,table)
                        cond IsHandEmpty()
                        act Open(cabinet)
            sequence
                cond IsClosed(cabinet)
                cond Holding(banana)
                cond On(apple,table)
                act PlaceIn(banana,fridge)
    sequence
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond On(apple,table)
        selector
            sequence
                cond Holding(banana)
                act Open(fridge)
            sequence
                cond On(banana,table)
                cond IsHandEmpty()
                act PickUp(banana)
