selector
    sequence
        cond On(b,place_b)
        cond On(c,place_c)
    sequence
        cond IsEmpty(place_c)
        selector
            selector
                sequence
                    cond On(b,place_b)
                    selector
                        sequence
                            cond Holding(c)
                            act DropC(c)
                        sequence
                            cond On(c,table)
                            cond IsHandEmpty()
                            act PickUpC(c)
                sequence
                    cond IsEmpty(place_b)
                    cond On(c,table)
                    cond Holding(b)
                    act DropB(b)
            sequence
                cond On(b,table)
                cond IsEmpty(place_b)
                cond IsHandEmpty()
                cond On(c,table)
                act PickUpB(b)
