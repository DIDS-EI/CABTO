selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(book,cabinet)
        cond In(apple,fridge)
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
    sequence
        cond IsOpen(cabinet)
        selector
            selector
                selector
                    sequence
                        cond In(banana,fridge)
                        selector
                            sequence
                                cond In(pen,cabinet)
                                selector
                                    sequence
                                        cond In(book,cabinet)
                                        selector
                                            sequence
                                                cond In(apple,fridge)
                                                selector
                                                    sequence
                                                        cond IsClosed(fridge)
                                                        act Close(cabinet)
                                                    sequence
                                                        cond IsOpen(fridge)
                                                        act Close(fridge)
                                            sequence
                                                cond IsOpen(fridge)
                                                cond Holding(apple)
                                                act PlaceIn(apple,fridge)
                                    sequence
                                        cond IsOpen(fridge)
                                        cond Holding(book)
                                        cond Holding(apple)
                                        act PlaceIn(book,cabinet)
                            sequence
                                cond IsOpen(fridge)
                                cond Holding(pen)
                                cond Holding(book)
                                cond Holding(apple)
                                act PlaceIn(pen,cabinet)
                    sequence
                        cond Holding(book)
                        cond Holding(banana)
                        cond Holding(apple)
                        cond IsOpen(fridge)
                        cond Holding(pen)
                        act PlaceIn(banana,fridge)
                sequence
                    cond On(pen,table)
                    cond Holding(book)
                    cond Holding(banana)
                    cond Holding(apple)
                    cond IsOpen(fridge)
                    cond IsHandEmpty()
                    act PickUp(pen)
            sequence
                cond On(pen,table)
                cond Holding(book)
                cond Holding(banana)
                cond Holding(apple)
                cond IsClosed(fridge)
                cond IsHandEmpty()
                act Open(fridge)
