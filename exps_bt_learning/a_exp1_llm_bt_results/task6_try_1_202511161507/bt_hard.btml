selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond In(banana,fridge)
                act Close(fridge)
            sequence
                cond Holding(banana)
                act PutIn(banana,fridge)
    sequence
        cond IsClosed(fridge)
        selector
            selector
                selector
                    sequence
                        cond Holding(banana)
                        act Open(fridge)
                    sequence
                        cond On(banana,breakfast_table)
                        cond IsHandEmpty()
                        cond On(banana,table)
                        act PickUp(banana)
                sequence
                    cond Holding(book)
                    cond On(banana,breakfast_table)
                    cond On(banana,table)
                    cond IsOpened(cabinet)
                    act PutIn(book,cabinet)
            sequence
                cond Holding(book)
                cond IsClosed(cabinet)
                cond On(banana,breakfast_table)
                cond On(banana,table)
                act Open(cabinet)
