selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsOpened(microwave)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond IsSwitchedOn(light)
                        selector
                            sequence
                                cond IsSwitchedOn(radio)
                                selector
                                    sequence
                                        cond Holding(pie)
                                        act Drop(pie,breakfast_table)
                                    sequence
                                        cond IsHandEmpty()
                                        cond On(pie,table)
                                        act PickUp(pie)
                            sequence
                                cond IsHandEmpty()
                                cond On(pie,table)
                                cond IsSwitchedOff(radio)
                                act SwitchOnDevice(radio)
                    sequence
                        cond IsSwitchedOff(light)
                        cond IsHandEmpty()
                        cond On(pie,table)
                        cond IsSwitchedOff(radio)
                        act SwitchOnDevice(light)
            sequence
                cond On(pie,table)
                cond IsSwitchedOff(light)
                cond IsSwitchedOff(radio)
                cond IsClosed(oven)
                cond IsHandEmpty()
                act OpenDevice(oven)
    sequence
        cond On(pie,table)
        cond IsClosed(microwave)
        cond IsSwitchedOff(light)
        cond IsSwitchedOff(radio)
        cond IsClosed(oven)
        cond IsHandEmpty()
        act OpenDevice(microwave)
