selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsOpened(microwave)
        cond IsSwitchedOn(microwave)
        selector
            selector
                sequence
                    cond Holding(soup)
                    act PutIn(soup,microwave)
                sequence
                    cond On(soup,table)
                    cond IsHandEmpty()
                    act PickUp(soup,table)
            sequence
                cond On(soup,table)
                cond Holding(chickenleg)
                cond IsOpened(oven)
                act PutIn(chickenleg,oven)
