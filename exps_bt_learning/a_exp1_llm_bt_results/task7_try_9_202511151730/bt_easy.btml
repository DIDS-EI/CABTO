selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        cond IsSwitchedOn(oven)
        selector
            selector
                sequence
                    cond Holding(chickenleg)
                    act PutIn(chickenleg,oven)
                sequence
                    cond On(chickenleg,table)
                    cond IsHandEmpty()
                    act PickUp(chickenleg,table)
            sequence
                cond Holding(soup)
                cond On(chickenleg,table)
                act PutIn(soup,oven)
