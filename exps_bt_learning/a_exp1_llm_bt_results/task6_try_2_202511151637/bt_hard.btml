selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(book,cabinet)
        cond In(apple,fridge)
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
    sequence
        cond IsClosed(cabinet)
        selector
            sequence
                cond In(pen,cabinet)
                selector
                    sequence
                        cond Open(fridge)
                        selector
                            selector
                                sequence
                                    cond In(book,cabinet)
                                    selector
                                        sequence
                                            cond In(apple,fridge)
                                            selector
                                                sequence
                                                    cond In(banana,fridge)
                                                    act CloseFridge()
                                                sequence
                                                    cond Holding(banana)
                                                    act PutInFridge(banana)
                                        sequence
                                            cond Holding(apple)
                                            cond Holding(banana)
                                            act PutInFridge(apple)
                                sequence
                                    cond Open(cabinet)
                                    cond Holding(book)
                                    cond Holding(banana)
                                    cond Holding(apple)
                                    act PutInCabinet(book)
                            sequence
                                cond Holding(book)
                                cond Holding(banana)
                                cond On(apple,table)
                                cond Open(cabinet)
                                cond IsHandEmpty()
                                act PickUp(apple)
                    sequence
                        cond Holding(book)
                        cond Holding(banana)
                        cond IsClosed(fridge)
                        cond On(apple,table)
                        cond Open(cabinet)
                        cond IsHandEmpty()
                        act OpenFridge()
            sequence
                cond Holding(book)
                cond Holding(banana)
                cond IsClosed(fridge)
                cond On(apple,table)
                cond Open(cabinet)
                cond Holding(pen)
                act PutInCabinet(pen)
