selector
    sequence
        cond In(book,fridge)
        cond In(pen,cabinet)
    sequence
        cond In(pen,cabinet)
        selector
            sequence
                cond IsOpened(fridge)
                selector
                    sequence
                        cond Holding(book)
                        act PutIn(book,fridge)
                    sequence
                        cond On(book,table)
                        cond IsHandEmpty()
                        act PickUp(book)
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                cond IsClosed(fridge)
                act Open(fridge)
    sequence
        cond On(book,table)
        cond IsClosed(fridge)
        selector
            sequence
                cond Holding(pen)
                selector
                    sequence
                        cond IsOpened(cabinet)
                        act PutIn(pen,cabinet)
                    sequence
                        cond IsClosed(cabinet)
                        act Open(cabinet)
            sequence
                cond IsClosed(cabinet)
                cond IsHandEmpty()
                cond On(pen,table)
                act PickUp(pen)
