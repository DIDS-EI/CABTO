selector
    sequence
        cond In(banana,fridge)
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond In(pen,cabinet)
                selector
                    selector
                        selector
                            sequence
                                cond In(banana,fridge)
                                selector
                                    sequence
                                        cond IsClosed(fridge)
                                        act Close(cabinet)
                                    sequence
                                        cond IsOpened(fridge)
                                        act Close(fridge)
                            sequence
                                cond IsOpened(fridge)
                                cond Holding(banana)
                                act PutIn(banana,fridge)
                        sequence
                            cond On(banana,table)
                            cond IsOpened(fridge)
                            cond IsHandEmpty()
                            act PickUp(banana)
                    sequence
                        cond On(banana,table)
                        cond IsHandEmpty()
                        cond IsClosed(fridge)
                        act Open(fridge)
            sequence
                cond On(banana,table)
                cond Holding(pen)
                cond IsClosed(fridge)
                act PutIn(pen,cabinet)
    sequence
        cond On(banana,table)
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        selector
            sequence
                cond Holding(pen)
                act Open(cabinet)
            sequence
                cond IsHandEmpty()
                cond On(pen,table)
                act PickUp(pen)
