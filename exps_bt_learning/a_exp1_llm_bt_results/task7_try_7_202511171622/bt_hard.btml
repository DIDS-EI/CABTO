selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsSwitchedOn(light)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        selector
            selector
                sequence
                    cond Holding(pie)
                    act PutOnBreakfastTable(pie)
                sequence
                    cond IsHandEmpty()
                    cond On(pie,table)
                    act PickUp(pie)
            sequence
                cond On(pie,table)
                cond Holding(chickenleg)
                act PutInOven(chickenleg)
