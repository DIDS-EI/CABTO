selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                sequence
                    cond In(pie,oven)
                    selector
                        sequence
                            cond IsSwitchedOn(oven)
                            selector
                                sequence
                                    cond Holding(chickenleg)
                                    act PlaceIn(chickenleg,oven)
                                sequence
                                    cond On(chickenleg,table)
                                    cond IsHandEmpty()
                                    act PickUp(chickenleg,table)
                        sequence
                            cond On(chickenleg,table)
                            cond IsSwitchedOff(oven)
                            cond IsHandEmpty()
                            act SwitchOn(oven)
                sequence
                    cond Holding(pie)
                    cond On(chickenleg,table)
                    cond IsSwitchedOff(oven)
                    act PlaceIn(pie,oven)
            sequence
                cond On(chickenleg,table)
                cond IsSwitchedOff(oven)
                cond On(pie,table)
                cond IsHandEmpty()
                act PickUp(pie,table)
    sequence
        cond On(chickenleg,table)
        cond IsClosed(oven)
        cond IsSwitchedOff(oven)
        cond IsHandEmpty()
        cond On(pie,table)
        act Open(oven)
