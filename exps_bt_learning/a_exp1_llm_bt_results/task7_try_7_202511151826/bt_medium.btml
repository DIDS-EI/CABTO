selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond On(soup,table)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PutInDevice(soup,microwave)
                    sequence
                        cond IsClosed(microwave)
                        act OpenDevice(microwave)
            sequence
                cond IsSwitchedOff(microwave)
                cond IsClosed(microwave)
                act ToggleSwitchOn(microwave)
