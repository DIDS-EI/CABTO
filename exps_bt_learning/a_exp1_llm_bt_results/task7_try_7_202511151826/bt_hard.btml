selector
    sequence
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond IsClosed(microwave)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsOpened(oven)
                        act OpenDevice(microwave)
                    sequence
                        cond IsClosed(oven)
                        act OpenDevice(oven)
            sequence
                cond IsClosed(oven)
                cond IsSwitchedOff(light)
                act ToggleSwitchOn(light)
