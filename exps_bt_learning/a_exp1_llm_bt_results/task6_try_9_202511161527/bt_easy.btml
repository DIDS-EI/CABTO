selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond Holding(robot,book)
        selector
            selector
                sequence
                    cond IsOpened(cabinet)
                    act PutInCabinet(book)
                sequence
                    cond IsHandEmpty(robot)
                    cond IsClosed(cabinet)
                    act OpenCabinet()
            sequence
                cond IsClosed(cabinet)
                cond Holding(robot,banana)
                act PutOn(banana,table)
    sequence
        cond On(book,breakfast_table)
        cond On(book,table)
        cond Holding(robot,banana)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty(robot)
                act PickUp(book)
            sequence
                cond Holding(robot,pen)
                act PutOn(pen,table)
