selector
    cond On(center_big_box,box_board)
    sequence
        cond Holding(right_franka,center_big_box)
        cond Holding(left_franka,center_big_box)
        act PlaceBigBoxOnBoxBoard(center_big_box,box_board)
    sequence
        cond BigBoxNeedTwoFranka()
        cond On(center_big_box,left_table)
        cond On(center_big_box,right_table)
        selector
            sequence
                cond IsHandEmpty(left_franka)
                selector
                    sequence
                        cond IsHandEmpty(right_franka)
                        act PickUpCenterBigBox(center_big_box)
                    sequence
                        cond Holding(right_franka,right_lego)
                        act PlaceLegoOnCenterBigBox(right_lego,center_big_box)
            sequence
                cond Holding(right_franka,right_lego)
                cond Holding(left_franka,left_lego)
                act PlaceLegoOnCenterBigBox(left_lego,center_big_box)
