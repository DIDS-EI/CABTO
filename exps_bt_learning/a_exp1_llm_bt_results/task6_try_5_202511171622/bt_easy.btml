selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond Holding(book)
        selector
            sequence
                cond IsOpened(cabinet)
                act PutInCabinet(book)
            sequence
                cond IsClosed(cabinet)
                act OpenCabinet()
    sequence
        cond IsClosed(cabinet)
        cond On(book,table)
        cond On(book,breakfast_table)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    act PickUp(book)
                sequence
                    cond IsOpened(fridge)
                    cond Holding(banana)
                    act PutInFridge(banana)
            sequence
                cond IsClosed(fridge)
                cond Holding(banana)
                act OpenFridge()
