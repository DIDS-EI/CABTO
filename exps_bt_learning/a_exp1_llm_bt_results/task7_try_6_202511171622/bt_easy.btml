selector
    sequence
        cond In(pie,oven)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsClosed(oven)
        selector
            selector
                sequence
                    cond IsSwitchedOn(oven)
                    selector
                        sequence
                            cond In(pie,oven)
                            selector
                                sequence
                                    cond Holding(chickenleg)
                                    act PutIn(chickenleg,oven)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(chickenleg,table)
                                    act PickUp(chickenleg)
                        sequence
                            cond On(chickenleg,table)
                            cond Holding(pie)
                            act PutIn(pie,oven)
                sequence
                    cond On(chickenleg,table)
                    cond Holding(pie)
                    cond IsSwitchedOff(oven)
                    act SwitchOn(oven)
            sequence
                cond IsHandEmpty()
                cond On(chickenleg,table)
                cond On(pie,table)
                cond IsSwitchedOff(oven)
                act PickUp(pie)
