selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(fridge)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            selector
                sequence
                    cond IsOpened(fridge)
                    selector
                        sequence
                            cond In(book,cabinet)
                            selector
                                sequence
                                    cond Holding(pen)
                                    act PutIn(pen,cabinet)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(pen,table)
                                    act PickUp(pen)
                        sequence
                            cond Holding(book)
                            cond On(pen,table)
                            act PutIn(book,cabinet)
                sequence
                    cond Holding(book)
                    cond IsClosed(fridge)
                    cond On(pen,table)
                    act Open(fridge)
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                cond IsClosed(fridge)
                cond On(pen,table)
                act PickUp(book)
    sequence
        cond On(pen,table)
        cond IsHandEmpty()
        cond On(book,table)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        act Open(cabinet)
