selector
    sequence
        cond On(book,breakfast_table)
        cond On(cake,breakfast_table)
    sequence
        cond On(book,breakfast_table)
        selector
            selector
                sequence
                    cond Holding(cake)
                    act PutOn(cake,breakfast_table)
                sequence
                    cond IsHandEmpty()
                    cond On(cake,breakfast_table)|On(cake,table)
                    act PickUp(cake)
            sequence
                cond Holding(pen)
                cond IsOpened(fridge)
                cond On(cake,breakfast_table)|On(cake,table)
                act PutIn(pen,fridge)
    sequence
        cond Holding(pen)
        cond On(cake,breakfast_table)|On(cake,table)
        selector
            sequence
                cond IsOpened(fridge)
                selector
                    selector
                        sequence
                            cond Holding(book)
                            act PutOn(book,breakfast_table)
                        sequence
                            cond IsHandEmpty()
                            cond On(book,breakfast_table)|On(book,table)
                            act PickUp(book)
                    sequence
                        cond Holding(banana)
                        cond On(book,breakfast_table)|On(book,table)
                        act PutIn(banana,fridge)
            sequence
                cond IsClosed(fridge)
                cond Holding(banana)
                cond On(book,breakfast_table)|On(book,table)
                act OpenContainer(fridge)
