selector
    cond On(center_big_box,box_board)
    sequence
        cond On(right_franka,center_table)
        selector
            selector
                sequence
                    cond On(left_franka,center_table)
                    selector
                        selector
                            sequence
                                cond Holding(two_franka,center_big_box)
                                act PlaceOnBoxBoard(center_big_box)
                            sequence
                                cond On(center_big_box,center_table)
                                cond IsHandEmpty(left_franka)
                                cond BigBoxNeedTwoFranka()
                                cond IsHandEmpty(right_franka)
                                act PickUpCenterBigBox(center_big_box)
                        sequence
                            cond On(center_big_box,center_table)
                            cond Holding(left_franka,left_lego)
                            cond BigBoxNeedTwoFranka()
                            cond IsHandEmpty(right_franka)
                            act PlaceOnCenterWithLeftFranka(left_lego)
                sequence
                    cond On(center_big_box,center_table)
                    cond Holding(left_franka,left_lego)
                    cond IsHandEmpty(right_franka)
                    cond On(left_franka,left_table)
                    cond BigBoxNeedTwoFranka()
                    act MoveLeftFrankaToCenter()
            sequence
                cond Holding(right_franka,right_lego)
                cond Holding(left_franka,left_lego)
                cond On(center_big_box,center_table)
                cond On(left_franka,left_table)
                cond BigBoxNeedTwoFranka()
                act PlaceOnCenterWithRightFranka(right_lego)
    sequence
        cond Holding(right_franka,right_lego)
        cond Holding(left_franka,left_lego)
        cond On(center_big_box,center_table)
        cond On(right_franka,right_table)
        cond On(left_franka,left_table)
        cond BigBoxNeedTwoFranka()
        act MoveRightFrankaToCenter()
