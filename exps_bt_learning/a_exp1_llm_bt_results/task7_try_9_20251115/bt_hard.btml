selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsHandEmpty()
        cond On(soup,table)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                act PutInMicrowave(soup)
            sequence
                cond IsSwitchedOff(microwave)
                act TurnOnMicrowave()
