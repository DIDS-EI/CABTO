selector
    sequence
        cond On(a,c)
        cond On(b,d)
        cond On(c,b)
    sequence
        cond On(b,d)
        selector
            sequence
                cond Holding(a)
                selector
                    sequence
                        cond Clear(c)
                        cond On(c,b)
                        act PutOn(a,c)
                    sequence
                        cond Holding(c)
                        cond Clear(b)
                        act PutOn(c,b)
            sequence
                cond On(a,table)
                cond Clear(a)
                cond Holding(c)
                cond Clear(b)
                cond IsHandEmpty()
                act PickUp(a)
    sequence
        cond On(a,table)
        selector
            sequence
                cond Clear(a)
                selector
                    sequence
                        cond Holding(c)
                        selector
                            sequence
                                cond Clear(d)
                                selector
                                    sequence
                                        cond Holding(b)
                                        act PutOn(b,d)
                                    sequence
                                        cond IsHandEmpty()
                                        cond On(b,table)
                                        cond Clear(b)
                                        act PickUp(b)
                            sequence
                                cond Clear(table)
                                cond On(b,table)
                                cond Holding(d)
                                cond Clear(b)
                                act PutOn(d,table)
                    sequence
                        cond Clear(c)
                        cond On(b,table)
                        cond Holding(d)
                        cond Clear(b)
                        cond IsHandEmpty()
                        cond On(c,table)
                        act PickUp(c)
            sequence
                cond Clear(d)
                cond Holding(a)
                cond Clear(c)
                cond On(b,table)
                cond Holding(d)
                cond Clear(b)
                cond On(c,table)
                act PutOn(a,d)
