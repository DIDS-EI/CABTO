selector
    cond On(a,place_a)
    sequence
        cond IsEmpty(place_a)
        selector
            selector
                sequence
                    cond IsHolding(a)
                    selector
                        sequence
                            cond IsNear(place_a)
                            act Place(a,place_a)
                        act MoveTo(place_a)
                sequence
                    cond On(a,b)
                    cond IsHandEmpty()
                    cond IsNear(a)
                    act Grasp(a,b)
            sequence
                cond On(a,b)
                cond IsHandEmpty()
                act MoveTo(a)
    sequence
        cond On(a,b)
        cond On(place_c,place_a)
        selector
            selector
                selector
                    sequence
                        cond IsNear(place_c)
                        selector
                            sequence
                                cond IsEmpty(c)
                                act MoveObject(place_c,place_a,c)
                            sequence
                                cond On(place_c,c)
                                cond IsHandEmpty()
                                act Grasp(place_c,c)
                    sequence
                        cond On(place_c,c)
                        cond IsHandEmpty()
                        act MoveTo(place_c)
                sequence
                    cond On(place_c,c)
                    cond IsNear(place_b)
                    cond IsEmpty(place_c)
                    cond On(place_b,a)
                    act MoveObject(place_b,a,place_c)
            sequence
                cond On(place_c,c)
                cond IsEmpty(place_c)
                cond On(place_b,a)
                act MoveTo(place_b)
