selector
    sequence
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond IsClosed(microwave)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsOpened(oven)
                        act Open(microwave)
                    sequence
                        cond IsClosed(oven)
                        act Open(oven)
            sequence
                cond IsClosed(oven)
                cond IsSwitchedOff(light)
                act SwitchOn(light)
