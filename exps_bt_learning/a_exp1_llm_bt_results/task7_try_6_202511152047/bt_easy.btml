selector
    sequence
        cond In(chickenleg,oven)
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                sequence
                    cond In(chickenleg,oven)
                    selector
                        sequence
                            cond IsSwitchedOn(oven)
                            selector
                                sequence
                                    cond Holding(pie)
                                    act PlaceIn(pie,oven)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(pie,table)
                                    act PickUp(pie)
                        sequence
                            cond IsSwitchedOff(oven)
                            cond IsHandEmpty()
                            cond On(pie,table)
                            act SwitchOn(oven)
                sequence
                    cond IsSwitchedOff(oven)
                    cond On(pie,table)
                    cond Holding(chickenleg)
                    act PlaceIn(chickenleg,oven)
            sequence
                cond IsSwitchedOff(oven)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond On(pie,table)
                act PickUp(chickenleg)
    sequence
        cond On(pie,table)
        cond On(chickenleg,table)
        cond IsHandEmpty()
        cond IsClosed(oven)
        cond IsSwitchedOff(oven)
        act Open(oven)
