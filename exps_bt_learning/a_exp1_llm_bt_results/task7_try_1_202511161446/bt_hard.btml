selector
    sequence
        cond IsOpened(oven)
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
        cond IsSwitchedOn(radio)
    sequence
        cond IsSwitchedOff(radio)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond IsSwitchedOn(light)
                        selector
                            sequence
                                cond On(pie,breakfast_table)
                                selector
                                    sequence
                                        cond IsOpened(microwave)
                                        act SwitchOn(radio)
                                    sequence
                                        cond IsClosed(microwave)
                                        act Open(microwave)
                            sequence
                                cond IsHandEmpty()
                                cond IsClosed(microwave)
                                cond On(pie,table)
                                act PutAOnB(pie,breakfast_table)
                    sequence
                        cond IsHandEmpty()
                        cond IsClosed(microwave)
                        cond IsSwitchedOff(light)
                        cond On(pie,table)
                        act SwitchOn(light)
            sequence
                cond IsClosed(microwave)
                cond IsSwitchedOff(light)
                cond On(pie,table)
                cond IsHandEmpty()
                cond IsClosed(oven)
                act Open(oven)
