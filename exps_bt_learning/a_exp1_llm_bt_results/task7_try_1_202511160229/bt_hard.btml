selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsSwitchedOn(radio)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            sequence
                                cond IsSwitchedOn(light)
                                selector
                                    selector
                                        sequence
                                            cond Holding(left_franka,pie)
                                            act PutDownLeftFrankaOnBreakfastTable(pie)
                                        sequence
                                            cond In(pie,microwave)
                                            cond IsHandEmpty(left_franka)
                                            act RemoveFromContainerLeftFranka(pie,microwave)
                                    sequence
                                        cond In(pie,microwave)
                                        cond Holding(left_franka,chickenleg)
                                        act PutInContainerLeftFranka(chickenleg,microwave)
                            sequence
                                cond In(pie,microwave)
                                cond IsSwitchedOff(light)
                                cond Holding(left_franka,chickenleg)
                                act SwitchOnDevice(light)
                    sequence
                        cond In(pie,microwave)
                        cond IsSwitchedOff(light)
                        cond Holding(left_franka,chickenleg)
                        cond IsClosed(oven)
                        act OpenContainerLeftFranka(oven)
            sequence
                cond IsClosed(microwave)
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                cond In(pie,microwave)
                cond Holding(left_franka,chickenleg)
                act OpenContainerLeftFranka(microwave)
    sequence
        cond IsSwitchedOff(radio)
        cond IsClosed(microwave)
        cond IsSwitchedOff(light)
        cond IsClosed(oven)
        cond In(pie,microwave)
        cond Holding(left_franka,chickenleg)
        act SwitchOnDevice(radio)
