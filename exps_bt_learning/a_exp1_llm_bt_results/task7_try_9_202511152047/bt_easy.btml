selector
    sequence
        cond In(chickenleg,oven)
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            selector
                sequence
                    cond In(pie,oven)
                    selector
                        sequence
                            cond Holding(chickenleg)
                            act PutInAppliance(chickenleg,oven)
                        sequence
                            cond On(chickenleg,table)
                            cond IsHandEmpty()
                            act PickUp(chickenleg)
                sequence
                    cond On(chickenleg,table)
                    cond Holding(pie)
                    act PutInAppliance(pie,oven)
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond On(pie,table)
                act PickUp(pie)
    sequence
        cond IsHandEmpty()
        cond On(chickenleg,table)
        cond IsSwitchedOff(oven)
        cond On(pie,table)
        act SwitchOn(oven)
