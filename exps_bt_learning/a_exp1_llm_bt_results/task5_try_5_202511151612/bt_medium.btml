selector
    sequence
        cond IsHalfFull(right_cup)
        cond IsHalfFull(left_cup)
    sequence
        cond CupNeedGraspAndSupport()
        cond Holding(left_franka,left_cup)
        selector
            selector
                selector
                    sequence
                        cond IsHalfFull(right_cup)
                        selector
                            selector
                                sequence
                                    cond Holding(right_franka,right_milk)
                                    act TransferMilkRightToLeft(right_milk,left_cup)
                                sequence
                                    cond IsHandEmpty(right_franka)
                                    cond CanGrasp(right_franka,right_milk)
                                    cond On(right_milk,right_table)
                                    act PickUpRightFranka(right_milk)
                            sequence
                                cond On(right_milk,right_table)
                                cond Holding(right_franka,right_cup)
                                cond CanGrasp(right_franka,right_milk)
                                act PutDownRightFranka(right_cup)
                    sequence
                        cond Holding(left_franka,left_milk)
                        cond On(right_milk,right_table)
                        cond Holding(right_franka,right_cup)
                        cond CanGrasp(right_franka,right_milk)
                        act PourMilkIntoCup(left_milk,right_cup)
                sequence
                    cond CanGrasp(right_franka,right_cup)
                    cond IsHandEmpty(right_franka)
                    cond On(right_cup,right_table)
                    cond On(right_milk,right_table)
                    cond CanGrasp(right_franka,right_milk)
                    cond Holding(left_franka,left_milk)
                    act PickUpRightFranka(right_cup)
            sequence
                cond CanGrasp(left_franka,left_milk)
                cond CanGrasp(right_franka,right_cup)
                cond IsHandEmpty(right_franka)
                cond On(right_cup,right_table)
                cond CanGrasp(right_franka,right_milk)
                cond On(right_milk,right_table)
                cond On(left_milk,left_table)
                cond IsHandEmpty(left_franka)
                act PickUpLeftFranka(left_milk)
