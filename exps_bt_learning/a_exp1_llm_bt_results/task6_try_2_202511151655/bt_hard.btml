selector
    sequence
        cond In(banana,fridge)
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
    sequence
        cond In(pen,cabinet)
        selector
            sequence
                cond IsClosed(cabinet)
                selector
                    selector
                        sequence
                            cond IsOpened(fridge)
                            selector
                                sequence
                                    cond In(banana,fridge)
                                    act CloseFridge()
                                sequence
                                    cond Holding(banana)
                                    act DropInFridge(banana)
                        sequence
                            cond IsClosed(fridge)
                            cond Holding(banana)
                            act OpenFridge()
                    sequence
                        cond On(banana,table)
                        cond IsHandEmpty()
                        cond IsClosed(fridge)
                        act PickUp(banana)
            sequence
                cond IsOpened(cabinet)
                cond On(banana,table)
                cond IsHandEmpty()
                cond IsClosed(fridge)
                act CloseCabinet()
    sequence
        cond On(banana,table)
        cond IsClosed(fridge)
        selector
            sequence
                cond Holding(pen)
                selector
                    sequence
                        cond IsOpened(cabinet)
                        act DropInCabinet(pen)
                    sequence
                        cond IsClosed(cabinet)
                        act OpenCabinet()
            sequence
                cond IsClosed(cabinet)
                cond IsHandEmpty()
                cond On(pen,table)
                act PickUp(pen)
