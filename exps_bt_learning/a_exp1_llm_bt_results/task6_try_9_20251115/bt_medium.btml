selector
    sequence
        cond IsClosed(fridge)
        cond In(apple,fridge)
    sequence
        cond IsOpen(fridge)
        selector
            sequence
                cond In(apple,fridge)
                act CloseFridge()
            sequence
                cond Holding(apple)
                act PutAppleInFridge(apple)
    sequence
        cond IsClosed(fridge)
        selector
            sequence
                cond Holding(apple)
                act OpenFridge()
            sequence
                cond On(apple,table)
                cond IsHandEmpty()
                act PickUpApple(apple)
