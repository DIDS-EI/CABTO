selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                selector
                    sequence
                        cond IsSwitchedOn(light)
                        selector
                            sequence
                                cond In(soup,microwave)
                                act SwitchOn(microwave)
                            sequence
                                cond IsOpened(microwave)
                                cond Holding(soup)
                                act PlaceIn(soup,microwave)
                    sequence
                        cond IsSwitchedOff(light)
                        cond IsOpened(microwave)
                        cond Holding(soup)
                        act SwitchOn(light)
                sequence
                    cond IsClosed(microwave)
                    cond IsSwitchedOff(light)
                    cond Holding(soup)
                    act Open(microwave)
            sequence
                cond IsClosed(microwave)
                cond IsSwitchedOff(light)
                cond On(soup,table)
                cond IsHandEmpty()
                act PickUp(soup)
