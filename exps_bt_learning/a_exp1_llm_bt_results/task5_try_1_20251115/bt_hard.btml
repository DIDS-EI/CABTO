selector
    sequence
        cond IsFull(right_cup)
        cond On(right_cup,right_table)
    sequence
        cond Holding(right_franka,right_cup)
        selector
            sequence
                cond IsFull(right_cup)
                act DropRightCup(right_cup)
            sequence
                cond IsFull(right_milk)
                cond CupNeedGraspAndSupport()
                act FillRightCup(right_cup)
    sequence
        cond IsFull(right_milk)
        cond CupNeedGraspAndSupport()
        cond On(right_cup,right_table)
        cond IsHandEmpty(right_franka)
        act PickUpRightCup(right_cup)
