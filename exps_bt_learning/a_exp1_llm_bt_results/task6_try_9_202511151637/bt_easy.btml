selector
    sequence
        cond Open(cabinet)
        cond In(apple,fridge)
    sequence
        cond Open(cabinet)
        selector
            selector
                selector
                    sequence
                        cond Holding(apple)
                        selector
                            sequence
                                cond OpenFridge()
                                act PutInFridge(apple)
                            sequence
                                cond IsClosed(fridge)
                                act OpenFridge()
                    sequence
                        cond On(apple,table)
                        cond IsClosed(fridge)
                        cond IsHandEmpty()
                        act PickUp(apple)
                sequence
                    cond On(apple,table)
                    cond IsClosed(fridge)
                    cond OpenCabinet()
                    cond Holding(book)
                    act PutInCabinet(book)
            sequence
                cond IsClosed(cabinet)
                cond IsClosed(fridge)
                cond On(apple,table)
                cond Holding(book)
                act OpenCabinet()
