selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        selector
            sequence
                cond In(pie,oven)
                selector
                    sequence
                        cond In(chickenleg,oven)
                        act SwitchOnOven()
                    sequence
                        cond On(chickenleg,table)
                        cond IsHandEmpty()
                        act PlaceInOven(chickenleg)
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond On(pie,table)
                act PlaceInOven(pie)
