selector
    sequence
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond On(book,breakfast_table)
        cond In(banana,fridge)
    sequence
        cond IsOpened(cabinet)
        selector
            selector
                selector
                    selector
                        sequence
                            cond In(banana,fridge)
                            selector
                                sequence
                                    cond On(book,breakfast_table)
                                    selector
                                        sequence
                                            cond IsClosed(fridge)
                                            act Close(cabinet)
                                        sequence
                                            cond IsOpened(fridge)
                                            act Close(fridge)
                                sequence
                                    cond Holding(book)
                                    cond IsOpened(fridge)
                                    act PutOn(book,breakfast_table)
                        sequence
                            cond Holding(book)
                            cond Holding(banana)
                            cond IsOpened(fridge)
                            act PutIn(banana,fridge)
                    sequence
                        cond On(banana,table)
                        cond On(banana,breakfast_table)
                        cond Holding(book)
                        cond IsHandEmpty()
                        cond IsOpened(fridge)
                        act PickUp(banana)
                sequence
                    cond On(banana,table)
                    cond On(banana,breakfast_table)
                    cond Holding(book)
                    cond IsOpened(fridge)
                    cond Holding(wine)
                    act PutOn(wine,table)
            sequence
                cond On(banana,table)
                cond On(banana,breakfast_table)
                cond Holding(book)
                cond IsClosed(fridge)
                cond Holding(wine)
                act Open(fridge)
