selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond IsSwitchedOn(light)
        cond IsHandEmpty(right_franka)
        cond On(pie,breakfast_table)
        cond IsClosed(oven)
        selector
            sequence
                cond IsSwitchedOff(oven)
                selector
                    selector
                        sequence
                            cond IsSwitchedOn(radio)
                            selector
                                sequence
                                    cond IsOpened(microwave)
                                    act OpenContainer(right_franka,oven)
                                sequence
                                    cond IsClosed(microwave)
                                    cond IsSwitchedOff(microwave)
                                    act OpenContainer(right_franka,microwave)
                        sequence
                            cond IsClosed(microwave)
                            cond IsSwitchedOff(radio)
                            cond IsSwitchedOff(microwave)
                            act SwitchOnDevice(right_franka,radio)
                    sequence
                        cond IsHandEmpty(left_franka)
                        cond IsClosed(microwave)
                        cond IsSwitchedOff(radio)
                        cond IsSwitchedOn(microwave)
                        act SwitchOffDevice(left_franka,microwave)
            sequence
                cond IsHandEmpty(left_franka)
                cond IsClosed(microwave)
                cond IsSwitchedOn(oven)
                cond IsSwitchedOn(microwave)
                cond IsSwitchedOff(radio)
                act SwitchOffDevice(left_franka,oven)
