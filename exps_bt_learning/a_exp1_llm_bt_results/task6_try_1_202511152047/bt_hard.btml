selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond On(book,breakfast_table)
        cond IsClosed(cabinet)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond On(book,breakfast_table)
                selector
                    sequence
                        cond IsClosed(cabinet)
                        selector
                            selector
                                selector
                                    sequence
                                        cond In(banana,fridge)
                                        act Close(fridge)
                                    sequence
                                        cond Holding(banana)
                                        act PutIn(banana,fridge)
                                sequence
                                    cond On(banana,table)
                                    cond IsHandEmpty()
                                    cond On(banana,breakfast_table)
                                    act PickUp(banana)
                            sequence
                                cond On(banana,table)
                                cond Holding(wine)
                                cond On(banana,breakfast_table)
                                act PutOn(wine,breakfast_table)
                    sequence
                        cond On(banana,table)
                        cond Holding(wine)
                        cond IsOpened(cabinet)
                        cond On(banana,breakfast_table)
                        act Close(cabinet)
            sequence
                cond Holding(book)
                cond IsOpened(cabinet)
                cond Holding(wine)
                cond On(banana,table)
                cond On(banana,breakfast_table)
                act PutOn(book,breakfast_table)
