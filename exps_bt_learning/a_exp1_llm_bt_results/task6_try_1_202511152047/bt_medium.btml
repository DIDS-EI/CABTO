selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(fridge)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            selector
                selector
                    selector
                        sequence
                            cond Holding(book)
                            selector
                                sequence
                                    cond In(pen,cabinet)
                                    selector
                                        sequence
                                            cond IsOpened(fridge)
                                            act PutIn(book,cabinet)
                                        sequence
                                            cond IsClosed(fridge)
                                            act Open(fridge)
                                sequence
                                    cond IsClosed(fridge)
                                    cond Holding(pen)
                                    act PutIn(pen,cabinet)
                        sequence
                            cond Holding(pen)
                            cond IsHandEmpty()
                            cond On(book,breakfast_table)
                            cond On(book,table)
                            cond IsClosed(fridge)
                            act PickUp(book)
                    sequence
                        cond Holding(apple)
                        cond Holding(pen)
                        cond On(book,breakfast_table)
                        cond On(book,table)
                        cond IsClosed(fridge)
                        act PutOn(apple,breakfast_table)
                sequence
                    cond Holding(apple)
                    cond On(pen,table)
                    cond IsHandEmpty()
                    cond On(book,breakfast_table)
                    cond On(book,table)
                    cond On(pen,breakfast_table)
                    cond IsClosed(fridge)
                    act PickUp(pen)
            sequence
                cond Holding(banana)
                cond Holding(apple)
                cond On(pen,table)
                cond On(book,breakfast_table)
                cond On(book,table)
                cond On(pen,breakfast_table)
                cond IsClosed(fridge)
                act PutOn(banana,table)
