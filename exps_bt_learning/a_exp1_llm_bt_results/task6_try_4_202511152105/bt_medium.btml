selector
    sequence
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond IsOpen(cabinet)
        selector
            selector
                sequence
                    cond In(book,cabinet)
                    selector
                        sequence
                            cond Holding(pen)
                            act PlaceInContainer(pen,cabinet)
                        sequence
                            cond On(pen,table)
                            cond IsHandEmpty()
                            act PickUp(pen)
                sequence
                    cond On(pen,table)
                    cond Holding(book)
                    act PlaceInContainer(book,cabinet)
            sequence
                cond On(pen,table)
                cond On(book,table)
                cond IsHandEmpty()
                act PickUp(book)
    sequence
        cond On(pen,table)
        cond On(book,table)
        cond IsClosed(cabinet)
        cond IsHandEmpty()
        act OpenContainer(cabinet)
