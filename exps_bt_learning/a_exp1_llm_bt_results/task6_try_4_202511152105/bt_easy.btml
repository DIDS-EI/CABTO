selector
    cond In(wine,fridge)
    sequence
        cond IsOpen(fridge)
        selector
            sequence
                cond Holding(wine)
                act PlaceInContainer(wine,fridge)
            sequence
                cond On(wine,breakfast_table)
                cond IsHandEmpty()
                act PickUpFromBreakfastTable(wine)
    sequence
        cond On(wine,breakfast_table)
        cond IsClosed(fridge)
        cond IsHandEmpty()
        act OpenContainer(fridge)
