selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsOpened(microwave)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    sequence
                        cond Holding(soup)
                        act PutIn(soup,microwave)
                    sequence
                        cond IsHandEmpty()
                        cond On(soup,table)
                        act PickUp(soup)
            sequence
                cond IsHandEmpty()
                cond On(soup,table)
                cond IsSwitchedOff(microwave)
                act SwitchOn(microwave)
    sequence
        cond IsHandEmpty()
        cond On(soup,table)
        cond IsSwitchedOff(microwave)
        cond IsClosed(microwave)
        act Open(microwave)
