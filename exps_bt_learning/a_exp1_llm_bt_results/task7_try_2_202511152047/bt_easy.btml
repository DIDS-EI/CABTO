selector
    sequence
        cond In(chickenleg,oven)
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                selector
                    sequence
                        cond In(chickenleg,oven)
                        selector
                            selector
                                sequence
                                    cond In(pie,oven)
                                    act SwitchOn(oven)
                                sequence
                                    cond IsOpened(oven)
                                    cond Holding(pie)
                                    act Place(pie,oven)
                            sequence
                                cond IsHandEmpty()
                                cond IsOpened(oven)
                                cond On(pie,table)
                                act PickUp(pie)
                    sequence
                        cond IsOpened(oven)
                        cond On(pie,table)
                        cond Holding(chickenleg)
                        act Place(chickenleg,oven)
                sequence
                    cond IsClosed(oven)
                    cond On(pie,table)
                    cond Holding(chickenleg)
                    act Open(oven)
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond IsClosed(oven)
                cond On(pie,table)
                act PickUp(chickenleg)
