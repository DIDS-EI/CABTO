selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsClosed(microwave)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond On(pie,breakfast_table)
                        selector
                            sequence
                                cond IsSwitchedOn(radio)
                                selector
                                    sequence
                                        cond IsSwitchedOn(light)
                                        act Open(microwave)
                                    sequence
                                        cond IsSwitchedOff(light)
                                        act SwitchOn(light)
                            sequence
                                cond IsSwitchedOff(light)
                                cond IsSwitchedOff(radio)
                                act SwitchOn(radio)
                    sequence
                        cond IsSwitchedOff(light)
                        cond IsHandEmpty()
                        cond IsSwitchedOff(radio)
                        act PutAOnB(pie,breakfast_table)
            sequence
                cond IsSwitchedOff(light)
                cond IsHandEmpty()
                cond IsSwitchedOff(radio)
                cond IsClosed(oven)
                act Open(oven)
