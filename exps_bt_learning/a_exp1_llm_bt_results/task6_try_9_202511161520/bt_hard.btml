selector
    sequence
        cond In(pen,cabinet)
        cond IsClosed(fridge)
        cond In(banana,fridge)
        cond IsClosed(cabinet)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond In(pen,cabinet)
                selector
                    sequence
                        cond IsHandEmpty()
                        cond In(banana,fridge)
                        selector
                            sequence
                                cond IsClosed(cabinet)
                                act Close(fridge)
                            sequence
                                cond IsOpened(cabinet)
                                act Close(cabinet)
                    sequence
                        cond Holding(banana)
                        cond IsOpened(cabinet)
                        act PutIn(banana,fridge)
            sequence
                cond Holding(banana)
                cond IsOpened(cabinet)
                cond Holding(pen)
                act PutIn(pen,cabinet)
    sequence
        cond IsClosed(fridge)
        cond Holding(banana)
        cond Holding(pen)
        selector
            selector
                sequence
                    cond IsOpened(cabinet)
                    selector
                        sequence
                            cond IsHandEmpty()
                            act Open(fridge)
                        sequence
                            cond Holding(book)
                            act PutOn(book,table)
                sequence
                    cond Holding(book)
                    cond IsHandEmpty()
                    cond IsClosed(cabinet)
                    act Open(cabinet)
            sequence
                cond Holding(cake)
                cond Holding(book)
                cond IsClosed(cabinet)
                act PutOn(cake,breakfast_table)
