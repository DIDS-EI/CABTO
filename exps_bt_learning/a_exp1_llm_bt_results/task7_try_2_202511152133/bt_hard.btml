selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(light)
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(radio)
    sequence
        cond IsClosed(microwave)
        selector
            selector
                sequence
                    cond On(pie,breakfast_table)
                    selector
                        sequence
                            cond IsOpened(oven)
                            selector
                                sequence
                                    cond IsSwitchedOn(radio)
                                    selector
                                        sequence
                                            cond IsSwitchedOn(light)
                                            act OpenMicrowave()
                                        sequence
                                            cond IsSwitchedOff(light)
                                            act SwitchOnLight()
                                sequence
                                    cond IsSwitchedOff(radio)
                                    cond IsSwitchedOff(light)
                                    act SwitchOnRadio()
                        sequence
                            cond IsSwitchedOff(radio)
                            cond IsSwitchedOff(light)
                            cond IsClosed(oven)
                            act OpenOven()
                sequence
                    cond IsSwitchedOff(radio)
                    cond In(pie,oven)
                    cond IsClosed(oven)
                    cond IsSwitchedOff(light)
                    act PutOnTable(pie,breakfast_table)
            sequence
                cond IsSwitchedOff(oven)
                cond On(pie,table)
                cond IsClosed(oven)
                cond IsHandEmpty()
                cond IsSwitchedOff(radio)
                cond IsSwitchedOff(light)
                act PutInOven(pie)
