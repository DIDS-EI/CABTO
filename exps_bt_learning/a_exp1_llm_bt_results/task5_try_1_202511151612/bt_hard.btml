selector
    sequence
        cond IsHalfFull(right_cup)
        cond IsHandEmpty(right_franka)
        cond On(right_milk,right_table)
        cond On(left_milk,left_table)
        cond IsHalfFull(left_cup)
        cond IsHandEmpty(left_franka)
    sequence
        cond IsHalfFull(left_cup)
        selector
            sequence
                cond On(left_milk,left_table)
                selector
                    sequence
                        cond IsHandEmpty(left_franka)
                        selector
                            sequence
                                cond IsHolding(right_franka,right_milk)
                                selector
                                    sequence
                                        cond IsHalfFull(right_cup)
                                        act PutDownRightFranka(right_milk,right_table)
                                    sequence
                                        cond IsEmpty(right_cup)
                                        cond IsFull(right_milk)
                                        cond IsHolding(right_franka,right_cup)
                                        act PourMilkRight(right_milk,right_cup)
                            sequence
                                cond IsEmpty(right_cup)
                                cond IsHolding(right_franka,right_cup)
                                cond IsHandEmpty(right_franka)
                                cond CanGrasp(right_franka,right_milk)
                                cond On(right_milk,right_table)
                                cond IsFull(right_milk)
                                act PickUpRightFranka(right_milk)
                    sequence
                        cond IsEmpty(right_cup)
                        cond IsHolding(right_franka,right_cup)
                        cond IsHandEmpty(right_franka)
                        cond CanGrasp(right_franka,right_milk)
                        cond On(right_milk,right_table)
                        cond IsHolding(left_franka,left_cup)
                        cond IsFull(right_milk)
                        act PutDownLeftFranka(left_cup,left_table)
            sequence
                cond IsEmpty(right_cup)
                cond IsHolding(right_franka,right_cup)
                cond IsHandEmpty(right_franka)
                cond CanGrasp(right_franka,right_milk)
                cond On(right_milk,right_table)
                cond IsHolding(left_franka,left_milk)
                cond IsHolding(left_franka,left_cup)
                cond IsFull(right_milk)
                act PutDownLeftFranka(left_milk,left_table)
    sequence
        cond IsEmpty(right_cup)
        cond IsHolding(right_franka,right_cup)
        cond IsHandEmpty(right_franka)
        cond IsEmpty(left_cup)
        cond IsFull(left_milk)
        cond CanGrasp(right_franka,right_milk)
        cond On(right_milk,right_table)
        cond IsHolding(left_franka,left_milk)
        cond IsFull(right_milk)
        selector
            sequence
                cond IsHolding(left_franka,left_cup)
                act PourMilkLeft(left_milk,left_cup)
            sequence
                cond CanGrasp(left_franka,left_cup)
                cond IsHandEmpty(left_franka)
                cond On(left_cup,left_table)
                act PickUpLeftFranka(left_cup)
