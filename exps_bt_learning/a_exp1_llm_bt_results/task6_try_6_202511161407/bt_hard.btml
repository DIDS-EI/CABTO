selector
    sequence
        cond IsClosed(fridge)
        cond In(banana,fridge)
    sequence
        cond Open(fridge)
        selector
            sequence
                cond In(banana,fridge)
                act CloseFridge()
            sequence
                cond Holding(banana)
                act PutInFridge(banana)
    sequence
        cond IsClosed(fridge)
        selector
            sequence
                cond Holding(banana)
                act OpenFridge()
            sequence
                cond IsHandEmpty()
                cond On(banana,table)
                act PickUp(banana)
