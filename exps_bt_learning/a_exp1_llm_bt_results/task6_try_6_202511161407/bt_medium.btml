selector
    sequence
        cond On(book,breakfast_table)
        cond In(pen,cabinet)
    sequence
        cond Open(cabinet)
        selector
            sequence
                cond On(book,breakfast_table)
                selector
                    sequence
                        cond Holding(pen)
                        act PutInCabinet(pen)
                    sequence
                        cond IsHandEmpty()
                        cond On(pen,table)
                        act PickUp(pen)
            sequence
                cond Holding(book)
                cond On(pen,table)
                act PutOn(book,breakfast_table)
    sequence
        cond IsClosed(cabinet)
        selector
            sequence
                cond On(pen,table)
                selector
                    sequence
                        cond Holding(book)
                        act OpenCabinet()
                    sequence
                        cond On(book,table)
                        cond IsHandEmpty()
                        act PickUp(book)
            sequence
                cond On(book,table)
                cond Holding(pen)
                act PutOn(pen,table)
