selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond In(pie,oven)
                        selector
                            sequence
                                cond Holding(chickenleg)
                                act PutIn(chickenleg,oven)
                            sequence
                                cond On(chickenleg,table)
                                cond IsHandEmpty()
                                act PickUp(chickenleg)
                    sequence
                        cond Holding(pie)
                        cond On(chickenleg,table)
                        act PutIn(pie,oven)
            sequence
                cond Holding(pie)
                cond On(chickenleg,table)
                cond IsClosed(oven)
                cond IsHandEmpty()
                act Open(oven)
    sequence
        cond On(chickenleg,table)
        cond IsClosed(oven)
        cond IsHandEmpty()
        cond IsSwitchedOff(oven)
        selector
            sequence
                cond Holding(pie)
                act SwitchOn(oven)
            sequence
                cond On(pie,table)
                act PickUp(pie)
