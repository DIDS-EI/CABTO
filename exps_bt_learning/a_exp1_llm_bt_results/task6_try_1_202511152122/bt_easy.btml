selector
    sequence
        cond In(book,cabinet)
        cond Open(cabinet)
    sequence
        cond IsClosed(cabinet)
        selector
            selector
                selector
                    sequence
                        cond In(book,cabinet)
                        cond IsHandEmpty()
                        act Open(cabinet)
                    sequence
                        cond Holding(book)
                        cond Open(cabinet)
                        act PutIn(book,cabinet)
                sequence
                    cond On(book,book)
                    cond Open(cabinet)
                    cond IsHandEmpty()
                    act PickUp(book)
            sequence
                cond On(book,book)
                cond Holding(banana)
                cond Open(cabinet)
                cond Open(fridge)
                act PutIn(banana,fridge)
