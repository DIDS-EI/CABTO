selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                selector
                    sequence
                        cond In(chickenleg,oven)
                        act SwitchOnDevice(oven)
                    sequence
                        cond IsOpened(oven)
                        cond Holding(chickenleg)
                        act CookInDevice(chickenleg,oven)
                sequence
                    cond IsClosed(oven)
                    cond Holding(chickenleg)
                    act OpenDevice(oven)
            sequence
                cond IsClosed(oven)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                act PickUpObject(chickenleg)
