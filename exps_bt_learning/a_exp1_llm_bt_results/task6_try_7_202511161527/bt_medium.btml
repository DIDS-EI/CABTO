selector
    cond On(book,breakfast_table)
    sequence
        cond Holding(left_franka,book)
        act PutOnLeftFranka(book,breakfast_table)
    sequence
        cond In(book,cabinet)
        selector
            sequence
                cond IsHandEmpty(left_franka)
                selector
                    sequence
                        cond IsOpened(cabinet)
                        act TakeOutLeftFranka(book,cabinet)
                    sequence
                        cond IsClosed(cabinet)
                        act OpenContainerLeftFranka(cabinet)
            sequence
                cond Holding(left_franka,pen)
                cond IsOpened(fridge)
                cond IsClosed(cabinet)
                act PutInLeftFranka(pen,fridge)
