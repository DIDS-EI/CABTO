selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond Holding(left_franka,book)
                act PutInLeftFranka(book,cabinet)
            sequence
                cond In(book,fridge)
                cond IsHandEmpty(left_franka)
                cond IsOpened(fridge)
                act TakeOutLeftFranka(book,fridge)
    sequence
        cond In(book,fridge)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty(left_franka)
                selector
                    sequence
                        cond IsOpened(fridge)
                        act OpenContainerLeftFranka(cabinet)
                    sequence
                        cond IsClosed(fridge)
                        act OpenContainerLeftFranka(fridge)
            sequence
                cond Holding(left_franka,pen)
                cond IsClosed(fridge)
                act PutOnLeftFranka(pen,breakfast_table)
