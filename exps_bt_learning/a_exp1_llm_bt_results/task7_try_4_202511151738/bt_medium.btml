selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                sequence
                    cond IsOpened(microwave)
                    selector
                        selector
                            sequence
                                cond In(soup,microwave)
                                act SwitchOnMicrowave()
                            sequence
                                cond Holding(soup)
                                act PlaceInMicrowave(soup)
                        sequence
                            cond On(soup,table)
                            cond IsHandEmpty()
                            act PickUp(soup)
                sequence
                    cond On(soup,table)
                    cond IsClosed(microwave)
                    cond IsHandEmpty()
                    act OpenMicrowave()
            sequence
                cond On(soup,table)
                cond Holding(chickenleg)
                cond IsClosed(microwave)
                cond IsOpened(oven)
                act PlaceInOven(chickenleg)
