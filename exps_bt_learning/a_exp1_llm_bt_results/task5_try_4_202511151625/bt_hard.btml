selector
    sequence
        cond On(right_milk,right_table)
        cond IsHalfFull(left_cup)
        cond IsHandEmpty(left_franka)
        cond On(left_milk,left_table)
        cond IsHandEmpty(right_franka)
        cond IsHalfFull(right_cup)
    sequence
        cond Holding(right_franka,right_milk)
        selector
            selector
                sequence
                    cond IsHalfFull(left_cup)
                    selector
                        sequence
                            cond IsHalfFull(right_cup)
                            selector
                                sequence
                                    cond On(left_milk,left_table)
                                    cond IsHandEmpty(left_franka)
                                    act PlaceDownRightFranka(right_milk,right_table)
                                sequence
                                    cond Holding(left_franka,left_milk)
                                    act PlaceDownLeftFranka(left_milk,left_table)
                        sequence
                            cond On(right_cup,right_table)
                            cond Holding(left_franka,left_milk)
                            cond IsEmpty(right_cup)
                            cond IsFull(right_milk)
                            act PourToCupRightFranka(right_milk,right_cup)
                sequence
                    cond Holding(left_franka,left_milk)
                    cond IsEmpty(right_cup)
                    cond IsFull(right_milk)
                    cond IsEmpty(left_cup)
                    cond On(right_cup,right_table)
                    cond IsFull(left_milk)
                    cond On(left_cup,left_table)
                    act PourToCupLeftFranka(left_milk,left_cup)
            sequence
                cond IsHandEmpty(left_franka)
                cond IsEmpty(right_cup)
                cond IsFull(right_milk)
                cond IsEmpty(left_cup)
                cond On(left_milk,left_table)
                cond CanGrasp(left_franka,left_milk)
                cond On(right_cup,right_table)
                cond IsFull(left_milk)
                cond On(left_cup,left_table)
                act PickUpLeftFranka(left_milk)
    sequence
        cond On(right_milk,right_table)
        cond CanGrasp(right_franka,right_milk)
        cond IsHandEmpty(left_franka)
        cond IsEmpty(right_cup)
        cond IsFull(right_milk)
        cond IsEmpty(left_cup)
        cond On(left_milk,left_table)
        cond IsHandEmpty(right_franka)
        cond CanGrasp(left_franka,left_milk)
        cond On(right_cup,right_table)
        cond IsFull(left_milk)
        cond On(left_cup,left_table)
        act PickUpRightFranka(right_milk)
