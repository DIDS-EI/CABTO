selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
    sequence
        cond IsClosed(microwave)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond On(pie,breakfast_table)
                        selector
                            sequence
                                cond IsSwitchedOn(radio)
                                selector
                                    sequence
                                        cond IsSwitchedOn(light)
                                        act OpenAppliance(microwave)
                                    sequence
                                        cond IsSwitchedOff(light)
                                        act TurnOn(light)
                            sequence
                                cond IsSwitchedOff(light)
                                cond IsSwitchedOff(radio)
                                act TurnOn(radio)
                    sequence
                        cond IsHandEmpty()
                        cond IsSwitchedOff(radio)
                        cond IsSwitchedOff(light)
                        act PutAOnB(pie,breakfast_table)
            sequence
                cond IsHandEmpty()
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                cond IsSwitchedOff(radio)
                act OpenAppliance(oven)
