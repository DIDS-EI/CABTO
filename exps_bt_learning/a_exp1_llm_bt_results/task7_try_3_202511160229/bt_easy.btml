selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                sequence
                    cond In(pie,oven)
                    selector
                        selector
                            sequence
                                cond In(chickenleg,oven)
                                act SwitchOnDevice(oven)
                            sequence
                                cond Holding(chickenleg)
                                cond IsClosed(oven)
                                act PutInContainer(chickenleg,oven)
                        sequence
                            cond IsHandEmpty()
                            cond On(chickenleg,table)
                            cond IsClosed(oven)
                            act PickUp(chickenleg)
                sequence
                    cond On(chickenleg,table)
                    cond Holding(pie)
                    cond IsClosed(oven)
                    act PutInContainer(pie,oven)
            sequence
                cond On(pie,table)
                cond IsHandEmpty()
                cond On(chickenleg,table)
                cond IsClosed(oven)
                act PickUp(pie)
