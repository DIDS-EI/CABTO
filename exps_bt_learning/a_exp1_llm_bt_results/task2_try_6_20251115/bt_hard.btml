selector
    sequence
        cond On(a,c)
        cond On(b,d)
    sequence
        cond On(d,table)
        selector
            selector
                sequence
                    cond On(a,c)
                    selector
                        sequence
                            cond Holding(b)
                            act Drop(b,d)
                        sequence
                            cond IsHandEmpty()
                            cond On(b,table)
                            act PickUp(b)
                sequence
                    cond On(c,table)
                    cond On(b,table)
                    cond Holding(a)
                    act Drop(a,c)
            sequence
                cond On(c,table)
                cond IsHandEmpty()
                cond On(b,table)
                cond On(a,table)
                act PickUp(a)
