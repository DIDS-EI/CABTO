selector
    sequence
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            sequence
                                cond IsOpened(microwave)
                                selector
                                    sequence
                                        cond IsSwitchedOn(radio)
                                        act PlaceOn(pie,breakfast_table)
                                    sequence
                                        cond IsSwitchedOff(radio)
                                        act SwitchOn(radio)
                            sequence
                                cond IsSwitchedOff(radio)
                                cond IsClosed(microwave)
                                act Open(microwave)
                    sequence
                        cond IsSwitchedOff(radio)
                        cond IsClosed(oven)
                        cond IsClosed(microwave)
                        act Open(oven)
            sequence
                cond IsSwitchedOff(radio)
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                cond IsClosed(microwave)
                act SwitchOn(light)
    sequence
        cond IsSwitchedOff(radio)
        cond IsSwitchedOff(light)
        cond IsClosed(microwave)
        cond IsClosed(oven)
        cond On(pie,table)
        cond IsHandEmpty()
        act PickUp(pie)
