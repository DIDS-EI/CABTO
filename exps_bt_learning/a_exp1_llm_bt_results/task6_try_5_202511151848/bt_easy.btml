selector
    sequence
        cond In(wine,fridge)
        cond IsOpened(fridge)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond Holding(wine)
                act DropIn(wine,fridge)
            sequence
                cond On(wine,table)|On(wine,breakfast_table)
                cond IsHandEmpty()
                act PickUp(wine)
    sequence
        cond On(wine,table)|On(wine,breakfast_table)
        cond IsClosed(fridge)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    act Open(fridge)
                sequence
                    cond IsOpened(cabinet)
                    cond Holding(banana)
                    act DropIn(banana,cabinet)
            sequence
                cond IsClosed(cabinet)
                cond Holding(banana)
                act Open(cabinet)
