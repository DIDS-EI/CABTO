selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond On(book,breakfast_table)
        cond IsClosed(cabinet)
    sequence
        cond IsClosed(cabinet)
        selector
            selector
                selector
                    sequence
                        cond In(banana,fridge)
                        selector
                            sequence
                                cond IsClosed(fridge)
                                selector
                                    sequence
                                        cond Holding(book)
                                        act PlaceOnBreakfastTable(book)
                                    sequence
                                        cond On(book,table)
                                        cond IsHandEmpty()
                                        act PickUp(book)
                            sequence
                                cond On(book,table)
                                cond IsHandEmpty()
                                cond IsOpened(fridge)
                                act Close(fridge)
                    sequence
                        cond Holding(banana)
                        cond On(book,table)
                        cond IsOpened(fridge)
                        act PutIn(banana,fridge)
                sequence
                    cond On(book,table)
                    cond On(banana,table)
                    cond IsHandEmpty()
                    cond IsOpened(fridge)
                    act PickUp(banana)
            sequence
                cond On(book,table)
                cond On(banana,table)
                cond IsHandEmpty()
                cond IsClosed(fridge)
                act Open(fridge)
