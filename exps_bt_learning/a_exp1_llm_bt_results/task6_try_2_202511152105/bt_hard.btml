selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        cond On(book,breakfast_table)
    sequence
        cond IsOpen(fridge)
        selector
            sequence
                cond IsClosed(cabinet)
                selector
                    selector
                        selector
                            sequence
                                cond On(book,breakfast_table)
                                selector
                                    sequence
                                        cond In(banana,fridge)
                                        cond IsHandEmpty()
                                        act Close(fridge)
                                    sequence
                                        cond Holding(banana)
                                        act PutIn(banana,fridge)
                            sequence
                                cond Holding(banana)
                                cond Holding(book)
                                act PutOn(book,breakfast_table)
                        sequence
                            cond On(banana,breakfast_table)
                            cond IsHandEmpty()
                            cond On(banana,table)
                            cond Holding(book)
                            act PickUp(banana)
                    sequence
                        cond On(banana,breakfast_table)
                        cond On(banana,table)
                        cond Holding(book)
                        cond Holding(pen)
                        act PutOn(pen,breakfast_table)
            sequence
                cond On(banana,breakfast_table)
                cond On(banana,table)
                cond IsHandEmpty()
                cond IsOpen(cabinet)
                cond Holding(pen)
                cond Holding(book)
                act Close(cabinet)
    sequence
        cond On(banana,breakfast_table)
        cond On(banana,table)
        cond IsHandEmpty()
        cond IsOpen(cabinet)
        cond Holding(pen)
        cond Holding(book)
        cond IsClosed(fridge)
        act Open(fridge)
