selector
    sequence
        cond On(b,d)
        cond On(c,b)
        cond On(a,c)
    sequence
        cond Holding(b)
        selector
            sequence
                cond On(c,b)
                selector
                    sequence
                        cond Clear(d)
                        selector
                            selector
                                selector
                                    sequence
                                        cond On(a,c)
                                        act Stack(b,d)
                                    sequence
                                        cond Holding(a)
                                        cond Clear(c)
                                        act Stack(a,c)
                                sequence
                                    cond IsHandEmpty()
                                    cond Clear(a)
                                    cond On(a,table)
                                    cond Clear(c)
                                    act PickUp(a)
                            sequence
                                cond Holding(c)
                                cond Clear(a)
                                cond On(a,table)
                                act PutDown(c)
                    sequence
                        cond Clear(a)
                        cond Clear(c)
