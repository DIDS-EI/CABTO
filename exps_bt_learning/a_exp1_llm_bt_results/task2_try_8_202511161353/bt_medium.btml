selector
    sequence
        cond On(b,a)
        cond On(c,b)
    sequence
        cond On(b,a)
        cond Clear(b)
        selector
            sequence
                cond Holding(c)
                act Stack(c,b)
            sequence
                cond IsHandEmpty()
                cond On(c,table)
                cond Clear(c)
                act PickUp(c)
    sequence
        cond On(c,table)
        cond Clear(c)
        selector
            selector
                selector
                    sequence
                        cond Clear(a)
                        selector
                            sequence
                                cond Holding(b)
                                act Stack(b,a)
                            sequence
                                cond IsHandEmpty()
                                cond Clear(b)
                                cond On(b,d)
                                act Unstack(b,d)
                    sequence
                        cond Holding(a)
                        cond Clear(b)
                        cond On(b,d)
                        act PutDown(a)
                sequence
                    cond On(b,d)
                    cond On(d,b)
                    cond IsHandEmpty()
                    cond Holding(a)
                    cond Clear(d)
                    act Unstack(d,b)
            sequence
                cond Holding(a)
                cond On(b,d)
                cond Holding(d)
                cond On(d,b)
                act PutDown(d)
