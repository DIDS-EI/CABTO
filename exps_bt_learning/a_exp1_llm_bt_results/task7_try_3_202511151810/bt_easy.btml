selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond On(chickenleg,table)
        cond IsHandEmpty()
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    sequence
                        cond IsOpened(oven)
                        act PutInOven(chickenleg)
                    sequence
                        cond IsClosed(oven)
                        act OpenOven(oven)
            sequence
                cond IsSwitchedOff(oven)
                cond IsClosed(oven)
                act SwitchOnOven(oven)
