selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsOpened(microwave)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    sequence
                        cond Holding(soup)
                        act PutIn(soup,microwave)
                    sequence
                        cond IsHandEmpty()
                        cond On(soup,table)
                        act PickUp(soup)
            sequence
                cond IsSwitchedOff(microwave)
                cond On(soup,table)
                cond IsHandEmpty()
                act SwitchOn(microwave)
    sequence
        cond IsSwitchedOff(microwave)
        cond IsClosed(microwave)
        cond On(soup,table)
        cond IsHandEmpty()
        act Open(microwave)
