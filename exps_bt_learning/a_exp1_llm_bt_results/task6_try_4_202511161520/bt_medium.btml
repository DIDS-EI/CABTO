selector
    sequence
        cond On(book,breakfast_table)
        cond On(cake,breakfast_table)
    sequence
        cond On(book,breakfast_table)
        selector
            selector
                sequence
                    cond Holding(cake)
                    act PlaceOn(cake,breakfast_table)
                sequence
                    cond IsHandEmpty()
                    cond On(cake,table)|On(cake,breakfast_table)
                    act PickUp(cake)
            sequence
                cond Holding(banana)
                cond IsOpened(cabinet)
                cond On(cake,table)|On(cake,breakfast_table)
                act PlaceIn(banana,cabinet)
    sequence
        cond Holding(banana)
        cond IsOpened(cabinet)
        cond On(cake,table)|On(cake,breakfast_table)
        selector
            selector
                sequence
                    cond Holding(book)
                    act PlaceOn(book,breakfast_table)
                sequence
                    cond IsHandEmpty()
                    cond On(book,table)|On(book,breakfast_table)
                    act PickUp(book)
            sequence
                cond Holding(pen)
                cond On(book,table)|On(book,breakfast_table)
                act PlaceOn(pen,breakfast_table)
