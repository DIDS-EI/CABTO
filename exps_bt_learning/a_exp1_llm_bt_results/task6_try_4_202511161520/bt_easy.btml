selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond Holding(book)
        selector
            sequence
                cond IsOpened(cabinet)
                act PlaceIn(book,cabinet)
            sequence
                cond IsClosed(cabinet)
                act OpenContainer(cabinet)
    sequence
        cond IsClosed(cabinet)
        cond On(book,table)|On(book,breakfast_table)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    act PickUp(book)
                sequence
                    cond Holding(cake)
                    cond IsOpened(fridge)
                    act PlaceIn(cake,fridge)
            sequence
                cond Holding(cake)
                cond IsClosed(fridge)
                act OpenContainer(fridge)
