selector
    sequence
        cond On(a,place_c)
        cond On(b,place_a)
        cond On(c,place_b)
    sequence
        cond IsEmpty(place_b)
        selector
            selector
                sequence
                    cond On(a,place_c)
                    selector
                        selector
                            sequence
                                cond On(b,place_a)
                                selector
                                    sequence
                                        cond Holding(c)
                                        act Drop(c,place_b)
                                    sequence
                                        cond IsHandEmpty()
                                        cond On(c,table)
                                        act PickUp(c)
                            sequence
                                cond Holding(b)
                                cond On(c,table)
                                cond IsEmpty(place_a)
                                act Drop(b,place_a)
                        sequence
                            cond On(c,table)
                            cond IsHandEmpty()
                            cond On(b,table)
                            cond IsEmpty(place_a)
                            act PickUp(b)
                sequence
                    cond IsEmpty(place_c)
                    cond Holding(a)
                    cond IsEmpty(place_a)
                    cond On(b,table)
                    cond On(c,table)
                    act Drop(a,place_c)
            sequence
                cond IsEmpty(place_c)
                cond On(a,table)
                cond IsEmpty(place_a)
                cond On(b,table)
                cond IsHandEmpty()
                cond On(c,table)
                act PickUp(a)
