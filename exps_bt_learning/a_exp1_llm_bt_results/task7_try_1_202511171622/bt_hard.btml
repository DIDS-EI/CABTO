selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsHandEmpty()
        cond IsClosed(oven)
        selector
            sequence
                cond On(pie,breakfast_table)
                selector
                    sequence
                        cond IsOpened(microwave)
                        selector
                            sequence
                                cond IsSwitchedOn(light)
                                selector
                                    sequence
                                        cond IsSwitchedOn(radio)
                                        act OpenOven()
                                    sequence
                                        cond IsSwitchedOff(radio)
                                        act SwitchOnAppliance(radio)
                            sequence
                                cond IsSwitchedOff(light)
                                cond IsSwitchedOff(radio)
                                act SwitchOnAppliance(light)
                    sequence
                        cond IsClosed(microwave)
                        cond IsSwitchedOff(light)
                        cond IsSwitchedOff(radio)
                        act OpenMicrowave()
            sequence
                cond IsClosed(microwave)
                cond IsSwitchedOff(light)
                cond On(pie,table)
                cond IsSwitchedOff(radio)
                act MoveToBreakfastTable(pie)
