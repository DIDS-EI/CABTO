selector
    sequence
        cond In(pie,oven)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    selector
                        sequence
                            cond In(pie,oven)
                            selector
                                sequence
                                    cond Holding(chickenleg)
                                    act PlaceInOven(chickenleg)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(chickenleg,table)
                                    act PickUp(chickenleg)
                        sequence
                            cond On(chickenleg,table)
                            cond Holding(pie)
                            act PlaceInOven(pie)
                    sequence
                        cond IsHandEmpty()
                        cond On(chickenleg,table)
                        cond On(pie,table)
                        act PickUp(pie)
            sequence
                cond IsHandEmpty()
                cond On(chickenleg,table)
                cond On(pie,table)
                cond IsSwitchedOff(oven)
                act SwitchOnAppliance(oven)
    sequence
        cond IsHandEmpty()
        cond On(pie,table)
        cond IsClosed(oven)
        cond On(chickenleg,table)
        cond IsSwitchedOff(oven)
        act OpenOven()
