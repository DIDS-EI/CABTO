selector
    sequence
        cond IsClosed(fridge)
        cond In(banana,fridge)
    sequence
        cond Open(fridge)
        selector
            selector
                selector
                    sequence
                        cond In(banana,fridge)
                        cond IsHandEmpty()
                        act CloseAction(fridge)
                    sequence
                        cond Holding(banana)
                        act PutInAction(banana,fridge)
                sequence
                    cond On(banana,breakfast_table)
                    cond On(banana,table)
                    cond IsHandEmpty()
                    act PickUpAction(banana)
            sequence
                cond On(banana,breakfast_table)
                cond On(banana,table)
                cond Holding(pen)
                cond Open(cabinet)
                act PutInAction(pen,cabinet)
    sequence
        cond IsClosed(fridge)
        cond On(banana,table)
        cond Holding(pen)
        cond On(banana,breakfast_table)
        cond Open(cabinet)
        selector
            sequence
                cond IsHandEmpty()
                act OpenAction(fridge)
            sequence
                cond Holding(book)
                act DropAction(book,breakfast_table)
