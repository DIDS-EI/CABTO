selector
    sequence
        cond In(book,cabinet)
        cond Open(cabinet)
    sequence
        cond Open(cabinet)
        selector
            sequence
                cond Holding(book)
                act PutInAction(book,cabinet)
            sequence
                cond In(book,fridge)
                cond IsHandEmpty()
                cond Open(fridge)
                act TakeOutAction(book,fridge)
    sequence
        cond IsClosed(cabinet)
        cond In(book,fridge)
        selector
            sequence
                cond IsHandEmpty()
                selector
                    sequence
                        cond Open(fridge)
                        act OpenAction(cabinet)
                    sequence
                        cond IsClosed(fridge)
                        act OpenAction(fridge)
            sequence
                cond IsClosed(fridge)
                cond Holding(book)
                act DropAction(book,breakfast_table)
