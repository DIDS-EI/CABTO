selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond Holding(book)
        selector
            selector
                sequence
                    cond IsOpened(cabinet)
                    selector
                        selector
                            sequence
                                cond In(pen,cabinet)
                                act PutInContainer(book,cabinet)
                            sequence
                                cond Holding(pen)
                                act PutInContainer(pen,cabinet)
                        sequence
                            cond On(pen,table)|On(pen,breakfast_table)
                            cond IsHandEmpty()
                            act PickUpItem(pen)
                sequence
                    cond IsClosed(cabinet)
                    cond On(pen,table)|On(pen,breakfast_table)
                    cond IsHandEmpty()
                    act OpenContainer(cabinet)
            sequence
                cond IsClosed(cabinet)
                cond On(pen,table)|On(pen,breakfast_table)
                cond Holding(banana)
                act PutOnSurface(banana,breakfast_table)
    sequence
        cond On(book,table)|On(book,breakfast_table)
        cond IsClosed(cabinet)
        cond On(pen,table)|On(pen,breakfast_table)
        cond Holding(banana)
        selector
            sequence
                cond IsHandEmpty()
                act PickUpItem(book)
            sequence
                cond Holding(apple)
                act PutOnSurface(apple,breakfast_table)
