selector
    cond On(left_box1,right_table)
    sequence
        cond IsHolding(left_franka,left_box1)
        act PlaceOnRightTableLeftFranka(left_box1)
    sequence
        cond On(left_box1,left_table)
        cond IsHandEmpty(left_franka)
        cond On(left_franka,left_table)
        act PickUpLeftFranka(left_box1)
