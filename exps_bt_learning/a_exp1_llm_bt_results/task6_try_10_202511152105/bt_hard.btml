selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        cond On(book,breakfast_table)
    sequence
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsOpen(fridge)
                selector
                    selector
                        sequence
                            cond In(banana,fridge)
                            selector
                                selector
                                    sequence
                                        cond IsHandEmpty()
                                        cond On(book,breakfast_table)
                                        act CloseContainer(fridge)
                                    sequence
                                        cond Holding(book)
                                        act PlaceOn(book,breakfast_table)
                                sequence
                                    cond On(book,table)
                                    cond IsHandEmpty()
                                    act PickUp(book)
                        sequence
                            cond On(book,table)
                            cond Holding(banana)
                            act PlaceIn(banana,fridge)
                    sequence
                        cond On(banana,table)
                        cond On(book,table)
                        cond IsHandEmpty()
                        act PickUp(banana)
            sequence
                cond IsClosed(fridge)
                cond On(banana,table)
                cond On(book,table)
                cond IsHandEmpty()
                act OpenContainer(fridge)
