selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    cond In(banana,fridge)
                    act CloseFridge(fridge)
                sequence
                    cond Holding(banana)
                    act PlaceInContainer(banana,fridge)
            sequence
                cond IsHandEmpty()
                cond On(banana,table)
                act PickUpItem(banana,table)
    sequence
        cond IsHandEmpty()
        cond On(banana,table)
        cond IsClosed(fridge)
        act OpenFridge(fridge)
