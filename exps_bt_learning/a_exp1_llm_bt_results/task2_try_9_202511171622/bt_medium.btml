selector
    sequence
        cond On(b,a)
        cond On(c,b)
    sequence
        cond On(a,table)
        selector
            selector
                sequence
                    cond On(c,b)
                    selector
                        sequence
                            cond Holding(b)
                            act PutOn(b,a)
                        sequence
                            cond IsHandEmpty()
                            cond On(b,table)
                            act PickUp(b)
                sequence
                    cond Holding(c)
                    cond On(b,table)
                    act PutOn(c,b)
            sequence
                cond IsHandEmpty()
                cond On(b,table)
                cond On(c,table)
                act PickUp(c)
