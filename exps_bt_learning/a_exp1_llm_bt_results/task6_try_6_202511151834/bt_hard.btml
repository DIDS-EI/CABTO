selector
    sequence
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        cond In(banana,fridge)
        cond On(book,breakfast_table)
    sequence
        cond IsClosed(cabinet)
        selector
            selector
                sequence
                    cond On(book,breakfast_table)
                    selector
                        selector
                            sequence
                                cond IsOpened(fridge)
                                selector
                                    sequence
                                        cond In(banana,fridge)
                                        cond IsHandEmpty()
                                        act CloseContainer(fridge)
                                    sequence
                                        cond Holding(banana)
                                        act PutIn(banana,fridge)
                            sequence
                                cond IsClosed(fridge)
                                cond Holding(banana)
                                act OpenContainer(fridge)
                        sequence
                            cond IsClosed(fridge)
                            cond On(banana,table)
                            cond IsHandEmpty()
                            act PickUp(banana)
                sequence
                    cond IsClosed(fridge)
                    cond Holding(book)
                    cond On(banana,table)
                    act PutOnBreakfastTable(book)
            sequence
                cond On(book,table)
                cond IsClosed(fridge)
                cond On(banana,table)
                cond IsHandEmpty()
                act PickUp(book)
