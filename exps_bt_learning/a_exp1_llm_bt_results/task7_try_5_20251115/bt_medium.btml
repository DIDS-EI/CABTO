selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsNotIn(chickenleg)
        selector
            sequence
                cond IsSwitchedOn(oven)
                act PutChickenlegInOven(chickenleg)
            sequence
                cond IsSwitchedOff(oven)
                act TurnOnOven()
