selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                selector
                    sequence
                        cond In(banana,fridge)
                        cond IsHandEmpty()
                        act Close(fridge)
                    sequence
                        cond Holding(banana)
                        act PutIn(banana,fridge)
                sequence
                    cond On(banana,table)|On(banana,breakfast_table)
                    cond IsHandEmpty()
                    act PickUp(banana)
            sequence
                cond On(banana,table)|On(banana,breakfast_table)
                cond Holding(book)
                act PutIn(book,fridge)
    sequence
        cond On(banana,table)|On(banana,breakfast_table)
        cond IsClosed(fridge)
        cond Holding(book)
        selector
            sequence
                cond IsHandEmpty()
                act Open(fridge)
            sequence
                cond Holding(pen)
                act PutOn(pen,table)
