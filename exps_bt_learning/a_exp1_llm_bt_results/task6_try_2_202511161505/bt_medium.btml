selector
    sequence
        cond On(book,breakfast_table)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            selector
                selector
                    sequence
                        cond On(book,breakfast_table)
                        selector
                            sequence
                                cond Holding(pen)
                                act PutIn(pen,cabinet)
                            sequence
                                cond On(pen,table)|On(pen,breakfast_table)
                                cond IsHandEmpty()
                                act PickUp(pen)
                    sequence
                        cond On(pen,table)|On(pen,breakfast_table)
                        cond Holding(book)
                        act PutOn(book,breakfast_table)
                sequence
                    cond On(pen,table)|On(pen,breakfast_table)
                    cond IsHandEmpty()
                    cond On(book,table)|On(book,breakfast_table)
                    act PickUp(book)
            sequence
                cond IsOpened(fridge)
                cond On(pen,table)|On(pen,breakfast_table)
                cond On(book,table)|On(book,breakfast_table)
                cond Holding(banana)
                act PutIn(banana,fridge)
    sequence
        cond IsOpened(fridge)
        cond On(book,table)|On(book,breakfast_table)
        cond On(pen,table)|On(pen,breakfast_table)
        cond IsHandEmpty()
        cond Holding(banana)
        cond IsClosed(cabinet)
        act Open(cabinet)
