selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            selector
                sequence
                    cond Holding(book)
                    act PutIn(book,cabinet)
                sequence
                    cond IsHandEmpty()
                    cond On(book,table)|On(book,breakfast_table)
                    act PickUp(book)
            sequence
                cond Holding(pen)
                cond On(book,table)|On(book,breakfast_table)
                act PutOn(pen,table)
    sequence
        cond IsClosed(cabinet)
        cond Holding(pen)
        cond On(book,table)|On(book,breakfast_table)
        selector
            sequence
                cond IsHandEmpty()
                act Open(cabinet)
            sequence
                cond Holding(banana)
                act PutOn(banana,table)
