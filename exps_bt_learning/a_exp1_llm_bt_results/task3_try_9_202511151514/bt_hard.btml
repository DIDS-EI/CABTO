selector
    cond On(center_big_box,box_board)
    sequence
        cond BigBoxNeedTwoFranka()
        selector
            selector
                selector
                    sequence
                        cond JointHolding(center_big_box)
                        act JointPlace(center_big_box,box_board)
                    sequence
                        cond IsHandEmpty(right_franka)
                        cond On(center_big_box,left_table)
                        cond IsHandEmpty(left_franka)
                        cond On(center_big_box,right_table)
                        act JointPickUp(center_big_box)
                sequence
                    cond Holding(right_franka,right_lego)
                    cond RightFrankaCanOnlyDoRightAction()
                    cond On(center_big_box,right_table)
                    cond On(center_big_box,left_table)
                    cond IsHandEmpty(left_franka)
                    act PlaceRightFranka(right_franka,right_lego)
            sequence
                cond LeftFrankaCanOnlyDoLeftAction()
                cond Holding(right_franka,right_lego)
                cond RightFrankaCanOnlyDoRightAction()
                cond On(center_big_box,right_table)
                cond On(center_big_box,left_table)
                cond Holding(left_franka,left_lego)
                act PlaceLeftFranka(left_franka,left_lego)
