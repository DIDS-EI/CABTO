selector
    sequence
        cond In(chickenleg,oven)
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    selector
                        sequence
                            cond In(chickenleg,oven)
                            selector
                                sequence
                                    cond Holding(pie)
                                    act PlaceInOven(pie)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(pie,table)
                                    act PickUpFromTable(pie)
                        sequence
                            cond On(pie,table)
                            cond Holding(chickenleg)
                            act PlaceInOven(chickenleg)
                    sequence
                        cond On(chickenleg,table)
                        cond IsHandEmpty()
                        cond On(pie,table)
                        act PickUpFromTable(chickenleg)
            sequence
                cond IsSwitchedOff(oven)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond On(pie,table)
                act SwitchOnAppliance(oven)
    sequence
        cond On(pie,table)
        cond On(chickenleg,table)
        cond IsHandEmpty()
        cond IsClosed(oven)
        cond IsSwitchedOff(oven)
        act OpenAppliance(oven)
