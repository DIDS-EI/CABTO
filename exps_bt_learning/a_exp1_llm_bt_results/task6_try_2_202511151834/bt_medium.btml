selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond In(pen,cabinet)
                selector
                    sequence
                        cond Holding(book)
                        act Insert(book,cabinet)
                    sequence
                        cond On(book,table)
                        cond IsHandEmpty()
                        act PickUp(book)
            sequence
                cond On(book,table)
                cond Holding(pen)
                act Insert(pen,cabinet)
    sequence
        cond IsClosed(cabinet)
        cond On(book,table)
        selector
            sequence
                cond Holding(pen)
                act Open(cabinet)
            sequence
                cond IsHandEmpty()
                cond On(pen,table)
                act PickUp(pen)
