selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(fridge)
        cond In(pen,cabinet)
    sequence
        cond IsClosed(fridge)
        selector
            selector
                selector
                    sequence
                        cond In(pen,cabinet)
                        selector
                            selector
                                sequence
                                    cond In(book,cabinet)
                                    act OpenFridge(fridge)
                                sequence
                                    cond Holding(book)
                                    cond IsOpened(cabinet)
                                    act PutInCabinet(book)
                            sequence
                                cond On(book,table)
                                cond IsHandEmpty()
                                cond IsOpened(cabinet)
                                act PickUpFromTable(book)
                    sequence
                        cond On(book,table)
                        cond Holding(pen)
                        cond IsOpened(cabinet)
                        act PutInCabinet(pen)
                sequence
                    cond On(book,table)
                    cond IsHandEmpty()
                    cond IsOpened(cabinet)
                    cond On(pen,table)
                    act PickUpFromTable(pen)
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                cond IsClosed(cabinet)
                cond On(pen,table)
                act OpenCabinet(cabinet)
