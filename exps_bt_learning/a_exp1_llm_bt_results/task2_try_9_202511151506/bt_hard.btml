selector
    sequence
        cond On(a,c)
        cond On(b,d)
        cond On(c,b)
    sequence
        cond On(d,table)
        selector
            selector
                sequence
                    cond On(a,c)
                    selector
                        selector
                            sequence
                                cond On(c,b)
                                selector
                                    sequence
                                        cond Holding(b)
                                        act PutOn(b,d)
                                    sequence
                                        cond IsHandEmpty()
                                        cond On(b,table)
                                        act PickUp(b)
                            sequence
                                cond On(b,table)
                                cond Holding(c)
                                act PutOn(c,b)
                        sequence
                            cond IsHandEmpty()
                            cond On(b,table)
                            cond On(c,table)
                            act PickUp(c)
                sequence
                    cond On(c,table)
                    cond On(b,table)
                    cond Holding(a)
                    act PutOn(a,c)
            sequence
                cond IsHandEmpty()
                cond On(b,table)
                cond On(c,table)
                cond On(a,table)
                act PickUp(a)
