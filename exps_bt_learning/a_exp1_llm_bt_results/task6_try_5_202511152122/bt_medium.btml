selector
    sequence
        cond In(pen,cabinet)
        cond On(book,breakfast_table)
    sequence
        cond In(pen,cabinet)
        selector
            sequence
                cond Holding(book)
                act PlaceOn(book,breakfast_table)
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                act PickUp(book)
    sequence
        cond On(book,table)
        selector
            selector
                sequence
                    cond Holding(pen)
                    selector
                        sequence
                            cond Open(cabinet)
                            act PutInStorage(pen,cabinet)
                        sequence
                            cond IsClosed(cabinet)
                            act OpenStorage(cabinet)
                sequence
                    cond IsClosed(cabinet)
                    cond On(pen,table)
                    cond IsHandEmpty()
                    act PickUp(pen)
            sequence
                cond Holding(banana)
                cond IsClosed(cabinet)
                cond On(pen,table)
                cond Open(fridge)
                act PutInStorage(banana,fridge)
