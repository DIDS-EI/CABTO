selector
    sequence
        cond IsClosed(fridge)
        cond In(banana,fridge)
    sequence
        cond Open(fridge)
        selector
            sequence
                cond In(banana,fridge)
                act CloseStorage(fridge)
            sequence
                cond Holding(banana)
                act PutInStorage(banana,fridge)
    sequence
        cond IsClosed(fridge)
        selector
            sequence
                cond Holding(banana)
                act OpenStorage(fridge)
            sequence
                cond On(banana,table)
                cond IsHandEmpty()
                act PickUp(banana)
