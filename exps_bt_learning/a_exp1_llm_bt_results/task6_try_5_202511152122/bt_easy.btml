selector
    sequence
        cond In(book,cabinet)
        cond Open(cabinet)
    sequence
        cond Open(cabinet)
        selector
            sequence
                cond Holding(book)
                act PutInStorage(book,cabinet)
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                act PickUp(book)
    sequence
        cond IsClosed(cabinet)
        cond On(book,table)
        cond IsHandEmpty()
        act OpenStorage(cabinet)
