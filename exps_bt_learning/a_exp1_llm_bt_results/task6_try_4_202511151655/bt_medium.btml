selector
    sequence
        cond In(book,fridge)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond In(pen,cabinet)
                    selector
                        sequence
                            cond Holding(book)
                            act PutIn(book,fridge)
                        sequence
                            cond On(book,table)
                            cond IsHandEmpty()
                            act PickUp(book)
                sequence
                    cond IsOpened(cabinet)
                    cond On(book,table)
                    cond Holding(pen)
                    act PutIn(pen,cabinet)
            sequence
                cond IsOpened(cabinet)
                cond On(book,table)
                cond IsHandEmpty()
                cond On(pen,table)
                act PickUp(pen)
    sequence
        cond On(book,table)
        cond IsHandEmpty()
        cond On(pen,table)
        cond IsClosed(fridge)
        selector
            sequence
                cond IsOpened(cabinet)
                act Open(fridge)
            sequence
                cond IsClosed(cabinet)
                act Open(cabinet)
