selector
    sequence
        cond In(banana,fridge)
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
    sequence
        cond In(banana,fridge)
        selector
            sequence
                cond IsOpened(cabinet)
                selector
                    selector
                        sequence
                            cond IsClosed(fridge)
                            selector
                                sequence
                                    cond In(pen,cabinet)
                                    act Close(cabinet)
                                sequence
                                    cond Holding(pen)
                                    act PutIn(pen,cabinet)
                        sequence
                            cond Holding(pen)
                            cond IsOpened(fridge)
                            act Close(fridge)
                    sequence
                        cond IsOpened(fridge)
                        cond IsHandEmpty()
                        cond On(pen,table)
                        act PickUp(pen)
            sequence
                cond IsOpened(fridge)
                cond IsHandEmpty()
                cond IsClosed(cabinet)
                cond On(pen,table)
                act Open(cabinet)
    sequence
        cond IsClosed(cabinet)
        cond On(pen,table)
        selector
            sequence
                cond IsOpened(fridge)
                selector
                    sequence
                        cond Holding(banana)
                        act PutIn(banana,fridge)
                    sequence
                        cond On(banana,table)
                        cond IsHandEmpty()
                        act PickUp(banana)
            sequence
                cond On(banana,table)
                cond IsHandEmpty()
                cond IsClosed(fridge)
                act Open(fridge)
