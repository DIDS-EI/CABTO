selector
    sequence
        cond On(a,c)
        cond On(b,d)
        cond On(c,b)
    sequence
        cond On(a,c)
        selector
            sequence
                cond Clear(d)
                selector
                    selector
                        sequence
                            cond On(c,b)
                            selector
                                sequence
                                    cond Holding(b)
                                    act Stack(b,d)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(b,a)
                                    cond Clear(b)
                                    act Unstack(b,a)
                        sequence
                            cond Holding(c)
                            cond On(b,a)
                            cond Clear(b)
                            act Stack(c,b)
                    sequence
                        cond IsHandEmpty()
                        cond Clear(c)
                        cond On(b,a)
                        cond On(c,b)
                        act Unstack(c,b)
            sequence
                cond Holding(d)
                cond Clear(c)
                cond On(b,a)
                cond On(c,b)
                act PutDown(d)
