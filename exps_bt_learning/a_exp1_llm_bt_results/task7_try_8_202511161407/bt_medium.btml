selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond Holding(soup)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    sequence
                        cond IsSwitchedOn(microwave)
                        act PutInContainer(soup,microwave)
                    sequence
                        cond IsSwitchedOff(microwave)
                        act SwitchOnDevice(microwave)
            sequence
                cond IsClosed(microwave)
                cond IsSwitchedOff(microwave)
                act OpenContainer(microwave)
    sequence
        cond On(soup,table)
        cond IsClosed(microwave)
        cond IsHandEmpty()
        cond IsSwitchedOff(microwave)
        act PickUpItem(soup)
