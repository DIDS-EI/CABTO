selector
    cond On(book,breakfast_table)
    sequence
        cond Holding(book)
        act PutDown(book,breakfast_table)
    sequence
        cond In(book,fridge)
        selector
            selector
                sequence
                    cond IsOpened(fridge)
                    selector
                        sequence
                            cond IsHandEmpty()
                            act RemoveFromContainer(book,fridge)
                        sequence
                            cond Holding(banana)
                            act PutDown(banana,breakfast_table)
                sequence
                    cond IsHandEmpty()
                    cond Holding(banana)
                    cond IsClosed(fridge)
                    act Open(fridge)
            sequence
                cond Holding(banana)
                cond Holding(pen)
                cond IsClosed(fridge)
                act PutDown(pen,table)
