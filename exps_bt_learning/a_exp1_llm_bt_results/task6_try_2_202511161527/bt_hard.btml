selector
    sequence
        cond IsClosed(fridge)
        cond In(banana,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                selector
                    sequence
                        cond In(banana,fridge)
                        selector
                            sequence
                                cond IsHandEmpty()
                                act Close(fridge)
                            sequence
                                cond Holding(book)
                                act PutDown(book,table)
                    sequence
                        cond Holding(banana)
                        cond Holding(book)
                        act StoreInContainer(banana,fridge)
                sequence
                    cond IsOpened(cabinet)
                    cond Holding(book)
                    cond IsHandEmpty()
                    cond In(banana,cabinet)
                    act RemoveFromContainer(banana,cabinet)
            sequence
                cond Holding(book)
                cond IsHandEmpty()
                cond In(banana,cabinet)
                cond IsClosed(cabinet)
                act Open(cabinet)
    sequence
        cond Holding(book)
        cond IsClosed(fridge)
        cond In(banana,cabinet)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty()
                act Open(fridge)
            sequence
                cond Holding(pen)
                act PutDown(pen,breakfast_table)
