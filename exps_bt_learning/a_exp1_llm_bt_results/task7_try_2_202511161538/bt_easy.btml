selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
        cond In(pie,oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                sequence
                    cond In(pie,oven)
                    selector
                        sequence
                            cond In(chickenleg,oven)
                            act SwitchOn(oven)
                        sequence
                            cond On(chickenleg,table)
                            cond IsOpened(oven)
                            act PutInOven(chickenleg,oven)
                sequence
                    cond On(chickenleg,table)
                    cond IsOpened(oven)
                    cond On(pie,table)
                    act PutInOven(pie,oven)
            sequence
                cond On(chickenleg,table)
                cond IsClosed(oven)
                cond On(pie,table)
                act OpenOven(oven)
