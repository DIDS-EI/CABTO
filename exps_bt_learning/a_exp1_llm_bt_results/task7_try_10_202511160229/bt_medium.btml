selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                selector
                    selector
                        selector
                            sequence
                                cond In(soup,microwave)
                                act SwitchOnLeftFranka(microwave)
                            sequence
                                cond IsClosed(microwave)
                                cond Holding(left_franka,soup)
                                act PutInMicrowaveLeftFranka(soup)
                        sequence
                            cond IsOpened(oven)
                            cond IsClosed(microwave)
                            cond In(soup,oven)
                            cond IsHandEmpty(left_franka)
                            act PickDownLeftFranka(soup,oven)
                    sequence
                        cond IsOpened(microwave)
                        cond IsOpened(oven)
                        cond IsHandEmpty(left_franka)
                        cond In(soup,oven)
                        act CloseDeviceLeftFranka(microwave)
                sequence
                    cond IsOpened(microwave)
                    cond IsHandEmpty(left_franka)
                    cond In(soup,oven)
                    cond IsClosed(oven)
                    act OpenDeviceLeftFranka(oven)
            sequence
                cond IsSwitchedOff(oven)
                cond In(soup,oven)
                cond IsClosed(oven)
                cond IsOpened(microwave)
                cond Holding(left_franka,chickenleg)
                act PutInOvenLeftFranka(chickenleg)
    sequence
        cond In(soup,oven)
        cond IsClosed(oven)
        cond IsOpened(microwave)
        cond Holding(left_franka,chickenleg)
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond IsSwitchedOff(oven)
                act SwitchOffLeftFranka(microwave)
            sequence
                cond IsSwitchedOn(oven)
                act SwitchOffLeftFranka(oven)
