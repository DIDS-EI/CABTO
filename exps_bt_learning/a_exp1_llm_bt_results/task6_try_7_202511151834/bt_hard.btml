selector
    sequence
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        cond In(banana,fridge)
        cond On(book,breakfast_table)
    sequence
        cond On(book,breakfast_table)
        selector
            selector
                selector
                    selector
                        sequence
                            cond IsClosed(cabinet)
                            selector
                                sequence
                                    cond IsOpened(fridge)
                                    selector
                                        sequence
                                            cond In(banana,fridge)
                                            cond IsHandEmpty()
                                            act Close(fridge)
                                        sequence
                                            cond Holding(banana)
                                            act StoreIn(banana,fridge)
                                sequence
                                    cond IsClosed(fridge)
                                    cond Holding(banana)
                                    cond IsHandEmpty()
                                    act Open(fridge)
                        sequence
                            cond IsOpened(cabinet)
                            cond IsClosed(fridge)
                            cond Holding(banana)
                            cond IsHandEmpty()
                            act Close(cabinet)
                    sequence
                        cond IsOpened(cabinet)
                        cond IsClosed(fridge)
                        cond Holding(apple)
                        cond Holding(banana)
                        act PutDown(apple,breakfast_table)
                sequence
                    cond On(banana,breakfast_table)
                    cond IsClosed(fridge)
                    cond Holding(apple)
                    cond On(banana,table)
                    cond IsHandEmpty()
                    cond IsOpened(cabinet)
                    act PickUp(banana)
            sequence
                cond On(banana,breakfast_table)
                cond IsClosed(fridge)
                cond Holding(apple)
                cond On(banana,table)
                cond IsOpened(cabinet)
                cond Holding(pen)
                act PutDown(pen,table)
