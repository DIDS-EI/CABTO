selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
    sequence
        cond IsOpened(microwave)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsSwitchedOn(radio)
                        selector
                            sequence
                                cond IsOpened(oven)
                                selector
                                    sequence
                                        cond Holding(pie)
                                        act PutDownOnTable(pie,breakfast_table)
                                    sequence
                                        cond IsHandEmpty()
                                        cond On(pie,table)
                                        act PickUp(pie)
                            sequence
                                cond IsHandEmpty()
                                cond IsClosed(oven)
                                cond On(pie,table)
                                act OpenOven()
                    sequence
                        cond IsHandEmpty()
                        cond IsSwitchedOff(radio)
                        cond IsClosed(oven)
                        cond On(pie,table)
                        act SwitchOnRadio()
            sequence
                cond IsClosed(oven)
                cond IsSwitchedOff(light)
                cond On(pie,table)
                cond IsHandEmpty()
                cond IsSwitchedOff(radio)
                act SwitchOnLight()
    sequence
        cond IsClosed(oven)
        cond IsSwitchedOff(light)
        cond IsClosed(microwave)
        cond On(pie,table)
        cond IsHandEmpty()
        cond IsSwitchedOff(radio)
        act OpenMicrowave()
