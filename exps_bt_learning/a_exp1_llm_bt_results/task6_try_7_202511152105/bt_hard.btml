selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        cond On(book,breakfast_table)
    sequence
        cond IsClosed(cabinet)
        selector
            selector
                selector
                    sequence
                        cond In(banana,fridge)
                        selector
                            sequence
                                cond Holding(book)
                                selector
                                    sequence
                                        cond IsClosed(fridge)
                                        act PlaceOn(book,breakfast_table)
                                    sequence
                                        cond IsOpen(fridge)
                                        act CloseContainer(fridge)
                            sequence
                                cond On(book,table)
                                cond IsHandEmpty()
                                cond IsOpen(fridge)
                                act PickUp(book)
                    sequence
                        cond On(book,table)
                        cond Holding(banana)
                        cond IsOpen(fridge)
                        act PlaceIn(banana,fridge)
                sequence
                    cond On(banana,table)
                    cond On(book,table)
                    cond IsHandEmpty()
                    cond IsOpen(fridge)
                    act PickUp(banana)
            sequence
                cond IsClosed(fridge)
                cond On(banana,table)
                cond On(book,table)
                cond IsHandEmpty()
                act OpenContainer(fridge)
