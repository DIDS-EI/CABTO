selector
    cond In(wine,fridge)
    sequence
        cond Holding(wine)
        selector
            sequence
                cond IsOpen(fridge)
                act PlaceIn(wine,fridge)
            sequence
                cond IsClosed(fridge)
                act OpenContainer(fridge)
    sequence
        cond On(wine,breakfast_table)
        cond IsHandEmpty()
        cond IsClosed(fridge)
        act PickUp(wine)
