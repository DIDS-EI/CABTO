selector
    sequence
        cond In(pie,oven)
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsClosed(oven)
        selector
            selector
                sequence
                    cond In(chickenleg,oven)
                    selector
                        sequence
                            cond IsSwitchedOn(oven)
                            selector
                                sequence
                                    cond Holding(pie)
                                    act PutIn(pie,oven)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(pie,table)
                                    act PickUp(pie)
                        sequence
                            cond IsHandEmpty()
                            cond On(pie,table)
                            cond IsSwitchedOff(oven)
                            act SwitchOn(oven)
                sequence
                    cond On(pie,table)
                    cond IsSwitchedOff(oven)
                    cond Holding(chickenleg)
                    act PutIn(chickenleg,oven)
            sequence
                cond IsHandEmpty()
                cond On(chickenleg,table)
                cond On(pie,table)
                cond IsSwitchedOff(oven)
                act PickUp(chickenleg)
