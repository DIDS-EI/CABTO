selector
    sequence
        cond In(pen,cabinet)
        cond IsClosed(fridge)
        cond In(banana,fridge)
        cond IsClosed(cabinet)
    sequence
        cond In(banana,fridge)
        selector
            selector
                sequence
                    cond IsOpened(cabinet)
                    selector
                        sequence
                            cond IsClosed(fridge)
                            selector
                                sequence
                                    cond In(pen,cabinet)
                                    act CloseCabinet(cabinet)
                                sequence
                                    cond Holding(pen)
                                    act PutInCabinet(pen)
                        sequence
                            cond Holding(pen)
                            cond IsOpened(fridge)
                            act CloseFridge(fridge)
                sequence
                    cond IsOpened(fridge)
                    cond Holding(pen)
                    cond IsClosed(cabinet)
                    act OpenCabinet(cabinet)
            sequence
                cond IsOpened(fridge)
                cond IsHandEmpty()
                cond On(pen,breakfast_table)
                cond IsClosed(cabinet)
                act PickUpFromBreakfastTable(pen)
    sequence
        cond On(pen,breakfast_table)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsOpened(fridge)
                selector
                    sequence
                        cond Holding(banana)
                        act PutInFridge(banana)
                    sequence
                        cond IsHandEmpty()
                        cond On(banana,table)
                        act PickUpFromTable(banana)
            sequence
                cond IsClosed(fridge)
                cond IsHandEmpty()
                cond On(banana,table)
                act OpenFridge(fridge)
