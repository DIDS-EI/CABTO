selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    sequence
                        cond Holding(chickenleg)
                        act DropInOven(chickenleg)
                    sequence
                        cond On(chickenleg,table)
                        cond IsHandEmpty()
                        act PickUp(chickenleg)
            sequence
                cond On(chickenleg,table)
                cond IsSwitchedOff(oven)
                cond IsHandEmpty()
                act SwitchOnOven()
    sequence
        cond On(chickenleg,table)
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond IsHandEmpty()
        act OpenOven()
