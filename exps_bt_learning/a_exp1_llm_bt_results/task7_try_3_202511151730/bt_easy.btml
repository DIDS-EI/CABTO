selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            sequence
                cond Holding(chickenleg)
                selector
                    sequence
                        cond IsOpened(oven)
                        act PutInOven(chickenleg)
                    sequence
                        cond IsClosed(oven)
                        act Open(oven)
            sequence
                cond On(chickenleg,table)
                cond IsClosed(oven)
                cond IsHandEmpty()
                act PickUp(chickenleg)
    sequence
        cond On(chickenleg,table)
        cond IsClosed(oven)
        cond IsHandEmpty()
        cond IsSwitchedOff(oven)
        act SwitchOn(oven)
