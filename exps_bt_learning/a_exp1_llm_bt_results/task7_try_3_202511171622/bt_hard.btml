selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsOpened(microwave)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsSwitchedOn(radio)
                        selector
                            sequence
                                cond Holding(pie)
                                selector
                                    sequence
                                        cond IsOpened(oven)
                                        act PutOnBreakfastTable(pie)
                                    sequence
                                        cond IsClosed(oven)
                                        act Open(oven)
                            sequence
                                cond IsHandEmpty()
                                cond On(pie,table)
                                cond IsClosed(oven)
                                act PickUp(pie)
                    sequence
                        cond IsHandEmpty()
                        cond On(pie,table)
                        cond IsSwitchedOff(radio)
                        cond IsClosed(oven)
                        act SwitchOn(radio)
            sequence
                cond On(pie,table)
                cond IsSwitchedOff(light)
                cond IsSwitchedOff(radio)
                cond IsClosed(oven)
                cond IsHandEmpty()
                act SwitchOn(light)
    sequence
        cond On(pie,table)
        cond IsClosed(microwave)
        cond IsSwitchedOff(light)
        cond IsSwitchedOff(radio)
        cond IsClosed(oven)
        cond IsHandEmpty()
        act Open(microwave)
