selector
    cond On(center_big_box,box_board)
    sequence
        cond On(box_board,center_table)
        selector
            selector
                sequence
                    cond Holding(left_franka,center_big_box)
                    act PutOnLeftFranka(center_big_box,box_board)
                sequence
                    cond On(left_franka,left_table)
                    cond On(center_big_box,left_table)
                    cond IsHandEmpty(left_franka)
                    act PickUpLeftFranka(center_big_box)
            sequence
                cond On(center_big_box,left_table)
                cond On(left_franka,left_table)
                cond Holding(left_franka,left_lego)
                cond On(center_big_box,center_table)
                act PutInLeftFranka(left_lego,center_big_box)
