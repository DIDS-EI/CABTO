selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                selector
                    selector
                        selector
                            sequence
                                cond In(soup,microwave)
                                act SwitchOn(microwave)
                            sequence
                                cond IsOpened(microwave)
                                cond Holding(soup)
                                act PutIn(soup,microwave)
                        sequence
                            cond On(soup,table)
                            cond IsOpened(microwave)
                            cond IsHandEmpty()
                            act PickUp(soup)
                    sequence
                        cond On(soup,table)
                        cond IsOpened(microwave)
                        cond Holding(chickenleg)
                        cond IsOpened(oven)
                        act PutIn(chickenleg,oven)
                sequence
                    cond On(soup,table)
                    cond Holding(chickenleg)
                    cond IsClosed(microwave)
                    cond IsOpened(oven)
                    act Open(microwave)
            sequence
                cond On(soup,table)
                cond Holding(chickenleg)
                cond IsClosed(microwave)
                cond IsClosed(oven)
                act Open(oven)
