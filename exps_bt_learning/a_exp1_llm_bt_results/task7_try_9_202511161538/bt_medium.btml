selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond On(right_franka,microwave)
        selector
            selector
                sequence
                    cond IsSwitchedOff(microwave)
                    selector
                        selector
                            selector
                                selector
                                    selector
                                        selector
                                            selector
                                                selector
                                                    sequence
                                                        cond In(soup,microwave)
                                                        selector
                                                            sequence
                                                                cond IsClosed(microwave)
                                                                act SwitchOnMicrowaveRightFranka()
                                                            sequence
                                                                cond IsOpened(microwave)
                                                                act CloseMicrowaveRightFranka()
                                                    sequence
                                                        cond Holding(right_franka,soup)
                                                        cond IsOpened(microwave)
                                                        act PutInMicrowaveRightFranka(soup)
                                                sequence
                                                    cond On(soup,table)
                                                    cond IsHandEmpty(right_franka)
                                                    cond On(right_franka,table)
                                                    cond IsOpened(microwave)
                                                    act PickUpRightFranka(soup)
                                            sequence
                                                cond On(soup,table)
                                                cond IsClosed(microwave)
                                                cond IsHandEmpty(right_franka)
                                                cond On(right_franka,table)
                                                act OpenMicrowaveRightFranka()
                                        sequence
                                            cond On(right_franka,table)
                                            cond IsClosed(microwave)
                                            cond Holding(left_franka,soup)
                                            cond IsHandEmpty(right_franka)
                                            cond On(left_franka,table)
                                            act DropLeftFranka(soup,table)
                                    sequence
                                        cond On(right_franka,table)
                                        cond IsClosed(microwave)
                                        cond Holding(left_franka,soup)
                                        cond IsHandEmpty(right_franka)
                                        cond IsHandEmpty(left_franka)
                                        act MoveLeftFranka(table)
                                sequence
                                    cond On(right_franka,table)
                                    cond IsOpened(oven)
                                    cond IsClosed(microwave)
                                    cond Holding(left_franka,soup)
                                    cond IsHandEmpty(right_franka)
                                    cond On(left_franka,oven)
                                    cond Holding(left_franka,pie)
                                    act PutInOvenLeftFranka(pie)
                            sequence
                                cond On(right_franka,table)
                                cond IsClosed(oven)
                                cond IsClosed(microwave)
                                cond IsSwitchedOff(oven)
                                cond Holding(left_franka,soup)
                                cond IsHandEmpty(right_franka)
                                cond On(left_franka,oven)
                                cond Holding(left_franka,pie)
                                act OpenOvenLeftFranka()
                        sequence
                            cond On(right_franka,table)
                            cond IsClosed(oven)
                            cond IsClosed(microwave)
                            cond Holding(left_franka,soup)
                            cond IsSwitchedOn(oven)
                            cond IsHandEmpty(right_franka)
                            cond On(left_franka,oven)
                            cond Holding(left_franka,pie)
                            act SwitchOffOvenLeftFranka()
                sequence
                    cond On(right_franka,table)
                    cond IsClosed(oven)
                    cond IsClosed(microwave)
                    cond Holding(left_franka,soup)
                    cond IsSwitchedOn(oven)
                    cond IsHandEmpty(right_franka)
                    cond On(left_franka,oven)
                    cond IsSwitchedOn(microwave)
                    cond Holding(left_franka,pie)
                    act SwitchOffMicrowaveRightFranka()
            sequence
                cond On(right_franka,table)
                cond IsClosed(oven)
                cond Holding(right_franka,pie)
                cond IsClosed(microwave)
                cond Holding(left_franka,soup)
                cond IsSwitchedOn(oven)
                cond On(left_franka,oven)
                cond IsSwitchedOn(microwave)
                cond Holding(left_franka,pie)
                act DropRightFranka(pie,table)
