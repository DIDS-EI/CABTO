selector
    sequence
        cond In(wine,fridge)
        cond IsOpened(fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond Holding(wine)
                    act PlaceIn(wine,fridge)
                sequence
                    cond On(wine,table)|On(wine,breakfast_table)
                    cond IsHandEmpty()
                    act PickUp(wine)
            sequence
                cond IsOpened(cabinet)
                cond On(wine,table)|On(wine,breakfast_table)
                cond Holding(pen)
                act PlaceIn(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        cond On(wine,table)|On(wine,breakfast_table)
        cond IsClosed(fridge)
        cond Holding(pen)
        selector
            sequence
                cond IsHandEmpty()
                act Open(fridge)
            sequence
                cond Holding(banana)
                act PlaceIn(banana,cabinet)
