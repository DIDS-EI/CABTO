selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            sequence
                                cond IsOpened(microwave)
                                selector
                                    sequence
                                        cond IsSwitchedOn(radio)
                                        act PlaceOnTable(pie,breakfast_table)
                                    sequence
                                        cond IsSwitchedOff(radio)
                                        act SwitchOn(radio)
                            sequence
                                cond IsSwitchedOff(radio)
                                cond IsClosed(microwave)
                                act Open(microwave)
                    sequence
                        cond IsClosed(microwave)
                        cond IsSwitchedOff(radio)
                        cond IsClosed(oven)
                        act Open(oven)
            sequence
                cond IsSwitchedOff(light)
                cond IsSwitchedOff(radio)
                cond IsClosed(microwave)
                cond IsClosed(oven)
                act SwitchOn(light)
    sequence
        cond IsHandEmpty()
        cond IsClosed(oven)
        cond On(pie,table)
        cond IsSwitchedOff(light)
        cond IsSwitchedOff(radio)
        cond IsClosed(microwave)
        act PickUp(pie)
