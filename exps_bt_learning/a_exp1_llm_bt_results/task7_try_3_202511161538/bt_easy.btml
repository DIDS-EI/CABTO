selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
        cond In(pie,oven)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            sequence
                                cond In(chickenleg,oven)
                                act PutIn(pie,oven)
                            sequence
                                cond Holding(chickenleg)
                                act PutIn(chickenleg,oven)
                    sequence
                        cond Holding(chickenleg)
                        cond IsClosed(oven)
                        act OpenContainer(oven)
            sequence
                cond Holding(chickenleg)
                cond IsSwitchedOff(oven)
                cond IsClosed(oven)
                act SwitchOn(oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond On(pie,table)
        selector
            sequence
                cond Holding(chickenleg)
                selector
                    sequence
                        cond IsHandEmpty()
                        act PickUp(pie)
                    act Release()
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                act PickUp(chickenleg)
