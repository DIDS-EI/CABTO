selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsSwitchedOn(radio)
                        selector
                            sequence
                                cond IsOpened(oven)
                                selector
                                    sequence
                                        cond IsOpened(microwave)
                                        act PutOn(pie,breakfast_table)
                                    sequence
                                        cond IsClosed(microwave)
                                        act OpenContainer(microwave)
                            sequence
                                cond IsClosed(microwave)
                                cond IsClosed(oven)
                                act OpenContainer(oven)
                    sequence
                        cond IsClosed(microwave)
                        cond IsSwitchedOff(radio)
                        cond IsClosed(oven)
                        act SwitchOn(radio)
            sequence
                cond IsSwitchedOff(light)
                cond IsClosed(microwave)
                cond IsSwitchedOff(radio)
                cond IsClosed(oven)
                act SwitchOn(light)
    sequence
        cond IsClosed(oven)
        cond IsSwitchedOff(light)
        cond IsClosed(microwave)
        cond On(pie,table)
        cond IsHandEmpty()
        cond IsSwitchedOff(radio)
        act PickUp(pie)
