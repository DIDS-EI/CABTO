selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond Holding(book)
        selector
            selector
                sequence
                    cond IsOpened(cabinet)
                    selector
                        selector
                            sequence
                                cond In(pen,cabinet)
                                act PutIn(book,cabinet)
                            sequence
                                cond Holding(pen)
                                act PutIn(pen,cabinet)
                        sequence
                            cond IsHandEmpty()
                            cond On(pen,table)orOn(pen,breakfast_table)
                            act PickUp(pen)
                sequence
                    cond IsClosed(cabinet)
                    cond IsHandEmpty()
                    cond On(pen,table)orOn(pen,breakfast_table)
                    act Open(cabinet)
            sequence
                cond IsClosed(cabinet)
                cond Holding(banana)
                cond On(pen,table)orOn(pen,breakfast_table)
                act PutOn(banana,breakfast_table)
    sequence
        cond IsClosed(cabinet)
        cond On(book,table)orOn(book,breakfast_table)
        cond Holding(banana)
        cond On(pen,table)orOn(pen,breakfast_table)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(book)
            sequence
                cond Holding(apple)
                act PutOn(apple,breakfast_table)
