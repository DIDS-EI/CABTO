selector
    sequence
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond On(book,breakfast_table)
        cond In(banana,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond In(banana,fridge)
                    selector
                        sequence
                            cond IsClosed(cabinet)
                            selector
                                selector
                                    sequence
                                        cond On(book,breakfast_table)
                                        cond IsHandEmpty()
                                        act Close(fridge)
                                    sequence
                                        cond Holding(book)
                                        act PutOn(book,breakfast_table)
                                sequence
                                    cond On(book,table)orOn(book,breakfast_table)
                                    cond IsHandEmpty()
                                    act PickUp(book)
                        sequence
                            cond IsOpened(cabinet)
                            cond On(book,table)orOn(book,breakfast_table)
                            cond IsHandEmpty()
                            act Close(cabinet)
                sequence
                    cond IsOpened(cabinet)
                    cond On(book,table)orOn(book,breakfast_table)
                    cond Holding(banana)
                    act PutIn(banana,fridge)
            sequence
                cond IsOpened(cabinet)
                cond On(book,table)orOn(book,breakfast_table)
                cond On(banana,table)orOn(banana,breakfast_table)
                cond IsHandEmpty()
                act PickUp(banana)
    sequence
        cond IsOpened(cabinet)
        cond IsClosed(fridge)
        cond On(book,table)orOn(book,breakfast_table)
        cond On(banana,table)orOn(banana,breakfast_table)
        selector
            sequence
                cond IsHandEmpty()
                act Open(fridge)
            sequence
                cond Holding(apple)
                act PutIn(apple,cabinet)
