selector
    sequence
        cond In(wine,fridge)
        cond IsOpened(fridge)
    sequence
        cond Holding(wine)
        selector
            sequence
                cond IsOpened(fridge)
                act PlaceIn(wine,fridge)
            sequence
                cond IsClosed(fridge)
                act Open(fridge)
    sequence
        cond IsClosed(fridge)
        cond On(wine,breakfast_table)
        cond IsHandEmpty()
        act PickUp(wine,breakfast_table)
