selector
    sequence
        cond On(apple,breakfast_table)
        cond IsOpened(fridge)
        cond In(wine,fridge)
    sequence
        cond Holding(wine)
        selector
            sequence
                cond IsOpened(fridge)
                selector
                    sequence
                        cond On(apple,breakfast_table)
                        act PlaceIn(wine,fridge)
                    sequence
                        cond Holding(apple)
                        act PlaceOn(apple,breakfast_table)
            sequence
                cond IsClosed(fridge)
                cond Holding(apple)
                act OpenObject(fridge)
    sequence
        cond On(wine,breakfast_table)
        cond IsClosed(fridge)
        cond Holding(apple)
        cond On(wine,table)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(wine)
            sequence
                cond Holding(book)
                act PlaceOn(book,breakfast_table)
