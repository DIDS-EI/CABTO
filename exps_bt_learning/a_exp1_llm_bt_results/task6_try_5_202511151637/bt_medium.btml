selector
    sequence
        cond In(banana,fridge)
        cond Open(fridge)
        cond In(pen,cabinet)
    sequence
        cond Open(fridge)
        selector
            selector
                sequence
                    cond In(pen,cabinet)
                    selector
                        sequence
                            cond Holding(banana)
                            act PutInFridge(banana)
                        sequence
                            cond IsHandEmpty()
                            cond On(banana,table)
                            act PickUp(banana)
                sequence
                    cond Open(cabinet)
                    cond Holding(pen)
                    cond On(banana,table)
                    act PutInCabinet(pen)
            sequence
                cond On(pen,table)
                cond Open(cabinet)
                cond IsHandEmpty()
                cond On(banana,table)
                act PickUp(pen)
    sequence
        cond On(pen,table)
        cond IsClosed(fridge)
        cond IsHandEmpty()
        cond On(banana,table)
        selector
            sequence
                cond Open(cabinet)
                act OpenContainer(fridge)
            sequence
                cond IsClosed(cabinet)
                act OpenContainer(cabinet)
