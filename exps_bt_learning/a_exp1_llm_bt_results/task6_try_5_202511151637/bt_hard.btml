selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(book,cabinet)
        cond In(apple,fridge)
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
    sequence
        cond IsClosed(cabinet)
        cond Open(fridge)
        selector
            selector
                sequence
                    cond In(apple,fridge)
                    selector
                        selector
                            sequence
                                cond In(banana,fridge)
                                selector
                                    sequence
                                        cond In(pen,cabinet)
                                        selector
                                            sequence
                                                cond In(book,cabinet)
                                                cond IsHandEmpty()
                                                act CloseContainer(fridge)
                                            sequence
                                                cond Open(cabinet)
                                                cond Holding(book)
                                                act PutInCabinet(book)
                                    sequence
                                        cond Open(cabinet)
                                        cond Holding(pen)
                                        cond Holding(book)
                                        act PutInCabinet(pen)
                            sequence
                                cond Open(cabinet)
                                cond Holding(pen)
                                cond Holding(book)
                                cond Holding(banana)
                                act PutInFridge(banana)
                        sequence
                            cond Holding(book)
                            cond Open(cabinet)
                            cond IsHandEmpty()
                            cond Holding(pen)
                            cond On(banana,table)
                            act PickUp(banana)
                sequence
                    cond Holding(book)
                    cond Holding(apple)
                    cond Open(cabinet)
                    cond Holding(pen)
                    cond On(banana,table)
                    act PutInFridge(apple)
            sequence
                cond Holding(book)
                cond On(apple,table)
                cond Open(cabinet)
                cond IsHandEmpty()
                cond Holding(pen)
                cond On(banana,table)
                act PickUp(apple)
