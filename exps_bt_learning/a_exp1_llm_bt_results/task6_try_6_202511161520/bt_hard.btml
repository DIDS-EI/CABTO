selector
    sequence
        cond In(pen,cabinet)
        cond IsClosed(fridge)
        cond In(banana,fridge)
        cond IsClosed(cabinet)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                selector
                    sequence
                        cond In(banana,fridge)
                        selector
                            selector
                                sequence
                                    cond In(pen,cabinet)
                                    cond IsHandEmpty()
                                    selector
                                        sequence
                                            cond IsClosed(cabinet)
                                            act CloseContainer(fridge)
                                        sequence
                                            cond IsOpened(cabinet)
                                            act CloseContainer(cabinet)
                                sequence
                                    cond IsOpened(cabinet)
                                    cond Holding(pen)
                                    act PutIn(pen,cabinet)
                            sequence
                                cond IsOpened(cabinet)
                                cond On(pen,table)orOn(pen,breakfast_table)
                                cond IsHandEmpty()
                                act PickUp(pen)
                    sequence
                        cond IsOpened(cabinet)
                        cond Holding(banana)
                        cond On(pen,table)orOn(pen,breakfast_table)
                        act PutIn(banana,fridge)
                sequence
                    cond IsOpened(cabinet)
                    cond On(pen,table)orOn(pen,breakfast_table)
                    cond On(banana,table)orOn(banana,breakfast_table)
                    cond IsHandEmpty()
                    act PickUp(banana)
            sequence
                cond IsHandEmpty()
                cond On(pen,table)orOn(pen,breakfast_table)
                cond On(banana,table)orOn(banana,breakfast_table)
                cond IsClosed(cabinet)
                act OpenContainer(cabinet)
    sequence
        cond IsClosed(fridge)
        cond On(pen,table)orOn(pen,breakfast_table)
        cond On(banana,table)orOn(banana,breakfast_table)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty()
                act OpenContainer(fridge)
            sequence
                cond Holding(banana)
                act PlaceOn(banana,table)
