selector
    sequence
        cond On(left_milk,left_table)
        cond IsHalfFull(right_cup)
        cond On(right_milk,right_table)
        cond IsHandEmpty(right_franka)
        cond IsHandEmpty(left_franka)
        cond IsHalfFull(left_cup)
    sequence
        cond IsEmpty(right_cup)
        cond IsFull(left_milk)
        cond CupNeedGraspAndSupport()
        cond Holding(right_franka,left_milk)
        selector
            sequence
                cond IsHalfFull(left_cup)
                selector
                    sequence
                        cond On(left_milk,left_table)
                        cond IsHandEmpty(left_franka)
                        selector
                            sequence
                                cond On(right_milk,right_table)
                                act PourRightFrankaIntoCup(left_milk,right_cup)
                            sequence
                                cond Holding(right_franka,right_milk)
                                act PlaceRightFrankaMilk(right_milk)
                    sequence
                        cond Holding(right_franka,right_milk)
                        cond Holding(left_franka,left_milk)
                        act PlaceLeftFrankaMilk(left_milk)
            sequence
                cond IsEmpty(left_cup)
                cond Holding(left_franka,right_milk)
                cond Holding(left_franka,left_milk)
                cond Holding(right_franka,right_milk)
                cond IsFull(right_milk)
                act PourLeftFrankaIntoCup(right_milk,left_cup)
