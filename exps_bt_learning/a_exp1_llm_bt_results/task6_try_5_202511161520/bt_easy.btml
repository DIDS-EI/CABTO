selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            selector
                sequence
                    cond Holding(book)
                    act PlaceIn(book,cabinet)
                sequence
                    cond IsHandEmpty()
                    cond On(book,table)
                    cond On(book,breakfast_table)
                    act PickUp(book)
            sequence
                cond Holding(banana)
                cond On(book,table)
                cond On(book,breakfast_table)
                act PlaceIn(banana,cabinet)
    sequence
        cond Holding(banana)
        cond On(book,table)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty()
                cond On(book,breakfast_table)
                act Open(cabinet)
            sequence
                cond Holding(book)
                act PlaceOn(book,breakfast_table)
