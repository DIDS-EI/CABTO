selector
    sequence
        cond In(pen,cabinet)
        cond IsClosed(fridge)
        cond In(banana,fridge)
        cond IsClosed(cabinet)
    sequence
        cond In(pen,cabinet)
        selector
            sequence
                cond IsClosed(cabinet)
                selector
                    sequence
                        cond IsOpened(fridge)
                        selector
                            sequence
                                cond IsHandEmpty()
                                cond In(banana,fridge)
                                act Close(fridge)
                            sequence
                                cond Holding(banana)
                                act PlaceIn(banana,fridge)
                    sequence
                        cond IsClosed(fridge)
                        cond Holding(banana)
                        cond IsHandEmpty()
                        act Open(fridge)
            sequence
                cond Holding(banana)
                cond IsClosed(fridge)
                cond IsOpened(cabinet)
                cond IsHandEmpty()
                act Close(cabinet)
    sequence
        cond IsClosed(fridge)
        selector
            selector
                sequence
                    cond Holding(banana)
                    selector
                        selector
                            sequence
                                cond IsOpened(cabinet)
                                selector
                                    sequence
                                        cond Holding(pen)
                                        act PlaceIn(pen,cabinet)
                                    sequence
                                        cond IsHandEmpty()
                                        cond On(pen,breakfast_table)
                                        cond On(pen,table)
                                        act PickUp(pen)
                            sequence
                                cond On(pen,table)
                                cond IsHandEmpty()
                                cond On(pen,breakfast_table)
                                cond IsClosed(cabinet)
                                act Open(cabinet)
                        sequence
                            cond Holding(book)
                            cond On(pen,table)
                            cond On(pen,breakfast_table)
                            cond IsClosed(cabinet)
                            act PlaceOn(book,breakfast_table)
                sequence
                    cond On(pen,breakfast_table)
                    cond IsClosed(cabinet)
                    cond Holding(book)
                    cond On(pen,table)
                    cond On(banana,breakfast_table)
                    cond IsHandEmpty()
                    cond On(banana,table)
                    act PickUp(banana)
            sequence
                cond Holding(cake)
                cond On(pen,breakfast_table)
                cond IsClosed(cabinet)
                cond Holding(book)
                cond On(pen,table)
                cond On(banana,breakfast_table)
                cond On(banana,table)
                act PlaceOn(cake,breakfast_table)
