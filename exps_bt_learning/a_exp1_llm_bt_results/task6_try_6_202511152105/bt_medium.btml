selector
    sequence
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond IsOpen(cabinet)
        selector
            selector
                selector
                    sequence
                        cond Holding(pen)
                        selector
                            sequence
                                cond In(book,cabinet)
                                act DropIn(pen,cabinet)
                            sequence
                                cond Holding(book)
                                act DropIn(book,cabinet)
                    sequence
                        cond On(pen,breakfast_table)
                        cond On(pen,table)
                        cond IsHandEmpty()
                        cond Holding(book)
                        act PickUp(pen)
                sequence
                    cond On(pen,breakfast_table)
                    cond On(pen,table)
                    cond Holding(apple)
                    cond Holding(book)
                    act DropOn(apple,breakfast_table)
            sequence
                cond On(book,table)
                cond On(pen,breakfast_table)
                cond On(pen,table)
                cond IsHandEmpty()
                cond Holding(apple)
                cond On(book,breakfast_table)
                act PickUp(book)
    sequence
        cond On(book,table)
        cond On(pen,breakfast_table)
        cond On(pen,table)
        cond Holding(apple)
        cond On(book,breakfast_table)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty()
                act Open(cabinet)
            sequence
                cond Holding(wine)
                act DropOn(wine,breakfast_table)
