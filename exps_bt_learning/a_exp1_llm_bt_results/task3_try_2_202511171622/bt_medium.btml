selector
    cond In(right_lego,center_big_box)
    sequence
        cond BigBoxNeedTwoFrankaHoldTogether()
        selector
            selector
                sequence
                    cond Holding(left_franka,center_big_box)
                    selector
                        selector
                            sequence
                                cond Holding(right_franka,right_lego)
                                act DropRightFranka(right_lego,center_big_box)
                            sequence
                                cond IsHandEmpty(right_franka)
                                cond On(right_lego,right_table)
                                cond On(right_franka,right_table)
                                act PickUpRightFranka(right_lego)
                        sequence
                            cond Holding(right_franka,center_big_box)
                            cond On(right_lego,right_table)
                            cond On(right_franka,right_table)
                            act DropRightFranka(center_big_box,box_board)
                sequence
                    cond On(center_big_box,left_table)
                    cond IsHandEmpty(left_franka)
                    cond On(right_franka,right_table)
                    cond On(right_lego,right_table)
                    cond Holding(right_franka,center_big_box)
                    cond On(left_franka,left_table)
                    act PickUpLeftFranka(center_big_box)
            sequence
                cond On(center_big_box,left_table)
                cond Holding(left_franka,left_lego)
                cond On(right_franka,right_table)
                cond On(right_lego,right_table)
                cond Holding(right_franka,center_big_box)
                cond On(left_franka,left_table)
                act DropLeftFranka(left_lego,center_big_box)
