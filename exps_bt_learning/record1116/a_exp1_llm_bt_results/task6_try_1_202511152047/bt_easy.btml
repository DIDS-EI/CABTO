selector
    cond In(wine,fridge)
    sequence
        cond Holding(wine)
        selector
            sequence
                cond IsOpened(fridge)
                act PutIn(wine,fridge)
            sequence
                cond IsClosed(fridge)
                act Open(fridge)
    sequence
        cond On(wine,breakfast_table)
        cond IsClosed(fridge)
        cond On(wine,table)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(wine)
            sequence
                cond Holding(apple)
                act PutOn(apple,breakfast_table)
