selector
    cond In(wine,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond Holding(wine)
                act PutIn(wine,fridge)
            sequence
                cond On(wine,breakfast_table)
                cond IsHandEmpty()
                act PickUpFromBreakfastTable(wine)
    sequence
        cond On(wine,breakfast_table)
        cond IsClosed(fridge)
        cond IsHandEmpty()
        act Open(fridge)
