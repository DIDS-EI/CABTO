selector
    sequence
        cond On(a,c)
        cond On(b,d)
        cond On(c,b)
    sequence
        cond On(b,d)
        selector
            selector
                sequence
                    cond On(c,b)
                    selector
                        sequence
                            cond Holding(a)
                            act PutDownOn(a,c)
                        sequence
                            cond IsHandEmpty()
                            cond On(a,table)
                            act PickUp(a)
                sequence
                    cond Holding(c)
                    cond On(a,table)
                    act PutDownOn(c,b)
            sequence
                cond IsHandEmpty()
                cond On(c,table)
                cond On(a,table)
                act PickUp(c)
    sequence
        cond On(c,table)
        cond On(a,table)
        selector
            sequence
                cond Holding(b)
                act PutDownOn(b,d)
            sequence
                cond IsHandEmpty()
                cond On(b,table)
                act PickUp(b)
