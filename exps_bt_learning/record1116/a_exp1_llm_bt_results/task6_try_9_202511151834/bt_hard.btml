selector
    sequence
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        cond In(banana,fridge)
        cond On(book,breakfast_table)
    sequence
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsOpened(fridge)
                selector
                    sequence
                        cond On(book,breakfast_table)
                        selector
                            sequence
                                cond In(banana,fridge)
                                act CloseObject(fridge)
                            sequence
                                cond Holding(banana)
                                act PlaceIn(banana,fridge)
                    sequence
                        cond Holding(book)
                        cond Holding(banana)
                        act PlaceOn(book,breakfast_table)
            sequence
                cond IsClosed(fridge)
                cond Holding(book)
                cond Holding(banana)
                act OpenObject(fridge)
    sequence
        cond IsOpened(cabinet)
        cond IsClosed(fridge)
        cond Holding(book)
        selector
            selector
                sequence
                    cond Holding(banana)
                    act CloseObject(cabinet)
                sequence
                    cond On(banana,table)
                    cond IsHandEmpty()
                    cond On(banana,breakfast_table)
                    act PickUp(banana)
            sequence
                cond Holding(apple)
                cond On(banana,table)
                cond On(banana,breakfast_table)
                act PlaceOnTable(apple)
