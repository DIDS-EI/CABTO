selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            sequence
                cond Holding(chickenleg)
                selector
                    sequence
                        cond IsOpened(oven)
                        act PlaceInDevice(chickenleg,oven)
                    sequence
                        cond IsClosed(oven)
                        act OpenDevice(oven)
            sequence
                cond IsClosed(oven)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                act PickUp(chickenleg)
    sequence
        cond IsClosed(oven)
        cond On(chickenleg,table)
        cond IsSwitchedOff(oven)
        cond IsHandEmpty()
        act SwitchOnDevice(oven)
