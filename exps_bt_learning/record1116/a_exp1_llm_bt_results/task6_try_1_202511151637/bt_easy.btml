selector
    sequence
        cond Open(cabinet)
        cond In(apple,fridge)
    sequence
        cond Open(fridge)
        selector
            sequence
                cond Open(cabinet)
                selector
                    selector
                        sequence
                            cond Holding(left_franka,apple)
                            act PlaceInFridge(left_franka,apple)
                        sequence
                            cond On(apple,table)
                            cond IsHandEmpty(left_franka)
                            act PickUp(left_franka,apple)
                    sequence
                        cond On(apple,table)
                        cond Holding(left_franka,book)
                        act PlaceInCabinet(left_franka,book)
            sequence
                cond IsClosed(cabinet)
                cond Holding(left_franka,book)
                cond On(apple,table)
                act OpenCabinet(right_franka)
    sequence
        cond IsClosed(cabinet)
        cond Holding(left_franka,book)
        cond On(apple,table)
        cond IsClosed(fridge)
        act OpenFridge(left_franka)
