selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                selector
                    sequence
                        cond In(soup,microwave)
                        act SwitchOnMicrowave()
                    sequence
                        cond Holding(soup)
                        cond IsOpened(microwave)
                        act PutInMicrowave(soup)
                sequence
                    cond IsOpened(microwave)
                    cond IsHandEmpty()
                    cond On(soup,table)
                    act PickUp(soup)
            sequence
                cond IsHandEmpty()
                cond IsClosed(microwave)
                cond On(soup,table)
                act OpenMicrowave()
