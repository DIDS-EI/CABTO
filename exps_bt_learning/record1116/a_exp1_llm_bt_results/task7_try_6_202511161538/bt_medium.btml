selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond Holding(soup)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PutInContainer(soup,microwave)
                    sequence
                        cond IsClosed(microwave)
                        act OpenMicrowave()
            sequence
                cond On(soup,table)
                cond IsHandEmpty()
                cond IsClosed(microwave)
                act PickUp(soup)
    sequence
        cond On(soup,table)
        cond IsHandEmpty()
        cond IsSwitchedOff(microwave)
        cond IsClosed(microwave)
        act SwitchOnMicrowave()
