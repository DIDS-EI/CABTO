selector
    sequence
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond On(book,breakfast_table)
        cond In(banana,fridge)
    sequence
        cond IsClosed(cabinet)
        selector
            selector
                sequence
                    cond On(book,breakfast_table)
                    selector
                        sequence
                            cond IsOpened(fridge)
                            selector
                                selector
                                    sequence
                                        cond In(banana,fridge)
                                        act Close(fridge)
                                    sequence
                                        cond Holding(banana)
                                        act PlaceIn(banana,fridge)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(banana,table)
                                    act PickUp(banana,table)
                        sequence
                            cond IsHandEmpty()
                            cond IsClosed(fridge)
                            cond On(banana,table)
                            act Open(fridge)
                sequence
                    cond IsClosed(fridge)
                    cond Holding(book)
                    cond On(banana,table)
                    act PlaceOnBreakfastTable(book)
            sequence
                cond IsHandEmpty()
                cond IsClosed(fridge)
                cond On(book,table)
                cond On(banana,table)
                act PickUp(book,table)
