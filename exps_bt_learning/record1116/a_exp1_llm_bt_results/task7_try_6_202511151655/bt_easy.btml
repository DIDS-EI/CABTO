selector
    sequence
        cond IsOpened(oven)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsClosed(oven)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                act Open(oven)
            sequence
                cond IsSwitchedOff(microwave)
                act TurnOn(microwave)
