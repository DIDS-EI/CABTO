selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond IsNoIsClosedIn(microwave)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    sequence
                        cond IsSwitchedOn(light)
                        selector
                            sequence
                                cond Holding(soup)
                                act PlaceIn(soup,microwave)
                            sequence
                                cond On(soup,table)
                                cond IsHandEmpty()
                                act PickUp(soup)
                    sequence
                        cond IsSwitchedOff(light)
                        cond On(soup,table)
                        cond IsHandEmpty()
                        act TurnOn(light)
            sequence
                cond IsSwitchedOff(light)
                cond On(soup,table)
                cond IsHandEmpty()
                cond IsSwitchedOff(microwave)
                act TurnOn(microwave)
