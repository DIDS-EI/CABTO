selector
    sequence
        cond On(apple,breakfast_table)
        cond IsOpened(fridge)
        cond In(wine,fridge)
    sequence
        cond Holding(apple)
        selector
            selector
                sequence
                    cond IsOpened(fridge)
                    selector
                        selector
                            sequence
                                cond In(wine,fridge)
                                act PlaceOn(apple,breakfast_table)
                            sequence
                                cond Holding(wine)
                                act PlaceInFridge(wine)
                        sequence
                            cond IsHandEmpty()
                            cond On(wine,table)
                            act PickUp(wine)
                sequence
                    cond IsClosed(fridge)
                    cond IsHandEmpty()
                    cond On(wine,table)
                    act OpenFridge()
            sequence
                cond IsClosed(fridge)
                cond Holding(book)
                cond On(wine,table)
                act PlaceOn(book,table)
    sequence
        cond On(apple,table)
        cond IsClosed(fridge)
        cond Holding(book)
        cond On(wine,table)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(apple)
            sequence
                cond IsOpened(cabinet)
                cond Holding(pen)
                act PlaceInCabinet(pen)
