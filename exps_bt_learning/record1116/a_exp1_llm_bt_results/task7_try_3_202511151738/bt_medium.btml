selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    selector
                        selector
                            sequence
                                cond Holding(soup)
                                act PutInMicrowave(soup)
                            sequence
                                cond On(soup,table)
                                cond IsHandEmpty()
                                act PickUp(soup)
                        sequence
                            cond On(soup,table)
                            cond Holding(chickenleg)
                            cond IsOpened(oven)
                            act PutInOven(chickenleg)
                    sequence
                        cond On(soup,table)
                        cond Holding(chickenleg)
                        cond IsClosed(oven)
                        act Open(oven)
            sequence
                cond On(soup,table)
                cond Holding(chickenleg)
                cond IsClosed(microwave)
                cond IsClosed(oven)
                act Open(microwave)
    sequence
        cond On(soup,table)
        cond Holding(chickenleg)
        cond IsClosed(microwave)
        cond IsClosed(oven)
        cond IsSwitchedOff(microwave)
        act SwitchOn(microwave)
