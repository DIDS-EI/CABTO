selector
    sequence
        cond In(chickenleg,oven)
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsHandEmpty()
        cond On(chickenleg,table)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond In(pie,oven)
                        selector
                            sequence
                                cond IsSwitchedOn(oven)
                                act LoadIntoAppliance(chickenleg,oven)
                            sequence
                                cond IsSwitchedOff(oven)
                                act TurnOn(oven)
                    sequence
                        cond IsSwitchedOff(oven)
                        cond On(pie,table)
                        act LoadIntoAppliance(pie,oven)
            sequence
                cond IsSwitchedOff(oven)
                cond IsClosed(oven)
                cond On(pie,table)
                act OpenAppliance(oven)
