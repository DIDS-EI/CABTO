selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                selector
                    selector
                        selector
                            selector
                                sequence
                                    cond In(chickenleg,oven)
                                    selector
                                        sequence
                                            cond In(pie,oven)
                                            act SwitchOnDevice(oven)
                                        sequence
                                            cond Holding(left_franka,pie)
                                            cond IsClosed(oven)
                                            act PlaceInOven(left_franka,pie)
                                sequence
                                    cond Holding(left_franka,pie)
                                    cond Holding(right_franka,chickenleg)
                                    cond IsClosed(oven)
                                    act PlaceInOven(right_franka,chickenleg)
                            sequence
                                cond IsOpened(oven)
                                cond Holding(left_franka,pie)
                                cond Holding(right_franka,chickenleg)
                                act CloseOven()
                        sequence
                            cond IsHandEmpty(left_franka)
                            cond IsOpened(oven)
                            cond Holding(right_franka,chickenleg)
                            cond On(pie,table)
                            act PickUp(left_franka,pie)
                    sequence
                        cond Holding(right_franka,chickenleg)
                        cond IsOpened(oven)
                        cond Holding(left_franka,soup)
                        cond On(pie,table)
                        act PutDown(left_franka,soup)
                sequence
                    cond IsHandEmpty(right_franka)
                    cond Holding(left_franka,soup)
                    cond On(chickenleg,table)
                    cond On(pie,table)
                    cond IsOpened(oven)
                    act PickUp(right_franka,chickenleg)
            sequence
                cond Holding(left_franka,soup)
                cond On(chickenleg,table)
                cond Holding(right_franka,light)
                cond On(pie,table)
                cond IsOpened(oven)
                act PutDown(right_franka,light)
