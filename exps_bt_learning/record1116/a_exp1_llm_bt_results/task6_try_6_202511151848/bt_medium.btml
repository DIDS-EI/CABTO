selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond Holding(pen)
                selector
                    selector
                        selector
                            sequence
                                cond In(book,cabinet)
                                act PlaceIn(pen,cabinet)
                            sequence
                                cond Holding(book)
                                act PlaceIn(book,cabinet)
                        sequence
                            cond On(book,table)|On(book,breakfast_table)
                            cond IsHandEmpty()
                            act PickUp(book)
                    sequence
                        cond On(book,table)|On(book,breakfast_table)
                        cond Holding(wine)
                        cond IsOpened(fridge)
                        act PlaceIn(wine,fridge)
            sequence
                cond On(book,table)|On(book,breakfast_table)
                cond On(pen,table)|On(pen,breakfast_table)
                cond IsHandEmpty()
                cond IsOpened(fridge)
                cond Holding(wine)
                act PickUp(pen)
    sequence
        cond On(book,table)|On(book,breakfast_table)
        cond IsClosed(cabinet)
        cond On(pen,table)|On(pen,breakfast_table)
        cond IsOpened(fridge)
        cond Holding(wine)
        selector
            sequence
                cond IsHandEmpty()
                act Open(cabinet)
            sequence
                cond Holding(banana)
                act PlaceIn(banana,fridge)
