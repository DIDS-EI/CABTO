selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        cond On(book,breakfast_table)
    sequence
        cond Holding(book)
        selector
            sequence
                cond IsClosed(cabinet)
                selector
                    selector
                        selector
                            selector
                                sequence
                                    cond In(banana,fridge)
                                    selector
                                        sequence
                                            cond IsClosed(fridge)
                                            act PlaceOnBreakfastTable(book)
                                        sequence
                                            cond IsOpen(fridge)
                                            act CloseFridge()
                                sequence
                                    cond Holding(banana)
                                    cond IsOpen(fridge)
                                    act PutInFridge(banana)
                            sequence
                                cond On(banana,breakfast_table)
                                cond IsHandEmpty()
                                cond On(banana,table)
                                cond IsOpen(fridge)
                                act PickUp(banana)
                        sequence
                            cond On(banana,breakfast_table)
                            cond Holding(apple)
                            cond On(banana,table)
                            cond IsOpen(fridge)
                            act PlaceOnTable(apple)
                    sequence
                        cond On(banana,breakfast_table)
                        cond IsClosed(fridge)
                        cond Holding(apple)
                        cond On(banana,table)
                        act OpenFridge()
            sequence
                cond On(banana,breakfast_table)
                cond On(banana,table)
                cond Holding(apple)
                cond IsOpen(cabinet)
                cond IsClosed(fridge)
                act CloseCabinet()
