selector
    cond In(wine,fridge)
    sequence
        cond Holding(wine)
        selector
            sequence
                cond IsOpen(fridge)
                act PutInFridge(wine)
            sequence
                cond IsClosed(fridge)
                act OpenFridge()
    sequence
        cond On(wine,breakfast_table)
        cond IsClosed(fridge)
        cond On(wine,table)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    act PickUp(wine)
                sequence
                    cond IsOpen(cabinet)
                    cond Holding(pen)
                    act PutInCabinet(pen)
            sequence
                cond IsClosed(cabinet)
                cond Holding(pen)
                act OpenCabinet()
