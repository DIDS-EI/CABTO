selector
    sequence
        cond On(c,b)
        cond On(b,a)
    sequence
        cond On(b,a)
        selector
            sequence
                cond On(b,table)
                selector
                    sequence
                        cond On(c,table)
                        selector
                            sequence
                                cond IsHandEmpty()
                                act PutAOnB(c,b)
                            sequence
                                cond Holding(a)
                                act Drop(a)
                    sequence
                        cond Holding(c)
                        cond Holding(a)
                        act Drop(c)
            sequence
                cond Holding(b)
                cond Holding(c)
                cond Holding(a)
                act Drop(b)
