selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(fridge)
        cond In(pen,cabinet)
    sequence
        cond Holding(pen)
        selector
            selector
                selector
                    sequence
                        cond IsOpened(cabinet)
                        selector
                            sequence
                                cond In(book,cabinet)
                                selector
                                    sequence
                                        cond IsOpened(fridge)
                                        act PutInContainer(pen,cabinet)
                                    sequence
                                        cond IsClosed(fridge)
                                        act OpenContainer(fridge)
                            sequence
                                cond Holding(book)
                                cond IsClosed(fridge)
                                act PutInContainer(book,cabinet)
                    sequence
                        cond Holding(book)
                        cond IsClosed(fridge)
                        cond IsClosed(cabinet)
                        act OpenContainer(cabinet)
                sequence
                    cond On(book,breakfast_table)|On(book,table)
                    cond IsHandEmpty()
                    cond IsClosed(fridge)
                    cond IsClosed(cabinet)
                    act PickUp(book)
            sequence
                cond On(book,breakfast_table)|On(book,table)
                cond IsClosed(fridge)
                cond Holding(wine)
                cond IsClosed(cabinet)
                act PutDown(wine,table)
    sequence
        cond Holding(wine)
        cond On(book,breakfast_table)|On(book,table)
        cond On(pen,breakfast_table)|On(pen,table)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(pen)
            sequence
                cond Holding(banana)
                act PutDown(banana,breakfast_table)
