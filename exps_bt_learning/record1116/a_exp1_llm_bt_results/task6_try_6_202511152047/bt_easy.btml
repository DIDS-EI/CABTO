selector
    cond In(wine,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond Holding(wine)
                act PutInContainer(wine,fridge)
            sequence
                cond IsHandEmpty()
                cond On(wine,breakfast_table)|On(wine,table)
                act PickUp(wine)
    sequence
        cond IsClosed(fridge)
        cond On(wine,breakfast_table)|On(wine,table)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    act OpenContainer(fridge)
                sequence
                    cond Holding(book)
                    cond IsOpened(cabinet)
                    act PutInContainer(book,cabinet)
            sequence
                cond Holding(book)
                cond IsClosed(cabinet)
                act OpenContainer(cabinet)
