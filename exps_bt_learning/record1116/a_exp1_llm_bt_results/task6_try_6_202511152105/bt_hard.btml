selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        cond On(book,breakfast_table)
    sequence
        cond On(book,breakfast_table)
        selector
            selector
                sequence
                    cond IsOpen(fridge)
                    selector
                        selector
                            sequence
                                cond In(banana,fridge)
                                cond IsHandEmpty()
                                selector
                                    sequence
                                        cond IsClosed(cabinet)
                                        act Close(fridge)
                                    sequence
                                        cond IsOpen(cabinet)
                                        act Close(cabinet)
                            sequence
                                cond Holding(banana)
                                cond IsOpen(cabinet)
                                act DropIn(banana,fridge)
                        sequence
                            cond On(banana,breakfast_table)
                            cond IsHandEmpty()
                            cond On(banana,table)
                            cond IsOpen(cabinet)
                            act PickUp(banana)
                sequence
                    cond On(banana,breakfast_table)
                    cond On(banana,table)
                    cond IsHandEmpty()
                    cond IsOpen(cabinet)
                    cond IsClosed(fridge)
                    act Open(fridge)
            sequence
                cond On(banana,breakfast_table)
                cond Holding(wine)
                cond On(banana,table)
                cond IsOpen(cabinet)
                cond IsClosed(fridge)
                act DropOn(wine,table)
    sequence
        cond On(banana,breakfast_table)
        cond Holding(wine)
        cond On(banana,table)
        cond IsOpen(cabinet)
        cond Holding(book)
        cond IsClosed(fridge)
        act DropOn(book,breakfast_table)
