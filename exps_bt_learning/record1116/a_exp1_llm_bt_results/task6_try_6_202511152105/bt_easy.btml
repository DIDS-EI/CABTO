selector
    cond In(wine,fridge)
    sequence
        cond Holding(wine)
        selector
            selector
                sequence
                    cond IsOpen(fridge)
                    act DropIn(wine,fridge)
                sequence
                    cond IsClosed(fridge)
                    cond IsHandEmpty()
                    act Open(fridge)
            sequence
                cond IsClosed(fridge)
                cond IsOpen(cabinet)
                cond Holding(book)
                act DropIn(book,cabinet)
    sequence
        cond On(wine,breakfast_table)
        cond IsOpen(cabinet)
        cond Holding(book)
        cond IsClosed(fridge)
        cond On(wine,table)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(wine)
            sequence
                cond Holding(pen)
                act DropIn(pen,cabinet)
