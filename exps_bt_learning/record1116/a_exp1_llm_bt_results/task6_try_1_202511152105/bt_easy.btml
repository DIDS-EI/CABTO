selector
    cond In(wine,fridge)
    sequence
        cond Holding(wine)
        selector
            selector
                sequence
                    cond IsOpen(fridge)
                    act PlaceInStorage(wine,fridge)
                sequence
                    cond IsClosed(fridge)
                    cond IsHandEmpty()
                    act OpenStorage(fridge)
            sequence
                cond IsClosed(fridge)
                cond Holding(banana)
                act PutAOnB(banana,breakfast_table)
    sequence
        cond On(wine,breakfast_table)
        cond IsClosed(fridge)
        cond Holding(banana)
        cond On(wine,table)
        selector
            sequence
                cond IsHandEmpty()
                act PickUp(wine)
            sequence
                cond IsOpen(cabinet)
                cond Holding(book)
                act PlaceInStorage(book,cabinet)
