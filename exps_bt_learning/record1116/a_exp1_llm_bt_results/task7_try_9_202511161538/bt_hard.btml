selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
    sequence
        cond IsSwitchedOff(light)
        cond IsSwitchedOn(radio)
        selector
            selector
                sequence
                    cond IsOpened(microwave)
                    selector
                        sequence
                            cond IsOpened(oven)
                            selector
                                sequence
                                    cond On(pie,breakfast_table)
                                    act SwitchOnLight()
                                sequence
                                    cond Holding(left_franka,pie)
                                    cond On(left_franka,breakfast_table)
                                    act DropLeftFranka(pie,breakfast_table)
                        sequence
                            cond On(left_franka,breakfast_table)
                            cond IsClosed(oven)
                            cond IsSwitchedOff(oven)
                            cond On(left_franka,oven)
                            cond Holding(left_franka,pie)
                            act OpenOvenLeftFranka()
                sequence
                    cond On(left_franka,breakfast_table)
                    cond IsClosed(oven)
                    cond IsClosed(microwave)
                    cond IsSwitchedOff(oven)
                    cond On(right_franka,microwave)
                    cond IsSwitchedOff(microwave)
                    cond On(left_franka,oven)
                    cond Holding(left_franka,pie)
                    act OpenMicrowaveRightFranka()
            sequence
                cond On(left_franka,breakfast_table)
                cond IsClosed(oven)
                cond IsClosed(microwave)
                cond IsSwitchedOff(oven)
                cond On(pie,table)
                cond On(right_franka,microwave)
                cond IsSwitchedOff(microwave)
                cond On(left_franka,table)
                cond IsHandEmpty(left_franka)
                cond On(left_franka,oven)
                act PickUpLeftFranka(pie)
