selector
    sequence
        cond In(pen,cabinet)
        cond On(book,breakfast_table)
    sequence
        cond IsClosed(cabinet)
        cond On(book,breakfast_table)
        selector
            sequence
                cond Holding(pen)
                act PutInCabinet(pen)
            sequence
                cond IsHandEmpty()
                cond On(pen,table)
                act PickUp(pen)
