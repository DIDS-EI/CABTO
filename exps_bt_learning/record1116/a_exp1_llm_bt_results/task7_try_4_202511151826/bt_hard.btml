selector
    sequence
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond IsClosed(microwave)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsOpened(oven)
                        act OpenAppliance(microwave)
                    sequence
                        cond IsClosed(oven)
                        act OpenAppliance(oven)
            sequence
                cond IsClosed(oven)
                cond IsSwitchedOff(light)
                act SwitchOnAppliance(light)
