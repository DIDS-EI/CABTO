selector
    sequence
        cond On(a,c)
        cond On(b,d)
        cond On(c,b)
    sequence
        cond On(b,table)
        selector
            selector
                sequence
                    cond On(a,c)
                    selector
                        selector
                            sequence
                                cond Holding(c)
                                selector
