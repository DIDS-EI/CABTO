selector
    cond In(left_lego,center_big_box)
    sequence
        cond On(center_big_box,center_table)
        selector
            sequence
                cond Holding(left_franka,left_lego)
                selector
                    sequence
                        cond IsOpen(center_big_box)
                        act PlaceInBox(left_franka,center_big_box)
                    act OpenBox(center_big_box)
            sequence
                cond On(left_lego,left_table)
                cond IsHandEmpty(left_franka)
                cond On(left_franka,left_table)
                act PickUp(left_franka,left_lego)
