selector
    sequence
        cond In(chickenleg,oven)
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond In(chickenleg,oven)
                selector
                    sequence
                        cond IsSwitchedOn(oven)
                        selector
                            sequence
                                cond Holding(pie)
                                act PutIn(pie,oven)
                            sequence
                                cond IsHandEmpty()
                                cond On(pie,table)
                                act PickUp(pie)
                    sequence
                        cond IsHandEmpty()
                        cond IsSwitchedOff(oven)
                        cond On(pie,table)
                        act TurnOn(oven)
            sequence
                cond IsSwitchedOff(oven)
                cond Holding(chickenleg)
                cond On(pie,table)
                act PutIn(chickenleg,oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond On(pie,table)
        selector
            sequence
                cond Holding(chickenleg)
                act Open(oven)
            sequence
                cond IsHandEmpty()
                cond On(chickenleg,table)
                act PickUp(chickenleg)
