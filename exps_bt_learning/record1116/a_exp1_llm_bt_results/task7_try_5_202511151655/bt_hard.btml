selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond IsSwitchedOn(light)
        selector
            sequence
                cond Holding(soup)
                selector
                    sequence
                        cond IsOpened(microwave)
                        selector
                            sequence
                                cond IsSwitchedOn(microwave)
                                act PutInMicrowave(soup)
                            sequence
                                cond IsSwitchedOff(microwave)
                                act SwitchOn(microwave)
                    sequence
                        cond IsClosed(microwave)
                        cond IsSwitchedOff(microwave)
                        act Open(microwave)
            sequence
                cond IsClosed(microwave)
                cond On(soup,table)
                cond IsHandEmpty()
                cond IsSwitchedOff(microwave)
                act PickUp(soup)
    sequence
        cond IsClosed(microwave)
        cond IsSwitchedOff(light)
        cond On(soup,table)
        cond IsSwitchedOff(microwave)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    act SwitchOn(light)
                sequence
                    cond IsOpened(oven)
                    cond Holding(chickenleg)
                    act PutInOven(chickenleg)
            sequence
                cond Holding(chickenleg)
                cond IsClosed(oven)
                act Open(oven)
