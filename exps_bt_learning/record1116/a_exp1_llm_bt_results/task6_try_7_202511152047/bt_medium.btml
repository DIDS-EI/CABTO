selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(fridge)
        cond In(pen,cabinet)
    sequence
        cond IsClosed(fridge)
        selector
            selector
                selector
                    selector
                        selector
                            selector
                                sequence
                                    cond In(pen,cabinet)
                                    selector
                                        sequence
                                            cond In(book,cabinet)
                                            act OpenContainer(fridge)
                                        sequence
                                            cond Holding(book)
                                            cond IsOpened(cabinet)
                                            act PlaceInContainer(book,cabinet)
                                sequence
                                    cond Holding(book)
                                    cond Holding(pen)
                                    cond IsOpened(cabinet)
                                    act PlaceInContainer(pen,cabinet)
                            sequence
                                cond On(pen,table)|On(pen,breakfast_table)
                                cond Holding(book)
                                cond IsHandEmpty()
                                cond IsOpened(cabinet)
                                act PickUp(pen)
                        sequence
                            cond On(pen,table)|On(pen,breakfast_table)
                            cond Holding(book)
                            cond Holding(wine)
                            cond IsOpened(cabinet)
                            act PlaceInContainer(wine,cabinet)
                    sequence
                        cond IsOpened(cabinet)
                        cond IsHandEmpty()
                        cond Holding(wine)
                        cond On(pen,table)|On(pen,breakfast_table)
                        cond On(book,table)|On(book,breakfast_table)
                        act PickUp(book)
                sequence
                    cond Holding(banana)
                    cond IsOpened(cabinet)
                    cond Holding(wine)
                    cond On(pen,table)|On(pen,breakfast_table)
                    cond On(book,table)|On(book,breakfast_table)
                    act PlaceInContainer(banana,cabinet)
            sequence
                cond Holding(banana)
                cond Holding(wine)
                cond On(pen,table)|On(pen,breakfast_table)
                cond On(book,table)|On(book,breakfast_table)
                cond IsClosed(cabinet)
                act OpenContainer(cabinet)
