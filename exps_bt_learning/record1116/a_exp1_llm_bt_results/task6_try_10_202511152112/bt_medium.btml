selector
    sequence
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond Open(cabinet)
        selector
            selector
                sequence
                    cond In(book,cabinet)
                    selector
                        sequence
                            cond Holding(pen)
                            act PutIn(pen,cabinet)
                        sequence
                            cond On(pen,table)
                            cond IsHandEmpty()
                            act PickUp(pen)
                sequence
                    cond Holding(book)
                    cond On(pen,table)
                    act PutIn(book,cabinet)
            sequence
                cond On(book,table)
                cond On(pen,table)
                cond IsHandEmpty()
                act PickUp(book)
    sequence
        cond On(book,table)
        cond On(pen,table)
        cond IsHandEmpty()
        act Open(cabinet)
