selector
    sequence
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsSwitchedOff(light)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    sequence
                        cond IsOpened(oven)
                        act SwitchOn(light)
                    sequence
                        cond IsClosed(oven)
                        act OpenDevice(oven)
            sequence
                cond IsClosed(microwave)
                cond IsClosed(oven)
                act OpenDevice(microwave)
