selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    sequence
                        cond Holding(soup)
                        act DropInMicrowave(soup)
                    sequence
                        cond IsHandEmpty()
                        cond On(soup,table)
                        act PickUp(soup)
            sequence
                cond IsHandEmpty()
                cond On(soup,table)
                cond IsClosed(microwave)
                act OpenMicrowave()
    sequence
        cond IsSwitchedOff(microwave)
        cond IsHandEmpty()
        cond On(soup,table)
        cond IsClosed(microwave)
        act SwitchOnMicrowave()
