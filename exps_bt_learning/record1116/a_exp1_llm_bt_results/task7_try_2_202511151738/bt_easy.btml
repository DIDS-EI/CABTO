selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                selector
                    sequence
                        cond In(chickenleg,oven)
                        act SwitchOn(oven)
                    sequence
                        cond Holding(chickenleg)
                        cond IsOpened(oven)
                        act PutIn(chickenleg,oven)
                sequence
                    cond On(chickenleg,table)
                    cond IsHandEmpty()
                    cond IsOpened(oven)
                    act PickUp(chickenleg)
            sequence
                cond IsClosed(oven)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                act Open(oven)
