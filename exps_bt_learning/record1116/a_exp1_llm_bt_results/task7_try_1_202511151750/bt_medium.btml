selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsOpened(microwave)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    sequence
                        cond Holding(soup)
                        act DropInMicrowave(soup)
                    sequence
                        cond IsHandEmpty()
                        cond On(soup,table)
                        act PickUp(soup)
            sequence
                cond IsSwitchedOff(microwave)
                cond IsHandEmpty()
                cond On(soup,table)
                act SwitchOnMicrowave()
    sequence
        cond IsHandEmpty()
        cond IsSwitchedOff(microwave)
        cond IsClosed(microwave)
        cond On(soup,table)
        act OpenMicrowave()
