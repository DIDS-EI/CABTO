selector
    sequence
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        cond In(banana,fridge)
        cond On(book,breakfast_table)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond In(banana,fridge)
                selector
                    sequence
                        cond On(book,breakfast_table)
                        selector
                            sequence
                                cond IsClosed(cabinet)
                                act CloseFridge(robot2)
                            sequence
                                cond IsOpened(cabinet)
                                act CloseCabinet(robot1)
                    sequence
                        cond IsOpened(cabinet)
                        cond Holding(right_franka,book)
                        act PutOnBreakfastTable(right_franka,book)
            sequence
                cond Holding(robot2,banana)
                cond IsOpened(cabinet)
                cond Holding(right_franka,book)
                act PutInFridge(robot2,banana)
