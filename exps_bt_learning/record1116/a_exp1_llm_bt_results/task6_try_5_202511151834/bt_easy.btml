selector
    sequence
        cond On(apple,breakfast_table)
        cond IsOpened(fridge)
        cond In(wine,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                selector
                    selector
                        sequence
                            cond In(wine,fridge)
                            selector
                                sequence
                                    cond Holding(right_franka,apple)
                                    act PutOnBreakfastTable(right_franka,apple)
                                sequence
                                    cond On(apple,table)
                                    cond IsHandEmpty(right_franka)
                                    act PickUp(right_franka,apple)
                        sequence
                            cond Holding(robot1,wine)
                            cond IsHandEmpty(right_franka)
                            cond On(apple,table)
                            act PutInFridge(robot1,wine)
                    sequence
                        cond Holding(robot1,wine)
                        cond On(apple,table)
                        cond Holding(right_franka,banana)
                        act PutInFridge(right_franka,banana)
                sequence
                    cond On(apple,table)
                    cond IsHandEmpty(robot1)
                    cond Holding(right_franka,banana)
                    cond On(wine,table)
                    act PickUp(robot1,wine)
            sequence
                cond On(wine,table)
                cond On(apple,table)
                cond IsOpened(cabinet)
                cond Holding(right_franka,banana)
                cond Holding(robot1,pen)
                act PutInCabinet(robot1,pen)
