selector
    cond IsFull(left_cup)
    sequence
        cond IsFull(left_milk)
        cond Holding(left_franka,left_cup)
        selector
            sequence
                cond Holding(left_franka,left_milk)
                act PourLeftMilkIntoLeftCup(left_cup)
            sequence
                cond IsHandEmpty(left_franka)
                cond CanGrasp(left_franka,left_milk)
                cond IsEmpty(left_cup)
                act PrepareLeftCupWithMilk()
