selector
    sequence
        cond In(chickenleg,oven)
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsClosed(oven)
        selector
            selector
                sequence
                    cond In(chickenleg,oven)
                    selector
                        sequence
                            cond IsSwitchedOn(oven)
                            selector
                                sequence
                                    cond Holding(pie)
                                    act PutIn(pie,oven)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(pie,table)
                                    act PickUp(pie)
                        sequence
                            cond IsHandEmpty()
                            cond IsSwitchedOff(oven)
                            cond On(pie,table)
                            act SwitchOn(oven)
                sequence
                    cond IsSwitchedOff(oven)
                    cond Holding(chickenleg)
                    cond On(pie,table)
                    act PutIn(chickenleg,oven)
            sequence
                cond IsHandEmpty()
                cond IsSwitchedOff(oven)
                cond On(pie,table)
                cond On(chickenleg,table)
                act PickUp(chickenleg)
