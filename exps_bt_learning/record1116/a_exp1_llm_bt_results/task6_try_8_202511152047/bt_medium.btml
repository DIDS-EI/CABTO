selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(fridge)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond IsOpened(fridge)
                selector
                    selector
                        sequence
                            cond In(pen,cabinet)
                            selector
                                sequence
                                    cond Holding(book)
                                    act PutIn(book,cabinet)
                                sequence
                                    cond On(book,table)
                                    cond IsHandEmpty()
                                    act PickUp(book)
                        sequence
                            cond On(book,table)
                            cond Holding(pen)
                            act PutIn(pen,cabinet)
                    sequence
                        cond On(book,table)
                        cond IsHandEmpty()
                        cond On(pen,table)
                        act PickUp(pen)
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                cond IsClosed(fridge)
                cond On(pen,table)
                act Open(fridge)
    sequence
        cond On(pen,table)
        cond IsHandEmpty()
        cond On(book,table)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        act Open(cabinet)
