selector
    sequence
        cond In(book,fridge)
        cond IsOpened(cabinet)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond IsOpened(cabinet)
                selector
                    selector
                        sequence
                            cond In(pen,cabinet)
                            selector
                                sequence
                                    cond Holding(book)
                                    act PlaceIn(book,fridge)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(book,table)
                                    act PickUp(book)
                        sequence
                            cond Holding(pen)
                            cond On(book,table)
                            act PlaceIn(pen,cabinet)
                    sequence
                        cond IsHandEmpty()
                        cond On(pen,table)
                        cond On(book,table)
                        act PickUp(pen)
            sequence
                cond IsClosed(cabinet)
                cond IsHandEmpty()
                cond On(pen,table)
                cond On(book,table)
                act Open(cabinet)
    sequence
        cond On(book,table)
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond IsHandEmpty()
        cond On(pen,table)
        act Open(fridge)
