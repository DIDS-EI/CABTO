selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
        cond In(pie,oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                selector
                    sequence
                        cond In(pie,oven)
                        selector
                            selector
                                sequence
                                    cond In(chickenleg,oven)
                                    act SwitchOnDevice(oven)
                                sequence
                                    cond Holding(chickenleg)
                                    cond IsOpened(oven)
                                    act PutInContainer(chickenleg,oven)
                            sequence
                                cond On(chickenleg,table)
                                cond IsHandEmpty()
                                cond IsOpened(oven)
                                act PickUp(chickenleg)
                    sequence
                        cond On(chickenleg,table)
                        cond Holding(pie)
                        cond IsOpened(oven)
                        act PutInContainer(pie,oven)
                sequence
                    cond On(chickenleg,table)
                    cond Holding(pie)
                    cond IsClosed(oven)
                    act OpenContainer(oven)
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond IsClosed(oven)
                cond On(pie,table)
                act PickUp(pie)
