selector
    sequence
        cond In(apple,fridge)
        cond IsOpened(fridge)
    sequence
        cond Holding(apple)
        selector
            sequence
                cond IsOpened(fridge)
                act PlaceInFridge(apple)
            sequence
                cond IsClosed(fridge)
                act OpenFridge()
    sequence
        cond IsClosed(fridge)
        cond IsHandEmpty()
        cond On(apple,table)
        act PickUp(apple)
