selector
    sequence
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond In(banana,fridge)
        cond In(apple,cabinet)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond In(banana,fridge)
                selector
                    selector
                        selector
                            sequence
                                cond In(apple,cabinet)
                                selector
                                    sequence
                                        cond IsClosed(cabinet)
                                        act CloseFridge()
                                    sequence
                                        cond IsOpened(cabinet)
                                        act CloseCabinet()
                            sequence
                                cond IsOpened(cabinet)
                                cond Holding(apple)
                                act PlaceInCabinet(apple)
                        sequence
                            cond IsClosed(cabinet)
                            cond Holding(apple)
                            act OpenCabinet()
                    sequence
                        cond IsClosed(cabinet)
                        cond On(apple,table)
                        cond IsHandEmpty()
                        act PickUp(apple)
            sequence
                cond IsClosed(cabinet)
                cond Holding(banana)
                cond On(apple,table)
                act PlaceInFridge(banana)
    sequence
        cond IsClosed(cabinet)
        cond IsClosed(fridge)
        cond On(apple,table)
        selector
            sequence
                cond Holding(banana)
                act OpenFridge()
            sequence
                cond On(banana,table)
                cond IsHandEmpty()
                act PickUp(banana)
