selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsSwitchedOff(light)
        selector
            sequence
                cond IsSwitchedOn(radio)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            sequence
                                cond IsOpened(microwave)
                                selector
                                    sequence
                                        cond On(pie,breakfast_table)
                                        act SwitchOnLight()
                                    sequence
                                        cond On(pie,table)
                                        act PutInOnto(pie,breakfast_table)
                            sequence
                                cond On(pie,table)
                                cond IsClosed(microwave)
                                act OpenMicrowave()
                    sequence
                        cond On(pie,table)
                        cond IsClosed(microwave)
                        cond IsClosed(oven)
                        act OpenOven()
            sequence
                cond IsSwitchedOff(radio)
                cond On(pie,table)
                cond IsClosed(microwave)
                cond IsClosed(oven)
                act SwitchOnRadio()
