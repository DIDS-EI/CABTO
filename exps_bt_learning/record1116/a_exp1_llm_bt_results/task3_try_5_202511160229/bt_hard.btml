selector
    cond On(center_big_box,box_board)
    sequence
        cond On(box_board,center_table)
        selector
            sequence
                cond On(left_franka,left_table)
                selector
                    selector
                        sequence
                            cond On(right_franka,right_table)
                            selector
                                selector
                                    sequence
                                        cond HoldingTogether(left_franka,right_franka,center_big_box)
                                        act PlaceBigBoxOnBoard(center_big_box,box_board)
                                    sequence
                                        cond Holding(left_franka,center_big_box)
                                        cond BigBoxNeedTwoFrankaHoldTogether()
                                        cond Holding(right_franka,center_big_box)
                                        act HoldBigBoxTogether(center_big_box)
                                sequence
                                    cond On(center_big_box,center_table)
                                    cond BigBoxNeedTwoFrankaHoldTogether()
                                    cond IsHandEmpty(left_franka)
                                    cond Holding(right_franka,center_big_box)
                                    act PickUpLeftFranka(center_big_box)
                        sequence
                            cond On(right_franka,center_table)
                            cond BigBoxNeedTwoFrankaHoldTogether()
                            cond On(right_franka,left_table)
                            cond IsHandEmpty(left_franka)
                            cond Holding(right_franka,center_big_box)
                            cond On(center_big_box,center_table)
                            act MoveActor(right_franka,right_table)
                    sequence
                        cond On(right_franka,center_table)
                        cond BigBoxNeedTwoFrankaHoldTogether()
                        cond Holding(left_franka,right_lego)
                        cond On(right_franka,left_table)
                        cond Holding(right_franka,center_big_box)
                        cond On(center_big_box,center_table)
                        act PutDownLeftFranka(right_lego,left_table)
            sequence
                cond On(right_franka,center_table)
                cond BigBoxNeedTwoFrankaHoldTogether()
                cond Holding(left_franka,right_lego)
                cond On(left_franka,right_table)
                cond On(right_franka,left_table)
                cond Holding(right_franka,center_big_box)
                cond On(left_franka,center_table)
                cond On(center_big_box,center_table)
                act MoveActor(left_franka,left_table)
