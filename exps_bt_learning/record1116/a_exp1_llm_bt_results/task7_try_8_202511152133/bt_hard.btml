selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(light)
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(radio)
    sequence
        cond IsSwitchedOff(light)
        selector
            sequence
                cond IsSwitchedOn(radio)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            sequence
                                cond On(pie,breakfast_table)
                                selector
                                    sequence
                                        cond IsOpened(microwave)
                                        act SwitchOnLight()
                                    sequence
                                        cond IsClosed(microwave)
                                        act OpenMicrowave()
                            sequence
                                cond On(pie,table)
                                cond In(pie,oven)
                                cond IsClosed(microwave)
                                act MovePieToBreakfastTable(pie)
                    sequence
                        cond On(pie,table)
                        cond In(pie,oven)
                        cond IsClosed(oven)
                        cond IsClosed(microwave)
                        act OpenOven()
            sequence
                cond On(pie,table)
                cond In(pie,oven)
                cond IsClosed(oven)
                cond IsSwitchedOff(radio)
                cond IsClosed(microwave)
                act SwitchOnRadio()
