selector
    cond On(center_big_box,box_board)
    sequence
        cond IsHolding(left_franka,center_big_box)
        cond IsHolding(right_franka,center_big_box)
        act PutOnBoxBoard(center_big_box,box_board)
    sequence
        cond BigBoxNeedTwoFrankaHoldTogether()
        cond IsHandEmpty(left_franka)
        cond On(center_big_box,center_table)
        cond IsHandEmpty(right_franka)
        act PickUpBigBox(center_big_box)
