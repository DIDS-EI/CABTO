selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                sequence
                    cond In(soup,microwave)
                    act SwitchOnMicrowave()
                sequence
                    cond On(soup,table)
                    cond IsHandEmpty()
                    cond IsOpened(microwave)
                    act PlaceInMicrowave(soup)
            sequence
                cond On(soup,table)
                cond IsClosed(microwave)
                cond IsHandEmpty()
                act OpenMicrowave()
