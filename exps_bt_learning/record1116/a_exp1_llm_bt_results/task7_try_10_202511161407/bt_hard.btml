selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond IsSwitchedOff(light)
        selector
            selector
                sequence
                    cond IsOpened(oven)
                    selector
                        sequence
                            cond On(pie,breakfast_table)
                            selector
                                sequence
                                    cond IsOpened(microwave)
                                    selector
                                        sequence
                                            cond IsSwitchedOn(radio)
                                            act SwitchOnLight()
                                        sequence
                                            cond IsSwitchedOff(radio)
                                            act SwitchOnRadio()
                                sequence
                                    cond IsClosed(microwave)
                                    cond IsSwitchedOff(radio)
                                    act OpenMicrowave()
                        sequence
                            cond IsSwitchedOff(radio)
                            cond IsClosed(microwave)
                            cond Holding(pie)
                            act PutOnTable(pie,breakfast_table)
                sequence
                    cond IsSwitchedOff(radio)
                    cond IsClosed(microwave)
                    cond Holding(pie)
                    cond IsClosed(oven)
                    act OpenOven()
            sequence
                cond IsClosed(microwave)
                cond IsClosed(oven)
                cond On(pie,table)
                cond IsHandEmpty()
                cond IsSwitchedOff(radio)
                act PickUp(pie)
