selector
    sequence
        cond On(book,breakfast_table)
        cond In(pen,cabinet)
    sequence
        cond On(book,breakfast_table)
        selector
            selector
                sequence
                    cond IsOpen(cabinet)
                    selector
                        selector
                            sequence
                                cond Holding(pen)
                                act DropIn(pen,cabinet)
                            sequence
                                cond On(pen,breakfast_table)
                                cond IsHandEmpty()
                                cond On(pen,table)
                                act PickUp(pen)
                        sequence
                            cond On(pen,breakfast_table)
                            cond IsOpen(fridge)
                            cond On(pen,table)
                            cond Holding(book)
                            act DropIn(book,fridge)
                sequence
                    cond Holding(book)
                    cond On(pen,table)
                    cond On(pen,breakfast_table)
                    cond IsOpen(fridge)
                    cond IsClosed(cabinet)
                    act Open(cabinet)
            sequence
                cond Holding(book)
                cond IsClosed(fridge)
                cond On(pen,table)
                cond On(pen,breakfast_table)
                cond IsClosed(cabinet)
                act Open(fridge)
