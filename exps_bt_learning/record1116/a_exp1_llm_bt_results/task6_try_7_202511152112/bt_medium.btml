selector
    sequence
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond At(cabinet)
        selector
            sequence
                cond IsOpen(cabinet)
                selector
                    sequence
                        cond Holding(pen)
                        selector
                            selector
                                selector
                                    sequence
                                        cond In(book,cabinet)
                                        act PlaceIn(pen,cabinet)
                                    sequence
                                        cond Holding(book)
                                        act PlaceIn(book,cabinet)
                                sequence
                                    cond On(book,table)
                                    cond On(book,breakfast_table)
                                    cond IsHandEmpty()
                                    act PickUp(book)
                            sequence
                                cond On(book,table)
                                cond On(book,breakfast_table)
                                cond Holding(wine)
                                act PlaceOn(wine,table)
                    sequence
                        cond On(pen,table)
                        cond On(book,breakfast_table)
                        cond Holding(wine)
                        cond On(pen,breakfast_table)
                        cond On(book,table)
                        cond IsHandEmpty()
                        act PickUp(pen)
            sequence
                cond On(pen,table)
                cond IsClosed(cabinet)
                cond On(book,breakfast_table)
                cond Holding(wine)
                cond On(pen,breakfast_table)
                cond On(book,table)
                cond IsHandEmpty()
                act OpenContainer(cabinet)
    sequence
        cond On(pen,table)
        cond IsClosed(cabinet)
        cond On(book,breakfast_table)
        cond Holding(wine)
        cond On(pen,breakfast_table)
        cond On(book,table)
        selector
            sequence
                cond IsHandEmpty()
                act MoveTo(cabinet)
            sequence
                cond Holding(apple)
                cond At(fridge)
                cond IsOpen(fridge)
                act PlaceIn(apple,fridge)
