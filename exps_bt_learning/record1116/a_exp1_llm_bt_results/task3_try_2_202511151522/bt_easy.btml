selector
    cond On(left_lego,center_big_box)
    sequence
        cond Holding(left_franka,left_lego)
        selector
            sequence
                cond On(center_big_box,box_board)
                act PlaceOnCenterBigBoxLeft(left_lego,center_big_box)
            sequence
                cond Holding(left_franka,center_big_box)
                cond Holding(right_franka,center_big_box)
                act PlaceCenterBigBoxOnBoard(center_big_box,box_board)
    sequence
        cond IsHandEmpty(left_franka)
        cond Holding(left_franka,center_big_box)
        cond Holding(right_franka,center_big_box)
        cond On(left_lego,left_table)
        act PickUpLeftFranka(left_lego)
