selector
    sequence
        cond In(apple,fridge)
        cond IsOpened(fridge)
    sequence
        cond Holding(apple)
        selector
            sequence
                cond IsOpened(fridge)
                act PutObjectInContainer(apple,fridge)
            sequence
                cond IsClosed(fridge)
                act OpenContainer(fridge)
    sequence
        cond IsClosed(fridge)
        cond IsHandEmpty()
        cond On(apple,table)
        act PickUpObject(apple)
