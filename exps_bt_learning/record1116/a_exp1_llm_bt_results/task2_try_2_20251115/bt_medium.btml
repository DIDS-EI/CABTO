selector
    sequence
        cond On(c,b)
        cond On(b,a)
    sequence
        cond On(c,b)
        selector
            sequence
                cond On(b,table)
                selector
                    sequence
                        cond IsHandEmpty()
                        act MoveObject(b,a)
                    sequence
                        cond Holding(d)
                        act Drop(d)
            sequence
                cond Holding(b)
                cond Holding(d)
                act Drop(b)
