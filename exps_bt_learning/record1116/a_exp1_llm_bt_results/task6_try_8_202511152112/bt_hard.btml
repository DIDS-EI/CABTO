selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(wine,fridge)
    sequence
        cond IsOpen(fridge)
        selector
            sequence
                cond In(banana,fridge)
                selector
                    selector
                        sequence
                            cond In(wine,fridge)
                            act CloseFridge()
                        sequence
                            cond Holding(wine)
                            act PutIn(wine,fridge)
                    sequence
                        cond On(wine,breakfast_table)
                        cond On(wine,table)
                        cond IsHandEmpty()
                        act PickUp(wine)
            sequence
                cond On(wine,table)
                cond On(wine,breakfast_table)
                cond Holding(banana)
                act PutIn(banana,fridge)
    sequence
        cond On(wine,table)
        cond IsClosed(fridge)
        cond On(wine,breakfast_table)
        selector
            selector
                selector
                    sequence
                        cond Holding(banana)
                        act OpenFridge()
                    sequence
                        cond On(banana,table)
                        cond On(banana,breakfast_table)
                        cond IsHandEmpty()
                        act PickUp(banana)
                sequence
                    cond Holding(apple)
                    cond On(banana,table)
                    cond On(banana,breakfast_table)
                    cond IsOpen(cabinet)
                    act PutIn(apple,cabinet)
            sequence
                cond Holding(apple)
                cond On(banana,breakfast_table)
                cond IsClosed(cabinet)
                cond On(banana,table)
                act OpenCabinet()
