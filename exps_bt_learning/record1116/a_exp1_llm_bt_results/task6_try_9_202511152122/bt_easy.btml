selector
    sequence
        cond In(book,cabinet)
        cond Open(cabinet)
    sequence
        cond Holding(book)
        selector
            selector
                sequence
                    cond Open(cabinet)
                    act PutIn(book,cabinet)
                sequence
                    cond IsClosed(cabinet)
                    cond IsHandEmpty()
                    act OpenContainer(cabinet)
            sequence
                cond IsClosed(cabinet)
                cond Holding(pen)
                act PutOn(pen,breakfast_table)
    sequence
        cond On(book,table)
        cond Holding(pen)
        selector
            sequence
                cond IsHandEmpty()
                selector
                    sequence
                        cond IsClosed(cabinet)
                        act PickUp(book)
                    sequence
                        cond Open(cabinet)
                        act CloseContainer(cabinet)
            sequence
                cond Open(cabinet)
                cond Holding(banana)
                act PutOn(banana,breakfast_table)
