selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            sequence
                cond Holding(chickenleg)
                selector
                    sequence
                        cond IsOpened(oven)
                        act PutIn(chickenleg,oven)
                    sequence
                        cond IsClosed(oven)
                        act Open(oven)
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond IsClosed(oven)
                act PickUp(chickenleg)
    sequence
        cond On(chickenleg,table)
        cond IsHandEmpty()
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        act SwitchOn(oven)
