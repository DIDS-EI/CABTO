selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                sequence
                    cond In(soup,microwave)
                    selector
                        sequence
                            cond IsSwitchedOn(light)
                            act SwitchOn(microwave)
                        sequence
                            cond IsSwitchedOff(light)
                            act SwitchOn(light)
                sequence
                    cond IsSwitchedOff(light)
                    cond IsNoIsClosedIn(microwave)
                    cond Holding(soup)
                    act PutInMicrowave(soup)
            sequence
                cond IsSwitchedOff(light)
                cond IsNoIsClosedIn(microwave)
                cond On(soup,table)
                cond IsHandEmpty()
                act PickUp(soup)
