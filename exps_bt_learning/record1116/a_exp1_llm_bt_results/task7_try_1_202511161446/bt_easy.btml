selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    sequence
                        cond In(pie,oven)
                        selector
                            sequence
                                cond Holding(chickenleg)
                                act PlaceIn(chickenleg,oven)
                            sequence
                                cond IsHandEmpty()
                                cond On(chickenleg,table)
                                act PickUp(chickenleg)
                    sequence
                        cond Holding(pie)
                        cond On(chickenleg,table)
                        act PlaceIn(pie,oven)
            sequence
                cond IsSwitchedOff(oven)
                cond Holding(pie)
                cond On(chickenleg,table)
                act SwitchOn(oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond On(chickenleg,table)
        selector
            sequence
                cond Holding(pie)
                act Open(oven)
            sequence
                cond IsHandEmpty()
                cond On(pie,table)
                act PickUp(pie)
