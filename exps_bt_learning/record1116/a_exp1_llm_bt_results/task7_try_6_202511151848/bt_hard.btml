selector
    sequence
        cond IsSwitchedOn(light)
        cond IsOpened(oven)
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
    sequence
        cond IsSwitchedOff(radio)
        selector
            selector
                sequence
                    cond On(pie,breakfast_table)
                    cond IsHandEmpty()
                    selector
                        sequence
                            cond IsSwitchedOn(light)
                            selector
                                sequence
                                    cond IsOpened(microwave)
                                    selector
                                        sequence
                                            cond IsOpened(oven)
                                            act SwitchOn(radio)
                                        sequence
                                            cond IsClosed(oven)
                                            act Open(oven)
                                sequence
                                    cond IsClosed(oven)
                                    cond IsClosed(microwave)
                                    act Open(microwave)
                        sequence
                            cond IsClosed(oven)
                            cond IsClosed(microwave)
                            cond IsSwitchedOff(light)
                            act SwitchOn(light)
                sequence
                    cond Holding(pie)
                    cond IsClosed(oven)
                    cond IsClosed(microwave)
                    cond IsSwitchedOff(light)
                    act PutOn(pie,breakfast_table)
            sequence
                cond IsClosed(oven)
                cond IsHandEmpty()
                cond IsSwitchedOff(light)
                cond IsClosed(microwave)
                cond On(pie,table)
                act PickUp(pie)
