selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    sequence
                        cond In(chickenleg,oven)
                        selector
                            sequence
                                cond Holding(pie)
                                act PutInContainer(pie,oven)
                            sequence
                                cond IsHandEmpty()
                                cond On(pie,table)
                                act PickUpItem(pie)
                    sequence
                        cond Holding(chickenleg)
                        cond On(pie,table)
                        act PutInContainer(chickenleg,oven)
            sequence
                cond IsSwitchedOff(oven)
                cond Holding(chickenleg)
                cond On(pie,table)
                act SwitchOnDevice(oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond On(pie,table)
        selector
            sequence
                cond Holding(chickenleg)
                act OpenContainer(oven)
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                act PickUpItem(chickenleg)
