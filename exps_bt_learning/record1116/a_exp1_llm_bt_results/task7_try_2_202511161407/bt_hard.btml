selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
    sequence
        cond IsOpened(oven)
        selector
            selector
                sequence
                    cond IsSwitchedOn(light)
                    selector
                        sequence
                            cond IsOpened(microwave)
                            selector
                                sequence
                                    cond Holding(left_franka,pie)
                                    selector
                                        sequence
                                            cond IsSwitchedOn(radio)
                                            act PutDownLeftFranka(pie,breakfast_table)
                                        sequence
                                            cond IsHandEmpty(left_franka)
                                            cond IsSwitchedOff(radio)
                                            act SwitchOnLeftFranka(radio)
                                sequence
                                    cond In(pie,oven)
                                    cond IsHandEmpty(left_franka)
                                    cond IsSwitchedOff(radio)
                                    act PickOutFromContainerLeftFranka(pie,oven)
                        sequence
                            cond In(pie,oven)
                            cond IsHandEmpty(left_franka)
                            cond IsClosed(microwave)
                            cond On(microwave,table)
                            cond IsSwitchedOff(radio)
                            act OpenContainerLeftFranka(microwave)
                sequence
                    cond In(pie,oven)
                    cond IsHandEmpty(left_franka)
                    cond IsClosed(microwave)
                    cond On(microwave,table)
                    cond IsSwitchedOff(light)
                    cond IsSwitchedOff(radio)
                    act SwitchOnLeftFranka(light)
            sequence
                cond In(pie,oven)
                cond IsClosed(microwave)
                cond On(microwave,table)
                cond Holding(left_franka,chickenleg)
                cond IsSwitchedOff(light)
                cond IsSwitchedOff(radio)
                act PutDownLeftFranka(chickenleg,breakfast_table)
