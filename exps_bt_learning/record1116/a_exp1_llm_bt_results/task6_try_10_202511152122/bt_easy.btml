selector
    sequence
        cond In(book,cabinet)
        cond Open(cabinet)
    sequence
        cond Open(cabinet)
        selector
            selector
                sequence
                    cond Holding(book)
                    act PutIn(book,cabinet)
                sequence
                    cond On(book,table)
                    cond On(book,breakfast_table)
                    cond IsHandEmpty()
                    act PickUp(book)
            sequence
                cond Holding(banana)
                cond On(book,table)
                cond On(book,breakfast_table)
                cond Open(fridge)
                act PutIn(banana,fridge)
    sequence
        cond Open(fridge)
        cond IsClosed(cabinet)
        cond On(book,table)
        cond On(book,breakfast_table)
        cond Holding(banana)
        selector
            sequence
                cond IsHandEmpty()
                act OpenCabinet()
            sequence
                cond Holding(pen)
                act PutIn(pen,fridge)
