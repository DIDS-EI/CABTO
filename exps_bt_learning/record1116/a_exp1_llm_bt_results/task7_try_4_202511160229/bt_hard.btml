selector
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsOpened(oven)
        cond IsClosed(microwave)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    selector
                        sequence
                            cond IsHandEmpty(left_franka)
                            selector
                                sequence
                                    cond IsSwitchedOn(radio)
                                    selector
                                        sequence
                                            cond IsHandEmpty(right_franka)
                                            cond On(pie,breakfast_table)
                                            act OpenMicrowave()
                                        sequence
                                            cond Holding(right_franka,pie)
                                            act PutOnBreakfastTableRightFranka(pie)
                                sequence
                                    cond Holding(right_franka,pie)
                                    cond IsSwitchedOff(radio)
                                    act SwitchOnRadio()
                        sequence
                            cond Holding(right_franka,pie)
                            cond IsSwitchedOff(radio)
                            cond Holding(left_franka,soup)
                            act PutDownLeftFranka(soup)
                    sequence
                        cond IsHandEmpty(right_franka)
                        cond IsSwitchedOff(radio)
                        cond On(pie,table)
                        cond Holding(left_franka,soup)
                        act PickUpRightFranka(pie)
            sequence
                cond IsSwitchedOff(radio)
                cond On(pie,table)
                cond IsSwitchedOff(light)
                cond Holding(left_franka,soup)
                cond IsHandEmpty(right_franka)
                act SwitchOnLight()
