selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                sequence
                    cond IsSwitchedOn(oven)
                    selector
                        sequence
                            cond In(chickenleg,oven)
                            selector
                                sequence
                                    cond Holding(pie)
                                    act DropInOven(pie)
                                sequence
                                    cond On(pie,table)
                                    cond IsHandEmpty()
                                    act PickUp(pie)
                        sequence
                            cond On(pie,table)
                            cond Holding(chickenleg)
                            act DropInOven(chickenleg)
                sequence
                    cond On(pie,table)
                    cond IsSwitchedOff(oven)
                    cond Holding(chickenleg)
                    act SwitchOnOven()
            sequence
                cond On(pie,table)
                cond IsSwitchedOff(oven)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                act PickUp(chickenleg)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond On(pie,table)
        cond IsHandEmpty()
        cond On(chickenleg,table)
        act OpenOven()
