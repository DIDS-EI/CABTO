selector
    sequence
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsClosed(microwave)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    selector
                        sequence
                            cond On(pie,breakfast_table)
                            selector
                                sequence
                                    cond IsSwitchedOn(radio)
                                    selector
                                        sequence
                                            cond IsSwitchedOn(light)
                                            act OpenMicrowave()
                                        sequence
                                            cond IsSwitchedOff(light)
                                            act SwitchOnLight()
                                sequence
                                    cond IsSwitchedOff(radio)
                                    cond IsSwitchedOff(light)
                                    act SwitchOnRadio()
                        sequence
                            cond IsSwitchedOff(radio)
                            cond IsSwitchedOff(light)
                            cond Holding(pie)
                            act PlaceOnBreakfastTable(pie)
                    sequence
                        cond On(pie,table)
                        cond IsSwitchedOff(radio)
                        cond IsHandEmpty()
                        cond IsSwitchedOff(light)
                        act PickUp(pie)
            sequence
                cond IsSwitchedOff(radio)
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                cond On(pie,table)
                cond IsHandEmpty()
                act OpenOven()
