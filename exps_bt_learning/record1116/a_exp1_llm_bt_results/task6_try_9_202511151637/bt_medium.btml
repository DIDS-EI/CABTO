selector
    sequence
        cond In(banana,fridge)
        cond Open(fridge)
        cond In(pen,cabinet)
    sequence
        cond Open(fridge)
        selector
            sequence
                cond OpenCabinet()
                selector
                    selector
                        selector
                            selector
                                sequence
                                    cond In(banana,fridge)
                                    selector
                                        selector
                                            sequence
                                                cond Holding(pen)
                                                act PutInCabinet(pen)
                                            sequence
                                                cond On(pen,table)
                                                cond IsHandEmpty()
                                                act PickUp(pen)
                                        sequence
                                            cond On(pen,table)
                                            cond Holding(book)
                                            act PutInCabinet(book)
                                sequence
                                    cond On(pen,table)
                                    cond Holding(banana)
                                    cond Holding(book)
                                    cond OpenFridge()
                                    act PutInFridge(banana)
                            sequence
                                cond On(pen,table)
                                cond Holding(book)
                                cond OpenFridge()
                                cond IsHandEmpty()
                                cond On(banana,table)
                                act PickUp(banana)
                        sequence
                            cond On(pen,table)
                            cond Holding(book)
                            cond OpenFridge()
                            cond Holding(apple)
                            cond On(banana,table)
                            act PutInFridge(apple)
                    sequence
                        cond On(pen,table)
                        cond Holding(book)
                        cond Holding(apple)
                        cond IsClosed(fridge)
                        cond On(banana,table)
                        act OpenFridge()
            sequence
                cond On(pen,table)
                cond Holding(book)
                cond Holding(apple)
                cond IsClosed(fridge)
                cond IsClosed(cabinet)
                cond On(banana,table)
                act OpenCabinet()
