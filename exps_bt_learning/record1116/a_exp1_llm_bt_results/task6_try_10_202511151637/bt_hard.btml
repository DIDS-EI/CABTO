selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(book,cabinet)
        cond In(apple,fridge)
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
    sequence
        cond IsClosed(cabinet)
        cond Open(cabinet)
        selector
            selector
                sequence
                    cond In(pen,cabinet)
                    selector
                        sequence
                            cond In(apple,fridge)
                            selector
                                sequence
                                    cond In(banana,fridge)
                                    selector
                                        sequence
                                            cond IsClosed(fridge)
                                            selector
                                                sequence
                                                    cond Holding(book)
                                                    act PlaceInContainer(book,cabinet)
                                                sequence
                                                    cond On(book,table)
                                                    cond IsHandEmpty()
                                                    act PickUpObject(book)
                                        sequence
                                            cond On(book,table)
                                            cond IsHandEmpty()
                                            cond Open(fridge)
                                            act CloseContainer(fridge)
                                sequence
                                    cond On(book,table)
                                    cond Open(fridge)
                                    cond Holding(banana)
                                    act PlaceInContainer(banana,fridge)
                        sequence
                            cond On(book,table)
                            cond Open(fridge)
                            cond Holding(apple)
                            cond Holding(banana)
                            act PlaceInContainer(apple,fridge)
                sequence
                    cond On(book,table)
                    cond Holding(banana)
                    cond Holding(apple)
                    cond Open(fridge)
                    cond Holding(pen)
                    act PlaceInContainer(pen,cabinet)
            sequence
                cond On(book,table)
                cond Holding(apple)
                cond Open(fridge)
                cond IsHandEmpty()
                cond Holding(pen)
                cond On(banana,table)
                act PickUpObject(banana)
