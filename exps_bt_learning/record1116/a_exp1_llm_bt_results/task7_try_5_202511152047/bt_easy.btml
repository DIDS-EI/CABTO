selector
    sequence
        cond In(chickenleg,oven)
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                sequence
                    cond In(pie,oven)
                    selector
                        sequence
                            cond IsSwitchedOn(oven)
                            selector
                                sequence
                                    cond Holding(chickenleg)
                                    act PlaceObjectInAppliance(chickenleg,oven)
                                sequence
                                    cond On(chickenleg,table)
                                    cond IsHandEmpty()
                                    act PickUpObject(chickenleg)
                        sequence
                            cond IsSwitchedOff(oven)
                            cond On(chickenleg,table)
                            cond IsHandEmpty()
                            act SwitchOnAppliance(oven)
                sequence
                    cond On(chickenleg,table)
                    cond IsSwitchedOff(oven)
                    cond Holding(pie)
                    act PlaceObjectInAppliance(pie,oven)
            sequence
                cond IsSwitchedOff(oven)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond On(pie,table)
                act PickUpObject(pie)
    sequence
        cond On(pie,table)
        cond On(chickenleg,table)
        cond IsHandEmpty()
        cond IsClosed(oven)
        cond IsSwitchedOff(oven)
        act OpenAppliance(oven)
