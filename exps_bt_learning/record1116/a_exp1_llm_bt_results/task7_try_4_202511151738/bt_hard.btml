selector
    sequence
        cond IsOpened(microwave)
        cond IsOpened(oven)
        cond IsSwitchedOn(light)
    sequence
        cond IsOpened(microwave)
        cond IsClosed(oven)
        selector
            sequence
                cond IsHandEmpty()
                selector
                    sequence
                        cond IsSwitchedOn(light)
                        act OpenOven()
                    sequence
                        cond IsSwitchedOff(light)
                        act SwitchOnLight()
            sequence
                cond IsSwitchedOff(light)
                cond Holding(soup)
                act PlaceInMicrowave(soup)
