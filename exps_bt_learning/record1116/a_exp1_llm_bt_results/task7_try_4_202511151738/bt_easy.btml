selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    selector
                        sequence
                            cond In(chickenleg,oven)
                            act SwitchOnOven()
                        sequence
                            cond Holding(chickenleg)
                            act PlaceInOven(chickenleg)
                    sequence
                        cond On(chickenleg,table)
                        cond IsHandEmpty()
                        act PickUp(chickenleg)
            sequence
                cond IsClosed(oven)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                act OpenOven()
