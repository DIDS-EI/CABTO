selector
    sequence
        cond On(a,c)
        cond On(b,d)
    sequence
        cond Holding(b)
        cond On(d,table)
        selector
            selector
                sequence
                    cond On(a,c)
                    act PutAOnB(b,d)
                sequence
                    cond On(c,table)
                    cond Holding(a)
                    act PutAOnB(a,c)
            sequence
                cond On(c,table)
                cond IsHandEmpty()
                cond On(a,table)
                act PickUp(a)
