selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                sequence
                    cond In(pie,oven)
                    selector
                        sequence
                            cond IsSwitchedOn(oven)
                            selector
                                sequence
                                    cond Holding(left_franka,chickenleg)
                                    act PlaceInLeftFranka(chickenleg,oven)
                                sequence
                                    cond IsHandEmpty(left_franka)
                                    cond On(chickenleg,table)
                                    act PickUpLeftFranka(chickenleg)
                        sequence
                            cond IsHandEmpty(left_franka)
                            cond On(chickenleg,table)
                            cond IsSwitchedOff(oven)
                            act SwitchOnLeftFranka(oven)
                sequence
                    cond On(chickenleg,table)
                    cond IsSwitchedOff(oven)
                    cond Holding(left_franka,pie)
                    act PlaceInLeftFranka(pie,oven)
            sequence
                cond IsHandEmpty(left_franka)
                cond On(chickenleg,table)
                cond IsSwitchedOff(oven)
                cond On(pie,table)
                act PickUpLeftFranka(pie)
    sequence
        cond On(chickenleg,table)
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        selector
            sequence
                cond IsHandEmpty(left_franka)
                cond On(pie,table)
                act OpenDeviceLeftFranka(oven)
            sequence
                cond Holding(left_franka,pie)
                act PutDownLeftFranka(pie)
