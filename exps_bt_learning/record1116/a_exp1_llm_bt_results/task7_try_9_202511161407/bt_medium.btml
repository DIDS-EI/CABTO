selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                selector
                    selector
                        selector
                            sequence
                                cond IsHandEmpty(left_franka)
                                cond In(soup,microwave)
                                act SwitchOnLeftFranka(microwave)
                            sequence
                                cond IsOpened(microwave)
                                cond Holding(left_franka,soup)
                                act PlaceInLeftFranka(soup,microwave)
                        sequence
                            cond On(soup,table)
                            cond IsHandEmpty(left_franka)
                            cond IsOpened(microwave)
                            act PickUpLeftFranka(soup)
                    sequence
                        cond In(pie,oven)
                        cond IsOpened(microwave)
                        cond Holding(left_franka,pie)
                        cond On(soup,table)
                        act PutDownInLeftFranka(pie,oven)
                sequence
                    cond In(pie,oven)
                    cond Holding(left_franka,pie)
                    cond IsHandEmpty(left_franka)
                    cond IsClosed(microwave)
                    cond On(soup,table)
                    act OpenDeviceLeftFranka(microwave)
            sequence
                cond In(pie,oven)
                cond In(chickenleg,microwave)
                cond Holding(left_franka,pie)
                cond IsClosed(microwave)
                cond Holding(left_franka,chickenleg)
                cond On(soup,table)
                act PutDownInLeftFranka(chickenleg,microwave)
