selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        selector
            selector
                sequence
                    cond In(chickenleg,oven)
                    selector
                        selector
                            sequence
                                cond In(pie,oven)
                                act SwitchOnOven()
                            sequence
                                cond Holding(pie)
                                act DropItem(pie,oven)
                        sequence
                            cond On(pie,table)
                            cond IsHandEmpty()
                            act PickUpItem(pie)
                sequence
                    cond On(pie,table)
                    cond Holding(chickenleg)
                    act DropItem(chickenleg,oven)
            sequence
                cond On(pie,table)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                act PickUpItem(chickenleg)
