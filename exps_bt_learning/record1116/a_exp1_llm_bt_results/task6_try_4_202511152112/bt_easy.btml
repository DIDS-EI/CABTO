selector
    sequence
        cond Open(cabinet)
        cond On(book,breakfast_table)
    sequence
        cond On(book,breakfast_table)
        act Open(cabinet)
    sequence
        cond Holding(book)
        act PutOn(book,breakfast_table)
    sequence
        cond On(book,table)
        cond IsHandEmpty()
        act PickUp(book)
