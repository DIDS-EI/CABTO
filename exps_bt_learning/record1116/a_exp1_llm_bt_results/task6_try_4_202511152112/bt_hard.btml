selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(wine,fridge)
    sequence
        cond Open(fridge)
        selector
            sequence
                cond In(banana,fridge)
                selector
                    selector
                        sequence
                            cond In(wine,fridge)
                            act Close(fridge)
                        sequence
                            cond Holding(wine)
                            act PutIn(wine,fridge)
                    sequence
                        cond On(wine,breakfast_table)
                        cond IsHandEmpty()
                        act PickUp(wine)
            sequence
                cond On(wine,breakfast_table)
                cond Holding(banana)
                act PutIn(banana,fridge)
    sequence
        cond On(wine,breakfast_table)
        selector
            sequence
                cond Holding(banana)
                act Open(fridge)
            sequence
                cond On(banana,table)
                cond IsHandEmpty()
                act PickUp(banana)
