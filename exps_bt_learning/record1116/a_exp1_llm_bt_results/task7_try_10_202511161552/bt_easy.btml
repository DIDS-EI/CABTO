selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
    sequence
        cond IsClosed(oven)
        selector
            selector
                sequence
                    cond In(chickenleg,oven)
                    selector
                        sequence
                            cond Holding(pie)
                            selector
                                sequence
                                    cond IsSwitchedOn(oven)
                                    act PlaceInOven(pie)
                                sequence
                                    cond IsSwitchedOff(oven)
                                    act SwitchOn(oven)
                        sequence
                            cond On(pie,table)
                            cond IsSwitchedOff(oven)
                            cond IsHandEmpty()
                            act PickUp(pie)
                sequence
                    cond On(pie,table)
                    cond IsSwitchedOff(oven)
                    cond Holding(chickenleg)
                    act PlaceInOven(chickenleg)
            sequence
                cond On(pie,table)
                cond IsSwitchedOff(oven)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                act PickUp(chickenleg)
