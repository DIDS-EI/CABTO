selector
    sequence
        cond On(book,breakfast_table)
        cond In(pen,cabinet)
    sequence
        cond In(pen,cabinet)
        selector
            sequence
                cond Holding(book)
                act PutOnSurface(book,breakfast_table)
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                act PickUpFromSurface(book,table)
    sequence
        cond On(book,table)
        selector
            sequence
                cond Open(cabinet)
                selector
                    sequence
                        cond Holding(pen)
                        act PutInContainer(pen,cabinet)
                    sequence
                        cond On(pen,breakfast_table)
                        cond IsHandEmpty()
                        act PickUpFromSurface(pen,breakfast_table)
            sequence
                cond IsClosed(cabinet)
                cond On(pen,breakfast_table)
                cond IsHandEmpty()
                act Open(cabinet)
