selector
    sequence
        cond IsSwitchedOn(light)
        cond IsOpened(oven)
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
    sequence
        cond IsClosed(microwave)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    selector
                        sequence
                            cond On(pie,breakfast_table)
                            selector
                                sequence
                                    cond IsSwitchedOn(radio)
                                    selector
                                        sequence
                                            cond IsSwitchedOn(light)
                                            act OpenMicrowave()
                                        sequence
                                            cond IsSwitchedOff(light)
                                            act SwitchOnLight()
                                sequence
                                    cond IsSwitchedOff(radio)
                                    cond IsSwitchedOff(light)
                                    act SwitchOnRadio()
                        sequence
                            cond IsSwitchedOff(radio)
                            cond Holding(pie)
                            cond IsSwitchedOff(light)
                            act PutOnTable(pie)
                    sequence
                        cond IsSwitchedOff(radio)
                        cond IsSwitchedOff(light)
                        cond On(pie,table)
                        cond IsHandEmpty()
                        act PickUp(pie)
            sequence
                cond IsClosed(oven)
                cond IsHandEmpty()
                cond IsSwitchedOff(radio)
                cond IsSwitchedOff(light)
                cond On(pie,table)
                act OpenOven()
