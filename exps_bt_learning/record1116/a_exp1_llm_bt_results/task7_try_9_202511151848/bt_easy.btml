selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    selector
                        sequence
                            cond In(chickenleg,oven)
                            selector
                                sequence
                                    cond Holding(pie)
                                    act PutInOven(pie)
                                sequence
                                    cond On(pie,table)
                                    cond IsHandEmpty()
                                    act PickUp(pie)
                        sequence
                            cond On(pie,table)
                            cond Holding(chickenleg)
                            act PutInOven(chickenleg)
                    sequence
                        cond On(chickenleg,table)
                        cond On(pie,table)
                        cond IsHandEmpty()
                        act PickUp(chickenleg)
            sequence
                cond On(chickenleg,table)
                cond IsSwitchedOff(oven)
                cond On(pie,table)
                cond IsHandEmpty()
                act SwitchOnOven()
    sequence
        cond On(chickenleg,table)
        cond IsClosed(oven)
        cond IsSwitchedOff(oven)
        cond IsHandEmpty()
        cond On(pie,table)
        act OpenOven()
