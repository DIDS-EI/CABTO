selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsNotIn(soup,microwave)
        cond IsHandEmpty()
        selector
            sequence
                cond IsSwitchedOn(microwave)
                act PutSoupInMicrowave(soup)
            sequence
                cond IsSwitchedOff(microwave)
                act TurnOnMicrowave()
