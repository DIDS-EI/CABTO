selector
    sequence
        cond IsOpened(oven)
        cond IsOpened(microwave)
        cond IsSwitchedOn(light)
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
    sequence
        cond IsClosed(microwave)
        selector
            selector
                sequence
                    cond On(pie,breakfast_table)
                    selector
                        sequence
                            cond IsSwitchedOn(light)
                            selector
                                sequence
                                    cond IsSwitchedOn(radio)
                                    selector
                                        sequence
                                            cond IsOpened(oven)
                                            act OpenDevice(microwave)
                                        sequence
                                            cond IsClosed(oven)
                                            act OpenDevice(oven)
                                sequence
                                    cond IsClosed(oven)
                                    cond IsSwitchedOff(radio)
                                    act SwitchOnDevice1(radio)
                        sequence
                            cond IsSwitchedOff(light)
                            cond IsClosed(oven)
                            cond IsSwitchedOff(radio)
                            act SwitchOnDevice1(light)
                sequence
                    cond IsSwitchedOff(light)
                    cond IsClosed(oven)
                    cond Holding(pie)
                    cond IsSwitchedOff(radio)
                    act PutDownOnBreakfastTable(pie)
            sequence
                cond On(pie,table)
                cond IsSwitchedOff(radio)
                cond IsSwitchedOff(light)
                cond IsHandEmpty()
                cond IsClosed(oven)
                act PickUp(pie)
