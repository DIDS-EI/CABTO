selector
    sequence
        cond In(chickenleg,oven)
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    selector
                        sequence
                            cond In(chickenleg,oven)
                            selector
                                sequence
                                    cond Holding(pie)
                                    act PutIn(pie,oven)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(pie,table)
                                    act PickUp(pie)
                        sequence
                            cond On(pie,table)
                            cond Holding(chickenleg)
                            act PutIn(chickenleg,oven)
                    sequence
                        cond On(chickenleg,table)
                        cond IsHandEmpty()
                        cond On(pie,table)
                        act PickUp(chickenleg)
            sequence
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond IsClosed(oven)
                cond On(pie,table)
                act OpenDevice(oven)
    sequence
        cond On(pie,table)
        cond On(chickenleg,table)
        cond IsHandEmpty()
        cond IsClosed(oven)
        cond IsSwitchedOff(oven)
        act SwitchOnDevice1(oven)
