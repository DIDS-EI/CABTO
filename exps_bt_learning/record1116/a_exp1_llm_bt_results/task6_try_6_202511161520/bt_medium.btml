selector
    sequence
        cond On(book,breakfast_table)
        cond On(cake,breakfast_table)
    sequence
        cond On(cake,breakfast_table)
        selector
            selector
                sequence
                    cond Holding(book)
                    act PlaceOn(book,breakfast_table)
                sequence
                    cond IsHandEmpty()
                    cond On(book,table)orOn(book,breakfast_table)
                    act PickUp(book)
            sequence
                cond IsOpened(cabinet)
                cond Holding(pen)
                cond On(book,table)orOn(book,breakfast_table)
                act PutIn(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        cond Holding(pen)
        cond On(book,table)orOn(book,breakfast_table)
        selector
            selector
                sequence
                    cond Holding(cake)
                    act PlaceOn(cake,breakfast_table)
                sequence
                    cond IsHandEmpty()
                    cond On(cake,table)orOn(cake,breakfast_table)
                    act PickUp(cake)
            sequence
                cond Holding(banana)
                cond On(cake,table)orOn(cake,breakfast_table)
                act PutIn(banana,cabinet)
