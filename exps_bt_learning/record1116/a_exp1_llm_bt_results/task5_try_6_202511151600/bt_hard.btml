selector
    sequence
        cond IsHalfFull(right_cup)
        cond IsHandEmpty(right_franka)
        cond On(right_milk,right_table)
        cond IsHandEmpty(left_franka)
        cond On(left_milk,left_table)
        cond IsHalfFull(left_cup)
    sequence
        cond IsHalfFull(left_cup)
        selector
            sequence
                cond IsHandEmpty(left_franka)
                cond On(left_milk,left_table)
                selector
                    sequence
                        cond IsHolding(right_franka,right_milk)
                        selector
                            sequence
                                cond IsHalfFull(right_cup)
                                act PutDownRightFranka(right_franka,right_milk)
                            sequence
                                cond IsEmpty(right_cup)
                                cond IsFull(right_milk)
                                cond CupNeedGraspAndSupport()
                                act PourIntoRightCup(right_franka,right_milk)
                    sequence
                        cond IsHandEmpty(right_franka)
                        cond IsEmpty(right_cup)
                        cond IsFull(right_milk)
                        cond On(right_milk,right_table)
                        cond CupNeedGraspAndSupport()
                        act PickUpRightFranka(right_franka,right_milk)
            sequence
                cond IsHandEmpty(right_franka)
                cond IsHolding(left_franka,left_milk)
                cond IsEmpty(right_cup)
                cond IsFull(right_milk)
                cond On(right_milk,right_table)
                cond CupNeedGraspAndSupport()
                act PutDownLeftFranka(left_franka,left_milk)
    sequence
        cond IsFull(left_milk)
        cond IsHandEmpty(right_franka)
        cond IsEmpty(right_cup)
        cond IsFull(right_milk)
        cond CupNeedGraspAndSupport()
        cond On(right_milk,right_table)
        cond IsEmpty(left_cup)
        selector
            sequence
                cond IsHolding(left_franka,left_milk)
                act PourIntoLeftCup(left_franka,left_milk)
            sequence
                cond IsHandEmpty(left_franka)
                cond On(left_milk,left_table)
                cond CanGrasp(left_franka,left_milk)
                act PickUpLeftFranka(left_franka,left_milk)
