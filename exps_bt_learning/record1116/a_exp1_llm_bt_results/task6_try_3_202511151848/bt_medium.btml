selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond In(pen,cabinet)
                selector
                    selector
                        sequence
                            cond Holding(book)
                            act PutIn(book,cabinet)
                        sequence
                            cond On(book,table)
                            cond On(book,breakfast_table)
                            cond IsHandEmpty()
                            act PickUp(book)
                    sequence
                        cond On(book,table)
                        cond On(book,breakfast_table)
                        cond Holding(wine)
                        act PutOn(wine,table)
            sequence
                cond On(book,table)
                cond Holding(wine)
                cond On(book,breakfast_table)
                cond Holding(pen)
                act PutIn(pen,cabinet)
    sequence
        cond IsClosed(cabinet)
        cond On(book,table)
        cond On(book,breakfast_table)
        cond Holding(wine)
        selector
            selector
                sequence
                    cond Holding(pen)
                    act Open(cabinet)
                sequence
                    cond On(pen,table)
                    cond On(pen,breakfast_table)
                    cond IsHandEmpty()
                    act PickUp(pen)
            sequence
                cond On(pen,table)
                cond On(pen,breakfast_table)
                cond Holding(apple)
                act PutOn(apple,breakfast_table)
