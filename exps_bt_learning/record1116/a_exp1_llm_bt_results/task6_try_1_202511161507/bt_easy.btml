selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(cabinet)
    sequence
        cond Holding(book)
        selector
            sequence
                cond IsOpened(cabinet)
                act PutIn(book,cabinet)
            sequence
                cond IsClosed(cabinet)
                act Open(cabinet)
    sequence
        cond IsClosed(cabinet)
        cond On(book,table)
        cond On(book,breakfast_table)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    act PickUp(book)
                sequence
                    cond Holding(banana)
                    cond IsOpened(fridge)
                    act PutIn(banana,fridge)
            sequence
                cond Holding(banana)
                cond IsClosed(fridge)
                act Open(fridge)
