selector
    sequence
        cond On(apple,breakfast_table)
        cond IsOpened(fridge)
        cond In(wine,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond On(apple,breakfast_table)
                    selector
                        sequence
                            cond Holding(wine)
                            act PutIn(wine,fridge)
                        sequence
                            cond On(wine,breakfast_table)
                            cond IsHandEmpty()
                            act PickUpFromBreakfastTable(wine)
                sequence
                    cond On(wine,breakfast_table)
                    cond Holding(apple)
                    act PutOn(apple,breakfast_table)
            sequence
                cond On(apple,table)
                cond On(wine,breakfast_table)
                cond IsHandEmpty()
                act PickUp(apple)
    sequence
        cond On(apple,table)
        cond On(wine,breakfast_table)
        cond IsClosed(fridge)
        cond IsHandEmpty()
        act Open(fridge)
