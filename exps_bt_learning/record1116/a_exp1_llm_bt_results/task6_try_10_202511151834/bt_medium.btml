selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
        cond In(pen,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            selector
                sequence
                    cond In(book,cabinet)
                    selector
                        sequence
                            cond Holding(pen)
                            act PutIn(pen,cabinet)
                        sequence
                            cond IsHandEmpty()
                            cond On(pen,table)
                            act PickUp(pen)
                sequence
                    cond Holding(book)
                    cond On(pen,table)
                    act PutIn(book,cabinet)
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                cond On(pen,table)
                act PickUp(book)
    sequence
        cond IsClosed(cabinet)
        cond On(pen,table)
        cond On(book,table)
        cond IsHandEmpty()
        act Open(cabinet)
