selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
        cond In(chickenleg,oven)
    sequence
        cond Holding(pie)
        selector
            selector
                sequence
                    cond IsSwitchedOn(oven)
                    selector
                        sequence
                            cond IsOpened(oven)
                            selector
                                sequence
                                    cond In(chickenleg,oven)
                                    act DropInOven(pie)
                                sequence
                                    cond Holding(chickenleg)
                                    act DropInOven(chickenleg)
                        sequence
                            cond Holding(chickenleg)
                            cond IsClosed(oven)
                            act OpenOven()
                sequence
                    cond IsSwitchedOff(oven)
                    cond Holding(chickenleg)
                    cond IsClosed(oven)
                    act TurnOnOven()
            sequence
                cond IsSwitchedOff(oven)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond IsClosed(oven)
                act PickUp(chickenleg)
