selector
    sequence
        cond In(pen,cabinet)
        cond On(book,breakfast_table)
    sequence
        cond IsHandEmpty()
        cond In(pen,cabinet)
        selector
            selector
                sequence
                    cond On(book,table)
                    act PutOnBreakfastTable(book)
                sequence
                    cond In(book,cabinet)
                    cond IsOpened(cabinet)
                    act TakeOutOfCabinet(book)
            sequence
                cond In(book,cabinet)
                cond IsClosed(cabinet)
                act OpenCabinet()
