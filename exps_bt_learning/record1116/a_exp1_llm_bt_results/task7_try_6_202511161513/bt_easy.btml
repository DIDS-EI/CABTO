selector
    sequence
        cond In(chickenleg,oven)
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond In(chickenleg,oven)
                selector
                    sequence
                        cond IsSwitchedOn(oven)
                        selector
                            sequence
                                cond Holding(pie)
                                act PutInDevice(pie,oven)
                            sequence
                                cond IsHandEmpty()
                                cond On(pie,table)
                                act PickUpFromTable(pie)
                    sequence
                        cond IsHandEmpty()
                        cond IsSwitchedOff(oven)
                        cond On(pie,table)
                        act SwitchOnDevice(oven)
            sequence
                cond IsSwitchedOff(oven)
                cond Holding(chickenleg)
                cond On(pie,table)
                act PutInDevice(chickenleg,oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond On(pie,table)
        selector
            sequence
                cond Holding(chickenleg)
                act OpenDevice(oven)
            sequence
                cond IsHandEmpty()
                cond On(chickenleg,table)
                act PickUpFromTable(chickenleg)
