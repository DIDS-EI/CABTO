selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
        cond In(book,cabinet)
        cond In(apple,fridge)
        cond In(pen,cabinet)
        cond IsClosed(cabinet)
    sequence
        cond Open(cabinet)
        selector
            sequence
                cond In(pen,cabinet)
                selector
                    sequence
                        cond In(book,cabinet)
                        selector
                            selector
                                sequence
                                    cond In(banana,fridge)
                                    selector
                                        sequence
                                            cond In(apple,fridge)
                                            selector
                                                sequence
                                                    cond IsClosed(fridge)
                                                    act CloseCabinet()
                                                sequence
                                                    cond Open(fridge)
                                                    act CloseFridge()
                                        sequence
                                            cond Open(fridge)
                                            cond Holding(apple)
                                            act PlaceInFridge(apple)
                                sequence
                                    cond Open(fridge)
                                    cond Holding(banana)
                                    cond Holding(apple)
                                    act PlaceInFridge(banana)
                            sequence
                                cond IsHandEmpty()
                                cond Open(fridge)
                                cond On(banana,table)
                                cond Holding(apple)
                                act PickUp(banana)
                    sequence
                        cond Open(fridge)
                        cond Holding(book)
                        cond Holding(apple)
                        cond On(banana,table)
                        act PlaceInCabinet(book)
            sequence
                cond Holding(book)
                cond Holding(apple)
                cond Open(fridge)
                cond Holding(pen)
                cond On(banana,table)
                act PlaceInCabinet(pen)
