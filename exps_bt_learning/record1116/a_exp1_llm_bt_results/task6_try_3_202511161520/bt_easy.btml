selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond Holding(book)
                act PutIn(book,cabinet)
            sequence
                cond IsHandEmpty()
                cond On(book,breakfast_table)|On(book,table)
                act PickUp(book)
    sequence
        cond IsClosed(cabinet)
        cond On(book,breakfast_table)|On(book,table)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    act OpenContainer(cabinet)
                sequence
                    cond Holding(banana)
                    cond IsOpened(fridge)
                    act PutIn(banana,fridge)
            sequence
                cond IsClosed(fridge)
                cond Holding(banana)
                act OpenContainer(fridge)
