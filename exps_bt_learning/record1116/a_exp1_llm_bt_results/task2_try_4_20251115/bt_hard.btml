selector
    sequence
        cond On(a,c)
        cond On(b,d)
    sequence
        cond On(c,table)
        cond IsHandEmpty()
        cond On(a,table)
        selector
            sequence
                cond On(b,d)
                act PutAOnB(a,c)
            sequence
                cond On(b,table)
                cond On(d,table)
                act PutAOnB(b,d)
