selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            selector
                sequence
                    cond IsOpened(microwave)
                    selector
                        selector
                            sequence
                                cond Holding(left_franka,soup)
                                selector
                                    selector
                                        sequence
                                            cond IsAt(left_franka,microwave)
                                            act PutInMicrowave(left_franka,soup)
                                        sequence
                                            cond IsAt(left_franka,breakfast_table)
                                            cond IsAt(left_franka,oven)
                                            cond IsHandEmpty(left_franka)
                                            cond IsAt(left_franka,table)
                                            act Move(left_franka,microwave)
                                    sequence
                                        cond IsAt(left_franka,oven)
                                        cond Holding(left_franka,pie)
                                        cond IsAt(left_franka,table)
                                        cond IsOpened(oven)
                                        cond IsAt(left_franka,breakfast_table)
                                        act PutInOven(left_franka,pie)
                            sequence
                                cond IsAt(left_franka,oven)
                                cond Holding(left_franka,pie)
                                cond On(soup,breakfast_table)
                                cond IsAt(left_franka,table)
                                cond IsHandEmpty(left_franka)
                                cond IsOpened(oven)
                                cond IsAt(left_franka,breakfast_table)
                                act PickUpFromBreakfastTable(left_franka,soup)
                        sequence
                            cond IsAt(left_franka,oven)
                            cond Holding(left_franka,pie)
                            cond On(soup,breakfast_table)
                            cond IsAt(left_franka,table)
                            cond Holding(left_franka,chickenleg)
                            cond IsOpened(oven)
                            cond IsAt(left_franka,breakfast_table)
                            act PutInOven(left_franka,chickenleg)
                sequence
                    cond IsHandEmpty(('left_franka',))
                    cond IsAt(left_franka,oven)
                    cond IsClosed(microwave)
                    cond Holding(left_franka,pie)
                    cond On(soup,breakfast_table)
                    cond IsAt(left_franka,table)
                    cond Holding(left_franka,chickenleg)
                    cond IsOpened(oven)
                    cond IsAt(left_franka,breakfast_table)
                    cond IsAt(('left_franka',),microwave)
                    act OpenMicrowave(left_franka)
            sequence
                cond IsHandEmpty(('left_franka',))
                cond IsAt(left_franka,oven)
                cond IsClosed(microwave)
                cond Holding(left_franka,pie)
                cond On(soup,breakfast_table)
                cond IsHandEmpty(('right_franka',))
                cond IsClosed(oven)
                cond IsAt(('right_franka',),oven)
                cond IsAt(left_franka,table)
                cond Holding(left_franka,chickenleg)
                cond IsAt(left_franka,breakfast_table)
                cond IsAt(('left_franka',),microwave)
                act OpenOven(right_franka)
