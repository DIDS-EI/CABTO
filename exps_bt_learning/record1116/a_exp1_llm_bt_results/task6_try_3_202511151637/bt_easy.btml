selector
    sequence
        cond Open(cabinet)
        cond In(apple,fridge)
    sequence
        cond Open(cabinet)
        selector
            sequence
                cond IsOpen(fridge)
                selector
                    selector
                        selector
                            sequence
                                cond Holding(apple)
                                act PlaceIn(apple,fridge)
                            sequence
                                cond On(apple,table)
                                cond IsHandEmpty()
                                act PickUp(apple)
                        sequence
                            cond On(apple,table)
                            cond IsOpen(cabinet)
                            cond Holding(pen)
                            act PlaceIn(pen,cabinet)
                    sequence
                        cond IsClosed(cabinet)
                        cond On(apple,table)
                        cond Holding(pen)
                        act Open(cabinet)
            sequence
                cond IsClosed(cabinet)
                cond IsClosed(fridge)
                cond On(apple,table)
                cond Holding(pen)
                act Open(fridge)
