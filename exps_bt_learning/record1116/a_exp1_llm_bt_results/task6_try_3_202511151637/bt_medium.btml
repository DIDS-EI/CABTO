selector
    sequence
        cond In(banana,fridge)
        cond Open(fridge)
        cond In(pen,cabinet)
    sequence
        cond Open(fridge)
        selector
            sequence
                cond IsOpen(fridge)
                selector
                    selector
                        selector
                            selector
                                selector
                                    sequence
                                        cond Holding(banana)
                                        selector
                                            sequence
                                                cond In(pen,cabinet)
                                                act PlaceIn(banana,fridge)
                                            sequence
                                                cond IsOpen(cabinet)
                                                cond Holding(pen)
                                                act PlaceIn(pen,cabinet)
                                    sequence
                                        cond IsOpen(cabinet)
                                        cond IsHandEmpty()
                                        cond Holding(pen)
                                        cond On(banana,table)
                                        act PickUp(banana)
                                sequence
                                    cond IsOpen(cabinet)
                                    cond Holding(pen)
                                    cond Holding(book)
                                    cond On(banana,table)
                                    act PlaceIn(book,fridge)
                            sequence
                                cond On(pen,table)
                                cond Holding(book)
                                cond IsOpen(cabinet)
                                cond IsHandEmpty()
                                cond On(banana,table)
                                act PickUp(pen)
                        sequence
                            cond On(pen,table)
                            cond Holding(book)
                            cond IsClosed(cabinet)
                            cond IsHandEmpty()
                            cond On(banana,table)
                            act Open(cabinet)
                    sequence
                        cond On(pen,table)
                        cond Holding(book)
                        cond Holding(apple)
                        cond IsClosed(cabinet)
                        cond On(banana,table)
                        act PlaceIn(apple,fridge)
            sequence
                cond On(pen,table)
                cond Holding(book)
                cond Holding(apple)
                cond IsClosed(fridge)
                cond IsClosed(cabinet)
                cond On(banana,table)
                act Open(fridge)
