selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond Holding(chickenleg)
                        selector
                            sequence
                                cond In(pie,oven)
                                act DropToOven(chickenleg)
                            sequence
                                cond Holding(pie)
                                act DropToOven(pie)
                    sequence
                        cond Holding(pie)
                        cond On(chickenleg,table)
                        cond IsHandEmpty()
                        act PickUp(chickenleg)
            sequence
                cond Holding(pie)
                cond On(chickenleg,table)
                cond IsHandEmpty()
                cond IsClosed(oven)
                act OpenOven()
    sequence
        cond Holding(pie)
        cond IsSwitchedOff(oven)
        cond On(chickenleg,table)
        cond IsClosed(oven)
        cond IsHandEmpty()
        act SwitchOnOven()
