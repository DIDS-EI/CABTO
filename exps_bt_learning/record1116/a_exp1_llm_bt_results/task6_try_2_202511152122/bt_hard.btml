selector
    sequence
        cond IsClosed(fridge)
        cond In(banana,fridge)
    sequence
        cond Open(fridge)
        selector
            selector
                sequence
                    cond In(banana,fridge)
                    cond IsHandEmpty()
                    act Close(fridge)
                sequence
                    cond Holding(banana)
                    act Drop(banana,fridge)
            sequence
                cond On(banana,table)
                cond IsHandEmpty()
                act PickUp(banana)
    sequence
        cond IsClosed(fridge)
        cond On(banana,table)
        cond IsHandEmpty()
        act Open(fridge)
