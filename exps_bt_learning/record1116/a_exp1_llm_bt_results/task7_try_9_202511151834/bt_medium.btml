selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                selector
                    sequence
                        cond In(soup,microwave)
                        act SwitchOnDevice(microwave)
                    sequence
                        cond Holding(soup)
                        cond IsOpened(microwave)
                        act CookInDevice(soup,microwave)
                sequence
                    cond Holding(soup)
                    cond IsClosed(microwave)
                    act OpenDevice(microwave)
            sequence
                cond IsClosed(microwave)
                cond On(soup,table)
                cond IsHandEmpty()
                act PickUpObject(soup)
