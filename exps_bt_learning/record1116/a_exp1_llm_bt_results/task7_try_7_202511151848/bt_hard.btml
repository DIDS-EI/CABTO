selector
    sequence
        cond IsSwitchedOn(light)
        cond IsOpened(oven)
        cond On(pie,breakfast_table)
        cond IsSwitchedOn(radio)
        cond IsOpened(microwave)
    sequence
        cond IsClosed(microwave)
        selector
            selector
                sequence
                    cond On(pie,breakfast_table)
                    selector
                        sequence
                            cond IsSwitchedOn(light)
                            selector
                                sequence
                                    cond IsOpened(oven)
                                    selector
                                        sequence
                                            cond IsSwitchedOn(radio)
                                            act Open(microwave)
                                        sequence
                                            cond IsSwitchedOff(radio)
                                            act SwitchOn(radio)
                                sequence
                                    cond IsSwitchedOff(radio)
                                    cond IsClosed(oven)
                                    act Open(oven)
                        sequence
                            cond IsSwitchedOff(radio)
                            cond IsClosed(oven)
                            cond IsSwitchedOff(light)
                            act SwitchOn(light)
                sequence
                    cond IsSwitchedOff(radio)
                    cond Holding(pie)
                    cond IsClosed(oven)
                    cond IsSwitchedOff(light)
                    act MoveToTable(pie)
            sequence
                cond IsClosed(oven)
                cond IsHandEmpty()
                cond IsSwitchedOff(radio)
                cond IsSwitchedOff(light)
                cond On(pie,table)
                act PickUp(pie)
