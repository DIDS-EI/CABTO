selector
    sequence
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
        cond In(pie,oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                selector
                    selector
                        sequence
                            cond In(pie,oven)
                            selector
                                selector
                                    sequence
                                        cond In(chickenleg,oven)
                                        selector
                                            sequence
                                                cond IsClosed(oven)
                                                act SwitchOnOven()
                                            sequence
                                                cond IsOpened(oven)
                                                act CloseOven()
                                    sequence
                                        cond Holding(chickenleg)
                                        cond IsOpened(oven)
                                        act PutInOven(chickenleg)
                                sequence
                                    cond On(chickenleg,table)
                                    cond IsHandEmpty()
                                    cond IsOpened(oven)
                                    cond On(chickenleg,breakfast_table)
                                    act PickUp(chickenleg)
                        sequence
                            cond On(chickenleg,table)
                            cond Holding(pie)
                            cond IsOpened(oven)
                            cond On(chickenleg,breakfast_table)
                            act PutInOven(pie)
                    sequence
                        cond On(pie,breakfast_table)
                        cond IsOpened(oven)
                        cond On(chickenleg,table)
                        cond On(pie,table)
                        cond IsHandEmpty()
                        cond On(chickenleg,breakfast_table)
                        act PickUp(pie)
                sequence
                    cond On(pie,breakfast_table)
                    cond IsClosed(oven)
                    cond On(chickenleg,table)
                    cond On(pie,table)
                    cond IsHandEmpty()
                    cond On(chickenleg,breakfast_table)
                    act OpenOven()
            sequence
                cond On(pie,breakfast_table)
                cond IsClosed(oven)
                cond On(chickenleg,table)
                cond Holding(soup)
                cond On(pie,table)
                cond On(chickenleg,breakfast_table)
                act PutDownOn(soup,breakfast_table)
