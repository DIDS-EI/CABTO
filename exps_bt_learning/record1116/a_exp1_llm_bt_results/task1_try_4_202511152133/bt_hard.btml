selector
    sequence
        cond On(a,place_c)
        cond On(c,place_b)
        cond On(b,place_a)
    sequence
        cond IsEmpty(place_c)
        selector
            sequence
                cond On(c,place_b)
                selector
                    sequence
                        cond Holding(a)
                        selector
                            sequence
                                cond On(b,place_a)
                                act Drop(a,place_c)
                            sequence
                                cond IsEmpty(place_a)
                                cond Holding(b)
                                act Drop(b,place_a)
                    sequence
                        cond IsEmpty(place_a)
                        cond On(a,table)
                        cond Holding(b)
                        cond IsHandEmpty()
                        act PickUp(a)
            sequence
                cond On(a,table)
                cond Holding(c)
                cond IsEmpty(place_a)
                cond IsHandEmpty()
                cond IsEmpty(place_b)
                cond Holding(b)
                act Drop(c,place_b)
