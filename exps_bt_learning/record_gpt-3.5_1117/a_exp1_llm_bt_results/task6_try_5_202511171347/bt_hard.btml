selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond In(banana,fridge)
                act CloseFridge()
            sequence
                cond Holding(left_franka,banana)
                act PutDownLeftFranka(banana,fridge)
    sequence
        cond IsClosed(fridge)
        cond Holding(left_franka,banana)
        act OpenFridge()
