selector
    sequence
        cond On(b,place_b)
        cond On(c,place_c)
    sequence
        cond IsEmpty(place_b)
        selector
            selector
                sequence
                    cond On(c,place_c)
                    selector
                        sequence
                            cond Holding(b)
                            act PutOnPlace(b,place_b)
                        sequence
                            cond IsHandEmpty()
                            cond On(b,table)
                            act PickUp(b)
                sequence
                    cond Holding(c)
                    cond On(b,table)
                    cond IsEmpty(place_c)
                    act PutOnPlace(c,place_c)
            sequence
                cond IsHandEmpty()
                cond On(c,table)
                cond IsEmpty(place_c)
                cond On(b,table)
                act PickUp(c)
