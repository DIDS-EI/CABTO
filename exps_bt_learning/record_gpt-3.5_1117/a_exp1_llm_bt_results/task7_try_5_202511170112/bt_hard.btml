selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsClosed(oven)
        selector
            sequence
                cond On(pie,breakfast_table)
                selector
                    sequence
                        cond IsSwitchedOn(light)
                        selector
                            sequence
                                cond IsSwitchedOn(radio)
                                selector
                                    sequence
                                        cond IsOpened(microwave)
                                        act Open(oven)
                                    sequence
                                        cond IsClosed(microwave)
                                        act Open(microwave)
                            sequence
                                cond IsSwitchedOff(radio)
                                cond IsClosed(microwave)
                                act SwitchOn(radio)
                    sequence
                        cond IsSwitchedOff(radio)
                        cond IsSwitchedOff(light)
                        cond IsClosed(microwave)
                        act SwitchOn(light)
            sequence
                cond IsSwitchedOff(radio)
                cond IsSwitchedOff(light)
                cond On(pie,table)
                cond IsClosed(microwave)
                act PutOnTable(pie,breakfast_table)
