selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond In(pie,oven)
                        selector
                            sequence
                                cond In(chickenleg,oven)
                                act SwitchOn(oven)
                            sequence
                                cond IsHandEmpty()
                                cond On(chickenleg,table)
                                act PutIn(chickenleg,oven)
                    sequence
                        cond IsHandEmpty()
                        cond On(pie,table)
                        cond On(chickenleg,table)
                        act PutIn(pie,oven)
            sequence
                cond IsHandEmpty()
                cond On(pie,table)
                cond IsClosed(oven)
                cond On(chickenleg,table)
                act Open(oven)
