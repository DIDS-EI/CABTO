selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsSwitchedOff(light)
        selector
            selector
                sequence
                    cond On(pie,breakfast_table)
                    selector
                        sequence
                            cond IsOpened(microwave)
                            selector
                                sequence
                                    cond IsSwitchedOn(radio)
                                    selector
                                        sequence
                                            cond IsOpened(oven)
                                            act SwitchOn(light)
                                        sequence
                                            cond IsClosed(oven)
                                            act Open(oven)
                                sequence
                                    cond IsClosed(oven)
                                    cond IsSwitchedOff(radio)
                                    act SwitchOn(radio)
                        sequence
                            cond IsClosed(oven)
                            cond IsSwitchedOff(radio)
                            cond IsClosed(microwave)
                            act Open(microwave)
                sequence
                    cond IsClosed(oven)
                    cond Holding(pie)
                    cond IsSwitchedOff(radio)
                    cond IsClosed(microwave)
                    act PutOnTable(pie,breakfast_table)
            sequence
                cond IsClosed(oven)
                cond IsSwitchedOff(radio)
                cond IsClosed(microwave)
                cond IsHandEmpty()
                cond On(pie,table)
                act PickUp(pie)
