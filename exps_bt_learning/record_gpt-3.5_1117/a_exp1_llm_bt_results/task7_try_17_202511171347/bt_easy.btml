selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                selector
                    sequence
                        cond Holding(chickenleg)
                        selector
                            sequence
                                cond In(pie,oven)
                                selector
                                    sequence
                                        cond IsSwitchedOn(oven)
                                        act PutIn(chickenleg,oven)
                                    sequence
                                        cond IsSwitchedOff(oven)
                                        act SwitchOn(oven)
                            sequence
                                cond IsSwitchedOff(oven)
                                cond Holding(pie)
                                act PutIn(pie,oven)
                    sequence
                        cond IsSwitchedOff(oven)
                        cond Holding(pie)
                        cond IsHandEmpty()
                        cond On(chickenleg,table)
                        act PickUp(chickenleg)
                sequence
                    cond IsSwitchedOff(oven)
                    cond Holding(pie)
                    cond Holding(soup)
                    cond On(chickenleg,table)
                    act PutDown(soup,table)
            sequence
                cond IsSwitchedOff(oven)
                cond Holding(soup)
                cond IsHandEmpty()
                cond On(chickenleg,table)
                cond On(pie,table)
                act PickUp(pie)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond Holding(soup)
        cond IsHandEmpty()
        cond On(chickenleg,table)
        cond On(pie,table)
        act Open(oven)
