selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
    sequence
        cond On(chickenleg,table)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond IsSwitchedOn(oven)
                        selector
                            sequence
                                cond In(pie,oven)
                                act PutIn(chickenleg,oven)
                            sequence
                                cond On(pie,table)
                                act PutIn(pie,oven)
                    sequence
                        cond On(pie,table)
                        cond IsSwitchedOff(oven)
                        act SwitchOn(oven)
            sequence
                cond On(pie,table)
                cond IsClosed(oven)
                cond IsSwitchedOff(oven)
                act Open(oven)
