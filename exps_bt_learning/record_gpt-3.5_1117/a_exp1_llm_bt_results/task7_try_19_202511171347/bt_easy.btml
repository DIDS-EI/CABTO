selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            sequence
                cond In(chickenleg,oven)
                selector
                    sequence
                        cond In(pie,oven)
                        act SwitchOn(oven)
                    sequence
                        cond On(pie,breakfast_table)
                        cond On(pie,table)
                        cond IsOpened(oven)
                        act PutIn(pie,oven)
            sequence
                cond On(pie,breakfast_table)
                cond IsOpened(oven)
                cond On(chickenleg,table)
                cond On(pie,table)
                cond On(chickenleg,breakfast_table)
                act PutIn(chickenleg,oven)
