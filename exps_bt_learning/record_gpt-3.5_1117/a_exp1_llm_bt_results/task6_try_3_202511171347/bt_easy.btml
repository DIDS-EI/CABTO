selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond Holding(book)
        selector
            sequence
                cond IsOpened(cabinet)
                act PutInContainer(book,cabinet)
            sequence
                cond IsClosed(cabinet)
                act OpenContainer(cabinet)
    sequence
        cond IsClosed(cabinet)
        cond IsHandEmpty()
        act PickUp(book)
