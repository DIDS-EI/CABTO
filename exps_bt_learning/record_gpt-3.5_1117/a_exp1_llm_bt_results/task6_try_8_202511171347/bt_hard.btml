selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond In(banana,fridge)
                    cond IsHandEmpty()
                    act CloseFridge()
                sequence
                    cond Holding(banana)
                    act Put(banana,fridge)
            sequence
                cond IsHandEmpty()
                act PickUp(banana)
    sequence
        cond IsClosed(fridge)
        cond IsHandEmpty()
        act OpenFridge()
