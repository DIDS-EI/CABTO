selector
    sequence
        cond On(b,a)
        cond On(c,b)
    sequence
        cond On(a,table)
        selector
            selector
                sequence
                    cond On(c,b)
                    selector
                        sequence
                            cond Holding(b)
                            act PutOnto(b,a)
                        sequence
                            cond IsHandEmpty()
                            cond On(b,table)
                            act PickUp(b)
                sequence
                    cond Holding(c)
                    cond On(b,table)
                    act PutOnto(c,b)
            sequence
                cond IsHandEmpty()
                cond On(c,table)
                cond On(b,table)
                act PickUp(c)
