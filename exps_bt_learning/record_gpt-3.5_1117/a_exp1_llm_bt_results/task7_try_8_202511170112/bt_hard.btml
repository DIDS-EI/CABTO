selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsSwitchedOff(radio)
        selector
            selector
                sequence
                    cond On(pie,breakfast_table)
                    selector
                        sequence
                            cond IsOpened(oven)
                            selector
                                sequence
                                    cond IsSwitchedOn(light)
                                    selector
                                        sequence
                                            cond IsOpened(microwave)
                                            act SwitchOnRadio()
                                        sequence
                                            cond IsClosed(microwave)
                                            act OpenMicrowave()
                                sequence
                                    cond IsSwitchedOff(light)
                                    cond IsClosed(microwave)
                                    act SwitchOnLight()
                        sequence
                            cond IsSwitchedOff(light)
                            cond IsClosed(oven)
                            cond IsClosed(microwave)
                            act OpenOven()
                sequence
                    cond IsSwitchedOff(light)
                    cond IsClosed(oven)
                    cond Holding(pie)
                    cond IsClosed(microwave)
                    act DropOnBreakfastTable(pie)
            sequence
                cond IsClosed(oven)
                cond On(pie,table)
                cond IsClosed(microwave)
                cond IsHandEmpty()
                cond IsSwitchedOff(light)
                act PickUp(pie)
