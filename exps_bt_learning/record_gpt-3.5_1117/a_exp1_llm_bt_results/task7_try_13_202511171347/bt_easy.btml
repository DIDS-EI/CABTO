selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    selector
                        selector
                            sequence
                                cond Holding(pie)
                                selector
                                    sequence
                                        cond In(chickenleg,oven)
                                        act PutInOven(pie)
                                    sequence
                                        cond Holding(chickenleg)
                                        act PutInOven(chickenleg)
                            sequence
                                cond On(pie,table)
                                cond Holding(chickenleg)
                                cond IsHandEmpty()
                                act PickUp(pie)
                        sequence
                            cond Holding(chickenleg)
                            cond Holding(soup)
                            cond On(pie,table)
                            act PutDown(soup,table)
                    sequence
                        cond Holding(soup)
                        cond On(pie,table)
                        cond IsHandEmpty()
                        cond On(chickenleg,table)
                        act PickUp(chickenleg)
            sequence
                cond IsClosed(oven)
                cond Holding(soup)
                cond IsHandEmpty()
                cond On(chickenleg,table)
                cond On(pie,table)
                act Open(oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond On(chickenleg,table)
        selector
            sequence
                cond On(pie,table)
                cond IsHandEmpty()
                selector
                    sequence
                        cond Holding(soup)
                        act SwitchOn(oven)
                    sequence
                        cond In(soup,microwave)
                        cond IsOpened(microwave)
                        act RemoveFromMicrowave(soup)
            sequence
                cond Holding(pie)
                cond In(soup,microwave)
                cond IsOpened(microwave)
                act PutDown(pie,table)
