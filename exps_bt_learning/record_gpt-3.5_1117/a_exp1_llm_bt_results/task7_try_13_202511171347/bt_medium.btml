selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond Holding(soup)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    sequence
                        cond IsSwitchedOn(microwave)
                        act PutInMicrowave(soup)
                    sequence
                        cond IsSwitchedOff(microwave)
                        act SwitchOn(microwave)
            sequence
                cond IsClosed(microwave)
                cond IsSwitchedOff(microwave)
                act Open(microwave)
    sequence
        cond On(soup,table)
        cond IsHandEmpty()
        cond IsClosed(microwave)
        cond IsSwitchedOff(microwave)
        act PickUp(soup)
