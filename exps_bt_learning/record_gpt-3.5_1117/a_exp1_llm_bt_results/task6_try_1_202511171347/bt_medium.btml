selector
    cond On(book,breakfast_table)
    sequence
        cond Holding(robot,book)
        act PutDown(book,breakfast_table)
    sequence
        cond In(book,fridge)
        selector
            selector
                sequence
                    cond IsOpened(fridge)
                    selector
                        sequence
                            cond IsHandEmpty(robot)
                            act PickFromContainer(book,fridge)
                        sequence
                            cond Holding(robot,banana)
                            act PutDown(banana,breakfast_table)
                sequence
                    cond IsClosed(fridge)
                    cond Holding(robot,banana)
                    cond IsHandEmpty(robot)
                    act OpenContainer(fridge)
            sequence
                cond IsClosed(fridge)
                cond Holding(robot,banana)
                cond Holding(robot,pen)
                act PutDown(pen,table)
