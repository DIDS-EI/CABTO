selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            selector
                selector
                    sequence
                        cond Holding(robot,book)
                        act PutInContainer(book,cabinet)
                    sequence
                        cond IsOpened(fridge)
                        cond In(book,fridge)
                        cond IsHandEmpty(robot)
                        act PickFromContainer(book,fridge)
                sequence
                    cond Holding(robot,banana)
                    cond IsOpened(fridge)
                    cond In(book,fridge)
                    act PutDown(banana,breakfast_table)
            sequence
                cond Holding(robot,banana)
                cond In(book,fridge)
                cond IsClosed(fridge)
                cond IsHandEmpty(robot)
                act OpenContainer(fridge)
    sequence
        cond Holding(robot,banana)
        cond In(book,fridge)
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty(robot)
                act OpenContainer(cabinet)
            sequence
                cond Holding(robot,pen)
                act PutDown(pen,table)
