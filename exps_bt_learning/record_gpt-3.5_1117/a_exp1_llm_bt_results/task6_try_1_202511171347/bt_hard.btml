selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                selector
                    sequence
                        cond In(banana,fridge)
                        selector
                            sequence
                                cond IsHandEmpty(robot)
                                act CloseContainer(fridge)
                            sequence
                                cond Holding(robot,pen)
                                act PutDown(pen,breakfast_table)
                    sequence
                        cond Holding(robot,banana)
                        cond Holding(robot,pen)
                        act PutInContainer(banana,fridge)
                sequence
                    cond IsHandEmpty(robot)
                    cond Holding(robot,pen)
                    cond IsOpened(cabinet)
                    cond In(banana,cabinet)
                    act PickFromContainer(banana,cabinet)
            sequence
                cond IsHandEmpty(robot)
                cond IsClosed(cabinet)
                cond Holding(robot,pen)
                cond In(banana,cabinet)
                act OpenContainer(cabinet)
    sequence
        cond IsClosed(fridge)
        cond IsClosed(cabinet)
        cond Holding(robot,pen)
        cond In(banana,cabinet)
        selector
            sequence
                cond IsHandEmpty(robot)
                act OpenContainer(fridge)
            sequence
                cond Holding(robot,book)
                act PutDown(book,table)
