selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond In(banana,fridge)
                act CloseFridge()
            sequence
                cond Holding(banana)
                act PutInFridge(banana)
    sequence
        cond IsClosed(fridge)
        selector
            sequence
                cond Holding(banana)
                act OpenFridge()
            sequence
                cond IsHandEmpty()
                act PickUp(banana)
