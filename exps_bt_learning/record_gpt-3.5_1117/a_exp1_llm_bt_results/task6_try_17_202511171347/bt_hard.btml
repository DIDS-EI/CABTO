selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
    sequence
        cond IsOpened(fridge)
        selector
            sequence
                cond In(banana,fridge)
                cond IsHandEmpty()
                act CloseFridge()
            sequence
                cond Holding(banana)
                act PutIn(banana,fridge)
    sequence
        cond IsClosed(fridge)
        selector
            selector
                sequence
                    cond Holding(banana)
                    selector
                        sequence
                            cond IsHandEmpty()
                            act OpenFridge()
                        sequence
                            cond Holding(pen)
                            cond IsOpened(cabinet)
                            act PutIn(pen,cabinet)
                sequence
                    cond IsOpened(cabinet)
                    cond On(banana,breakfast_table)
                    cond Holding(pen)
                    cond IsHandEmpty()
                    cond On(banana,table)
                    act PickUp(banana)
            sequence
                cond IsOpened(cabinet)
                cond Holding(book)
                cond On(banana,breakfast_table)
                cond Holding(pen)
                cond On(banana,table)
                act PutIn(book,cabinet)
