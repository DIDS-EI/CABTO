selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond Holding(right_franka,soup)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PutInMicrowaveRightFranka(soup)
                    sequence
                        cond IsClosed(microwave)
                        act OpenMicrowave()
            sequence
                cond IsHandEmpty(right_franka)
                cond IsOpened(oven)
                cond IsClosed(microwave)
                cond In(soup,oven)
                act TakeOutOvenRightFranka(soup)
    sequence
        cond IsSwitchedOff(microwave)
        cond In(soup,oven)
        selector
            sequence
                cond IsClosed(microwave)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            sequence
                                cond IsHandEmpty(right_franka)
                                act SwitchOnMicrowave()
                            sequence
                                cond Holding(right_franka,chickenleg)
                                act PutDownRightFranka(chickenleg,table)
                    sequence
                        cond IsClosed(oven)
                        cond Holding(right_franka,chickenleg)
                        act OpenOven()
            sequence
                cond IsOpened(microwave)
                cond IsClosed(oven)
                cond Holding(right_franka,chickenleg)
                act CloseMicrowave()
