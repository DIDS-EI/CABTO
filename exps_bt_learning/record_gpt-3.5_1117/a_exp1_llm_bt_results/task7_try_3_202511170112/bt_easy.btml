selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            selector
                sequence
                    cond Holding(right_franka,pie)
                    selector
                        sequence
                            cond IsOpened(oven)
                            selector
                                selector
                                    sequence
                                        cond In(chickenleg,oven)
                                        act PutInOvenRightFranka(pie)
                                    sequence
                                        cond Holding(left_franka,chickenleg)
                                        act PutInOvenLeftFranka(chickenleg)
                                sequence
                                    cond IsHandEmpty(left_franka)
                                    cond On(chickenleg,breakfast_table)
                                    act PickUpLeftFrankaFromBreakfastTable(chickenleg)
                        sequence
                            cond IsClosed(oven)
                            cond IsHandEmpty(left_franka)
                            cond On(chickenleg,breakfast_table)
                            act OpenOven()
                sequence
                    cond IsClosed(oven)
                    cond IsHandEmpty(left_franka)
                    cond On(chickenleg,breakfast_table)
                    cond In(pie,microwave)
                    cond IsOpened(microwave)
                    cond IsHandEmpty(right_franka)
                    act TakeOutMicrowaveRightFranka(pie)
            sequence
                cond IsClosed(oven)
                cond IsHandEmpty(left_franka)
                cond On(chickenleg,breakfast_table)
                cond IsClosed(microwave)
                cond In(pie,microwave)
                cond IsHandEmpty(right_franka)
                act OpenMicrowave()
