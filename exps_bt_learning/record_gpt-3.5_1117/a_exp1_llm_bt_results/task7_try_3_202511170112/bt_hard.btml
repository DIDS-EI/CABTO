selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
        selector
            selector
                sequence
                    cond IsOpened(oven)
                    selector
                        sequence
                            cond IsSwitchedOn(radio)
                            selector
                                sequence
                                    cond Holding(right_franka,pie)
                                    act PutDownRightFranka(pie,breakfast_table)
                                sequence
                                    cond IsHandEmpty(right_franka)
                                    cond In(pie,oven)
                                    act TakeOutOvenRightFranka(pie)
                        sequence
                            cond IsSwitchedOff(radio)
                            cond IsHandEmpty(right_franka)
                            cond In(pie,oven)
                            act SwitchOnRadio()
                sequence
                    cond IsSwitchedOff(radio)
                    cond IsClosed(oven)
                    cond IsHandEmpty(right_franka)
                    cond In(pie,oven)
                    act OpenOven()
            sequence
                cond IsSwitchedOff(radio)
                cond Holding(right_franka,soup)
                cond IsClosed(oven)
                cond In(pie,oven)
                act PutInMicrowaveRightFranka(soup)
