selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond Holding(soup)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PutIn(soup,microwave)
                    sequence
                        cond IsClosed(microwave)
                        act OpenDevice(microwave)
            sequence
                cond On(soup,table)
                cond IsHandEmpty()
                cond IsClosed(microwave)
                act PickUp(soup)
    sequence
        cond On(soup,table)
        cond IsHandEmpty()
        cond IsClosed(microwave)
        cond IsSwitchedOff(microwave)
        act SwitchOn(microwave)
