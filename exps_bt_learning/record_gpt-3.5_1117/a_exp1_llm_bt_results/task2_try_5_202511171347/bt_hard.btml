selector
    sequence
        cond On(c,b)
        cond On(b,d)
        cond On(a,c)
    sequence
        cond On(b,d)
        selector
            selector
                sequence
                    cond On(a,c)
                    selector
                        sequence
                            cond Holding(c)
                            act PutOn(c,b)
                        sequence
                            cond On(c,table)
                            cond IsHandEmpty()
                            act PickUp(c)
                sequence
                    cond Holding(a)
                    cond On(c,table)
                    act PutOn(a,c)
            sequence
                cond On(c,table)
                cond On(a,table)
                cond IsHandEmpty()
                act PickUp(a)
    sequence
        cond On(c,table)
        cond On(a,table)
        selector
            sequence
                cond Holding(b)
                act PutOn(b,d)
            sequence
                cond On(b,table)
                cond IsHandEmpty()
                act PickUp(b)
