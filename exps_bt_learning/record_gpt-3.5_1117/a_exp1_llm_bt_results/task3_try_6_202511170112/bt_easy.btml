selector
    cond In(left_lego,center_big_box)
    sequence
        cond Holding(right_franka,left_lego)
        selector
            sequence
                cond IsHandEmpty(left_franka)
                cond On(center_big_box,box_board)
                act PutInRightFranka(left_lego,center_big_box)
            sequence
                cond Holding(left_franka,center_big_box)
                act PutDownLeftFranka(center_big_box,box_board)
    sequence
        cond On(left_lego,left_table)
        cond IsHandEmpty(right_franka)
        selector
            sequence
                cond Holding(left_franka,center_big_box)
                act PickUpRightFranka(left_lego)
            sequence
                cond On(center_big_box,center_table)
                cond IsHandEmpty(left_franka)
                act PickUpLeftFranka(center_big_box)
