selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    sequence
                        cond Holding(right_franka,pie)
                        selector
                            sequence
                                cond In(chickenleg,oven)
                                act PutInRightFranka(pie,oven)
                            sequence
                                cond Holding(left_franka,chickenleg)
                                act PutInLeftFranka(chickenleg,oven)
                    sequence
                        cond Holding(left_franka,chickenleg)
                        cond IsHandEmpty(right_franka)
                        cond In(pie,microwave)
                        cond IsOpened(microwave)
                        act TakeOutRightFranka(pie,microwave)
            sequence
                cond IsSwitchedOff(oven)
                cond In(pie,microwave)
                cond IsHandEmpty(right_franka)
                cond IsOpened(microwave)
                cond Holding(left_franka,chickenleg)
                act TurnOnDevice(oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond In(pie,microwave)
        cond IsOpened(microwave)
        cond Holding(left_franka,chickenleg)
        selector
            sequence
                cond IsHandEmpty(right_franka)
                act OpenOven(oven)
            sequence
                cond Holding(right_franka,chickenleg)
                act PutDownRightFranka(chickenleg,breakfast_table)
