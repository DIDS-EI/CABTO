selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOff(microwave)
        selector
            selector
                selector
                    sequence
                        cond In(soup,microwave)
                        act TurnOnDevice(microwave)
                    sequence
                        cond Holding(left_franka,soup)
                        cond IsOpened(microwave)
                        act PutInLeftFranka(soup,microwave)
                sequence
                    cond Holding(left_franka,soup)
                    cond IsClosed(microwave)
                    act OpenMicrowave(microwave)
            sequence
                cond In(soup,oven)
                cond IsHandEmpty(left_franka)
                cond IsOpened(oven)
                cond IsClosed(microwave)
                act TakeOutLeftFranka(soup,oven)
    sequence
        cond In(soup,oven)
        cond IsSwitchedOn(microwave)
        cond IsClosed(microwave)
        selector
            sequence
                cond IsHandEmpty(left_franka)
                selector
                    selector
                        sequence
                            cond IsOpened(oven)
                            act TurnOffDevice(microwave)
                        sequence
                            cond IsSwitchedOff(oven)
                            cond IsClosed(oven)
                            act OpenOven(oven)
                    sequence
                        cond IsClosed(oven)
                        cond IsSwitchedOn(oven)
                        act TurnOffDevice(oven)
            sequence
                cond IsClosed(oven)
                cond Holding(left_franka,oven)
                cond IsSwitchedOn(oven)
                act PutDownLeftFranka(oven,breakfast_table)
