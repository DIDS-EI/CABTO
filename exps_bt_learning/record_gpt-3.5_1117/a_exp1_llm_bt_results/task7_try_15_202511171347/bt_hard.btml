selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsOpened(oven)
        cond IsOpened(microwave)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsSwitchedOn(radio)
                        selector
                            selector
                                sequence
                                    cond Holding(left_franka,pie)
                                    act PutDownLeftFranka(pie,breakfast_table)
                                sequence
                                    cond In(pie,oven)
                                    cond IsHandEmpty(left_franka)
                                    act TakeOutLeftFranka(pie,oven)
                            sequence
                                cond Holding(left_franka,soup)
                                cond In(pie,oven)
                                act PutDownLeftFranka(soup,breakfast_table)
                    sequence
                        cond Holding(left_franka,soup)
                        cond In(pie,oven)
                        cond IsSwitchedOff(radio)
                        act TurnOnDevice(radio)
            sequence
                cond Holding(left_franka,soup)
                cond In(pie,oven)
                cond IsSwitchedOff(radio)
                cond IsSwitchedOff(light)
                act TurnOnDevice(light)
