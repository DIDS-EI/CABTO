selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    sequence
                        cond In(chickenleg,oven)
                        selector
                            sequence
                                cond Holding(left_franka,pie)
                                act PutInLeftFranka(pie,oven)
                            sequence
                                cond IsHandEmpty(left_franka)
                                cond On(pie,table)
                                act PickUpLeftFranka(pie)
                    sequence
                        cond Holding(left_franka,chickenleg)
                        cond On(pie,table)
                        act PutInLeftFranka(chickenleg,oven)
            sequence
                cond IsSwitchedOff(oven)
                cond Holding(left_franka,chickenleg)
                cond On(pie,table)
                act SwitchOnDevice(oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond On(pie,table)
        selector
            selector
                selector
                    sequence
                        cond Holding(left_franka,chickenleg)
                        act OpenDevice(oven)
                    sequence
                        cond IsHandEmpty(left_franka)
                        cond On(chickenleg,table)
                        act PickUpLeftFranka(chickenleg)
                sequence
                    cond Holding(left_franka,soup)
                    cond IsOpened(microwave)
                    cond On(chickenleg,table)
                    act PutInLeftFranka(soup,microwave)
            sequence
                cond Holding(left_franka,soup)
                cond IsClosed(microwave)
                cond On(chickenleg,table)
                act OpenDevice(microwave)
