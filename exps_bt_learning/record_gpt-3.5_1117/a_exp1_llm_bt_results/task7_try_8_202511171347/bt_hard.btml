selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsSwitchedOff(light)
        selector
            sequence
                cond IsSwitchedOn(radio)
                selector
                    sequence
                        cond IsOpened(microwave)
                        selector
                            selector
                                selector
                                    sequence
                                        cond IsOpened(oven)
                                        selector
                                            sequence
                                                cond On(pie,breakfast_table)
                                                act SwitchOnDevice(light)
                                            sequence
                                                cond Holding(left_franka,pie)
                                                act PutDownLeftFranka(pie,breakfast_table)
                                    sequence
                                        cond IsClosed(oven)
                                        cond Holding(left_franka,pie)
                                        act OpenDevice(oven)
                                sequence
                                    cond IsClosed(oven)
                                    cond IsHandEmpty(left_franka)
                                    cond On(pie,table)
                                    act PickUpLeftFranka(pie)
                            sequence
                                cond IsClosed(oven)
                                cond Holding(left_franka,soup)
                                cond On(pie,table)
                                act PutDownLeftFranka(soup,breakfast_table)
                    sequence
                        cond IsClosed(oven)
                        cond Holding(left_franka,soup)
                        cond On(pie,table)
                        cond IsClosed(microwave)
                        act OpenDevice(microwave)
            sequence
                cond IsClosed(oven)
                cond IsSwitchedOff(radio)
                cond IsClosed(microwave)
                cond Holding(left_franka,soup)
                cond On(pie,table)
                act SwitchOnDevice(radio)
