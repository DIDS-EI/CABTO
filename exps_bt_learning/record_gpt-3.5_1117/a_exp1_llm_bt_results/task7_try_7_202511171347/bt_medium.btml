selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond Holding(soup)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PutInDevice(soup,microwave)
                    sequence
                        cond IsClosed(microwave)
                        act Open(microwave)
            sequence
                cond IsClosed(microwave)
                cond IsSwitchedOff(microwave)
                act TurnOn(microwave)
    sequence
        cond On(soup,table)
        cond IsHandEmpty()
        cond IsClosed(microwave)
        cond IsSwitchedOff(microwave)
        act PickUp(soup)
