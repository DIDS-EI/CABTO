selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsSwitchedOn(radio)
                selector
                    sequence
                        cond IsOpened(microwave)
                        selector
                            sequence
                                cond IsSwitchedOn(light)
                                selector
                                    sequence
                                        cond IsOpened(oven)
                                        act PutOnTable(pie)
                                    sequence
                                        cond IsClosed(oven)
                                        act Open(oven)
                            sequence
                                cond IsClosed(oven)
                                cond IsSwitchedOff(light)
                                act TurnOn(light)
                    sequence
                        cond IsClosed(oven)
                        cond IsClosed(microwave)
                        cond IsSwitchedOff(light)
                        act Open(microwave)
            sequence
                cond IsClosed(oven)
                cond IsSwitchedOff(radio)
                cond IsClosed(microwave)
                cond IsSwitchedOff(light)
                act TurnOn(radio)
    sequence
        cond IsClosed(oven)
        cond IsSwitchedOff(radio)
        cond IsClosed(microwave)
        cond IsHandEmpty()
        cond On(pie,table)
        cond IsSwitchedOff(light)
        act PickUp(pie)
