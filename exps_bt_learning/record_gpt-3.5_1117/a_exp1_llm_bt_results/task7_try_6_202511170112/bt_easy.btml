selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
    sequence
        cond IsClosed(oven)
        cond IsSwitchedOff(oven)
        selector
            sequence
                cond In(pie,oven)
                selector
                    sequence
                        cond In(chickenleg,oven)
                        act SwitchOnOven()
                    sequence
                        cond On(chickenleg,table)
                        act PutIn(chickenleg,oven)
            sequence
                cond On(pie,table)
                cond On(chickenleg,table)
                act PutIn(pie,oven)
