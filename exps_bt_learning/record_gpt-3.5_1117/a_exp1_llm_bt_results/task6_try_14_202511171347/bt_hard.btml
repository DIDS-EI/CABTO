selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
    sequence
        cond IsHandEmpty(right_franka)
        selector
            sequence
                cond IsOpened(fridge)
                selector
                    sequence
                        cond In(banana,fridge)
                        act CloseContainerRightFranka(fridge)
                    sequence
                        cond Holding(left_franka,banana)
                        act PutInContainerLeftFranka(banana,fridge)
            sequence
                cond IsClosed(fridge)
                cond Holding(left_franka,banana)
                act OpenContainerRightFranka(fridge)
    sequence
        cond Holding(right_franka,book)
        cond IsClosed(fridge)
        selector
            selector
                selector
                    sequence
                        cond Holding(left_franka,banana)
                        act PutDownRightFranka(book,table)
                    sequence
                        cond IsHandEmpty(left_franka)
                        cond IsOpened(cabinet)
                        cond In(banana,cabinet)
                        act TakeOutContainerLeftFranka(banana,cabinet)
                sequence
                    cond IsHandEmpty(left_franka)
                    cond In(banana,cabinet)
                    cond IsClosed(cabinet)
                    act OpenContainerLeftFranka(cabinet)
            sequence
                cond Holding(left_franka,book)
                cond IsClosed(cabinet)
                cond In(banana,cabinet)
                act PutDownLeftFranka(book,table)
