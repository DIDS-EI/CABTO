selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond Holding(right_franka,book)
        selector
            selector
                sequence
                    cond IsOpened(cabinet)
                    act PutInContainerRightFranka(book,cabinet)
                sequence
                    cond IsClosed(cabinet)
                    cond IsHandEmpty(right_franka)
                    act OpenContainerRightFranka(cabinet)
            sequence
                cond IsClosed(cabinet)
                cond Holding(right_franka,pen)
                act PutDownRightFranka(pen,breakfast_table)
    sequence
        cond In(book,fridge)
        cond Holding(right_franka,pen)
        cond IsClosed(cabinet)
        selector
            sequence
                cond IsHandEmpty(right_franka)
                selector
                    sequence
                        cond IsOpened(fridge)
                        act TakeOutContainerRightFranka(book,fridge)
                    sequence
                        cond IsClosed(fridge)
                        act OpenContainerRightFranka(fridge)
            sequence
                cond IsClosed(fridge)
                cond Holding(right_franka,banana)
                act PutDownRightFranka(banana,breakfast_table)
