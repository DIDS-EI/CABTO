selector
    sequence
        cond IsHandEmpty(left_franka)
        cond IsHalfFull(right_cup)
        cond IsHalfFull(left_cup)
        cond IsHandEmpty(right_franka)
        cond On(left_milk,left_table)
        cond On(right_milk,right_table)
    sequence
        cond IsHalfFull(right_cup)
        cond IsHalfFull(left_cup)
        cond Holding(left_franka,left_cup)
        cond On(right_milk,right_table)
        selector
            sequence
                cond On(left_milk,left_table)
                selector
                    sequence
                        cond IsHandEmpty(right_franka)
                        act PutDownCupLeftFranka(left_cup,left_table)
                    sequence
                        cond Holding(right_franka,right_cup)
                        act PutDownCupRightFranka(right_cup,right_table)
            sequence
                cond Holding(right_franka,right_cup)
                cond Holding(left_franka,left_milk)
                act PutDownMilkLeftFranka(left_milk,left_table)
