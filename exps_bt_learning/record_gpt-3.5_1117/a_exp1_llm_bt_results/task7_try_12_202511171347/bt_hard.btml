selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsSwitchedOff(radio)
        selector
            selector
                sequence
                    cond On(pie,breakfast_table)
                    selector
                        sequence
                            cond IsOpened(microwave)
                            selector
                                sequence
                                    cond IsOpened(oven)
                                    selector
                                        sequence
                                            cond IsSwitchedOn(light)
                                            act SwitchOn(radio)
                                        sequence
                                            cond IsSwitchedOff(light)
                                            act SwitchOn(light)
                                sequence
                                    cond IsClosed(oven)
                                    cond IsSwitchedOff(light)
                                    act Open(oven)
                        sequence
                            cond IsClosed(oven)
                            cond IsClosed(microwave)
                            cond IsSwitchedOff(light)
                            act Open(microwave)
                sequence
                    cond IsClosed(oven)
                    cond Holding(pie)
                    cond IsClosed(microwave)
                    cond IsSwitchedOff(light)
                    act PutDown(pie,breakfast_table)
            sequence
                cond IsClosed(oven)
                cond IsClosed(microwave)
                cond IsHandEmpty()
                cond On(pie,table)
                cond IsSwitchedOff(light)
                act PickUp(pie)
