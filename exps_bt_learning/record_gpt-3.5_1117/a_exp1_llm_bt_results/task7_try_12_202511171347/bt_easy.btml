selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                selector
                    sequence
                        cond In(chickenleg,oven)
                        selector
                            selector
                                sequence
                                    cond In(pie,oven)
                                    act SwitchOn(oven)
                                sequence
                                    cond Holding(pie)
                                    cond IsOpened(oven)
                                    act PlaceInContainer(pie,oven)
                            sequence
                                cond On(pie,table)
                                cond IsOpened(oven)
                                cond IsHandEmpty()
                                act PickUp(pie)
                    sequence
                        cond On(pie,table)
                        cond Holding(chickenleg)
                        cond IsOpened(oven)
                        act PlaceInContainer(chickenleg,oven)
                sequence
                    cond IsClosed(oven)
                    cond On(pie,table)
                    cond Holding(chickenleg)
                    act Open(oven)
            sequence
                cond IsClosed(oven)
                cond On(pie,table)
                cond IsHandEmpty()
                cond On(chickenleg,table)
                act PickUp(chickenleg)
