selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                sequence
                    cond In(chickenleg,oven)
                    selector
                        sequence
                            cond IsSwitchedOn(oven)
                            selector
                                sequence
                                    cond Holding(pie)
                                    act PlaceInContainer(pie,oven)
                                sequence
                                    cond On(pie,table)
                                    cond IsHandEmpty()
                                    act PickUp(pie)
                        sequence
                            cond IsSwitchedOff(oven)
                            cond On(pie,table)
                            cond IsHandEmpty()
                            act SwitchOn(oven)
                sequence
                    cond IsSwitchedOff(oven)
                    cond On(pie,table)
                    cond Holding(chickenleg)
                    act PlaceInContainer(chickenleg,oven)
            sequence
                cond IsSwitchedOff(oven)
                cond On(pie,table)
                cond IsHandEmpty()
                cond On(chickenleg,table)
                act PickUp(chickenleg)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond IsHandEmpty()
        cond On(chickenleg,table)
        cond On(pie,table)
        act Open(oven)
