selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsOpened(microwave)
        selector
            sequence
                cond IsSwitchedOn(microwave)
                selector
                    sequence
                        cond Holding(soup)
                        act PlaceInContainer(soup,microwave)
                    sequence
                        cond On(soup,table)
                        cond IsHandEmpty()
                        act PickUp(soup)
            sequence
                cond On(soup,table)
                cond IsHandEmpty()
                cond IsSwitchedOff(microwave)
                act SwitchOn(microwave)
    sequence
        cond On(soup,table)
        cond IsHandEmpty()
        cond IsClosed(microwave)
        cond IsSwitchedOff(microwave)
        act Open(microwave)
