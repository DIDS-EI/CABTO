selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsSwitchedOff(radio)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    selector
                        sequence
                            cond On(pie,breakfast_table)
                            selector
                                sequence
                                    cond IsOpened(microwave)
                                    selector
                                        sequence
                                            cond IsOpened(oven)
                                            act SwitchOn(radio)
                                        sequence
                                            cond IsClosed(oven)
                                            act Open(oven)
                                sequence
                                    cond IsClosed(oven)
                                    cond IsClosed(microwave)
                                    act Open(microwave)
                        sequence
                            cond IsClosed(oven)
                            cond Holding(pie)
                            cond IsClosed(microwave)
                            act PutDown(pie,breakfast_table)
                    sequence
                        cond IsClosed(oven)
                        cond On(pie,table)
                        cond IsHandEmpty()
                        cond IsClosed(microwave)
                        act PickUp(pie)
            sequence
                cond IsClosed(oven)
                cond IsClosed(microwave)
                cond IsHandEmpty()
                cond On(pie,table)
                cond IsSwitchedOff(light)
                act SwitchOn(light)
