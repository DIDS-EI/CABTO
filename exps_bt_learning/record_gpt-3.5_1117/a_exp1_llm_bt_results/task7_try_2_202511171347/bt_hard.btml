selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsClosed(microwave)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond IsSwitchedOn(light)
                        selector
                            sequence
                                cond IsSwitchedOn(radio)
                                selector
                                    selector
                                        sequence
                                            cond On(pie,breakfast_table)
                                            act OpenMicrowave()
                                        sequence
                                            cond In(pie,oven)
                                            act PutOnBreakfastTableFromOven(pie)
                                    act PutInOven(pie)
                            sequence
                                cond IsSwitchedOff(radio)
                                act SwitchOnRadio()
                    sequence
                        cond IsSwitchedOff(radio)
                        cond IsSwitchedOff(light)
                        act SwitchOnLight()
            sequence
                cond IsClosed(oven)
                cond IsSwitchedOff(radio)
                cond IsSwitchedOff(light)
                act OpenOven()
