selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond On(chickenleg,table)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond In(pie,oven)
                        selector
                            sequence
                                cond IsSwitchedOn(oven)
                                act PutInOvenFromTable(chickenleg)
                            sequence
                                cond IsSwitchedOff(oven)
                                act SwitchOnOven()
                    sequence
                        cond IsSwitchedOff(oven)
                        cond On(pie,table)
                        act PutInOvenFromTable(pie)
            sequence
                cond IsSwitchedOff(oven)
                cond IsClosed(oven)
                cond On(pie,table)
                act OpenOven()
