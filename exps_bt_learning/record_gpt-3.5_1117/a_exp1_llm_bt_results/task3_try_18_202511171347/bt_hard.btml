selector
    cond On(center_big_box,box_board)
    sequence
        cond On(left_franka,left_table)
        cond On(right_franka,right_table)
        selector
            selector
                selector
                    sequence
                        cond HoldingTogether(left_franka,right_franka,center_big_box)
                        act PutDownBigBoxTogether(left_franka,right_franka)
                    sequence
                        cond BigBoxNeedTwoFrankaHoldTogether()
                        cond HoldingPart(right_franka,center_big_box)
                        cond HoldingPart(left_franka,center_big_box)
                        act HoldTogetherBigBox(center_big_box)
                sequence
                    cond On(center_big_box,center_table)
                    cond IsHandEmpty(right_franka)
                    cond HoldingPart(left_franka,center_big_box)
                    cond BigBoxNeedTwoFrankaHoldTogether()
                    act PickUpRightFrankaBigBox(center_big_box)
            sequence
                cond On(center_big_box,center_table)
                cond BigBoxNeedTwoFrankaHoldTogether()
                cond HoldingPart(left_franka,center_big_box)
                cond Holding(right_franka,right_lego)
                act PutDownRightFranka(right_lego,right_table)
