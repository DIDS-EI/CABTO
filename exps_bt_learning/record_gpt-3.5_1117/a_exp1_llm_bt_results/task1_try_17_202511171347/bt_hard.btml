selector
    sequence
        cond On(a,place_c)
        cond On(b,place_a)
        cond On(c,place_b)
    sequence
        cond On(b,place_a)
        selector
            selector
                sequence
                    cond On(a,place_c)
                    selector
                        sequence
                            cond Holding(c)
                            act PutDown(c,place_b)
                        sequence
                            cond On(c,table)
                            cond IsHandEmpty()
                            act PickUp(c)
                sequence
                    cond Holding(a)
                    cond On(c,table)
                    act PutDown(a,place_c)
            sequence
                cond On(c,table)
                cond On(a,table)
                cond IsHandEmpty()
                act PickUp(a)
    sequence
        cond On(c,table)
        cond On(a,table)
        selector
            sequence
                cond Holding(b)
                act PutDown(b,place_a)
            sequence
                cond On(b,table)
                cond IsHandEmpty()
                act PickUp(b)
