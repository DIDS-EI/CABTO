selector
    sequence
        cond On(b,place_b)
        cond On(c,place_c)
    sequence
        cond On(c,place_c)
        selector
            sequence
                cond Holding(b)
                act PutDown(b,place_b)
            sequence
                cond On(b,table)
                cond IsHandEmpty()
                act PickUp(b)
    sequence
        cond On(b,table)
        selector
            sequence
                cond Holding(c)
                act PutDown(c,place_c)
            sequence
                cond On(c,table)
                cond IsHandEmpty()
                act PickUp(c)
