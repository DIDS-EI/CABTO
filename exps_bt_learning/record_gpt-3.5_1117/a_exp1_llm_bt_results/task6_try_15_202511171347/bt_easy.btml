selector
    sequence
        cond IsOpened(cabinet)
        cond In(book,cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond Holding(book)
                act PutIn(book,cabinet)
            sequence
                cond On(book,table)
                cond IsHandEmpty()
                act PickUp(book)
    sequence
        cond On(book,table)
        cond IsClosed(cabinet)
        cond IsHandEmpty()
        act OpenContainer(cabinet)
