selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            selector
                sequence
                    cond IsOpened(oven)
                    selector
                        sequence
                            cond In(pie,oven)
                            selector
                                sequence
                                    cond Holding(chickenleg)
                                    act PlaceInOven(chickenleg)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(chickenleg,table)
                                    act PickUp(chickenleg)
                        sequence
                            cond Holding(pie)
                            cond On(chickenleg,table)
                            act PlaceInOven(pie)
                sequence
                    cond IsClosed(oven)
                    cond Holding(pie)
                    cond On(chickenleg,table)
                    act OpenOven()
            sequence
                cond IsHandEmpty()
                cond On(pie,table)
                cond IsClosed(oven)
                cond On(chickenleg,table)
                act PickUp(pie)
    sequence
        cond IsClosed(oven)
        cond On(chickenleg,table)
        cond IsSwitchedOff(oven)
        cond On(pie,table)
        cond IsHandEmpty()
        act SwitchOnOven()
