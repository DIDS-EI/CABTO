selector
    sequence
        cond IsSwitchedOn(microwave)
        cond In(soup,microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond Holding(soup)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PlaceInMicrowave(soup)
                    sequence
                        cond IsClosed(microwave)
                        act OpenMicrowave()
            sequence
                cond IsHandEmpty()
                cond On(soup,table)
                cond IsClosed(microwave)
                act PickUp(soup)
    sequence
        cond IsSwitchedOff(microwave)
        cond IsHandEmpty()
        cond On(soup,table)
        cond IsClosed(microwave)
        act SwitchOnMicrowave()
