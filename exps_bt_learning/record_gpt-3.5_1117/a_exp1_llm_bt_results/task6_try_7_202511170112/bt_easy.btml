selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(cabinet)
    sequence
        cond Holding(book)
        selector
            sequence
                cond IsOpened(cabinet)
                act PutInCabinet(book)
            sequence
                cond IsClosed(cabinet)
                act OpenCabinet()
    sequence
        cond IsHandEmpty()
        cond IsClosed(cabinet)
        cond On(book,table)
        act PickUp(book)
