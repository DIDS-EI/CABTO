selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            sequence
                                cond IsSwitchedOn(light)
                                selector
                                    sequence
                                        cond IsSwitchedOn(radio)
                                        act PutOnTable(pie,breakfast_table)
                                    sequence
                                        cond IsSwitchedOff(radio)
                                        act SwitchOn(radio)
                            sequence
                                cond IsSwitchedOff(radio)
                                cond IsSwitchedOff(light)
                                act SwitchOn(light)
                    sequence
                        cond IsSwitchedOff(radio)
                        cond IsSwitchedOff(light)
                        cond IsClosed(oven)
                        act Open(oven)
            sequence
                cond IsSwitchedOff(radio)
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                cond IsClosed(microwave)
                act Open(microwave)
    sequence
        cond IsClosed(oven)
        cond IsSwitchedOff(radio)
        cond On(pie,table)
        cond IsClosed(microwave)
        cond IsHandEmpty()
        cond IsSwitchedOff(light)
        act PickUp(pie)
