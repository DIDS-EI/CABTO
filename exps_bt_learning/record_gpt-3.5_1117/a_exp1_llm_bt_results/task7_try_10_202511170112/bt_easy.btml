selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    sequence
                        cond In(chickenleg,oven)
                        selector
                            sequence
                                cond Holding(pie)
                                act PutIn(pie,oven)
                            sequence
                                cond IsHandEmpty()
                                cond On(pie,table)
                                act PickUp(pie)
                    sequence
                        cond On(pie,table)
                        cond Holding(chickenleg)
                        act PutIn(chickenleg,oven)
            sequence
                cond On(pie,table)
                cond Holding(chickenleg)
                cond IsSwitchedOff(oven)
                act SwitchOn(oven)
    sequence
        cond On(pie,table)
        cond IsClosed(oven)
        cond IsSwitchedOff(oven)
        selector
            sequence
                cond Holding(chickenleg)
                act Open(oven)
            sequence
                cond IsHandEmpty()
                cond On(chickenleg,table)
                act PickUp(chickenleg)
