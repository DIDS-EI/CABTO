selector
    sequence
        cond On(a,place_c)
        cond On(b,place_a)
        cond On(c,place_b)
    sequence
        cond On(a,place_c)
        cond On(c,place_b)
        selector
            selector
                sequence
                    cond IsEmpty(place_a)
                    selector
                        sequence
                            cond Holding(right_franka,b)
                            act PutDownRightFranka(b,place_a)
                        sequence
                            cond On(b,table)
                            cond IsHandEmpty(right_franka)
                            act PickUpRightFranka(b)
                sequence
