selector
    sequence
        cond On(b,place_b)
        cond On(c,place_c)
    sequence
        cond IsEmpty(place_b)
        selector
            selector
                sequence
                    cond On(c,place_c)
                    selector
                        sequence
                            cond Holding(left_franka,b)
                            act PutDownLeftFranka(b,place_b)
                        sequence
                            cond On(b,table)
                            cond IsHandEmpty(left_franka)
                            act PickUpLeftFranka(b)
                sequence
                    cond On(b,table)
                    cond Holding(left_franka,c)
                    cond IsEmpty(place_c)
                    act PutDownLeftFranka(c,place_c)
            sequence
                cond Holding(left_franka,c)
                cond On(b,table)
                cond On(a,place_c)
                cond IsHandEmpty(left_franka)
                act PickUpLeftFrankaFromPlace(a,place_c)
    sequence
        cond On(a,place_b)
        cond On(b,table)
        cond On(a,place_c)
        cond IsHandEmpty(left_franka)
        cond IsHandEmpty(right_franka)
        cond Holding(left_franka,c)
        act PickUpRightFrankaFromPlace(a,place_b)
