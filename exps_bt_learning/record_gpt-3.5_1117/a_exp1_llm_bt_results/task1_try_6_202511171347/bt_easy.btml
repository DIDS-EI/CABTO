selector
    cond On(a,place_a)
    sequence
        cond Holding(left_franka,a)
        selector
            sequence
                cond IsEmpty(place_a)
                act PutDownLeftFranka(a,place_a)
            sequence
                cond On(c,place_a)
                cond IsHandEmpty(right_franka)
                act PickUpRightFrankaFromPlace(c,place_a)
    sequence
        cond On(a,place_c)
        cond On(c,place_a)
        selector
            sequence
                cond IsHandEmpty(right_franka)
                selector
                    sequence
                        cond IsHandEmpty(left_franka)
                        act PickUpLeftFrankaFromPlace(a,place_c)
                    sequence
                        cond IsEmpty(place_b)
                        cond Holding(left_franka,b)
                        act PutDownLeftFranka(b,place_b)
            sequence
                cond Holding(right_franka,c)
                cond IsEmpty(place_c)
                cond IsEmpty(place_b)
                cond Holding(left_franka,b)
                act PutDownRightFranka(c,place_c)
