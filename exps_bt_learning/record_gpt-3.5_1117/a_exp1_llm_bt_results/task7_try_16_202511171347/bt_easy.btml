selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            sequence
                cond In(pie,oven)
                selector
                    sequence
                        cond Holding(chickenleg)
                        selector
                            sequence
                                cond IsSwitchedOn(oven)
                                act PutIn(chickenleg,oven)
                            sequence
                                cond IsSwitchedOff(oven)
                                act SwitchOn(oven)
                    sequence
                        cond IsSwitchedOff(oven)
                        cond IsHandEmpty()
                        cond On(chickenleg,table)
                        act PickUp(chickenleg)
            sequence
                cond IsSwitchedOff(oven)
                cond Holding(pie)
                cond On(chickenleg,table)
                act PutIn(pie,oven)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond On(chickenleg,table)
        selector
            sequence
                cond Holding(pie)
                act Open(oven)
            sequence
                cond On(pie,table)
                cond IsHandEmpty()
                act PickUp(pie)
