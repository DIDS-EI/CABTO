selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOff(oven)
        cond In(pie,oven)
        cond In(chickenleg,oven)
        selector
            sequence
                cond IsClosed(oven)
                act SwitchOnOven()
            sequence
                cond IsOpened(oven)
                act CloseOven()
