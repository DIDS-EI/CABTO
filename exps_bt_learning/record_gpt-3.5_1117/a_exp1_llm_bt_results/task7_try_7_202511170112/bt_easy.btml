selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond In(pie,oven)
                        selector
                            sequence
                                cond Holding(chickenleg)
                                act PutInOven(chickenleg)
                            sequence
                                cond IsHandEmpty()
                                cond On(chickenleg,table)
                                act PickUpFromTable(chickenleg)
                    sequence
                        cond IsHandEmpty()
                        cond Holding(pie)
                        cond On(chickenleg,table)
                        act PutInOven(pie)
            sequence
                cond IsHandEmpty()
                cond IsClosed(oven)
                cond Holding(pie)
                cond On(chickenleg,table)
                act OpenOven()
    sequence
        cond On(chickenleg,table)
        cond IsSwitchedOff(oven)
        selector
            sequence
                cond IsClosed(oven)
                selector
                    sequence
                        cond Holding(pie)
                        selector
                            sequence
                                cond IsHandEmpty()
                                act SwitchOnOven()
                            sequence
                                cond Holding(soup)
                                act ReleaseHolding(soup)
                    sequence
                        cond IsHandEmpty()
                        cond On(pie,breakfast_table)
                        cond On(pie,table)
                        cond Holding(soup)
                        act PickUp(pie)
            sequence
                cond On(pie,table)
                cond IsHandEmpty()
                cond On(pie,breakfast_table)
                cond IsOpened(oven)
                cond Holding(soup)
                act CloseOven()
