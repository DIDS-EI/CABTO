selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsSwitchedOn(light)
                selector
                    sequence
                        cond IsSwitchedOn(radio)
                        selector
                            sequence
                                cond IsOpened(microwave)
                                selector
                                    sequence
                                        cond IsOpened(oven)
                                        act PutOnBreakfastTable(pie)
                                    sequence
                                        cond IsClosed(oven)
                                        act OpenOven()
                            sequence
                                cond IsClosed(oven)
                                cond IsClosed(microwave)
                                act OpenMicrowave()
                    sequence
                        cond IsSwitchedOff(radio)
                        cond IsClosed(oven)
                        cond IsClosed(microwave)
                        act SwitchOnRadio()
            sequence
                cond IsSwitchedOff(radio)
                cond IsSwitchedOff(light)
                cond IsClosed(oven)
                cond IsClosed(microwave)
                act SwitchOnLight()
    sequence
        cond IsClosed(oven)
        cond IsSwitchedOff(radio)
        cond On(pie,table)
        cond IsClosed(microwave)
        cond IsHandEmpty()
        cond IsSwitchedOff(light)
        act PickUpFromTable(pie)
