selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond Holding(soup)
                selector
                    sequence
                        cond IsOpened(microwave)
                        act PutInMicrowave(soup)
                    sequence
                        cond IsClosed(microwave)
                        act OpenMicrowave()
            sequence
                cond On(soup,table)
                cond IsHandEmpty()
                cond IsClosed(microwave)
                act PickUp(soup)
    sequence
        cond On(soup,table)
        cond IsHandEmpty()
        cond IsClosed(microwave)
        cond IsSwitchedOff(microwave)
        act SwitchOnMicrowave()
