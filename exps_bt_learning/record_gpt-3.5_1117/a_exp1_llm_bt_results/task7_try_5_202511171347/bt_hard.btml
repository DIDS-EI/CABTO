selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond On(pie,breakfast_table)
        cond IsSwitchedOff(light)
        selector
            sequence
                cond IsOpened(oven)
                selector
                    sequence
                        cond IsSwitchedOn(radio)
                        selector
                            sequence
                                cond IsOpened(microwave)
                                act SwitchOnLight()
                            sequence
                                cond IsClosed(microwave)
                                act OpenMicrowave()
                    sequence
                        cond IsSwitchedOff(radio)
                        cond IsClosed(microwave)
                        act SwitchOnRadio()
            sequence
                cond IsClosed(oven)
                cond IsSwitchedOff(radio)
                cond IsClosed(microwave)
                act OpenOven()
