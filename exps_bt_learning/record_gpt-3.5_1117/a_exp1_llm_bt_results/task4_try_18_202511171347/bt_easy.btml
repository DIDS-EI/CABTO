selector
    cond On(left_box1,right_table)
    sequence
        cond IsHolding(left_franka,left_box1)
        selector
            sequence
                cond At(left_franka,right_table)
                act PutDownLeftFranka(left_box1,right_table)
            act MoveLeftFranka(right_table,right_table)
    sequence
        cond On(left_box1,left_table)
        cond IsHandEmpty(left_franka)
        selector
            sequence
                cond At(left_franka,left_table)
                act PickUpLeftFranka(left_box1)
            act MoveLeftFranka(left_table,left_table)
