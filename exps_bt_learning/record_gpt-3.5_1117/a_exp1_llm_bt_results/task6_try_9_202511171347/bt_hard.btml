selector
    sequence
        cond In(banana,fridge)
        cond IsClosed(fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond In(banana,fridge)
                    cond IsHandEmpty()
                    act CloseContainer(fridge)
                sequence
                    cond Holding(banana)
                    act PutIn(banana,fridge)
            sequence
                cond IsHandEmpty()
                cond On(banana,table)
                act PickUp1(banana)
    sequence
        cond IsClosed(fridge)
        cond IsHandEmpty()
        cond On(banana,table)
        act OpenContainer(fridge)
