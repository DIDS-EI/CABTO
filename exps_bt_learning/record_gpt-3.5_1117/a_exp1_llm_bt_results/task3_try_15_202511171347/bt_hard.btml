selector
    cond On(center_big_box,box_board)
    sequence
        cond On(box_board,center_table)
        selector
            selector
                selector
                    sequence
                        cond On(left_franka,center_table)
                        selector
                            sequence
                                cond On(right_franka,center_table)
                                selector
                                    sequence
                                        cond Holding(left_franka,center_big_box)
                                        cond Holding(right_franka,center_big_box)
                                        act BothFrankaDropBigBoxOnBoxBoard()
                                    sequence
                                        cond On(center_big_box,center_table)
                                        cond IsHandEmpty(left_franka)
                                        cond IsHandEmpty(right_franka)
                                        cond BigBoxNeedTwoFrankaHoldTogether()
                                        act BothFrankaPickUpBigBox()
                            sequence
                                cond On(right_franka,box_board)
                                cond On(right_franka,left_table)
                                cond On(center_big_box,center_table)
                                cond On(right_franka,right_table)
                                cond IsHandEmpty(left_franka)
                                cond IsHandEmpty(right_franka)
                                cond BigBoxNeedTwoFrankaHoldTogether()
                                act MoveRightFranka(center_table)
                    sequence
                        cond On(right_franka,box_board)
                        cond On(left_franka,box_board)
                        cond On(right_franka,left_table)
                        cond On(left_franka,right_table)
                        cond On(center_big_box,center_table)
                        cond On(right_franka,right_table)
                        cond On(left_franka,left_table)
                        cond IsHandEmpty(left_franka)
                        cond IsHandEmpty(right_franka)
                        cond BigBoxNeedTwoFrankaHoldTogether()
                        act MoveLeftFranka(center_table)
                sequence
                    cond On(right_franka,box_board)
                    cond On(left_franka,box_board)
                    cond On(right_franka,left_table)
                    cond On(left_franka,right_table)
                    cond On(center_big_box,center_table)
                    cond On(right_franka,right_table)
                    cond Holding(right_franka,right_lego)
                    cond On(left_franka,left_table)
                    cond IsHandEmpty(left_franka)
                    cond BigBoxNeedTwoFrankaHoldTogether()
                    act DropRightFranka(right_lego,right_table)
            sequence
                cond On(right_franka,box_board)
                cond On(left_franka,box_board)
                cond On(right_franka,left_table)
                cond On(left_franka,right_table)
                cond On(center_big_box,center_table)
                cond On(right_franka,right_table)
                cond Holding(right_franka,right_lego)
                cond On(left_franka,left_table)
                cond Holding(left_franka,left_lego)
                cond BigBoxNeedTwoFrankaHoldTogether()
                act DropLeftFranka(left_lego,left_table)
