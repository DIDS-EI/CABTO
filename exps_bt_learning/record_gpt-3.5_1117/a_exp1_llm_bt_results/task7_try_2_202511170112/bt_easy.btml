selector
    sequence
        cond In(chickenleg,oven)
        cond IsSwitchedOn(oven)
        cond In(pie,oven)
    sequence
        cond In(pie,oven)
        selector
            selector
                sequence
                    cond Holding(left_franka,chickenleg)
                    selector
                        sequence
                            cond IsSwitchedOn(oven)
                            selector
                                sequence
                                    cond IsOpened(oven)
                                    act PutInOvenLeftFranka(chickenleg)
                                sequence
                                    cond IsClosed(oven)
                                    act OpenOven()
                        sequence
                            cond IsClosed(oven)
                            cond IsSwitchedOff(oven)
                            act SwitchOnOven()
                sequence
                    cond IsClosed(oven)
                    cond IsHandEmpty(left_franka)
                    cond On(chickenleg,table)
                    cond IsSwitchedOff(oven)
                    act PickUpLeftFranka(chickenleg)
            sequence
                cond IsOpened(oven)
                cond IsHandEmpty(left_franka)
                cond On(chickenleg,table)
                cond IsSwitchedOff(oven)
                act CloseOven()
    sequence
        cond IsOpened(oven)
        cond On(chickenleg,table)
        cond IsSwitchedOff(oven)
        selector
            selector
                sequence
                    cond Holding(left_franka,pie)
                    act PutInOvenLeftFranka(pie)
                sequence
                    cond On(pie,table)
                    cond IsHandEmpty(left_franka)
                    act PickUpLeftFranka(pie)
            sequence
                cond On(pie,table)
                cond Holding(left_franka,soup)
                act PutDownLeftFranka(soup,breakfast_table)
