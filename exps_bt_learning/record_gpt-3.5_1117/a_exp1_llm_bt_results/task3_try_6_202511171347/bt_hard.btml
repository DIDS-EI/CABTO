selector
    cond On(center_big_box,box_board)
    sequence
        cond On(left_franka,left_table)
        cond BigBoxNeedTwoFrankaHoldTogether()
        selector
            sequence
                cond Holding(left_franka,center_big_box)
                act DropBigBoxLeftFranka(center_big_box,box_board)
            sequence
                cond On(center_big_box,center_table)
                cond IsHandEmpty(left_franka)
                act PickUpBigBoxLeftFranka(center_big_box)
