selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOn(oven)
        selector
            selector
                sequence
                    cond IsOpened(oven)
                    selector
                        sequence
                            cond In(pie,oven)
                            selector
                                sequence
                                    cond Holding(chickenleg)
                                    act PlaceIn(chickenleg,oven)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(chickenleg,table)
                                    act PickUp(chickenleg)
                        sequence
                            cond Holding(pie)
                            cond On(chickenleg,table)
                            act PlaceIn(pie,oven)
                sequence
                    cond IsClosed(oven)
                    cond Holding(pie)
                    cond On(chickenleg,table)
                    act Open(oven)
            sequence
                cond IsClosed(oven)
                cond On(pie,table)
                cond IsHandEmpty()
                cond On(chickenleg,table)
                act PickUp(pie)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond IsHandEmpty()
        cond On(chickenleg,table)
        cond On(pie,table)
        act TurnOn(oven)
