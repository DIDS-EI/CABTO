selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond Holding(pie)
        selector
            sequence
                cond IsOpened(microwave)
                selector
                    sequence
                        cond IsOpened(oven)
                        selector
                            sequence
                                cond IsSwitchedOn(light)
                                selector
                                    sequence
                                        cond IsSwitchedOn(radio)
                                        act PutDown(pie,breakfast_table)
                                    sequence
                                        cond IsSwitchedOff(radio)
                                        act TurnOn(radio)
                            sequence
                                cond IsSwitchedOff(radio)
                                cond IsSwitchedOff(light)
                                act TurnOn(light)
                    sequence
                        cond IsClosed(oven)
                        cond IsSwitchedOff(radio)
                        cond IsSwitchedOff(light)
                        act Open(oven)
            sequence
                cond IsClosed(oven)
                cond IsSwitchedOff(radio)
                cond IsClosed(microwave)
                cond IsSwitchedOff(light)
                act Open(microwave)
    sequence
        cond IsClosed(oven)
        cond IsSwitchedOff(radio)
        cond IsClosed(microwave)
        cond IsHandEmpty()
        cond On(pie,table)
        cond IsSwitchedOff(light)
        act PickUp(pie)
