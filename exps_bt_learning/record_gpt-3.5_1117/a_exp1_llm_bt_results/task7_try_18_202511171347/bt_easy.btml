selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsSwitchedOff(oven)
        selector
            selector
                selector
                    sequence
                        cond In(pie,oven)
                        selector
                            selector
                                sequence
                                    cond In(chickenleg,oven)
                                    act SwitchOn(oven)
                                sequence
                                    cond Holding(chickenleg)
                                    cond IsOpened(oven)
                                    act PutIn(chickenleg,oven)
                            sequence
                                cond On(chickenleg,table)
                                cond IsOpened(oven)
                                cond IsHandEmpty()
                                act PickUp(chickenleg)
                    sequence
                        cond Holding(pie)
                        cond IsOpened(oven)
                        cond On(chickenleg,table)
                        act PutIn(pie,oven)
                sequence
                    cond IsClosed(oven)
                    cond Holding(pie)
                    cond On(chickenleg,table)
                    act Open(oven)
            sequence
                cond IsClosed(oven)
                cond On(pie,table)
                cond IsHandEmpty()
                cond On(chickenleg,table)
                act PickUp(pie)
