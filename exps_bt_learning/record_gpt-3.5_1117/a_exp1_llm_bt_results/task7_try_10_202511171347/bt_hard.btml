selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsClosed(microwave)
        selector
            selector
                sequence
                    cond IsSwitchedOn(radio)
                    selector
                        sequence
                            cond IsSwitchedOn(light)
                            selector
                                sequence
                                    cond IsOpened(oven)
                                    selector
                                        sequence
                                            cond On(pie,breakfast_table)
                                            act OpenMicrowave()
                                        sequence
                                            cond At(right_franka,breakfast_table)
                                            cond Holding(right_franka,pie)
                                            act PutOnBreakfastTableRightFranka(pie)
                                sequence
                                    cond IsClosed(oven)
                                    cond At(right_franka,breakfast_table)
                                    cond Holding(right_franka,pie)
                                    act OpenOven()
                        sequence
                            cond Holding(right_franka,pie)
                            cond IsClosed(oven)
                            cond At(right_franka,breakfast_table)
                            cond IsSwitchedOff(light)
                            act SwitchOnLight()
                sequence
                    cond IsClosed(oven)
                    cond IsSwitchedOff(radio)
                    cond IsSwitchedOff(light)
                    cond At(right_franka,breakfast_table)
                    cond Holding(right_franka,pie)
                    act SwitchOnRadio()
            sequence
                cond Holding(right_franka,pie)
                cond IsClosed(oven)
                cond IsSwitchedOff(radio)
                cond At(right_franka,table)
                cond At(right_franka,microwave)
                cond At(right_franka,oven)
                cond IsSwitchedOff(light)
                act MoveRightFranka(breakfast_table)
