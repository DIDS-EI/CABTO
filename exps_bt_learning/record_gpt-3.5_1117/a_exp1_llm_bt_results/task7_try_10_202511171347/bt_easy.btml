selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond Holding(left_franka,chickenleg)
        selector
            sequence
                cond IsSwitchedOn(oven)
                selector
                    selector
                        selector
                            sequence
                                cond At(left_franka,oven)
                                selector
                                    sequence
                                        cond IsOpened(oven)
                                        selector
                                            sequence
                                                cond In(pie,oven)
                                                act PutInOvenLeftFranka(chickenleg)
                                            sequence
                                                cond Holding(left_franka,pie)
                                                act PutInOvenLeftFranka(pie)
                                    sequence
                                        cond IsClosed(oven)
                                        cond Holding(left_franka,pie)
                                        act OpenOven()
                            sequence
                                cond At(left_franka,table)
                                cond IsClosed(oven)
                                cond Holding(left_franka,pie)
                                cond At(left_franka,microwave)
                                cond At(left_franka,breakfast_table)
                                act MoveLeftFranka(oven)
                        sequence
                            cond At(left_franka,table)
                            cond IsClosed(oven)
                            cond On(pie,table)
                            cond IsHandEmpty(left_franka)
                            cond At(left_franka,microwave)
                            cond At(left_franka,breakfast_table)
                            act PickUpLeftFranka(pie)
                    sequence
                        cond At(left_franka,table)
                        cond IsClosed(oven)
                        cond Holding(left_franka,soup)
                        cond On(pie,table)
                        cond IsOpened(microwave)
                        cond At(left_franka,microwave)
                        cond At(left_franka,breakfast_table)
                        act PutInMicrowaveLeftFranka(soup)
            sequence
                cond IsSwitchedOff(oven)
                cond At(left_franka,table)
                cond IsClosed(oven)
                cond Holding(left_franka,soup)
                cond On(pie,table)
                cond IsOpened(microwave)
                cond At(left_franka,microwave)
                cond At(left_franka,breakfast_table)
                act SwitchOnOven()
    sequence
        cond IsSwitchedOff(oven)
        cond At(left_franka,table)
        cond IsClosed(oven)
        cond Holding(left_franka,soup)
        cond On(chickenleg,table)
        cond IsHandEmpty(left_franka)
        cond On(pie,table)
        cond IsOpened(microwave)
        cond At(left_franka,microwave)
        cond At(left_franka,breakfast_table)
        act PickUpLeftFranka(chickenleg)
