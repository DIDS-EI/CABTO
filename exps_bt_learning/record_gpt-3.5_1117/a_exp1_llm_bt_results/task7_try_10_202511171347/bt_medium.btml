selector
    sequence
        cond In(soup,microwave)
        cond IsSwitchedOn(microwave)
    sequence
        cond IsSwitchedOn(microwave)
        selector
            sequence
                cond Holding(left_franka,soup)
                selector
                    sequence
                        cond IsOpened(microwave)
                        selector
                            sequence
                                cond At(left_franka,microwave)
                                act PutInMicrowaveLeftFranka(soup)
                            sequence
                                cond At(left_franka,table)
                                cond At(left_franka,breakfast_table)
                                cond At(left_franka,oven)
                                act MoveLeftFranka(microwave)
                    sequence
                        cond At(left_franka,table)
                        cond At(left_franka,breakfast_table)
                        cond At(left_franka,oven)
                        cond IsClosed(microwave)
                        act OpenMicrowave()
            sequence
                cond At(left_franka,table)
                cond IsClosed(microwave)
                cond On(soup,table)
                cond At(left_franka,oven)
                cond IsHandEmpty(left_franka)
                cond At(left_franka,breakfast_table)
                act PickUpLeftFranka(soup)
    sequence
        cond At(left_franka,table)
        cond IsClosed(microwave)
        cond On(soup,table)
        cond At(left_franka,oven)
        cond IsSwitchedOff(microwave)
        cond At(left_franka,breakfast_table)
        selector
            sequence
                cond IsHandEmpty(left_franka)
                act SwitchOnMicrowave()
            sequence
                cond Holding(left_franka,pie)
                cond IsOpened(oven)
                act PutInOvenLeftFranka(pie)
