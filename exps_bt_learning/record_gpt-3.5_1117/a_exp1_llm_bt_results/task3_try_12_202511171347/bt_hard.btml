selector
    cond On(center_big_box,box_board)
    sequence
        cond On(left_franka,left_table)
        cond On(center_big_box,center_table)
        cond On(box_board,center_table)
        cond On(right_franka,right_table)
        selector
            sequence
                cond HoldingLeftBigBox(left_franka,center_big_box)
                selector
                    sequence
                        cond HoldingRightBigBox(right_franka,center_big_box)
                        act PutDownBigBoxLeft(center_big_box,box_board)
                    sequence
                        cond BigBoxNeedTwoFrankaHoldTogether()
                        cond IsHandEmpty(right_franka)
                        act PickUpBigBoxRight(center_big_box)
            sequence
                cond BigBoxNeedTwoFrankaHoldTogether()
                cond IsHandEmpty(left_franka)
                cond IsHandEmpty(right_franka)
                act PickUpBigBoxLeft(center_big_box)
