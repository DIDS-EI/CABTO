selector
    sequence
        cond On(b,a)
        cond On(c,b)
    sequence
        cond On(b,a)
        cond Clear(b)
        selector
            sequence
                cond Holding(robot,c)
                act Stack(c,b)
            sequence
                cond IsHandEmpty(robot)
                cond On(c,a)
                cond Clear(c)
                act UnStack(c,a)
    sequence
        cond On(c,a)
        cond Clear(c)
        selector
            selector
                sequence
                    cond Clear(a)
                    selector
                        selector
                            selector
                                selector
                                    sequence
                                        cond Holding(robot,b)
                                        act Stack(b,a)
                                    sequence
                                        cond IsHandEmpty(robot)
                                        cond Clear(b)
                                        cond On(b,d)
                                        act UnStack(b,d)
                                sequence
                                    cond Holding(robot,d)
                                    cond On(b,d)
                                    cond Clear(b)
                                    act PutDown(d)
                            sequence
                                cond On(d,b)
                                cond Clear(d)
                                cond IsHandEmpty(robot)
                                cond On(b,d)
                                act UnStack(d,b)
                        sequence
                            cond On(d,b)
                            cond Holding(robot,d)
                            cond On(b,d)
                            act PutDown(d)
                sequence
                    cond On(d,a)
                    cond Clear(d)
                    cond On(b,d)
                    cond On(d,b)
                    cond IsHandEmpty(robot)
                    act UnStack(d,a)
            sequence
                cond On(d,b)
                cond Holding(robot,d)
                cond On(b,d)
                cond On(d,a)
                act PutDown(d)
