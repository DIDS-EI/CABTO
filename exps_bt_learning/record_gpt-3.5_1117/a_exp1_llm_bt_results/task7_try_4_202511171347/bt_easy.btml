selector
    sequence
        cond In(pie,oven)
        cond IsSwitchedOn(oven)
        cond In(chickenleg,oven)
    sequence
        cond IsOpened(oven)
        selector
            selector
                sequence
                    cond IsSwitchedOn(oven)
                    selector
                        sequence
                            cond In(pie,oven)
                            selector
                                sequence
                                    cond Holding(chickenleg)
                                    act PutInOven(chickenleg)
                                sequence
                                    cond IsHandEmpty()
                                    cond On(chickenleg,table)
                                    act PickUp(chickenleg)
                        sequence
                            cond Holding(pie)
                            cond On(chickenleg,table)
                            act PutInOven(pie)
                sequence
                    cond IsSwitchedOff(oven)
                    cond Holding(pie)
                    cond On(chickenleg,table)
                    act SwitchOn(oven)
            sequence
                cond IsSwitchedOff(oven)
                cond On(pie,table)
                cond IsHandEmpty()
                cond On(chickenleg,table)
                act PickUp(pie)
    sequence
        cond IsSwitchedOff(oven)
        cond IsClosed(oven)
        cond IsHandEmpty()
        cond On(chickenleg,table)
        cond On(pie,table)
        act OpenOven(oven)
