selector
    sequence
        cond On(pie,breakfast_table)
        cond IsOpened(oven)
        cond IsSwitchedOn(radio)
        cond IsSwitchedOn(light)
        cond IsOpened(microwave)
    sequence
        cond IsClosed(oven)
        selector
            selector
                sequence
                    cond On(pie,breakfast_table)
                    selector
                        sequence
                            cond IsSwitchedOn(light)
                            selector
                                sequence
                                    cond IsSwitchedOn(radio)
                                    selector
                                        sequence
                                            cond IsOpened(microwave)
                                            act OpenOven(oven)
                                        sequence
                                            cond IsClosed(microwave)
                                            act OpenMicrowave(microwave)
                                sequence
                                    cond IsSwitchedOff(radio)
                                    cond IsClosed(microwave)
                                    act SwitchOn(radio)
                        sequence
                            cond IsSwitchedOff(radio)
                            cond IsClosed(microwave)
                            cond IsSwitchedOff(light)
                            act SwitchOn(light)
                sequence
                    cond Holding(pie)
                    cond IsSwitchedOff(radio)
                    cond IsClosed(microwave)
                    cond IsSwitchedOff(light)
                    act PutOnBreakfastTable(pie)
            sequence
                cond IsSwitchedOff(radio)
                cond IsClosed(microwave)
                cond IsHandEmpty()
                cond On(pie,table)
                cond IsSwitchedOff(light)
                act PickUp(pie)
