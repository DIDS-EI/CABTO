selector
    sequence
        cond In(book,cabinet)
        cond IsOpened(cabinet)
    sequence
        cond IsOpened(cabinet)
        selector
            sequence
                cond Holding(book)
                act PutIn(book,cabinet)
            sequence
                cond IsHandEmpty()
                cond On(book,table)
                act PickUp(book)
    sequence
        cond IsHandEmpty()
        cond IsClosed(cabinet)
        cond On(book,table)
        act OpenContainer(cabinet)
