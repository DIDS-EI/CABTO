selector
    sequence
        cond IsClosed(fridge)
        cond In(banana,fridge)
    sequence
        cond IsOpened(fridge)
        selector
            selector
                sequence
                    cond IsHandEmpty()
                    cond In(banana,fridge)
                    act CloseContainer(fridge)
                sequence
                    cond Holding(banana)
                    act PutIn(banana,fridge)
            sequence
                cond IsHandEmpty()
                cond On(banana,table)
                act PickUp(banana)
    sequence
        cond IsHandEmpty()
        cond IsClosed(fridge)
        cond On(banana,table)
        act OpenContainer(fridge)
